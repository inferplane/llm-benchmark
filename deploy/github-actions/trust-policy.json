{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {"Federated": "arn:aws:iam::180294183052:oidc-provider/token.actions.githubusercontent.com"},
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {"token.actions.githubusercontent.com:aud": "sts.amazonaws.com"},
        "StringLike": {"token.actions.githubusercontent.com:sub": [
          "repo:inferplane/llm-benchmark:ref:refs/heads/main",
          "repo:inferplane/llm-benchmark:ref:refs/heads/auto/*",
          "repo:inferplane/llm-benchmark:ref:refs/heads/bench/*"
        ]}
      }
    }
  ]
}
