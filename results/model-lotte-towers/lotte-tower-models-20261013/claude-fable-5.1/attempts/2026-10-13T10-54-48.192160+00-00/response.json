{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>롯데월드타워 설계 과정 — 도면·단계별 3D·완성 모델</title>\n<style>\n  :root{\n    --bg:#0f1419; --panel:#171e26; --panel2:#1e2731; --line:#2c3845;\n    --text:#e8edf2; --muted:#9fb0c0; --accent:#ffb84d; --accent2:#5bc0eb; --ok:#8fd694;\n    --official:#cfe4ff; --est:#ffb84d;\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0;background:var(--bg);color:var(--text);font-family:\"Apple SD Gothic Neo\",\"Malgun Gothic\",\"Noto Sans KR\",system-ui,sans-serif;line-height:1.5;font-size:16px}\n  header{padding:16px 20px 8px;border-bottom:1px solid var(--line);display:flex;flex-wrap:wrap;gap:8px 16px;align-items:baseline}\n  header h1{font-size:1.25rem;margin:0}\n  header .sub{color:var(--muted);font-size:.9rem}\n  .badge{margin-left:auto;background:var(--panel2);border:1px solid var(--line);border-radius:999px;padding:2px 10px;font-size:.8rem;color:var(--accent2);font-family:ui-monospace,monospace}\n  .notice{margin:10px 20px 0;padding:10px 12px;background:#2a2416;border:1px solid #5a4a1e;border-radius:8px;font-size:.88rem;color:#ffe2a8}\n  .controls{padding:12px 20px;display:flex;flex-wrap:wrap;gap:12px 20px;align-items:center;border-bottom:1px solid var(--line)}\n  .tabs{display:flex;flex-wrap:wrap;gap:6px}\n  .tabs button{background:var(--panel2);color:var(--text);border:1px solid var(--line);border-radius:8px;padding:8px 12px;font-size:.92rem;cursor:pointer}\n  .tabs button[aria-selected=\"true\"]{background:var(--accent);color:#1a1200;border-color:var(--accent);font-weight:700}\n  .tabs button:focus-visible,.viewer:focus-visible,input:focus-visible,.dtabs button:focus-visible,.btn:focus-visible{outline:3px solid var(--accent2);outline-offset:2px}\n  .level{display:flex;align-items:center;gap:10px;flex:1;min-width:260px}\n  .level label{white-space:nowrap;font-size:.92rem}\n  .level input[type=range]{flex:1;min-width:120px;accent-color:var(--accent)}\n  .level output{font-variant-numeric:tabular-nums;min-width:11em;font-size:.9rem;color:var(--accent)}\n  main{display:grid;grid-template-columns:minmax(300px,1.05fr) 1fr 1fr;gap:12px;padding:12px 20px}\n  .panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;display:flex;flex-direction:column;min-height:420px;overflow:hidden}\n  .panel h2{font-size:1rem;margin:0;padding:10px 14px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:8px;flex-wrap:wrap}\n  .panel h2 small{color:var(--muted);font-weight:400;font-size:.8rem}\n  .dtabs{display:flex;gap:4px;padding:8px 10px 0}\n  .dtabs button{flex:1;background:var(--panel2);color:var(--text);border:1px solid var(--line);border-bottom:none;border-radius:8px 8px 0 0;padding:6px 4px;font-size:.85rem;cursor:pointer}\n  .dtabs button[aria-selected=\"true\"]{background:#243141;color:var(--accent2);font-weight:700}\n  .drawing{flex:1;background:#243141;margin:0 10px;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;min-height:300px}\n  .drawing svg{width:100%;height:100%;max-height:520px;display:block}\n  .caption{padding:10px 14px;font-size:.85rem;color:var(--muted)}\n  .caption b{color:var(--text)}\n  .viewer{flex:1;position:relative;min-height:320px;background:radial-gradient(ellipse at 50% 20%,#2b3a4c,#121820 70%);cursor:grab}\n  .viewer canvas{display:block;width:100%;height:100%}\n  .vbtns{position:absolute;right:8px;top:8px;display:flex;flex-direction:column;gap:6px}\n  .btn{background:rgba(23,30,38,.9);color:var(--text);border:1px solid var(--line);border-radius:8px;width:38px;height:38px;font-size:1.1rem;cursor:pointer}\n  .btn:hover{border-color:var(--accent2)}\n  .hint{position:absolute;left:8px;bottom:8px;font-size:.75rem;color:var(--muted);background:rgba(15,20,25,.7);padding:3px 8px;border-radius:6px}\n  .fallback{position:absolute;inset:0;display:none;align-items:center;justify-content:center;padding:20px;text-align:center;color:var(--muted)}\n  .legend{display:flex;gap:14px;flex-wrap:wrap;font-size:.8rem;color:var(--muted);padding:0 14px 8px}\n  .legend span::before{content:\"\";display:inline-block;width:22px;height:0;border-top:2px solid var(--official);margin-right:6px;vertical-align:middle}\n  .legend span.est::before{border-top:2px dashed var(--est)}\n  .legend span.sel::before{border-top:2px solid var(--accent2)}\n  section.desc{padding:4px 20px 20px;display:grid;grid-template-columns:1.2fr 1fr;gap:12px}\n  .card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px 16px;font-size:.92rem}\n  .card h3{margin:0 0 6px;font-size:1rem;color:var(--accent)}\n  .card ul{margin:6px 0 0 1.2em;padding:0}\n  table{width:100%;border-collapse:collapse;font-size:.85rem}\n  td,th{border-bottom:1px solid var(--line);padding:5px 6px;text-align:left;vertical-align:top}\n  th{color:var(--muted);font-weight:600}\n  .tag{display:inline-block;border-radius:4px;padding:0 6px;font-size:.75rem;font-weight:700}\n  .tag.o{background:#243a57;color:var(--official)} .tag.e{background:#4a3410;color:var(--est)}\n  footer{padding:10px 20px 24px;color:var(--muted);font-size:.8rem;border-top:1px solid var(--line)}\n  footer a{color:var(--accent2)}\n  @media (max-width:1100px){main{grid-template-columns:1fr 1fr}.panel.draw{grid-column:1/-1}}\n  @media (max-width:720px){main{grid-template-columns:1fr}.panel.draw{grid-column:auto}section.desc{grid-template-columns:1fr}header .badge{margin-left:0}.panel{min-height:380px}}\n</style>\n<script src=\"../runtime/three-runtime.js\"></script>\n</head>\n<body>\n<header>\n  <h1>롯데월드타워 설계 과정 인터랙티브</h1>\n  <span class=\"sub\">배치·평면·입면·단면 도면 ↔ 설계 단계별 3D ↔ 완성 3D 모델</span>\n  <span class=\"badge\" aria-label=\"구현 모델\">model: claude-fable-5.1</span>\n</header>\n<div class=\"notice\">\n  이 페이지는 공개 자료(KPF, LERA 프로젝트 소개)를 바탕으로 한 <b>설명용 개념 재구성</b>입니다. 공식 시공 도면이나 검증된 구조 설계가 아닙니다.\n  <span class=\"tag o\">공개</span> 표시는 공개 자료에 있는 값(높이 555 m, 지상 123층 등), <span class=\"tag e\">추정</span> 표시는 공개 자료에 없어 이 페이지가 가정한 개념 치수·부재입니다.\n</div>\n\n<div class=\"controls\">\n  <div class=\"tabs\" role=\"tablist\" aria-label=\"설계 단계\" id=\"stageTabs\"></div>\n  <div class=\"level\">\n    <label for=\"lv\">기준층 선택</label>\n    <input type=\"range\" id=\"lv\" min=\"1\" max=\"123\" value=\"60\" step=\"1\" aria-describedby=\"lvOut\">\n    <output id=\"lvOut\" for=\"lv\"></output>\n  </div>\n</div>\n\n<main>\n  <section class=\"panel draw\" aria-labelledby=\"dh\">\n    <h2 id=\"dh\">설계도면 <small>(단위: m · 개념 재구성)</small></h2>\n    <div class=\"dtabs\" role=\"tablist\" aria-label=\"도면 종류\" id=\"dtabs\">\n      <button role=\"tab\" data-d=\"site\">배치도</button>\n      <button role=\"tab\" data-d=\"plan\">기준층 평면도</button>\n      <button role=\"tab\" data-d=\"elev\">입면도</button>\n      <button role=\"tab\" data-d=\"sect\">단면도</button>\n    </div>\n    <div class=\"drawing\" id=\"drawing\" aria-live=\"polite\"></div>\n    <div class=\"legend\"><span>공개 수치</span><span class=\"est\">추정·개념</span><span class=\"sel\">선택 층 / 대응선</span></div>\n    <div class=\"caption\" id=\"dcap\"></div>\n  </section>\n\n  <section class=\"panel\" aria-labelledby=\"sh\">\n    <h2 id=\"sh\">선택한 설계 단계의 3D 형상 <small id=\"stageName\"></small></h2>\n    <div class=\"viewer\" id=\"v1\" tabindex=\"0\" role=\"application\" aria-label=\"설계 단계 3D 뷰어. 방향키로 회전, +/- 확대 축소, R 초기화\">\n      <div class=\"vbtns\"><button class=\"btn\" data-v=\"1\" data-a=\"in\" title=\"확대\" aria-label=\"확대\">＋</button><button class=\"btn\" data-v=\"1\" data-a=\"out\" title=\"축소\" aria-label=\"축소\">－</button><button class=\"btn\" data-v=\"1\" data-a=\"reset\" title=\"시점 초기화\" aria-label=\"시점 초기화\">⟲</button></div>\n      <div class=\"hint\">드래그 회전 · 휠/핀치 확대 · 방향키 · R 초기화</div>\n      <div class=\"fallback\">3D 실행 환경(Three.js)을 불러올 수 없습니다. 도면 패널은 계속 사용할 수 있습니다.</div>\n    </div>\n    <div class=\"caption\" id=\"scap\"></div>\n  </section>\n\n  <section class=\"panel\" aria-labelledby=\"fh\">\n    <h2 id=\"fh\">완성 모델 <small>높이 555 m · 지상 123층</small></h2>\n    <div class=\"viewer\" id=\"v2\" tabindex=\"0\" role=\"application\" aria-label=\"완성 건물 3D 뷰어. 방향키로 회전, +/- 확대 축소, R 초기화\">\n      <div class=\"vbtns\"><button class=\"btn\" data-v=\"2\" data-a=\"in\" aria-label=\"확대\">＋</button><button class=\"btn\" data-v=\"2\" data-a=\"out\" aria-label=\"축소\">－</button><button class=\"btn\" data-v=\"2\" data-a=\"reset\" aria-label=\"시점 초기화\">⟲</button></div>\n      <div class=\"hint\">드래그 회전 · 휠/핀치 확대 · 방향키 · R 초기화</div>\n      <div class=\"fallback\">3D 실행 환경(Three.js)을 불러올 수 없습니다.</div>\n    </div>\n    <div class=\"caption\" id=\"fcap\"></div>\n  </section>\n</main>\n\n<section class=\"desc\">\n  <div class=\"card\">\n    <h3 id=\"descTitle\"></h3>\n    <div id=\"descBody\"></div>\n  </div>\n  <div class=\"card\">\n    <h3>치수와 근거 기준표</h3>\n    <table>\n      <tr><th>항목</th><th>값</th><th>근거</th></tr>\n      <tr><td>전체 높이</td><td>555 m</td><td><span class=\"tag o\">공개</span> KPF·LERA 프로젝트 소개</td></tr>\n      <tr><td>지상 층수</td><td>123층</td><td><span class=\"tag o\">공개</span></td></tr>\n      <tr><td>형태 특징</td><td>위로 갈수록 평면·외곽 축소, 한국 도자기의 선 참고</td><td><span class=\"tag o\">공개</span> KPF 설명</td></tr>\n      <tr><td>구조 개념</td><td>중앙 코어 + 외곽 메가칼럼 + 아웃리거/벨트트러스</td><td><span class=\"tag o\">공개</span> LERA 소개의 개념 수준 · 부재 위치·수량은 <span class=\"tag e\">추정</span></td></tr>\n      <tr><td>저층 외곽 폭</td><td>약 70 × 70 m</td><td><span class=\"tag e\">추정</span> 이 페이지의 개념 가정</td></tr>\n      <tr><td>평균 층고</td><td>약 4.5 m</td><td><span class=\"tag e\">계산</span> 555 m ÷ 123층 (실제는 층별로 다름)</td></tr>\n      <tr><td>지하 층수·저층부 배치</td><td>지하부 존재, 저층 상업시설 인접</td><td><span class=\"tag e\">개념</span> 정확한 규모·위치 표현 아님</td></tr>\n    </table>\n  </div>\n</section>\n\n<footer>\n  출처(텍스트 링크, 실행 중 접근하지 않음): 원 설계사 KPF — <a href=\"https://www.kpf.com/project/lotte-world-tower\">kpf.com/project/lotte-world-tower</a> ·\n  구조 설계사 LERA — <a href=\"https://www.lera.com/lotte-world-tower\">lera.com/lotte-world-tower</a>.\n  3D 형상과 도면은 같은 매개변수 함수에서 생성되므로 서로 대응하지만, 실제 건물 치수를 재현한 것은 아닙니다. 구현: claude-fable-5.1\n</footer>\n\n<script>\n(function(){\n'use strict';\nconst H=555, FLOORS=123, FH=H/FLOORS, BASE=35;\nconst reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n/* ---------- 설계 단계 ---------- */\nconst STAGES=[\n {name:'1. 부지와 수직 매스', p:{taper:0,curve:1,roundGrow:0,slim:0,seam:0,facade:0,podium:0},\n  desc:'대지에 약 70×70 m(추정) 정사각형 평면을 설정하고, 목표 높이 555 m(공개)까지 그대로 올린 가상의 기준 매스입니다. 이후 단계는 이 매스에서 무엇이 빠지고 다듬어지는지를 보여줍니다.',\n  bullets:['기준층 평면이 모든 층에서 동일 → 입면이 수직선','실제 설계안이 아니라 비교용 출발점']},\n {name:'2. 위로 갈수록 좁아지는 형태', p:{taper:1,curve:1,roundGrow:0,slim:0,seam:0,facade:0,podium:0},\n  desc:'KPF 설명대로 상부로 갈수록 기준층 면적과 외곽이 줄어듭니다. 이 단계에서는 외곽선을 직선으로 줄여 단순한 테이퍼 형태를 만듭니다. 상부 평면 폭은 추정값입니다.',\n  bullets:['입면도: 직선 경사의 외곽선','평면도: 선택 층 높이에 따라 폭이 선형으로 감소']},\n {name:'3. 도자기의 선 — 곡면 외곽', p:{taper:1,curve:1.35,roundGrow:1,slim:0,seam:0,facade:0,podium:0},\n  desc:'한국 도자기의 완만하게 부푼 선을 참고해(공개된 설계 설명) 외곽선을 곡선으로 바꾸고, 모서리를 위로 갈수록 둥글게 다듬습니다. 곡률 값은 설명을 위한 추정입니다.',\n  bullets:['입면도: 아래는 완만하고 위에서 빠르게 좁아지는 곡선','평면도: 각진 사각형 → 둥근 사각형으로 변화']},\n {name:'4. 정상부 분절과 방향성', p:{taper:1,curve:1.35,roundGrow:1,slim:1,seam:1,facade:0,podium:0},\n  desc:'한 방향(여기서는 남북 방향, 개념)으로 더 얇아지게 하여 상부가 납작한 날 모양이 되게 하고, 넓은 면 중앙에 수직 분절선을 두어 두 장의 외피가 만나는 인상을 줍니다. 분절 위치·형상은 추정입니다.',\n  bullets:['단면도: 깊이 방향이 폭보다 빠르게 감소','3D: 상부가 얇아져 방향성이 생김']},\n {name:'5. 완성 — 외피·저층부·구조 개념', p:{taper:1,curve:1.35,roundGrow:1,slim:1,seam:1,facade:1,podium:1},\n  desc:'외피에 수평 분할선을 더하고, 인접 저층부(상업시설)와의 관계를 개념적으로 표시합니다. 내부 구조는 LERA 소개의 \"코어 + 외곽 기둥 + 아웃리거/벨트트러스\" 개념을 단면도에 추정 위치로 나타냅니다.',\n  bullets:['오른쪽 완성 모델과 동일한 매개변수','단면도의 트러스 구간은 개념 위치(추정)']}\n];\nconst FINAL=STAGES[4].p;\n\n/* ---------- 매개변수 형상 함수 (도면과 3D가 공유) ---------- */\nfunction profile(t,p){\n  t=Math.min(1,Math.max(0,t));\n  const f=Math.pow(t,p.curve);\n  const ax=BASE-p.taper*29*f;\n  const by=BASE-p.taper*(29+p.slim*4)*Math.pow(t,p.curve*(1+0.2*p.slim));\n  const n=5-(5-2.2)*p.roundGrow*t;\n  return {ax:Math.max(ax,0.6),by:Math.max(by,0.5),n};\n}\nfunction ring(pr,M){\n  const pts=[];\n  for(let i=0;i<M;i++){\n    const a=i/M*Math.PI*2,c=Math.cos(a),s=Math.sin(a),e=2/pr.n;\n    pts.push([Math.sign(c)*Math.pow(Math.abs(c),e)*pr.ax, Math.sign(s)*Math.pow(Math.abs(s),e)*pr.by]);\n  }\n  return pts;\n}\nfunction levelZ(fl){return fl*FH;}\n\n/* ---------- 상태 ---------- */\nlet stageIdx=4, floor=60, dkind='plan';\n\n/* ---------- 도면 (SVG) ---------- */\nconst drawing=document.getElementById('drawing'), dcap=document.getElementById('dcap');\nconst S={o:'#cfe4ff',e:'#ffb84d',sel:'#5bc0eb',txt:'#e8edf2',mut:'#9fb0c0'};\nconst fmt=v=>v.toFixed(1).replace(/\\.0$/,'');\nfunction txt(x,y,s,o={}){return `<text x=\"${x}\" y=\"${y}\" fill=\"${o.c||S.txt}\" font-size=\"${o.fs||11}\" text-anchor=\"${o.a||'start'}\" ${o.t?`transform=\"${o.t}\"`:''} font-family=\"system-ui,sans-serif\">${s}</text>`;}\nfunction dim(x1,y1,x2,y2,label,c,off=0){ // 치수선\n  const dx=x2-x1,dy=y2-y1,L=Math.hypot(dx,dy),nx=-dy/L*off,ny=dx/L*off;\n  const X1=x1+nx,Y1=y1+ny,X2=x2+nx,Y2=y2+ny,mx=(X1+X2)/2,my=(Y1+Y2)/2;\n  const vert=Math.abs(dx)<1;\n  return `<g stroke=\"${c}\" stroke-width=\"1\" fill=\"none\"><line x1=\"${x1}\" y1=\"${y1}\" x2=\"${X1}\" y2=\"${Y1}\" stroke-dasharray=\"2 2\"/><line x1=\"${x2}\" y1=\"${y2}\" x2=\"${X2}\" y2=\"${Y2}\" stroke-dasharray=\"2 2\"/><line x1=\"${X1}\" y1=\"${Y1}\" x2=\"${X2}\" y2=\"${Y2}\"/><line x1=\"${X1-3}\" y1=\"${Y1+(vert?0:3)}\" x2=\"${X1+3}\" y2=\"${Y1-(vert?0:3)}\"/><line x1=\"${X2-3}\" y1=\"${Y2+(vert?0:3)}\" x2=\"${X2+3}\" y2=\"${Y2-(vert?0:3)}\"/></g>`+\n   txt(mx+(vert?-4:0),my+(vert?0:-4),label,{c,a:vert?'end':'middle',fs:11,t:vert?`rotate(-90 ${mx-4} ${my})`:''});\n}\nfunction poly(pts,c,o={}){return `<polygon points=\"${pts.map(p=>p.join(',')).join(' ')}\" fill=\"${o.f||'none'}\" stroke=\"${c}\" stroke-width=\"${o.w||1.5}\" ${o.d?`stroke-dasharray=\"${o.d}\"`:''}/>`;}\n\nfunction drawSite(){\n  const W=520,Hh=420,sc=2.0,cx=190,cy=230; // 1 m = 2 px\n  const p=STAGES[stageIdx].p, pr=profile(0,p), fp=ring(pr,64).map(q=>[cx+q[0]*sc,cy-q[1]*sc]);\n  let s=`<svg viewBox=\"0 0 ${W} ${Hh}\" role=\"img\" aria-label=\"배치도 개념\">`;\n  s+=`<rect x=\"20\" y=\"40\" width=\"470\" height=\"300\" fill=\"none\" stroke=\"${S.e}\" stroke-dasharray=\"6 4\"/>`+txt(26,56,'대지 경계 (개념·추정)',{c:S.e});\n  s+=`<rect x=\"290\" y=\"110\" width=\"190\" height=\"200\" fill=\"#1e2731\" stroke=\"${S.e}\" stroke-dasharray=\"4 3\"/>`+txt(385,205,'저층부 상업시설',{c:S.e,a:'middle'})+txt(385,222,'(개념 위치, 규모 추정)',{c:S.e,a:'middle',fs:10});\n  s+=`<path d=\"M20 370 Q 260 350 490 375\" stroke=\"#4a7fb0\" stroke-width=\"2\" fill=\"none\"/>`+txt(255,392,'석촌호수 방향 (개념)',{c:'#7fb3e0',a:'middle',fs:10});\n  s+=poly(fp,S.sel,{f:'#2a4a66',w:2})+txt(cx,cy+4,'타워 저층 외곽',{a:'middle',c:S.txt})+txt(cx,cy+20,'1층 평면 투영',{a:'middle',c:S.mut,fs:10});\n  s+=dim(cx-pr.ax*sc,cy-pr.by*sc-6,cx+pr.ax*sc,cy-pr.by*sc-6,`${fmt(pr.ax*2)} m (추정)`,S.e,-14);\n  s+=dim(cx+pr.ax*sc+6,cy-pr.by*sc,cx+pr.ax*sc+6,cy+pr.by*sc,`${fmt(pr.by*2)} m (추정)`,S.e,16);\n  s+=`<g transform=\"translate(455,65)\"><circle r=\"16\" fill=\"none\" stroke=\"${S.txt}\"/><path d=\"M0 -14 L5 4 L0 0 L-5 4 Z\" fill=\"${S.txt}\"/>${txt(0,-20,'N',{a:'middle'})}</g>`;\n  s+=`<g transform=\"translate(30,400)\"><line x1=\"0\" y1=\"0\" x2=\"${50*sc}\" y2=\"0\" stroke=\"${S.txt}\" stroke-width=\"3\"/>${txt(0,14,'0',{fs:10})}${txt(50*sc,14,'50 m',{fs:10,a:'end'})}</g>`;\n  s+='</svg>';\n  drawing.innerHTML=s;\n  dcap.innerHTML=`<b>배치도(개념)</b> — 타워 저층 외곽을 대지에 투영한 그림입니다. 축척 1 m = 2 px, 북쪽은 위. 대지·저층부·호수의 상대 위치는 공개 사진·지도에서 알 수 있는 대략적 관계만 개념으로 표현했고, 치수는 모두 <span class=\"tag e\">추정</span>입니다. 선택 단계의 저층 평면이 그대로 반영됩니다.`;\n}\nfunction drawPlan(){\n  const W=520,Hh=420,sc=4.2,cx=240,cy=210;\n  const p=STAGES[stageIdx].p, t=levelZ(floor)/H, pr=profile(t,p), base=profile(0,p);\n  const out=ring(pr,96).map(q=>[cx+q[0]*sc,cy-q[1]*sc]);\n  const basePts=ring(base,96).map(q=>[cx+q[0]*sc,cy-q[1]*sc]);\n  const cw=Math.min(pr.ax*0.55,14), cd=Math.min(pr.by*0.6,12);\n  let s=`<svg viewBox=\"0 0 ${W} ${Hh}\" role=\"img\" aria-label=\"${floor}층 기준층 평면도 개념\">`;\n  s+=poly(basePts,S.mut,{d:'3 4',w:1})+txt(cx+base.ax*sc-2,cy-base.by*sc-6,'1층 외곽 (참고)',{c:S.mut,fs:10,a:'end'});\n  s+=poly(out,S.sel,{f:'#2a4a66',w:2.2});\n  // 코어\n  s+=`<rect x=\"${cx-cw*sc}\" y=\"${cy-cd*sc}\" width=\"${cw*2*sc}\" height=\"${cd*2*sc}\" fill=\"#3a4b5e\" stroke=\"${S.e}\" stroke-dasharray=\"4 3\"/>`+txt(cx,cy+4,'코어(추정)',{a:'middle',fs:10,c:S.e});\n  // 메가칼럼 8개 (개념)\n  if(stageIdx>=4){\n    const pts=ring(profile(t,p),8).map(q=>[q[0]*0.86,q[1]*0.86]);\n    pts.forEach((q,i)=>{ const a=(i+0.5)/8*Math.PI*2,c=Math.cos(a),e=2/pr.n,sn=Math.sin(a);\n      const X=cx+Math.sign(c)*Math.pow(Math.abs(c),e)*pr.ax*0.84*sc, Y=cy-Math.sign(sn)*Math.pow(Math.abs(sn),e)*pr.by*0.82*sc;\n      s+=`<rect x=\"${X-5}\" y=\"${Y-5}\" width=\"10\" height=\"10\" fill=\"${S.e}\" opacity=\".85\"/>`;});\n    s+=txt(28,392,'■ 외곽 기둥 8개: LERA의 개념 설명 기반, 위치·수량·크기는 추정',{c:S.e,fs:10});\n  }\n  s+=dim(cx-pr.ax*sc,cy-pr.by*sc-8,cx+pr.ax*sc,cy-pr.by*sc-8,`폭 ${fmt(pr.ax*2)} m (계산·추정)`,S.e,-14);\n  s+=dim(cx+pr.ax*sc+8,cy-pr.by*sc,cx+pr.ax*sc+8,cy+pr.by*sc,`깊이 ${fmt(pr.by*2)} m (계산·추정)`,S.e,16);\n  s+=txt(20,24,`기준층 평면도 — ${floor}층 (높이 약 ${fmt(levelZ(floor))} m)`,{fs:13});\n  s+=txt(20,42,`면적(개념) 약 ${Math.round(pr.ax*pr.by*4*0.86).toLocaleString()} m² · 1층 대비 ${Math.round(pr.ax*pr.by/(base.ax*base.by)*100)} %`,{fs:11,c:S.mut});\n  s+=`<g transform=\"translate(30,370)\"><line x1=\"0\" y1=\"0\" x2=\"${20*sc}\" y2=\"0\" stroke=\"${S.txt}\" stroke-width=\"3\"/>${txt(0,14,'0',{fs:10})}${txt(20*sc,14,'20 m',{fs:10,a:'end'})}</g>`;\n  s+=`<g transform=\"translate(480,60)\"><circle r=\"14\" fill=\"none\" stroke=\"${S.txt}\"/><path d=\"M0 -12 L4 3 L0 0 L-4 3 Z\" fill=\"${S.txt}\"/>${txt(0,-18,'N',{a:'middle'})}</g>`;\n  s+='</svg>';\n  drawing.innerHTML=s;\n  dcap.innerHTML=`<b>기준층 평면도(개념)</b> — 슬라이더로 고른 ${floor}층의 외곽선을 선택 단계의 형상 함수로 잘라낸 단면입니다. 층 높이는 555 m ÷ 123층 ≈ 4.5 m의 균등 층고로 <span class=\"tag e\">계산</span>했으며, 외곽 폭·코어·기둥은 모두 <span class=\"tag e\">추정</span>입니다. 3D 모델의 하늘색 링이 이 평면의 위치입니다.`;\n}\nfunction drawElev(){\n  const W=520,Hh=620,sc=1.0,cx=200,gy=580;\n  const p=STAGES[stageIdx].p,N=80;\n  const L=[],R=[],FL=[],FR=[];\n  for(let i=0;i<=N;i++){const t=i/N,pr=profile(t,p),fp=profile(t,FINAL),y=gy-t*H*sc;L.push([cx-pr.ax*sc,y]);R.push([cx+pr.ax*sc,y]);FL.push([cx-fp.ax*sc,y]);FR.push([cx+fp.ax*sc,y]);}\n  const outline=L.concat(R.reverse()), fin=FL.concat(FR.reverse());\n  let s=`<svg viewBox=\"0 0 ${W} ${Hh}\" role=\"img\" aria-label=\"입면도 개념\">`;\n  s+=`<line x1=\"20\" y1=\"${gy}\" x2=\"500\" y2=\"${gy}\" stroke=\"${S.txt}\" stroke-width=\"2\"/>`+txt(24,gy+14,'지반 ±0 (기준)',{fs:10,c:S.mut});\n  if(p.podium) s+=`<rect x=\"${cx+30}\" y=\"${gy-40}\" width=\"110\" height=\"40\" fill=\"#1e2731\" stroke=\"${S.e}\" stroke-dasharray=\"4 3\"/>`+txt(cx+85,gy-16,'저층부(개념)',{fs:10,a:'middle',c:S.e});\n  if(stageIdx<4) s+=poly(fin,S.mut,{d:'3 4',w:1})+txt(cx+45,gy-H*sc+10,'완성안 외곽(참고)',{fs:10,c:S.mut});\n  s+=poly(outline,S.o,{f:'#2a4a66',w:2});\n  if(p.facade){for(let f=10;f<FLOORS;f+=10){const t=levelZ(f)/H,pr=profile(t,p),y=gy-t*H*sc;s+=`<line x1=\"${cx-pr.ax*sc}\" y1=\"${y}\" x2=\"${cx+pr.ax*sc}\" y2=\"${y}\" stroke=\"#5e7a96\" stroke-width=\".6\"/>`;}}\n  if(p.seam){s+=`<line x1=\"${cx}\" y1=\"${gy-H*0.55}\" x2=\"${cx}\" y2=\"${gy-H}\" stroke=\"${S.e}\" stroke-dasharray=\"3 3\"/>`+txt(cx+4,gy-H*0.75,'분절선(추정)',{fs:10,c:S.e});}\n  // 선택 층\n  const tz=levelZ(floor)/H,prz=profile(tz,p),yz=gy-tz*H*sc;\n  s+=`<line x1=\"${cx-prz.ax*sc-20}\" y1=\"${yz}\" x2=\"${cx+prz.ax*sc+20}\" y2=\"${yz}\" stroke=\"${S.sel}\" stroke-width=\"1.5\"/>`+txt(cx+prz.ax*sc+24,yz+4,`${floor}F · ${fmt(levelZ(floor))} m`,{fs:11,c:S.sel});\n  s+=dim(cx-60,gy,cx-60,gy-H*sc,'555 m (공개)',S.o,-40);\n  const b=profile(0,p),tp=profile(1,p);\n  s+=dim(cx-b.ax*sc,gy+22,cx+b.ax*sc,gy+22,`${fmt(b.ax*2)} m (추정)`,S.e,16);\n  s+=dim(cx-tp.ax*sc,gy-H*sc-8,cx+tp.ax*sc,gy-H*sc-8,`상부 폭 ${fmt(tp.ax*2)} m (추정)`,S.e,-12);\n  s+=txt(20,24,'입면도 — 동서 방향(폭) · 축척 1 m = 1 px',{fs:13});\n  s+=txt(20,42,'외곽 곡선은 공개 설명(도자기의 선)을 해석한 개념 함수',{fs:11,c:S.mut});\n  s+='</svg>';\n  drawing.innerHTML=s;\n  dcap.innerHTML=`<b>입면도(개념)</b> — 선택 단계의 외곽선을 정면(폭 방향)에서 본 모습입니다. 높이 555 m는 <span class=\"tag o\">공개</span> 값, 저층·상부 폭과 곡률은 <span class=\"tag e\">추정</span>입니다. 하늘색 선은 슬라이더로 고른 층이며 평면도·3D 모델의 링과 같은 높이입니다.`;\n}\nfunction drawSect(){\n  const W=520,Hh=620,sc=1.0,cx=200,gy=580;\n  const p=STAGES[stageIdx].p,N=80;\n  const L=[],R=[];\n  for(let i=0;i<=N;i++){const t=i/N,pr=profile(t,p),y=gy-t*H*sc;L.push([cx-pr.by*sc,y]);R.push([cx+pr.by*sc,y]);",
