{
  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Lotte Tower - Procedural Spire</title>\n<style>\n  html, body {\n    margin: 0;\n    padding: 0;\n    overflow: hidden;\n    background: linear-gradient(to bottom, #0a0e1a 0%, #1a2338 50%, #2a3550 100%);\n    font-family: 'Segoe UI', Arial, sans-serif;\n    color: #e8eef5;\n  }\n  canvas {\n    display: block;\n  }\n  #info-panel {\n    position: absolute;\n    top: 16px;\n    left: 16px;\n    background: rgba(10, 14, 26, 0.75);\n    border: 1px solid rgba(200, 220, 255, 0.3);\n    border-radius: 8px;\n    padding: 14px 18px;\n    font-size: 19px;\n    line-height: 1.5;\n    max-width: 360px;\n    backdrop-filter: blur(4px);\n  }\n  #info-panel h1 {\n    font-size: 22px;\n    margin: 0 0 8px 0;\n    color: #cfe3ff;\n    letter-spacing: 1px;\n  }\n  #info-panel p {\n    margin: 4px 0;\n    font-size: 19px;\n  }\n  #controls {\n    position: absolute;\n    bottom: 16px;\n    left: 16px;\n    background: rgba(10, 14, 26, 0.75);\n    border: 1px solid rgba(200, 220, 255, 0.3);\n    border-radius: 8px;\n    padding: 12px 16px;\n    font-size: 19px;\n  }\n  #controls button {\n    font-size: 19px;\n    padding: 8px 14px;\n    margin: 4px 4px 4px 0;\n    background: #1e2a44;\n    color: #e8eef5;\n    border: 1px solid rgba(200,220,255,0.4);\n    border-radius: 6px;\n    cursor: pointer;\n  }\n  #controls button:hover {\n    background: #2c3d61;\n  }\n  #draw-readout {\n    margin-top: 8px;\n    font-size: 19px;\n    color: #aeefff;\n  }\n</style>\n</head>\n<body>\n\n<div id=\"info-panel\">\n  <h1>Lotte World Tower</h1>\n  <p>A procedurally drawn spire inspired by Seoul's tapering glass obelisk.</p>\n  <p id=\"draw-readout\">Rotation: initializing...</p>\n</div>\n\n<div id=\"controls\">\n  <button id=\"btn-spin\">Toggle Spin</button>\n  <button id=\"btn-light\">Cycle Light</button>\n  <button id=\"btn-reset\">Reset View</button>\n</div>\n\n<canvas id=\"scene-canvas\"></canvas>\n\n<script>\n(function() {\n  \"use strict\";\n\n  const canvas = document.getElementById('scene-canvas');\n  const ctx = canvas.getContext('2d');\n  const readout = document.getElementById('draw-readout');\n\n  let W, H;\n  function resize() {\n    W = canvas.width = window.innerWidth;\n    H = canvas.height = window.innerHeight;\n  }\n  window.addEventListener('resize', resize);\n  resize();\n\n  // State\n  let angle = 0;\n  let spinning = true;\n  let lightMode = 0;\n  const lightModes = [\n    { name: \"Dawn\", sky: ['#1a1430', '#4a3a6a'], glow: '#ffb37a' },\n    { name: \"Night\", sky: ['#02030a', '#0a1430'], glow: '#8fdfff' },\n    { name: \"Dusk\", sky: ['#200a1a', '#5a2050'], glow: '#ff7ab3' }\n  ];\n\n  const TOWER_SEGMENTS = 42;\n  const TOWER_BASE_RADIUS = 1.0;\n  const TOWER_HEIGHT = 5.0;\n\n  function project(x, y, z, camAngle) {\n    // Simple rotation around Y axis then perspective projection\n    const cosA = Math.cos(camAngle);\n    const sinA = Math.sin(camAngle);\n    const rx = x * cosA - z * sinA;\n    const rz = x * sinA + z * cosA;\n\n    const camDist = 7.5;\n    const scale = (W * 0.11) / (rz + camDist);\n    const px = W / 2 + rx * scale;\n    const py = H * 0.72 - y * scale;\n    return { x: px, y: py, scale: scale, depth: rz };\n  }\n\n  function towerProfile(t) {\n    // t in [0,1] from base to tip; tapering with a few bulges like Lotte Tower silhouette\n    const taper = Math.pow(1 - t, 0.78);\n    const bulge = 1 + 0.05 * Math.sin(t * Math.PI * 6) * (1 - t);\n    return TOWER_BASE_RADIUS * taper * bulge + 0.02;\n  }\n\n  function drawTower(camAngle, glowColor) {\n    const levels = 60;\n    const segs = TOWER_SEGMENTS;\n\n    for (let i = 0; i < levels; i++) {\n      const t0 = i / levels;\n      const t1 = (i + 1) / levels;\n      const y0 = t0 * TOWER_HEIGHT - TOWER_HEIGHT * 0.5;\n      const y1 = t1 * TOWER_HEIGHT - TOWER_HEIGHT * 0.5;\n      const r0 = towerProfile(t0);\n      const r1 = towerProfile(t1);\n\n      const shade = 0.25 + 0.5 * (1 - t0);\n      const panelColor = `rgba(${Math.round(180*shade+30)}, ${Math.round(210*shade+40)}, ${Math.round(240*shade+60)}, 0.85)`;\n\n      for (let s = 0; s < segs; s++) {\n        const a0 = (s / segs) * Math.PI * 2;\n        const a1 = ((s + 1) / segs) * Math.PI * 2;\n\n        const x00 = Math.cos(a0) * r0, z00 = Math.sin(a0) * r0;\n        const x01 = Math.cos(a1) * r0, z01 = Math.sin(a1) * r0;\n        const x10 = Math.cos(a0) * r1, z10 = Math.sin(a0) * r1;\n        const x11 = Math.cos(a1) * r1, z11 = Math.sin(a1) * r1;\n\n        const p00 = project(x00, y0, z00, camAngle);\n        const p01 = project(x01, y0, z01, camAngle);\n        const p10 = project(x10, y1, z10, camAngle);\n        const p11 = project(x11, y1, z11, camAngle);\n\n        const avgDepth = (p00.depth + p01.depth + p10.depth + p11.depth) / 4;\n        if (avgDepth < -1) continue; // basic backface-ish cull\n\n        const faceNormalFacing = Math.cos((a0+a1)/2 + camAngle);\n        const lit = Math.max(0, faceNormalFacing);\n        const r = parseInt(panelColor.slice(5, panelColor.indexOf(',')));\n        ctx.beginPath();\n        ctx.moveTo(p00.x, p00.y);\n        ctx.lineTo(p01.x, p01.y);\n        ctx.lineTo(p11.x, p11.y);\n        ctx.lineTo(p10.x, p10.y);\n        ctx.closePath();\n\n        const litR = Math.min(255, 60 + lit * 170);\n        const litG = Math.min(255, 80 + lit * 170);\n        const litB = Math.min(255, 110 + lit * 160);\n        ctx.fillStyle = `rgba(${litR},${litG},${litB},0.9)`;\n        ctx.fill();\n        ctx.strokeStyle = 'rgba(10,14,26,0.4)';\n        ctx.lineWidth = 0.5;\n        ctx.stroke();\n      }\n    }\n\n    // Spire tip glow\n    const tip = project(0, TOWER_HEIGHT * 0.5 + 0.4, 0, camAngle);\n    const grad = ctx.createRadialGradient(tip.x, tip.y, 0, tip.x, tip.y, 40);\n    grad.addColorStop(0, glowColor);\n    grad.addColorStop(1, 'rgba(0,0,0,0)');\n    ctx.fillStyle = grad;\n    ctx.beginPath();\n    ctx.arc(tip.x, tip.y, 40, 0, Math.PI * 2);\n    ctx.fill();\n  }\n\n  function drawSky(colors) {\n    const grad = ctx.createLinearGradient(0, 0, 0, H);\n    grad.addColorStop(0, colors[0]);\n    grad.addColorStop(1, colors[1]);\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, W, H);\n  }\n\n  function drawGround() {\n    const grad = ctx.createLinearGradient(0, H*0.72, 0, H);\n    grad.addColorStop(0, 'rgba(20,26,40,0.9)');\n    grad.addColorStop(1, 'rgba(5,7,12,1)');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, H*0.72, W, H*0.28);\n  }\n\n  function renderFrame() {\n    const mode = lightModes[lightMode];\n    drawSky(mode.sky);\n    drawGround();\n    drawTower(angle, mode.glow);\n\n    readout.textContent =\n      \"Rotation: \" + (angle % (Math.PI*2)).toFixed(2) +\n      \" rad | Light: \" + mode.name +\n      \" | Spin: \" + (spinning ? \"on\" : \"off\");\n\n    if (spinning) angle += 0.006;\n    requestAnimationFrame(renderFrame);\n  }\n\n  document.getElementById('btn-spin').addEventListener('click', function() {\n    spinning = !spinning;\n  });\n  document.getElementById('btn-light').addEventListener('click', function() {\n    lightMode = (lightMode + 1) % lightModes.length;\n  });\n  document.getElementById('btn-reset').addEventListener('click', function() {\n    angle = 0;\n    spinning = true;\n    lightMode = 0;\n  });\n\n  requestAnimationFrame(renderFrame);\n})();\n</script>\n\n</body>\n</html>",
