  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>롯데월드타워 설계 과정</title>\n    <style>\n        body, html { margin: 0; padding: 0; font-family: Arial, sans-serif; }\n        .container { display: flex; flex-direction: column; align-items: center; padding: 20px; }\n        .diagrams { display: flex; justify-content: space-around; width: 100%; margin-bottom: 20px; }\n        .diagram { width: 200px; height: 200px; border: 1px solid #ccc; text-align: center; padding: 10px; }\n        .controls { display: flex; flex-direction: column; align-items: center; }\n        .control-btn { font-size: 19px; padding: 10px; margin: 5px; cursor: pointer; }\n        canvas { border: 1px solid #000; }\n        #exaone { position: absolute; top: 10px; left: 10px; font-size: 19px; color: #333; }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div id=\"exaone\">exaone-3.5-32b</div>\n        <div class=\"diagrams\">\n            <div class=\"diagram\" id=\"site-plan\">사이트 배치도 (단위: m, 추정)</div>\n            <div class=\"diagram\" id=\"floor-plan\">기준층 평면도 (단위: m, 추정)</div>\n            <div class=\"diagram\" id=\"elevation\">입면도 (단위: m, 추정)</div>\n            <div class=\"diagram\" id=\"section\">단면도 (단위: m, 추정)</div>\n        </div>\n        <div class=\"controls\">\n            <div class=\"control-btn\" onclick=\"toggleLabels()\">레이블 토글</div>\n            <select id=\"stage-select\" onchange=\"loadModel(this.value)\">\n                <option value=\"initial\">초기 설계</option>\n                <option value=\"stage1\">단계 1</option>\n                <option value=\"stage2\">단계 2</option>\n                <option value=\"final\">완성</option>\n            </select>\n        </div>\n        <canvas id=\"3d-canvas\" width=\"800\" height=\"600\"></canvas>\n    </div>\n\n    <script src=\"../runtime/three-runtime.js\"></script>\n    <script>\n        const scene = new THREE.Scene();\n        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);\n        const renderer = new THREE.WebGLRenderer({ canvas: document.getElementById('3d-canvas') });\n        renderer.setSize(800, 600);\n        document.getElementById('3d-canvas').style.width = '800px';\n        document.getElementById('3d-canvas').style.height = '600px';\n\n        const controls = new THREE.OrbitControls(camera, renderer.domElement);\n        camera.position.set(0, 0, 2000);\n\n        const ambientLight = new THREE.AmbientLight(0x404040);\n        scene.add(ambientLight);\n\n        const directionalLight = new THREE.DirectionalLight(0xffffff, 0.5);\n        directionalLight.position.set(1, 1, 1).normalize();\n        scene.add(directionalLight);\n\n        let towerModel;\n        const models = {\n            initial: createInitialModel(),\n            stage1: createStage1Model(),\n            stage2: createStage2Model(),\n            final: createFinalModel()\n        };\n\n        function createInitialModel() {\n            const geometry = new THREE.CylinderGeometry(100, 100, 50, 32, 1, true, 0, Math.PI * 2);\n            const material = new THREE.MeshStandardMaterial({ color: 0x888888 });\n            return new THREE.Mesh(geometry, material);\n        }\n\n        function createStage1Model() {\n            const geometry = new THREE.CylinderGeometry(100, 80, 100, 32, 1, true, 0, Math.PI * 2);\n            const material = new THREE.MeshStandardMaterial({ color: 0x44aa88 });\n            return new THREE.Mesh(geometry, material);\n        }\n\n        function createStage2Model() {\n            const geometry = new THREE.CylinderGeometry(80, 60, 150, 32, 1, true, 0, Math.PI * 2);\n            const material = new THREE.MeshStandardMaterial({ color: 0xaa88cc });\n            return new THREE.Mesh(geometry, material);\n        }\n\n        function createFinalModel() {\n            const geometry = new THREE.CylinderGeometry(60, 40, 200, 32, 1, true, 0, Math.PI * 2);\n            const material = new THREE.MeshStandardMaterial({ color: 0x88ccaa });\n            return new THREE.Mesh(geometry, material);\n        }\n\n        function loadModel(stage) {\n            if (towerModel) scene.remove(towerModel);\n            towerModel = models[stage];\n            scene.add(towerModel);\n        }\n\n        function animate() {\n            requestAnimationFrame(animate);\n            controls.update();\n            renderer.render(scene, camera);\n        }\n\n        loadModel('initial');\n        animate();\n\n        function toggleLabels() {\n            const diagrams = document.querySelectorAll('.diagram');\n            diagrams.forEach(diag => {\n                diag.style.backgroundColor = diag.style.backgroundColor === 'yellow' ? '' : 'yellow';\n            });\n        }\n\n        document.getElementById('3d-canvas').focus();\n        window.addEventListener('keydown', (e) => {\n            if (e.key === 'ArrowLeft') controls.rotateLeft(Math.PI / 20);\n            if (e.key === 'ArrowRight') controls.rotateRight(Math.PI / 20);\n            if (e.key === 'ArrowUp') controls.dollyOut(1.1);\n            if (e.key === 'ArrowDown') controls.dollyIn(1.1);\n        });\n    </script>\n</body>\n</html>",
