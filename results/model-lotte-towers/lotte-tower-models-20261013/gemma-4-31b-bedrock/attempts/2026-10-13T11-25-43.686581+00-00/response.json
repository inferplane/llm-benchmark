{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Lotte World Tower Architectural Process - gemma-4-31b-bedrock</title>\n    <script src=\"../runtime/three-runtime.js\"></script>\n    <style>\n        :root {\n            --bg-color: #0f172a;\n            --panel-color: rgba(30, 41, 59, 0.85);\n            --accent-color: #38bdf8;\n            --text-color: #f1f5f9;\n            --highlight: #fbbf24;\n        }\n        body, html {\n            margin: 0; padding: 0; width: 100%; height: 100%;\n            overflow: hidden; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n            background-color: var(--bg-color); color: var(--text-color);\n        }\n        #container { position: relative; width: 100%; height: 100%; }\n        canvas { display: block; }\n\n        /* UI Panels */\n        .ui-overlay {\n            position: absolute; pointer-events: none;\n            display: flex; flex-direction: column; gap: 20px;\n            padding: 20px; z-index: 10;\n        }\n        .left-panel { top: 0; left: 0; width: 320px; height: calc(100% - 40px); pointer-events: auto; }\n        .bottom-panel { bottom: 0; left: 0; width: 100%; height: 120px; pointer-events: auto; flex-direction: row; align-items: center; justify-content: center; }\n\n        .glass-panel {\n            background: var(--panel-color);\n            backdrop-filter: blur(10px);\n            border: 1px solid rgba(255,255,255,0.1);\n            border-radius: 12px;\n            padding: 20px;\n            box-shadow: 0 8px 32px rgba(0,0,0,0.5);\n        }\n\n        h1 { font-size: 1.2rem; margin: 0 0 15px 0; color: var(--accent-color); border-bottom: 2px solid var(--accent-color); padding-bottom: 5px; }\n        .step-nav { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }\n        .step-btn {\n            background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.2);\n            color: white; padding: 10px; cursor: pointer; text-align: left;\n            transition: all 0.3s; border-radius: 6px; font-size: 0.9rem;\n        }\n        .step-btn:hover { background: rgba(255,255,255,0.15); }\n        .step-btn.active { background: var(--accent-color); color: var(--bg-color); font-weight: bold; border-color: var(--accent-color); }\n\n        .blueprint-area {\n            background: #1e293b; border: 1px solid #334155;\n            height: 200px; border-radius: 8px; position: relative;\n            overflow: hidden; margin-top: 15px;\n        }\n        .blueprint-svg { width: 100%; height: 100%; }\n        .blueprint-label {\n            position: absolute; top: 5px; right: 5px; font-size: 10px;\n            color: #94a3b8; pointer-events: none;\n        }\n\n        .model-info { font-size: 0.85rem; line-height: 1.6; color: #cbd5e1; }\n        .model-info b { color: var(--highlight); }\n\n        .footer-brand {\n            position: absolute; bottom: 20px; right: 20px;\n            font-family: monospace; color: rgba(255,255,255,0.4); font-size: 12px;\n        }\n\n        .controls-hint {\n            position: absolute; top: 20px; right: 20px;\n            background: rgba(0,0,0,0.5); padding: 10px; border-radius: 8px; font-size: 12px;\n        }\n\n        @media (max-width: 768px) {\n            .left-panel { width: 240px; padding: 10px; }\n            .blueprint-area { height: 150px; }\n        }\n    </style>\n</head>\n<body>\n\n<div id=\"container\">\n    <div class=\"ui-overlay left-panel\">\n        <div class=\"glass-panel\" style=\"height: 100%; overflow-y: auto; box-sizing: border-box;\">\n            <h1>Lotte World Tower Design</h1>\n            \n            <div class=\"step-nav\">\n                <button class=\"step-btn active\" onclick=\"setStep(0)\">1. Massing & Base</button>\n                <button class=\"step-btn\" onclick=\"setStep(1)\">2. Tapering & Curve</button>\n                <button class=\"step-btn\" onclick=\"setStep(2)\">3. Split Top & Detail</button>\n                <button class=\"step-btn\" onclick=\"setStep(3)\">4. Final Structure</button>\n            </div>\n\n            <div id=\"info-content\" class=\"model-info\">\n                <!-- Dynamic Content -->\n            </div>\n\n            <div class=\"blueprint-area\" id=\"blueprint\">\n                <div class=\"blueprint-label\" id=\"blueprint-title\">평면도 (Floor Plan)</div>\n                <svg class=\"blueprint-svg\" id=\"blueprint-svg\" viewBox=\"0 0 100 100\">\n                    <!-- Dynamic SVG -->\n                </svg>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"controls-hint\">\n        Rotate: Left Click | Pan: Right Click | Zoom: Scroll\n    </div>\n    <div class=\"footer-brand\">Model: gemma-4-31b-bedrock</div>\n</div>\n\n<script>\n    /** \n     * Architectural Data Definition \n     * Dimensions are conceptual approximations based on public data (Height: 555m)\n     */\n    const DESIGN_STEPS = [\n        {\n            title: \"Massing & Base\",\n            desc: \"기초 매스 설정 단계. <b>지상 123층, 높이 555m</b>의 기본 볼륨을 설정합니다. 하단부는 넓은 면적의 상업 및 오피스 공간을 확보하기 위한 직사각형 기반의 형태를 띱니다.\",\n            blueprintTitle: \"배치도 (Site Plan)\",\n            blueprintType: \"site\",\n            geomType: \"box\"\n        },\n        {\n            title: \"Tapering & Curve\",\n            desc: \"한국 전통 도자기의 곡선을 적용하여 <b>위로 갈수록 좁아지는 테이퍼링(Tapering)</b> 구조를 설계합니다. 이는 풍압을 줄이는 공학적 이점과 심미적 유연함을 동시에 제공합니다.\",\n            blueprintTitle: \"기준층 평면도 (Typical Floor)\",\n            blueprintType: \"plan\",\n            geomType: \"taper\"\n        },\n        {\n            title: \"Split Top & Detail\",\n            desc: \"타워 상부의 <b>수직 분할(Split)</b> 설계를 통해 건물의 정체성을 완성합니다. 상층부로 갈수록 두 갈래로 나뉘는 형태는 현대적인 해석의 전통미를 보여줍니다.\",\n            blueprintTitle: \"입면도 (Elevation)\",\n            blueprintType: \"elev\",\n            geomType: \"split\"\n        },\n        {\n            title: \"Final Structure\",\n            desc: \"최종 외장 커튼월과 구조 보강이 완료된 상태입니다. <b>코어월과 아웃리거</b> 구조가 적용되어 초고층의 안정성을 확보한 완성 모델입니다.\",\n            blueprintTitle: \"단면도 (Section)\",\n            blueprintType: \"sect\",\n            geomType: \"final\"\n        }\n    ];\n\n    // --- Three.js Setup ---\n    let scene, camera, renderer, controls, currentModel;\n    const container = document.getElementById('container');\n\n    function initThree() {\n        scene = new THREE.Scene();\n        scene.background = new THREE.Color(0x0f172a);\n        scene.fog = new THREE.FogExp2(0x0f172a, 0.002);\n\n        camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 1, 2000);\n        camera.position.set(150, 150, 300);\n\n        renderer = new THREE.WebGLRenderer({ antialias: true });\n        renderer.setSize(window.innerWidth, window.innerHeight);\n        renderer.setPixelRatio(window.devicePixelRatio);\n        container.appendChild(renderer.domElement);\n\n        controls = new THREE.OrbitControls(camera, renderer.domElement);\n        controls.enableDamping = true;\n        controls.target.set(0, 100, 0);\n\n        const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);\n        scene.add(ambientLight);\n\n        const dirLight = new THREE.DirectionalLight(0x38bdf8, 1.0);\n        dirLight.position.set(100, 200, 100);\n        scene.add(dirLight);\n\n        const grid = new THREE.GridHelper(400, 20, 0x334155, 0x1e293b);\n        scene.add(grid);\n\n        window.addEventListener('resize', onWindowResize);\n        setStep(0);\n        animate();\n    }\n\n    function onWindowResize() {\n        camera.aspect = window.innerWidth / window.innerHeight;\n        camera.updateProjectionMatrix();\n        renderer.setSize(window.innerWidth, window.innerHeight);\n    }\n\n    function animate() {\n        requestAnimationFrame(animate);\n        controls.update();\n        renderer.render(scene, camera);\n    }\n\n    // --- Geometry Generation ---\n    function createTowerModel(type) {\n        if (currentModel) scene.remove(currentModel);\n        \n        const group = new THREE.Group();\n        const mat = new THREE.MeshPhongMaterial({ \n            color: 0x38bdf8, \n            transparent: true, \n            opacity: 0.8, \n            flatShading: false,\n            shininess: 100 \n        });\n        const wireMat = new THREE.MeshBasicMaterial({ color: 0xffffff, wireframe: true, transparent: true, opacity: 0.3 });\n\n        if (type === 'box') {\n            const geo = new THREE.BoxGeometry(40, 200, 40);\n            const mesh = new THREE.Mesh(geo, mat);\n            const wire = new THREE.Mesh(geo, wireMat);\n            mesh.position.y = 100; wire.position.y = 100;\n            group.add(mesh, wire);\n        } \n        else if (type === 'taper') {\n            const geo = new THREE.CylinderGeometry(15, 25, 200, 4); // Square base tapering\n            const mesh = new THREE.Mesh(geo, mat);\n            const wire = new THREE.Mesh(geo, wireMat);\n            mesh.position.y = 100; wire.position.y = 100;\n            group.add(mesh, wire);\n        }\n        else if (type === 'split') {\n            const baseGeo = new THREE.CylinderGeometry(15, 25, 140, 4);\n            const base = new THREE.Mesh(baseGeo, mat);\n            base.position.y = 70;\n            group.add(base);\n\n            const topGeo = new THREE.CylinderGeometry(5, 15, 60, 4);\n            const top1 = new THREE.Mesh(topGeo, mat);\n            top1.position.set(3, 140, 3);\n            const top2 = new THREE.Mesh(topGeo, mat);\n            top2.position.set(-3, 140, -3);\n            group.add(top1, top2);\n        }\n        else if (type === 'final') {\n            // Complex combined shape\n            const points = [];\n            for (let i = 0; i <= 20; i++) {\n                const y = i * 10;\n                const r = 25 * (1 - i/25);\n                points.push(new THREE.Vector2(r, y));\n            }\n            const shape = new THREE.Shape();\n            shape.moveTo(points[0].x, points[0].y);\n            for(let i=1; i<points.length; i++) shape.lineTo(points[i].x, points[i].y);\n            shape.lineTo(-points[points.length-1].x, points[points.length-1].y);\n            for(let i=points.length-1; i>=0; i--) shape.lineTo(-points[i].x, points[i].y);\n            shape.closePath();\n\n            const extrudeSettings = { depth: 50, bevelEnabled: false };\n            const geometry = new THREE.ExtrudeGeometry(shape, extrudeSettings);\n            const mesh = new THREE.Mesh(geometry, mat);\n            mesh.position.z = -25;\n            \n            const wire = new THREE.Mesh(geometry, wireMat);\n            wire.position.z = -25;\n\n            group.add(mesh, wire);\n            \n            // Add a spire\n            const spireGeo = new THREE.CylinderGeometry(0.5, 1, 30, 8);\n            const spire = new THREE.Mesh(spireGeo, new THREE.MeshPhongMaterial({color: 0xffffff}));\n            spire.position.y = 215;\n            group.add(spire);\n        }\n\n        currentModel = group;\n        scene.add(currentModel);\n    }\n\n    // --- Blueprint Logic ---\n    function updateBlueprint(type) {\n        const svg = document.getElementById('blueprint-svg');\n        const title = document.getElementById('blueprint-title');\n        svg.innerHTML = '';\n        \n        const color = \"#38bdf8\";\n        const white = \"#ffffff\";\n\n        if (type === 'site') {\n            title.innerText = \"배치도 (Site Plan) - Scale 1:5000\";\n            svg.innerHTML = `\n                <rect x=\"10\" y=\"10\" width=\"80\" height=\"80\" fill=\"none\" stroke=\"${white}\" stroke-width=\"0.5\" />\n                <rect x=\"40\" y=\"40\" width=\"20\" height=\"20\" fill=\"${color}\" stroke=\"${white}\" stroke-width=\"1\" />\n                <text x=\"42\" y=\"38\" fill=\"${white}\" font-size=\"3\">Lotte Tower</text>\n                <line x1=\"0\" y1=\"0\" x2=\"10\" y2=\"10\" stroke=\"${white}\" stroke-width=\"0.2\" />\n                <text x=\"2\" y=\"8\" fill=\"${white}\" font-size=\"3\">N</text>\n            `;\n        } else if (type === 'plan') {\n            title.innerText = \"기준층 평면도 (Typical Floor) - Scale 1:1000\";\n            svg.innerHTML = `\n                <rect x=\"30\" y=\"30\" width=\"40\" height=\"40\" fill=\"none\" stroke=\"${color}\" stroke-width=\"1\" />\n                <rect x=\"42\" y=\"42\" width=\"16\" height=\"16\" fill=\"rgba(56,189,248,0.3)\" stroke=\"${white}\" stroke-width=\"0.5\" />\n                <text x=\"43\" y=\"52\" fill=\"${white}\" font-size=\"2\">CORE</text>\n                <line x1=\"30\" y1=\"30\" x2=\"70\" y2=\"70\" stroke=\"${white}\" stroke-width=\"0.2\" stroke-dasharray=\"2\" />\n            `;\n        } else if (type === 'elev') {\n            title.innerText = \"입면도 (Elevation) - Scale 1:2000\";\n            svg.innerHTML = `\n                <path d=\"M40 90 L60 90 L55 20 L45 20 Z\" fill=\"none\" stroke=\"${color}\" stroke-width=\"1\" />\n                <path d=\"M45 20 L42 10 M55 20 L58 10\" stroke=\"${white}\" stroke-width=\"0.5\" />\n                <line x1=\"20\" y1=\"90\" x2=\"80\" y2=\"90\" stroke=\"${white}\" stroke-width=\"0.5\" />\n                <text x=\"62\" y=\"50\" fill=\"${white}\" font-size=\"3\">555m</text>\n            `;\n        } else if (type === 'sect') {\n            title.innerText = \"단면도 (Section) - Scale 1:2000\";\n            svg.innerHTML = `\n                <path d=\"M40 90 L60 90 L58 10 L42 10 Z\" fill=\"rgba(56,189,248,0.2)\" stroke=\"${color}\" stroke-width=\"1\" />\n                <line x1=\"45\" y1=\"90\" x2=\"45\" y2=\"10\" stroke=\"${white}\" stroke-width=\"0.5\" />\n                <line x1=\"55\" y1=\"90\" x2=\"55\" y2=\"10\" stroke=\"${white}\" stroke-width=\"0.5\" />\n                <rect x=\"47\" y=\"10\" width=\"6\" height=\"80\" fill=\"none\" stroke=\"${white}\" stroke-width=\"0.3\" stroke-dasharray=\"1\" />\n                <text x=\"57\" y=\"40\" fill=\"${white}\" font-size=\"2\">Core Wall</text>\n            `;\n        }\n    }\n\n    function setStep(index) {\n        const step = DESIGN_STEPS[index];\n        \n        // UI\n        document.querySelectorAll('.step-btn').forEach((btn, i) => {\n            btn.classList.toggle('active', i === index);\n        });\n        \n        document.getElementById('info-content').innerHTML = `\n            <h2 style=\"font-size:1rem; margin-top:0;\">${step.title}</h2>\n            <p>${step.desc}</p>\n        `;\n        \n        updateBlueprint(step.blueprintType);\n        createTowerModel(step.geomType);\n    }\n\n    // Launch\n    initThree();\n\n</script>\n</body>\n</html>",
