  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Lotte World Tower - Architectural Study</title>\n    <style>\n        :root {\n            --bg-color: #0a0a0c;\n            --accent-color: #c5a059;\n            --text-color: #e0e0e0;\n            --panel-bg: rgba(20, 20, 25, 0.85);\n            --ui-font-size: 19px;\n        }\n\n        body, html {\n            margin: 0;\n            padding: 0;\n            width: 100%;\n            height: 100%;\n            overflow: hidden;\n            background-color: var(--bg-color);\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n            color: var(--text-color);\n        }\n\n        #canvas-container {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            z-index: 1;\n        }\n\n        .ui-overlay {\n            position: absolute;\n            z-index: 10;\n            pointer-events: none;\n            display: flex;\n            flex-direction: column;\n            gap: 20px;\n            padding: 20px;\n            box-sizing: border-box;\n            width: 100%;\n            height: 100%;\n        }\n\n        .panel {\n            pointer-events: auto;\n            background: var(--panel-bg);\n            backdrop-filter: blur(10px);\n            border: 1px solid var(--accent-color);\n            padding: 20px;\n            max-width: 320px;\n            border-radius: 4px;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.5);\n        }\n\n        h1 {\n            font-size: 24px;\n            margin: 0 0 10px 0;\n            color: var(--accent-color);\n            text-transform: uppercase;\n            letter-spacing: 2px;\n        }\n\n        p, label, span {\n            font-size: var(--ui-font-size);\n            line-height: 1.4;\n            margin-bottom: 10px;\n        }\n\n        .controls-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 10px;\n            margin-top: 20px;\n        }\n\n        button {\n            background: transparent;\n            color: var(--text-color);\n            border: 1px solid var(--accent-color);\n            padding: 10px;\n            cursor: pointer;\n            font-size: var(--ui-font-size);\n            transition: all 0.2s;\n            text-transform: uppercase;\n        }\n\n        button:hover, button:focus {\n            background: var(--accent-color);\n            color: var(--bg-color);\n            outline: none;\n        }\n\n        .keyboard-hint {\n            margin-top: 15px;\n            font-size: 16px; /* Base, but the prompt requires meaningful text 19px */\n            opacity: 0.8;\n            border-top: 1px solid #444;\n            padding-top: 10px;\n        }\n        \n        /* Ensuring meaningful instructional text is 19px */\n        .instructional-text {\n            font-size: var(--ui-font-size);\n        }\n\n        @media (max-width: 600px) {\n            .ui-overlay {\n                justify-content: flex-end;\n            }\n            .panel {\n                max-width: calc(100% - 40px);\n                margin-bottom: 20px;\n            }\n            /* Ensure model isn't occluded by moving panel to bottom or making it smaller */\n            #canvas-container {\n                top: 0;\n            }\n        }\n    </style>\n</head>\n<body>\n\n    <div id=\"canvas-container\"></div>\n\n    <div class=\"ui-overlay\">\n        <div class=\"panel\">\n            <h1>Lotte World Tower</h1>\n            <p class=\"instructional-text\">An architectural study of the Seoul skyscraper's tapering form and structural elegance.</p>\n            \n            <div class=\"controls-grid\">\n                <button onclick=\"camera.orbit(0.1, 0)\" title=\"Rotate Left\">Rotate L</button>\n                <button onclick=\"camera.orbit(-0.1, 0)\" title=\"Rotate Right\">Rotate R</button>\n                <button onclick=\"camera.zoom(0.9)\" title=\"Zoom In\">Zoom +</button>\n                <button onclick=\"camera.zoom(1.1)\" title=\"Zoom Out\">Zoom -</button>\n            </div>\n            <button onclick=\"camera.reset()\" style=\"width: 100%; margin-top: 10px;\">Reset View</button>\n\n            <div class=\"keyboard-hint instructional-text\">\n                <strong>Controls:</strong><br>\n                Arrows: Orbit | +/-: Zoom | R: Reset\n            </div>\n        </div>\n    </div>\n\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/0.160.0/three.min.js\"></script>\n    <script>\n        let scene, camera, renderer, tower;\n        const container = document.getElementById('canvas-container');\n\n        const cameraState = {\n            phi: Math.PI / 4,\n            theta: Math.PI / 4,\n            radius: 800,\n            targetRadius: 800\n        };\n\n        function init() {\n            scene = new THREE.Scene();\n            scene.background = new THREE.Color(0x0a0a0c);\n\n            camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 1, 5000);\n            \n            renderer = new THREE.WebGLRenderer({ antialias: true });\n            renderer.setSize(window.innerWidth, window.innerHeight);\n            renderer.setPixelRatio(window.devicePixelRatio);\n            container.appendChild(renderer.domElement);\n\n            // Lighting\n            const ambientLight = new THREE.AmbientLight(0x404040, 2);\n            scene.add(ambientLight);\n\n            const directionalLight = new THREE.DirectionalLight(0xc5a059, 3);\n            directionalLight.position.set(100, 200, 100);\n            scene.add(directionalLight);\n\n            const pointLight = new THREE.PointLight(0xffffff, 1);\n            pointLight.position.set(-100, 100, -100);\n            scene.add(pointLight);\n\n            // Building Geometry (Lotte Tower abstraction)\n            const towerGroup = new THREE.Group();\n            const segments = 10;\n            const heightPerSegment = 50;\n            const baseRadius = 40;\n\n            for (let i = 0; i < segments; i++) {\n                const currentRadius = baseRadius * (1 - i / segments * 0.7);\n                const nextRadius = baseRadius * (1 - (i + 1) / segments * 0.7);\n                \n                const geo = new THREE.CylinderGeometry(nextRadius, currentRadius, heightPerSegment, 6);\n                const mat = new THREE.MeshPhongMaterial({ \n                    color: 0xcccccc, \n                    shininess: 100, \n                    transparent: true, \n                    opacity: 0.9 \n                });\n                const segment = new THREE.Mesh(geo, mat);\n                segment.position.y = i * heightPerSegment;\n                towerGroup.add(segment);\n            }\n            \n            tower = towerGroup;\n            scene.add(tower);\n\n            // Ground Plane\n            const grid = new THREE.GridHelper(1000, 20, 0x333333, 0x222222);\n            scene.add(grid);\n\n            window.addEventListener('resize', onWindowResize);\n            window.addEventListener('keydown', onKeyDown);\n            \n            updateCamera();\n            animate();\n        }\n\n        function onWindowResize() {\n            camera.aspect = window.innerWidth / window.innerHeight;\n            camera.updateProjectionMatrix();\n            renderer.setSize(window.innerWidth, window.innerHeight);\n        }\n\n        function onKeyDown(e) {\n            switch(e.key) {\n                case 'ArrowLeft': cameraState.theta -= 0.1; break;\n                case 'ArrowRight': cameraState.theta += 0.1; break;\n                case 'ArrowUp': cameraState.phi -= 0.1; break;\n                case 'ArrowDown': cameraState.phi += 0.1; break;\n                case '+': case '=': cameraState.radius *= 0.9; break;\n                case '-': case '_': cameraState.radius *= 1.1; break;\n                case 'r': case 'R': resetView(); break;\n            }\n            updateCamera();\n        }\n\n        function updateCamera() {\n            camera.position.x = cameraState.radius * Math.sin(cameraState.phi) * Math.cos(cameraState.theta);\n            camera.position.y = cameraState.radius * Math.cos(cameraState.phi);\n            camera.position.z = cameraState.radius * Math.sin(cameraState.phi) * Math.sin(cameraState.theta);\n            camera.lookAt(0, 250, 0);\n        }\n\n        function resetView() {\n            cameraState.phi = Math.PI / 4;\n            cameraState.theta = Math.PI / 4;\n            cameraState.radius = 800;\n            updateCamera();\n        }\n\n        // Global camera control object for HTML buttons\n        window.camera = {\n            orbit: (dt, dp) => { \n                cameraState.theta += dt; \n                cameraState.phi += dp; \n                updateCamera(); \n            },\n            zoom: (factor) => { \n                cameraState.radius *= factor; \n                updateCamera(); \n            },\n            reset: () => { \n                resetView(); \n            }\n        };\n\n        function animate() {\n            requestAnimationFrame(animate);\n            renderer.render(scene, camera);\n        }\n\n        init();\n    </script>\n</body>\n</html>",
