  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Lotte World Tower - Architectural Study</title>\n    <style>\n        :root {\n            --bg-color: #0a0a0c;\n            --panel-bg: rgba(20, 20, 25, 0.85);\n            --accent: #00d4ff;\n            --text-main: #e0e0e0;\n            --text-dim: #a0a0a0;\n            --font-size-min: 19px;\n        }\n        body, html {\n            margin: 0; padding: 0; width: 100%; height: 100%;\n            overflow: hidden; background: var(--bg-color);\n            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n            color: var(--text-main);\n        }\n        #canvas-container {\n            position: absolute; top: 0; left: 0; width: 100%; height: 100%;\n        }\n        .ui-overlay {\n            position: absolute; z-index: 10;\n            pointer-events: none;\n            display: flex; flex-direction: column;\n            gap: 20px; padding: 20px;\n            box-sizing: border-box;\n            width: 100%; height: 100%;\n        }\n        .panel {\n            pointer-events: auto;\n            background: var(--panel-bg);\n            backdrop-filter: blur(10px);\n            border: 1px solid rgba(255,255,255,0.1);\n            border-radius: 8px;\n            padding: 20px;\n            max-width: 320px;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.5);\n        }\n        h1 { font-size: 24px; margin: 0 0 10px 0; color: var(--accent); }\n        p { font-size: var(--font-size-min); line-height: 1.4; margin: 0 0 15px 0; color: var(--text-dim); }\n        \n        .controls-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 10px;\n        }\n        button {\n            background: #2a2a32;\n            color: white;\n            border: 1px solid var(--accent);\n            padding: 10px;\n            font-size: var(--font-size-min);\n            cursor: pointer;\n            border-radius: 4px;\n            transition: background 0.2s;\n        }\n        button:hover { background: var(--accent); color: #000; }\n        button:focus { outline: 3px solid white; }\n\n        .accessibility-hint {\n            position: absolute; bottom: 20px; right: 20px;\n            font-size: var(--font-size-min);\n            color: var(--text-dim);\n            text-align: right;\n            pointer-events: none;\n        }\n\n        @media (max-width: 600px) {\n            .ui-overlay {\n                padding: 10px;\n                justify-content: flex-end; /* Push panels to bottom for better visibility */\n            }\n            .panel {\n                max-width: calc(100% - 20px);\n                margin-bottom: 20px;\n            }\n            .controls-grid {\n                grid-template-columns: 1fr;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div id=\"canvas-container\"></div>\n    \n    <div class=\"ui-overlay\">\n        <div class=\"panel\">\n            <h1>Lotte World Tower</h1>\n            <p>A study of the tapered, sleek geometry of the 555m Seoul landmark.</p>\n            <div class=\"controls-grid\">\n                <button id=\"btn-reset\" title=\"Reset Camera\">Reset View</button>\n                <button id=\"btn-zoom-in\" title=\"Zoom In\">+</button>\n                <button id=\"btn-zoom-out\" title=\"Zoom Out\">−</button>\n                <button id=\"btn-rotate\" title=\"Rotate Orbit\">Rotate</button>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"accessibility-hint\">\n        Keyboard: [R] Reset | [+/-] Zoom | [Arrow Keys] Orbit\n    </div>\n\n    <script>\n        (function() {\n            if (!window.THREE) {\n                console.error(\"THREE.js runtime missing.\");\n                return;\n            }\n\n            let scene, camera, renderer, controls, tower;\n            const container = document.getElementById('canvas-container');\n\n            function init() {\n                scene = new THREE.Scene();\n                scene.background = new THREE.Color(0x050507);\n                scene.fog = new THREE.FogExp2(0x050507, 0.002);\n\n                camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 1, 10000);\n                camera.position.set(200, 150, 400);\n\n                renderer = new THREE.WebGLRenderer({ antialias: true });\n                renderer.setSize(window.innerWidth, window.innerHeight);\n                renderer.setPixelRatio(window.devicePixelRatio);\n                container.appendChild(renderer.domElement);\n\n                controls = new THREE.OrbitControls(camera, renderer.domElement);\n                controls.enableDamping = true;\n                controls.dampingFactor = 0.05;\n                controls.screenSpacePanning = false;\n\n                const ambientLight = new THREE.AmbientLight(0x404040, 2);\n                scene.add(ambientLight);\n\n                const sunLight = new THREE.DirectionalLight(0xffffff, 1.2);\n                sunLight.position.set(100, 500, 100);\n                scene.add(sunLight);\n\n                const blueLight = new THREE.PointLight(0x00d4ff, 1);\n                blueLight.position.set(-100, 100, -100);\n                scene.add(blueLight);\n\n                createTower();\n                createGround();\n\n                window.addEventListener('resize', onWindowResize);\n                setupInputs();\n                animate();\n            }\n\n            function createTower() {\n                // Simplified tapering geometry for Lotte Tower\n                const geometry = new THREE.CylinderGeometry(15, 35, 555, 32); \n                const material = new THREE.MeshStandardMaterial({\n                    color: 0xcccccc,\n                    metalness: 0.9,\n                    roughness: 0.1,\n                    transparent: true,\n                    opacity: 0.9\n                });\n                tower = new THREE.Mesh(geometry, material);\n                tower.position.y = 555 / 2;\n                scene.add(tower);\n\n                // Add a \"crown\" effect\n                const crownGeo = new THREE.CylinderGeometry(2, 5, 40, 32);\n                const crown = new THREE.Mesh(crownGeo, material);\n                crown.position.y = 555 + 20;\n                scene.add(crown);\n            }\n\n            function createGround() {\n                const grid = new THREE.GridHelper(2000, 40, 0x222222, 0x111111);\n                scene.add(grid);\n                \n                const planeGeo = new THREE.PlaneGeometry(2000, 2000);\n                const planeMat = new THREE.MeshStandardMaterial({ color: 0x08080a });\n                const plane = new THREE.Mesh(planeGeo, planeMat);\n                plane.rotation.x = -Math.PI / 2;\n                scene.add(plane);\n            }\n\n            function onWindowResize() {\n                camera.aspect = window.innerWidth / window.innerHeight;\n                camera.updateProjectionMatrix();\n                renderer.setSize(window.innerWidth, window.innerHeight);\n            }\n\n            function setupInputs() {\n                const resetView = () => {\n                    camera.position.set(200, 150, 400);\n                    controls.target.set(0, 200, 0);\n                    controls.update();\n                };\n\n                const zoomIn = () => {\n                    camera.position.multiplyScalar(0.9);\n                    controls.update();\n                };\n\n                const zoomOut = () => {\n                    camera.position.multiplyScalar(1.1);\n                    controls.update();\n                };\n\n                const rotateCam = () => {\n                    const currentPos = camera.position.clone();\n                    const angle = Math.PI / 12;\n                    const x = currentPos.x * Math.cos(angle) - currentPos.z * Math.sin(angle);\n                    const z = currentPos.x * Math.sin(angle) + currentPos.z * Math.cos(angle);\n                    camera.position.set(x, currentPos.y, z);\n                    controls.update();\n                };\n\n                document.getElementById('btn-reset').addEventListener('click', resetView);\n                document.getElementById('btn-zoom-in').addEventListener('click', zoomIn);\n                document.getElementById('btn-zoom-out').addEventListener('click', zoomOut);\n                document.getElementById('btn-rotate').addEventListener('click', rotateCam);\n\n                window.addEventListener('keydown', (e) => {\n                    switch(e.key.toLowerCase()) {\n                        case 'r': resetView(); break;\n                        case '+': zoomIn(); break;\n                        case '-': zoomOut(); break;\n                        case 'arrowleft': \n                            rotateCam( -Math.PI/12 ); break;\n                        case 'arrowright': \n                            rotateCam( Math.PI/12 ); break;\n                    }\n                });\n            }\n\n            function animate() {\n                requestAnimationFrame(animate);\n                controls.update();\n                renderer.render(scene, camera);\n            }\n\n            init();\n        })();\n    </script>\n</body>\n</html>",
