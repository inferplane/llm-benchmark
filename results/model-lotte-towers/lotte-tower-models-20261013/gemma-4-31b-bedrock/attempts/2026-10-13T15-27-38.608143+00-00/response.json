{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Lotte World Tower - Architectural Process Study</title>\n    <style>\n        :root {\n            --bg-color: #0a0a0c;\n            --panel-bg: rgba(20, 20, 25, 0.9);\n            --accent: #00d4ff;\n            --text-main: #e0e0e0;\n            --text-dim: #a0a0a0;\n            --font-size-min: 16px;\n        }\n        body, html {\n            margin: 0; padding: 0; width: 100%; height: 100%;\n            overflow: hidden; background: var(--bg-color);\n            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n            color: var(--text-main);\n        }\n        #canvas-container {\n            position: absolute; top: 0; left: 0; width: 100%; height: 100%;\n        }\n        .ui-overlay {\n            position: absolute; z-index: 10;\n            pointer-events: none;\n            display: flex; flex-direction: column;\n            gap: 15px; padding: 20px;\n            box-sizing: border-box;\n            width: 100%; height: 100%;\n        }\n        .panel {\n            pointer-events: auto;\n            background: var(--panel-bg);\n            backdrop-filter: blur(10px);\n            border: 1px solid rgba(255,255,255,0.1);\n            border-radius: 12px;\n            padding: 15px;\n            max-width: 360px;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.5);\n        }\n        h1 { font-size: 20px; margin: 0 0 8px 0; color: var(--accent); }\n        p { font-size: 14px; line-height: 1.4; margin: 0 0 12px 0; color: var(--text-dim); }\n        \n        .controls-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 8px;\n            margin-bottom: 15px;\n        }\n        button {\n            background: #2a2a32;\n            color: white;\n            border: 1px solid var(--accent);\n            padding: 8px;\n            font-size: 14px;\n            cursor: pointer;\n            border-radius: 4px;\n            transition: all 0.2s;\n        }\n        button:hover { background: var(--accent); color: #000; }\n        button.active { background: var(--accent); color: #000; font-weight: bold; }\n\n        .diagram-container {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 10px;\n            margin-top: 10px;\n        }\n        .diag-box {\n            background: rgba(0,0,0,0.4);\n            border: 1px solid #444;\n            height: 100px;\n            position: relative;\n            cursor: pointer;\n            overflow: hidden;\n        }\n        .diag-box:hover { border-color: var(--accent); }\n        .diag-box span {\n            position: absolute; bottom: 2px; left: 5px;\n            font-size: 11px; color: var(--accent);\n        }\n        .diag-svg { width: 100%; height: 100%; }\n\n        .model-info {\n            font-size: 12px;\n            color: var(--text-dim);\n            border-top: 1px solid #333;\n            padding-top: 10px;\n            margin-top: 10px;\n        }\n\n        .accessibility-hint {\n            position: absolute; bottom: 20px; right: 20px;\n            font-size: 13px;\n            color: var(--text-dim);\n            text-align: right;\n            pointer-events: none;\n        }\n\n        @media (max-width: 600px) {\n            .ui-overlay { padding: 10px; justify-content: flex-start; overflow-y: auto; }\n            .panel { max-width: calc(100% - 20px); }\n        }\n    </style>\n</head>\n<body>\n    <div id=\"canvas-container\"></div>\n    \n    <div class=\"ui-overlay\">\n        <div class=\"panel\">\n            <h1>롯데월드타워 설계 연구</h1>\n            <p>건축 설계 과정 및 3D 형상 분석 (Conceptual Study)</p>\n            \n            <div class=\"controls-grid\">\n                <button id=\"btn-step1\">Step 1: 매스</button>\n                <button id=\"btn-step2\">Step 2: 테이퍼링</button>\n                <button id=\"btn-step3\">Step 3: 분할</button>\n                <button id=\"btn-step4\" class=\"active\">Step 4: 최종</button>\n            </div>\n\n            <div class=\"controls-grid\">\n                <button id=\"btn-reset\">시점 초기화</button>\n                <button id=\"btn-rotate\">회전</button>\n            </div>\n\n            <div class=\"diagram-container\">\n                <div class=\"diag-box\" onclick=\"updateView('site')\">\n                    <svg class=\"diag-svg\" viewBox=\"0 0 50 50\">\n                        <rect x=\"5\" y=\"5\" width=\"40\" height=\"40\" fill=\"none\" stroke=\"#666\" />\n                        <circle cx=\"25\" cy=\"25\" r=\"4\" fill=\"var(--accent)\" />\n                        <line x1=\"0\" y1=\"0\" x2=\"10\" y2=\"10\" stroke=\"#444\" />\n                    </svg>\n                    <span>배치도 (Site)</span>\n                </div>\n                <div class=\"diag-box\" onclick=\"updateView('floor')\">\n                    <svg class=\"diag-svg\" viewBox=\"0 0 50 50\">\n                        <circle cx=\"25\" cy=\"25\" r=\"15\" fill=\"none\" stroke=\"#666\" />\n                        <path d=\"M25 10 L25 40 M10 25 L40 25\" stroke=\"#444\" />\n                        <circle cx=\"25\" cy=\"25\" r=\"2\" fill=\"var(--accent)\" />\n                    </svg>\n                    <span>기준층 평면 (Plan)</span>\n                </div>\n                <div class=\"diag-box\" onclick=\"updateView('ele')\">\n                    <svg class=\"diag-svg\" viewBox=\"0 0 50 50\">\n                        <path d=\"M20 45 L22 5 L28 5 L30 45 Z\" fill=\"none\" stroke=\"#666\" />\n                        <line x1=\"32\" y1=\"5\" x2=\"32\" y2=\"45\" stroke=\"var(--accent)\" />\n                        <text x=\"33\" y=\"25\" fill=\"var(--accent)\" font-size=\"4\">555m</text>\n                    </svg>\n                    <span>입면도 (Elevation)</span>\n                </div>\n                <div class=\"diag-box\" onclick=\"updateView('sec')\">\n                    <svg class=\"diag-svg\" viewBox=\"0 0 50 50\">\n                        <path d=\"M20 45 L22 5 L28 5 L30 45 Z\" fill=\"none\" stroke=\"#666\" />\n                        <line x1=\"22\" y1=\"20\" x2=\"28\" y2=\"20\" stroke=\"var(--accent)\" />\n                        <line x1=\"22\" y1=\"35\" x2=\"28\" y2=\"35\" stroke=\"var(--accent)\" />\n                    </svg>\n                    <span>단면도 (Section)</span>\n                </div>\n            </div>\n\n            <div class=\"model-info\">\n                <strong>Model:</strong> gemma-4-31b-bedrock<br>\n                <strong>Note:</strong> 공개 자료 기반 추정 수치 사용.\n            </div>\n        </div>\n    </div>\n\n    <div class=\"accessibility-hint\">\n        [R] 초기화 | [+/-] 확대/축소 | [← →] 회전\n    </div>\n\n    <script src=\"../runtime/three-runtime.js\"></script>\n    <script>\n        (function() {\n            if (!window.THREE) {\n                const script = document.createElement('script');\n                script.src = \"../runtime/three-runtime.js\";\n                script.onload = init;\n                document.head.appendChild(script);\n            } else {\n                init();\n            }\n\n            let scene, camera, renderer, controls, towerGroup;\n            const container = document.getElementById('canvas-container');\n\n            function init() {\n                scene = new THREE.Scene();\n                scene.background = new THREE.Color(0x0a0a0c);\n                scene.fog = new THREE.FogExp2(0x0a0a0c, 0.0015);\n\n                camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 1, 10000);\n                camera.position.set(300, 300, 600);\n\n                renderer = new THREE.WebGLRenderer({ antialias: true });\n                renderer.setSize(window.innerWidth, window.innerHeight);\n                renderer.setPixelRatio(window.devicePixelRatio);\n                container.appendChild(renderer.domElement);\n\n                controls = new THREE.OrbitControls(camera, renderer.domElement);\n                controls.enableDamping = true;\n                controls.target.set(0, 200, 0);\n\n                const ambientLight = new THREE.AmbientLight(0x404040, 2);\n                scene.add(ambientLight);\n\n                const sunLight = new THREE.DirectionalLight(0xffffff, 1.5);\n                sunLight.position.set(200, 500, 200);\n                scene.add(sunLight);\n\n                const blueLight = new THREE.PointLight(0x00d4ff, 1);\n                blueLight.position.set(-200, 200, -200);\n                scene.add(blueLight);\n\n                towerGroup = new THREE.Group();\n                scene.add(towerGroup);\n\n                createGround();\n                setDesignStep(4); // Default to final\n                \n                window.addEventListener('resize', onWindowResize);\n                setupInputs();\n                animate();\n            }\n\n            function createGround() {\n                const grid = new THREE.GridHelper(2000, 40, 0x333333, 0x222222);\n                scene.add(grid);\n                const planeGeo = new THREE.PlaneGeometry(2000, 2000);\n                const planeMat = new THREE.MeshStandardMaterial({ color: 0x08080a });\n                const plane = new THREE.Mesh(planeGeo, planeMat);\n                plane.rotation.x = -Math.PI / 2;\n                scene.add(plane);\n            }\n\n            function setDesignStep(step) {\n                towerGroup.clear();\n                const material = new THREE.MeshStandardMaterial({\n                    color: 0xcccccc,\n                    metalness: 0.8,\n                    roughness: 0.2,\n                    transparent: true,\n                    opacity: 0.8\n                });\n\n                const TOTAL_HEIGHT = 555;\n\n                if (step === 1) { // Massing\n                    const geo = new THREE.BoxGeometry(60, TOTAL_HEIGHT, 60);\n                    const mesh = new THREE.Mesh(geo, material);\n                    mesh.position.y = TOTAL_HEIGHT / 2;\n                    towerGroup.add(mesh);\n                } else if (step === 2) { // Tapering\n                    const geo = new THREE.CylinderGeometry(15, 40, TOTAL_HEIGHT, 32);\n                    const mesh = new THREE.Mesh(geo, material);\n                    mesh.position.y = TOTAL_HEIGHT / 2;\n                    towerGroup.add(mesh);\n                } else if (step === 3) { // Segmented/Split\n                    for(let i=0; i<3; i++) {\n                        const h = TOTAL_HEIGHT / 3;\n                        const geo = new THREE.CylinderGeometry(15 + (25-15)*(2-i/3), 15 + (25-15)*(3-i/3), h, 32);\n                        const mesh = new THREE.Mesh(geo, material);\n                        mesh.position.y = (h/2) + (i * h);\n                        towerGroup.add(mesh);\n                    }\n                } else { // Final\n                    // Body\n                    const bodyGeo = new THREE.CylinderGeometry(12, 38, 510, 32);\n                    const body = new THREE.Mesh(bodyGeo, material);\n                    body.position.y = 510 / 2;\n                    towerGroup.add(body);\n\n                    // Crown (integrating into total 555m)\n                    const crownGeo = new THREE.CylinderGeometry(0, 12, 45, 32);\n                    const crown = new THREE.Mesh(crownGeo, material);\n                    crown.position.y = 510 + (45/2);\n                    towerGroup.add(crown);\n                }\n\n                document.querySelectorAll('.controls-grid button').forEach(btn => btn.classList.remove('active'));\n                document.getElementById('btn-step' + step).classList.add('active');\n            }\n\n            function onWindowResize() {\n                camera.aspect = window.innerWidth / window.innerHeight;\n                camera.updateProjectionMatrix();\n                renderer.setSize(window.innerWidth, window.innerHeight);\n            }\n\n            function setupInputs() {\n                const resetView = () => {\n                    camera.position.set(300, 300, 600);\n                    controls.target.set(0, 200, 0);\n                    controls.update();\n                };\n\n                const rotateCam = (angle) => {\n                    const pos = camera.position.clone();\n                    const x = pos.x * Math.cos(angle) - pos.z * Math.sin(angle);\n                    const z = pos.x * Math.sin(angle) + pos.z * Math.cos(angle);\n                    camera.position.set(x, pos.y, z);\n                    controls.update();\n                };\n\n                document.getElementById('btn-reset').addEventListener('click', resetView);\n                document.getElementById('btn-rotate').addEventListener('click', () => rotateCam(Math.PI / 12));\n                \n                document.getElementById('btn-step1').addEventListener('click', () => setDesignStep(1));\n                document.getElementById('btn-step2').addEventListener('click', () => setDesignStep(2));\n                document.getElementById('btn-step3').addEventListener('click', () => setDesignStep(3));\n                document.getElementById('btn-step4').addEventListener('click', () => setDesignStep(4));\n\n                window.addEventListener('keydown', (e) => {\n                    switch(e.key.toLowerCase()) {\n                        case 'r': resetView(); break;\n                        case '+': camera.position.multiplyScalar(0.9); break;\n                        case '-': camera.position.multiplyScalar(1.1); break;\n                        case 'arrowleft': rotateCam(-Math.PI/12); break;\n                        case 'arrowright': rotateCam(Math.PI/12); break;\n                    }\n                });\n            }\n\n            window.updateView = function(type) {\n                switch(type) {\n                    case 'site': \n                        camera.position.set(0, 800, 0); \n                        controls.target.set(0, 0, 0); \n                        break;\n                    case 'floor': \n                        camera.position.set(0, 100, 0); \n                        controls.target.set(0, 100, 0); \n                        break;\n                    case 'ele': \n                        camera.position.set(600, 200, 0); \n                        controls.target.set(0, 200, 0); \n                        break;\n                    case 'sec': \n                        camera.position.set(0, 200, 600); \n                        controls.target.set(0, 200, 0); \n                        break;\n                }\n                controls.update();\n            };\n\n            function animate() {\n                requestAnimationFrame(animate);\n                controls.update();\n                renderer.render(scene, camera);\n            }\n        })();\n    </script>\n</body>\n</html>",
