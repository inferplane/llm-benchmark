{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>롯데월드타워 설계 과정 — glm-5.3</title>\n<style>\n:root{--ink:#1c2430;--paper:#f5f1e8;--line:#3a4656;--accent:#b3541e;--soft:#8a8f98;}\n*{box-sizing:border-box;margin:0;padding:0}\nbody{font-family:\"Noto Sans KR\",\"Malgun Gothic\",sans-serif;background:var(--paper);color:var(--ink);font-size:20px;line-height:1.6}\nheader{padding:28px 32px;border-bottom:2px solid var(--line)}\nh1{font-size:34px;letter-spacing:.02em}\nh2{font-size:26px;margin-bottom:14px;border-left:6px solid var(--accent);padding-left:12px}\n.sub{font-size:20px;color:var(--soft);margin-top:6px}\nmain{max-width:1280px;margin:0 auto;padding:24px 32px}\nsection{margin:44px 0}\n.panel{background:#fff;border:1px solid #d8d2c4;border-radius:10px;padding:20px}\n.grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}\n@media(max-width:900px){.grid{grid-template-columns:1fr}}\ncanvas.view{width:100%;display:block;border:1px solid #cfc9ba;border-radius:6px;background:#fbf9f3;touch-action:none}\n#drawCanvas{aspect-ratio:1200/760}\n#stageCanvas{aspect-ratio:1200/700}\n#finalCanvas{aspect-ratio:1200/800}\ncanvas.view:focus-visible{outline:3px solid var(--accent)}\n.caption{font-size:19px;color:#4a5261;margin-top:10px}\n.note{font-size:19px;background:#fdf3e7;border:1px solid #e5c9a0;border-radius:8px;padding:14px 18px;margin-top:16px}\n.btnrow{display:flex;flex-wrap:wrap;gap:10px;margin:14px 0}\nbutton{font-size:19px;padding:10px 18px;border:2px solid var(--line);background:#fff;border-radius:8px;cursor:pointer}\nbutton.active{background:var(--accent);color:#fff;border-color:var(--accent)}\nbutton:focus-visible{outline:3px solid #b3541e}\n.stage-desc{font-size:20px;min-height:96px;margin-top:10px}\nfooter{padding:24px 32px;border-top:2px solid var(--line);font-size:19px;color:var(--soft)}\na{color:var(--accent)}\n</style>\n</head>\n<body>\n<header>\n<h1>롯데월드타워 설계 과정 인터랙티브</h1>\n<p class=\"sub\">모델: glm-5.3 (us.zai.glm-5.3) — 공개 자료 기반 개념 재구성 (실제 시공 도면 아님)</p>\n</header>\n<main>\n\n<section>\n<h2>1. 개념 도면 (2D)</h2>\n<div class=\"btnrow\">\n<button id=\"dw-site\" class=\"active\">배치도</button>\n<button id=\"dw-plan\">기준층 평면도</button>\n<button id=\"dw-elev\">입면도</button>\n<button id=\"dw-sect\">단면도</button>\n</div>\n<div class=\"panel\">\n<canvas id=\"drawCanvas\" class=\"view\" aria-label=\"설계 도면\"></canvas>\n<p class=\"caption\" id=\"drawCap\"></p>\n</div>\n<div class=\"note\">\n<strong>단위·근거:</strong> 높이 555m·지상 123층은 공개 자료 기준(크라운 포함 전체 높이). 그 외 치수·단면·부재는 공개 자료에 없는 <strong>추정 개념값</strong>이며 단위는 미터(m)입니다. KPF는 형태와 외관에 한국 도자기의 선을 참고했다고 설명합니다.<br>\n원 설계사: kpf.com/project/lotte-world-tower · 구조 설계사: lera.com/lotte-world-tower (실행 중 가져오지 않는 텍스트 출처)\n</div>\n</section>\n\n<section>\n<h2>2. 설계 단계별 3D 형상</h2>\n<div class=\"btnrow\" id=\"stageBtns\"></div>\n<div class=\"panel\">\n<canvas id=\"stageCanvas\" class=\"view\" tabindex=\"0\" aria-label=\"단계별 3D 모델\"></canvas>\n<p class=\"stage-desc\" id=\"stageDesc\"></p>\n<div class=\"btnrow\">\n<button id=\"stageSpin\">단계 모델 자동 회전: 꺼짐</button>\n<button id=\"stageReset\">시점 초기화</button>\n</div>\n<p class=\"caption\">단계 뷰어 조작: 드래그=회전, 휠·핀치=확대/축소, 키보드 ←→↑↓=회전, +/-=줌, R=초기화 (캔버스를 클릭해 포커스)</p>\n</div>\n</section>\n\n<section>\n<h2>3. 완성 모델 (회전·확대/축소·시점 초기화)</h2>\n<div class=\"grid\">\n<div class=\"panel\">\n<canvas id=\"finalCanvas\" class=\"view\" tabindex=\"0\" aria-label=\"완성 3D 모델\"></canvas>\n<div class=\"btnrow\">\n<button id=\"autoRot\">카메라 자동 회전: 꺼짐</button>\n<button id=\"finalReset\">시점 초기화</button>\n</div>\n<p class=\"caption\">마우스 드래그=회전, 휠·핀치=확대/축소, 키보드 ←→↑↓=회전, +/-=줌, R=초기화 (캔버스를 클릭해 포커스)</p>\n</div>\n<div class=\"panel\">\n<h2 style=\"margin-top:0\">도면 ↔ 단계 ↔ 완성 대응</h2>\n<p style=\"font-size:20px\">\n• <strong>배치도</strong> ↔ 1단계(부지·저층) ↔ 완성 모델의 기단부<br>\n• <strong>평면도</strong> ↔ 2단계(기준층 레이아웃) ↔ 완성 모델의 중간부<br>\n• <strong>입면도</strong> ↔ 3단계(테이퍼 형태) ↔ 완성 모델의 전체 실루엣<br>\n• <strong>단면도</strong> ↔ 4단계(코어·수직 동선) ↔ 완성 모델의 내부 코어<br>\n선택한 단계는 위 2번 섹션에서, 대응 도면은 1번 섹션에서 확인하세요.\n</p>\n</div>\n</div>\n</section>\n</main>\n<footer>\n본 페이지는 공개 자료를 참고한 설명용 개념 재구성이며 공식 시공 도면이나 검증된 구조 설계가 아닙니다. 추정 치수는 개념 표현용입니다. — glm-5.3\n</footer>\n\n<script src=\"../runtime/three-runtime.js\"></script>\n<script>\n(function(){\n\"use strict\";\nconst reduced=window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n/* ---------- 2D drawings (responsive, text kept >=19px rendered) ---------- */\nconst dc=document.getElementById(\"drawCanvas\"),dctx=dc.getContext(\"2d\");\nconst cap=document.getElementById(\"drawCap\");\nconst DW={site:0,plan:1,elev:2,sect:3};\nlet curDw=DW.site;\nconst dwBtns={};\n[\"site\",\"plan\",\"elev\",\"sect\"].forEach(k=>{\n  const b=document.getElementById(\"dw-\"+k);\n  dwBtns[k]=b;\n  b.addEventListener(\"click\",()=>{curDw=DW[k];Object.keys(dwBtns).forEach(x=>dwBtns[x].classList.toggle(\"active\",x===k));renderDw();});\n});\nlet dpr=window.devicePixelRatio||1,dW=1200,dH=760,dS=1;\nfunction sizeDrawCanvas(){\n  const cw=dc.clientWidth||1200;\n  const ch=Math.round(cw*760/1200);\n  dpr=window.devicePixelRatio||1;\n  dc.width=Math.round(cw*dpr);dc.height=Math.round(ch*dpr);\n  dW=cw;dH=ch;dS=cw/1200;\n  dctx.setTransform(dpr,0,0,dpr,0,0);\n  renderDw();\n}\n/* text drawn in CSS pixels (never below 19px) at scaled logical coords */\nfunction label(t,x,y,s){dctx.font=\"600 \"+Math.max(19,s||20)+\"px sans-serif\";dctx.fillStyle=\"#1c2430\";dctx.fillText(t,x*dS,y*dS);}\nfunction dimLine(x1,y1,x2,y2,text){\n  dctx.save();dctx.scale(dS,dS);\n  dctx.strokeStyle=\"#b3541e\";dctx.lineWidth=2/dS+1;\n  dctx.beginPath();dctx.moveTo(x1,y1);dctx.lineTo(x2,y2);dctx.stroke();\n  dctx.beginPath();dctx.moveTo(x1,y1-6);dctx.lineTo(x1,y1+6);dctx.moveTo(x2,y2-6);dctx.lineTo(x2,y2+6);dctx.stroke();\n  dctx.restore();\n  dctx.font=\"600 19px sans-serif\";dctx.fillStyle=\"#b3541e\";\n  const tx=((x1+x2)/2)*dS-dctx.measureText(text).width/2, ty=((y1+y2)/2)*dS-10;\n  dctx.fillText(text,tx,ty);\n}\nfunction geo(fn){dctx.save();dctx.scale(dS,dS);dctx.strokeStyle=\"#3a4656\";dctx.lineWidth=Math.max(1.4,2);fn();dctx.restore();}\nfunction roundRectPath(c,x,y,w,h,r){c.moveTo(x+r,y);c.arcTo(x+w,y,x+w,y+h,r);c.arcTo(x+w,y+h,x,y+h,r);c.arcTo(x,y+h,x,y,r);c.arcTo(x,y,x+w,y,r);c.closePath();}\nfunction renderDw(){\n  dctx.setTransform(dpr,0,0,dpr,0,0);\n  dctx.clearRect(0,0,dW,dH);\n  dctx.fillStyle=\"#fbf9f3\";dctx.fillRect(0,0,dW,dH);\n  if(curDw===DW.site){\n    geo(()=>{dctx.strokeRect(80,80,1040,560);});\n    label(\"부지 경계(개념) — 잠실 일대\",100,124,20);\n    dctx.save();dctx.scale(dS,dS);\n    dctx.fillStyle=\"#e8e2d2\";dctx.fillRect(300,300,240,240);dctx.strokeRect(300,300,240,240);\n    dctx.fillStyle=\"#c9d8e8\";dctx.fillRect(560,340,120,160);dctx.strokeRect(560,340,120,160);\n    dctx.beginPath();dctx.arc(880,420,90,0,Math.PI*2);dctx.stroke();\n    dctx.restore();\n    label(\"저층 파빌리온(추정)\",310,334,19);\n    label(\"타워 기단(추정)\",545,534,19);\n    label(\"석촌호수(주변 환경)\",830,424,19);\n    label(\"북\",52,66,22);\n    geo(()=>{dctx.beginPath();dctx.moveTo(60,70);dctx.lineTo(60,40);dctx.stroke();});\n    dimLine(80,700,1120,700,\"부지 배치 개념도 — 축척 없음(개념)\");\n    cap.textContent=\"배치도: 잠실 부지에 타워·저층부·호수 인접 환경을 배치한 개념도. 치수는 추정 개념이며 실제 부지 경계와 다릅니다.\";\n  }else if(curDw===DW.plan){\n    geo(()=>{dctx.beginPath();roundRectPath(dctx,380,180,440,400,40);dctx.stroke();});\n    label(\"기준층 평면(개념) — 둥근 모서리 사각형\",390,164,20);\n    geo(()=>{dctx.strokeRect(540,320,120,140);});\n    label(\"코어(추정)\",555,399,19);\n    dctx.save();dctx.scale(dS,dS);dctx.setLineDash([8,6]);dctx.strokeRect(420,220,360,320);dctx.setLineDash([]);dctx.restore();\n    label(\"외피 라인(추정)\",430,249,19);\n    label(\"사무·전망 공간\",430,564,19);\n    dimLine(380,640,820,640,\"기준층 폭 약 60m(추정)\");\n    cap.textContent=\"기준층 평면도: 위로 갈수록 좁아지는 테이퍼 형태의 대표층 개념. 코어 위치·폭은 추정 개념값(단위 m).\";\n  }else if(curDw===DW.elev){\n    /* total 555m = body 515m + crown 40m; 620px for 555m */\n    geo(()=>{\n      dctx.beginPath();dctx.moveTo(480,700);\n      dctx.bezierCurveTo(472,470,500,270,560,126);\n      dctx.lineTo(640,126);\n      dctx.bezierCurveTo(700,270,728,470,720,700);\n      dctx.closePath();dctx.stroke();\n      dctx.beginPath();dctx.moveTo(560,126);dctx.lineTo(600,80);dctx.lineTo(640,126);dctx.closePath();dctx.stroke();\n    });\n    label(\"입면(남측 개념) — 도자기의 곡선을 참고한 테이퍼\",470,742,19);\n    dctx.save();dctx.scale(dS,dS);dctx.setLineDash([4,6]);\n    for(let y=680;y>140;y-=48){dctx.beginPath();dctx.moveTo(470,y);dctx.lineTo(730,y);dctx.stroke();}\n    dctx.setLineDash([]);dctx.restore();\n    label(\"크라운(최상부, 추정 형상)\",640,110,19);\n    dimLine(760,700,760,80,\"전체 높이 555m = 몸체 515m(추정) + 크라운 40m(추정)\");\n    cap.textContent=\"입면도: 위로 갈수록 좁아지는 실루엣. 전체 555m·123층은 공개 자료 기준이며, 몸체·크라운 구분 곡선과 층 라인은 개념 표현입니다.\";\n  }else{\n    /* section: base 560, 480px for 555m; body top ~114, crown to 80 */\n    geo(()=>{\n      dctx.strokeRect(480,560,240,140);\n      dctx.beginPath();dctx.moveTo(500,560);dctx.bezierCurveTo(495,380,515,200,560,114);\n      dctx.lineTo(640,114);dctx.bezierCurveTo(685,200,705,380,700,560);dctx.closePath();dctx.stroke();\n      dctx.beginPath();dctx.moveTo(560,114);dctx.lineTo(600,80);dctx.lineTo(640,114);dctx.closePath();dctx.stroke();\n    });\n    label(\"저층부(추정)\",500,644,19);\n    dctx.save();dctx.scale(dS,dS);\n    dctx.fillStyle=\"#d9d2c0\";dctx.fillRect(570,120,60,440);dctx.strokeRect(570,120,60,440);\n    dctx.setLineDash([4,6]);\n    for(let y=540;y>140;y-=40){dctx.beginPath();dctx.moveTo(500,y);dctx.lineTo(700,y);dctx.stroke();}\n    dctx.setLineDash([]);dctx.restore();\n    label(\"코어(추정)\",575,364,19);\n    label(\"크라운(추정)\",640,104,19);\n    dimLine(740,560,740,80,\"지상 123층 · 555m(공개 자료, 크라운 포함)\");\n    cap.textContent=\"단면도: 코어와 수직 동선을 담은 개념 단면. 코어 크기·층 높이·크라운은 추정 개념값이며 검증된 구조 설계가 아닙니다.\";\n  }\n}\n\n/* ---------- 3D helpers ---------- */\nconst BODY_H=515, CROWN_H=40, TOTAL_H=555; /* crown included in 555m */\nfunction profile(t){ /* taper: half-width base->top, ceramic curve */\n  return 0.5*(1+0.55*t*t)-0.28*t;\n}\nfunction makeTowerGeometry(levels){\n  const pts=[];const n=levels;\n  for(let i=0;i<=n;i++){\n    const t=i/n;\n    const w=Math.max(profile(t)*60,4);\n    pts.push(new THREE.Vector2(w,t*BODY_H));\n  }\n  return new THREE.LatheGeometry(pts,48);\n}\nfunction makeStageMesh(stage){\n  const g=new THREE.Group();\n  const mat=new THREE.MeshStandardMaterial({color:0x9fb4c8,metalness:.2,roughness:.6});\n  const coreMat=new THREE.MeshStandardMaterial({color:0xb3541e,metalness:.1,roughness:.7});\n  if(stage===0){\n    const ground=new THREE.Mesh(new THREE.CylinderGeometry(140,140,4,48),new THREE.MeshStandardMaterial({color:0xd8d2c0}));\n    ground.position.y=-2;g.add(ground);\n    const pod=new THREE.Mesh(new THREE.CylinderGeometry(70,75,30,48),mat);pod.position.y=15;g.add(pod);\n  }else if(stage===1){\n    for(let i=0;i<6;i++){\n      const w=profile(i/12)*60;\n      const f=new THREE.Mesh(new THREE.CylinderGeometry(w,w,18,48),mat);\n      f.position.y=10+i*20;g.add(f);\n    }\n    const core=new THREE.Mesh(new THREE.CylinderGeometry(10,10,130,24),coreMat);core.position.y=65;g.add(core);\n  }else if(stage===2){\n    g.add(new THREE.Mesh(makeTowerGeometry(24),mat));\n  }else if(stage===3){\n    const body=new THREE.Mesh(makeTowerGeometry(24),new THREE.MeshStandardMaterial({color:0x9fb4c8,transparent:true,opacity:.25}));\n    g.add(body);\n    const core=new THREE.Mesh(new THREE.CylinderGeometry(11,13,BODY_H,24),coreMat);core.position.y=BODY_H/2;g.add(core);\n  }else{\n    g.add(new THREE.Mesh(makeTowerGeometry(40),mat));\n    const core=new THREE.Mesh(new THREE.CylinderGeometry(11,13,BODY_H,24),coreMat);core.position.y=BODY_H/2;g.add(core);\n    const pod=new THREE.Mesh(new THREE.CylinderGeometry(70,75,30,48),mat);pod.position.y=15;g.add(pod);\n    /* crown sits on body top so total = 555m */\n    const crown=new THREE.Mesh(new THREE.ConeGeometry(8,CROWN_H,24),new THREE.MeshStandardMaterial({color:0xd7e2ec,metalness:.4,roughness:.3}));\n    crown.position.y=BODY_H+CROWN_H/2;g.add(crown);\n  }\n  return g;\n}\n\n/* ---------- responsive 3D viewer factory ---------- */\nfunction makeViewer(canvas,aspectNum,aspectDen){\n  const renderer=new THREE.WebGLRenderer({canvas:canvas,antialias:true});\n  const scene=new THREE.Scene();scene.background=new THREE.Color(0xfbf9f3);\n  scene.add(new THREE.HemisphereLight(0xffffff,0x888899,1.1));\n  const dir=new THREE.DirectionalLight(0xffffff,.8);dir.position.set(250,500,350);scene.add(dir);\n  const cam=new THREE.PerspectiveCamera(45,aspectNum/aspectDen,.1,4000);\n  const orbit=new THREE.OrbitControls(cam,canvas);\n  orbit.enableDamping=true;\n  function resize(){\n    const w=canvas.clientWidth||600,h=canvas.clientHeight||Math.round((canvas.clientWidth||600)*aspectDen/aspectNum);\n    renderer.setSize(w,h,false);\n    cam.aspect=w/h;cam.updateProjectionMatrix();\n  }\n  resize();\n  if(window.ResizeObserver){new ResizeObserver(resize).observe(canvas);}\n  else{window.addEventListener(\"resize\",resize);}\n  return {renderer,scene,cam,orbit,resize};\n}\n\n/* ---------- stage viewer ---------- */\nconst stageDescs=[\n\"1단계 — 부지·저층: 잠실 부지에 저층 파빌리온을 배치하는 개념 단계. 배치도와 대응됩니다.\",\n\"2단계 — 기준층 조직: 둥근 모서리의 기준층을 쌓고 코어를 세우는 단계. 평면도와 대응됩니다.\",\n\"3단계 — 테이퍼 형태: 위로 좁아지는 도자기 곡선의 실루엣을 완성하는 단계. 입면도와 대응됩니다.\",\n\"4단계 — 코어·수직 동선: 코어와 수직 계획을 조립하는 단계. 단면도와 대응됩니다.\",\n\"5단계 — 완성 개념: 555m·123층의 완성 형태 개념(크라운 포함, 추정 치수 포함).\"\n];\nconst stageCanvas=document.getElementById(\"stageCanvas\");\nconst SV=makeViewer(stageCanvas,1200,700);\nlet stageGroup=null,stageSpin=false;\nconst stageBtnRow=document.getElementById(\"stageBtns\");\nfunction setStage(i){\n  if(stageGroup)SV.scene.remove(stageGroup);\n  stageGroup=makeStageMesh(i);\n  SV.scene.add(stageGroup);\n  document.getElementById(\"stageDesc\").textContent=stageDescs[i];\n  [...stageBtnRow.children].forEach((b,x)=>b.classList.toggle(\"active\",x===i));\n}\nfor(let i=0;i<5;i++){\n  const b=document.createElement(\"button\");b.textContent=(i+1)+\"단계\";\n  b.addEventListener(\"click\",()=>setStage(i));stageBtnRow.appendChild(b);\n}\nfunction resetStageCam(){SV.cam.position.set(500,420,700);SV.orbit.target.set(0,260,0);SV.orbit.update();}\nresetStageCam();setStage(0);\ndocument.getElementById(\"stageReset\").addEventListener(\"click\",resetStageCam);\nconst spinBtn=document.getElementById(\"stageSpin\");\nspinBtn.addEventListener(\"click\",()=>{stageSpin=!stageSpin;spinBtn.textContent=\"단계 모델 자동 회전: \"+(stageSpin?\"켜짐\":\"꺼짐\");spinBtn.classList.toggle(\"active\",stageSpin);});\nif(reduced){stageSpin=false;spinBtn.textContent=\"단계 모델 자동 회전: 꺼짐 (움직임 감소 설정)\";}\n\n/* ---------- final viewer ---------- */\nconst fCanvas=document.getElementById(\"finalCanvas\");\nconst FV=makeViewer(fCanvas,1200,800);\nFV.scene.add(makeStageMesh(4));\nfunction resetFinalCam(){FV.cam.position.set(600,500,850);FV.orbit.target.set(0,270,0);FV.orbit.update();}\nresetFinalCam();\ndocument.getElementById(\"finalReset\").addEventListener(\"click\",resetFinalCam);\nconst autoBtn=document.getElementById(\"autoRot\");\nlet autoRot=false;\nautoBtn.addEventListener(\"click\",()=>{autoRot=!autoRot;FV.orbit.autoRotate=autoRot&&!reduced;autoBtn.textContent=\"카메라 자동 회전: \"+(autoRot?\"켜짐\":\"꺼짐\");autoBtn.classList.toggle(\"active\",autoRot);});\nif(reduced){autoBtn.textContent=\"카메라 자동 회전: 꺼짐 (움직임 감소 설정)\";}\n\n/* ---------- keyboard controls for BOTH viewers ---------- */\nfunction bindKeys(canvas,cam,orbit,resetFn){\n  canvas.addEventListener(\"keydown\",e=>{\n    const k=e.key;let used=true;\n    if(k===\"r\"||k===\"R\"){resetFn();}\n    else if(k===\"+\"||k===\"=\"){cam.position.sub(orbit.target).multiplyScalar(.92).add(orbit.target);}\n    else if(k===\"-\"||k===\"_\"){cam.position.sub(orbit.target).multiplyScalar(1.08).add(orbit.target);}\n    else if(k===\"ArrowLeft\"){cam.position.sub(orbit.target).applyAxisAngle(new THREE.Vector3(0,1,0),.06).add(orbit.target);}\n    else if(k===\"ArrowRight\"){cam.position.sub(orbit.target).applyAxisAngle(new THREE.Vector3(0,1,0),-.06).add(orbit.target);}\n    else if(k===\"ArrowUp\"){cam.position.sub(orbit.target).applyAxisAngle(new THREE.Vector3(1,0,0),.06).add(orbit.target);}\n    else if(k===\"ArrowDown\"){cam.position.sub(orbit.target).applyAxisAngle(new THREE.Vector3(1,0,0),-.06).add(orbit.target);}\n    else{used=false;}\n    if(used){e.preventDefault();orbit.update();}\n  });\n}\nbindKeys(stageCanvas,SV.cam,SV.orbit,resetStageCam);\nbindKeys(fCanvas,FV.cam,FV.orbit,resetFinalCam);\n\n/* ---------- render loop ---------- */\nlet last=performance.now();\nfunction animate(now){\n  requestAnimationFrame(animate);\n  const dt=Math.min((now-last)/1000,.05);last=now;\n  if(stageGroup&&stageSpin&&!reduced)stageGroup.rotation.y+=dt*.4;\n  SV.orbit.update();FV.orbit.update();\n  SV.renderer.render(SV.scene,SV.cam);\n  FV.renderer.render(FV.scene,FV.cam);\n}\nrequestAnimationFrame(animate);\n\n/* initial sizing after layout */\nsizeDrawCanvas();\nwindow.addEventListener(\"resize\",sizeDrawCanvas);\n})();\n</script>\n</body>\n</html>",
