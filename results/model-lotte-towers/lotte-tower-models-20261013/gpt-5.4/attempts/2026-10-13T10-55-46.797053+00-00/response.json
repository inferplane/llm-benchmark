{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\" />\n<title>롯데월드타워 설계 과정 인터랙티브 뷰어 · gpt-5.4</title>\n<style>\n  :root{\n    --bg:#0b1020;\n    --panel:#121a31;\n    --panel2:#182241;\n    --ink:#eef3ff;\n    --muted:#b8c4e6;\n    --line:#3a4a7a;\n    --accent:#7fd3ff;\n    --accent2:#9ef0c8;\n    --warn:#ffd27a;\n    --danger:#ff9aa2;\n    --shadow:0 10px 30px rgba(0,0,0,.28);\n    --radius:16px;\n  }\n  *{box-sizing:border-box}\n  html,body{height:100%}\n  body{\n    margin:0;\n    font-family:system-ui,-apple-system,Segoe UI,Roboto,Pretendard,Apple SD Gothic Neo,Noto Sans KR,sans-serif;\n    background:\n      radial-gradient(circle at 20% 0%, #1a2750 0%, transparent 35%),\n      radial-gradient(circle at 100% 20%, #12354a 0%, transparent 30%),\n      linear-gradient(180deg,#09101f,#0d1326 45%,#0a1020);\n    color:var(--ink);\n  }\n  .app{\n    display:grid;\n    grid-template-columns: 380px 1fr;\n    min-height:100vh;\n    gap:14px;\n    padding:14px;\n  }\n  .sidebar,.main{\n    min-width:0;\n  }\n  .sidebar{\n    display:flex;\n    flex-direction:column;\n    gap:14px;\n  }\n  .card{\n    background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.015));\n    border:1px solid rgba(255,255,255,.08);\n    border-radius:var(--radius);\n    box-shadow:var(--shadow);\n    overflow:hidden;\n  }\n  .card .hd{\n    padding:14px 16px 10px;\n    border-bottom:1px solid rgba(255,255,255,.08);\n    background:linear-gradient(180deg,rgba(255,255,255,.03),transparent);\n  }\n  .card .bd{padding:14px 16px}\n  h1,h2,h3,p{margin:0}\n  h1{font-size:1.2rem; line-height:1.3}\n  h2{font-size:1rem; margin-bottom:8px}\n  h3{font-size:.95rem; margin-bottom:8px}\n  .sub{color:var(--muted); font-size:.92rem; line-height:1.5}\n  .tiny{font-size:.82rem; color:var(--muted); line-height:1.45}\n  .badge{\n    display:inline-flex; align-items:center; gap:8px;\n    padding:6px 10px; border-radius:999px;\n    background:rgba(127,211,255,.12); color:var(--accent);\n    border:1px solid rgba(127,211,255,.25);\n    font-size:.82rem; font-weight:700;\n  }\n  .grid2{display:grid; grid-template-columns:1fr 1fr; gap:10px}\n  .facts{\n    display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:12px;\n  }\n  .fact{\n    background:rgba(255,255,255,.03);\n    border:1px solid rgba(255,255,255,.08);\n    border-radius:12px; padding:10px;\n  }\n  .fact .k{font-size:.78rem; color:var(--muted)}\n  .fact .v{font-size:1rem; font-weight:700; margin-top:4px}\n  .controls{\n    display:grid; gap:12px;\n  }\n  .seg{\n    display:flex; flex-wrap:wrap; gap:8px;\n  }\n  button, .btnlike{\n    appearance:none; border:none; cursor:pointer;\n    background:var(--panel2); color:var(--ink);\n    border:1px solid rgba(255,255,255,.1);\n    border-radius:12px; padding:10px 12px;\n    font:inherit;\n  }\n  button:hover{filter:brightness(1.08)}\n  button:focus-visible, input:focus-visible{\n    outline:2px solid var(--accent);\n    outline-offset:2px;\n  }\n  .seg button.active{\n    background:linear-gradient(180deg,rgba(127,211,255,.22),rgba(127,211,255,.12));\n    border-color:rgba(127,211,255,.45);\n    color:#fff;\n  }\n  .rangeRow{display:grid; grid-template-columns:1fr auto; gap:10px; align-items:center}\n  input[type=\"range\"]{width:100%}\n  .legend{\n    display:grid; gap:8px;\n  }\n  .legend .item{\n    display:grid; grid-template-columns:14px 1fr; gap:10px; align-items:start;\n    font-size:.9rem; color:var(--muted);\n  }\n  .sw{width:14px;height:14px;border-radius:4px;border:1px solid rgba(255,255,255,.2)}\n  .main{\n    display:grid;\n    grid-template-rows: minmax(360px, 58vh) auto;\n    gap:14px;\n  }\n  .viewerWrap{\n    position:relative;\n    min-height:360px;\n  }\n  #viewer{\n    width:100%; height:100%;\n    background:\n      linear-gradient(180deg,rgba(255,255,255,.02),rgba(255,255,255,0)),\n      radial-gradient(circle at 50% 0%, rgba(127,211,255,.08), transparent 35%);\n  }\n  .overlay{\n    position:absolute; inset:0; pointer-events:none;\n    display:flex; flex-direction:column; justify-content:space-between;\n    padding:14px;\n  }\n  .overlayTop,.overlayBottom{\n    display:flex; justify-content:space-between; gap:10px; align-items:flex-start;\n  }\n  .pill{\n    pointer-events:auto;\n    background:rgba(10,16,32,.72);\n    backdrop-filter:blur(8px);\n    border:1px solid rgba(255,255,255,.1);\n    border-radius:12px;\n    padding:10px 12px;\n    max-width:min(420px, 100%);\n  }\n  .pill strong{display:block; margin-bottom:4px}\n  .toolbar{\n    display:flex; gap:8px; flex-wrap:wrap; pointer-events:auto;\n  }\n  .toolbar button{background:rgba(10,16,32,.78)}\n  .bottomGrid{\n    display:grid; grid-template-columns: 1.1fr .9fr;\n    gap:14px;\n  }\n  .drawings{\n    display:grid; grid-template-columns:1fr 1fr; gap:14px;\n  }\n  .drawingCard canvas{\n    width:100%; height:auto; display:block;\n    background:#f7fbff;\n    border-top:1px solid rgba(255,255,255,.08);\n  }\n  .drawingMeta{\n    padding:10px 12px;\n    background:#eef5ff;\n    color:#1b2748;\n    border-top:1px solid #d7e4ff;\n  }\n  .drawingMeta .title{font-weight:800; margin-bottom:4px}\n  .drawingMeta .desc{font-size:.86rem; line-height:1.45}\n  .mapping{\n    display:grid; gap:10px;\n  }\n  .mapRow{\n    padding:10px 12px; border-radius:12px;\n    background:rgba(255,255,255,.03);\n    border:1px solid rgba(255,255,255,.08);\n  }\n  .mapRow strong{color:#fff}\n  a{color:var(--accent)}\n  .note{\n    margin-top:10px; padding:10px 12px; border-radius:12px;\n    background:rgba(255,210,122,.08); border:1px solid rgba(255,210,122,.22);\n    color:#ffe8b3; font-size:.88rem; line-height:1.5;\n  }\n  .sr-only{\n    position:absolute!important; width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;\n  }\n  @media (max-width: 1100px){\n    .app{grid-template-columns:1fr}\n    .main{grid-template-rows:minmax(320px, 48vh) auto}\n    .bottomGrid{grid-template-columns:1fr}\n  }\n  @media (max-width: 760px){\n    .drawings{grid-template-columns:1fr}\n    .facts{grid-template-columns:1fr 1fr}\n    .overlayTop,.overlayBottom{flex-direction:column; align-items:stretch}\n  }\n  @media (prefers-reduced-motion: reduce){\n    *{scroll-behavior:auto}\n  }\n</style>\n</head>\n<body>\n<div class=\"app\">\n  <aside class=\"sidebar\">\n    <section class=\"card\">\n      <div class=\"hd\">\n        <div class=\"badge\">모델 표시: gpt-5.4</div>\n        <h1 style=\"margin-top:10px;\">롯데월드타워 설계 과정 인터랙티브 뷰어</h1>\n        <p class=\"sub\" style=\"margin-top:8px;\">\n          배치도·평면도·입면도·단면도와 단계별 3D 형상, 완성 3D 모델을 한 화면 체계로 연결한 설명용 개념 재구성입니다.\n        </p>\n      </div>\n      <div class=\"bd\">\n        <div class=\"facts\">\n          <div class=\"fact\"><div class=\"k\">공개 기준 높이</div><div class=\"v\">555 m</div></div>\n          <div class=\"fact\"><div class=\"k\">공개 기준 층수</div><div class=\"v\">지상 123층</div></div>\n          <div class=\"fact\"><div class=\"k\">형태 특징</div><div class=\"v\">상부로 갈수록 축소</div></div>\n          <div class=\"fact\"><div class=\"k\">형태 참고</div><div class=\"v\">한국 도자기 선</div></div>\n        </div>\n        <div class=\"note\">\n          이 페이지는 공개 설명 자료를 바탕으로 한 <strong>개념적 시각화</strong>입니다. 공식 시공 도면, 검증된 구조 설계, 실제 상세 치수로 사용하면 안 됩니다. 공개 자료에 없는 치수·단면·부재는 추정값으로 표현했습니다.\n        </div>\n      </div>\n    </section>\n\n    <section class=\"card\">\n      <div class=\"hd\"><h2>3D 보기 제어</h2></div>\n      <div class=\"bd controls\">\n        <div>\n          <h3>표시 모드</h3>\n          <div class=\"seg\" id=\"modeButtons\" role=\"tablist\" aria-label=\"표시 모드\">\n            <button data-mode=\"stage\" class=\"active\" role=\"tab\" aria-selected=\"true\">설계 단계</button>\n            <button data-mode=\"final\" role=\"tab\" aria-selected=\"false\">완성 모델</button>\n            <button data-mode=\"compare\" role=\"tab\" aria-selected=\"false\">비교 오버레이</button>\n          </div>\n        </div>\n\n        <div>\n          <h3>설계 단계</h3>\n          <div class=\"seg\" id=\"stageButtons\" role=\"tablist\" aria-label=\"설계 단계\">\n            <button data-stage=\"0\" class=\"active\">1. 기본 질량</button>\n            <button data-stage=\"1\">2. 테이퍼</button>\n            <button data-stage=\"2\">3. 분절/후퇴</button>\n            <button data-stage=\"3\">4. 외피 정제</button>\n          </div>\n        </div>\n\n        <div>\n          <h3>층 높이 탐색</h3>\n          <div class=\"rangeRow\">\n            <input id=\"floorSlider\" type=\"range\" min=\"1\" max=\"123\" value=\"60\" step=\"1\" aria-label=\"층 높이 탐색 슬라이더\">\n            <output id=\"floorOut\" for=\"floorSlider\">60층</output>\n          </div>\n          <p class=\"tiny\" style=\"margin-top:6px;\">선택 층의 개념적 기준층 윤곽을 3D와 도면에 함께 강조합니다.</p>\n        </div>\n\n        <div class=\"grid2\">\n          <button id=\"toggleWire\">와이어프레임</button>\n          <button id=\"toggleDims\">도면 치수선 표시</button>\n          <button id=\"resetView\">시점 초기화</button>\n          <button id=\"topView\">상부 시점</button>\n        </div>\n\n        <div class=\"legend\">\n          <div class=\"item\"><span class=\"sw\" style=\"background:#7fd3ff\"></span><span>현재 선택 설계 단계 형상</span></div>\n          <div class=\"item\"><span class=\"sw\" style=\"background:#9ef0c8\"></span><span>완성 모델 형상</span></div>\n          <div class=\"item\"><span class=\"sw\" style=\"background:#ffd27a\"></span><span>선택 층의 기준층 윤곽</span></div>\n          <div class=\"item\"><span class=\"sw\" style=\"background:#ff9aa2\"></span><span>도면에서 강조된 대응 요소</span></div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"card\">\n      <div class=\"hd\"><h2>출처와 해석 범위</h2></div>\n      <div class=\"bd tiny\">\n        <p>원 설계사 공개 설명: <a href=\"https://www.kpf.com/project/lotte-world-tower\" target=\"_blank\" rel=\"noopener noreferrer\">KPF · Lotte World Tower</a></p>\n        <p style=\"margin-top:8px;\">구조 설계사 공개 설명: <a href=\"https://www.lera.com/lotte-world-tower\" target=\"_blank\" rel=\"noopener noreferrer\">LERA · Lotte World Tower</a></p>\n        <p style=\"margin-top:10px;\">\n          본 페이지의 배치도, 평면도, 입면도, 단면도는 공개 사실인 높이·층수·상부 축소 형상·도자기 선 참고 개념을 중심으로 재구성했습니다. 실제 코어 형상, 구조 시스템 상세, 커튼월 분절, 피난·기계층 구성, 기초 및 부재 치수는 공개 자료에 없는 부분이므로 설명용 추정으로 단순화했습니다.\n        </p>\n      </div>\n    </section>\n  </aside>\n\n  <main class=\"main\">\n    <section class=\"card viewerWrap\">\n      <div id=\"viewer\" aria-label=\"3차원 모델 뷰어\"></div>\n      <div class=\"overlay\">\n        <div class=\"overlayTop\">\n          <div class=\"pill\" id=\"statusPill\">\n            <strong>현재 보기</strong>\n            <div class=\"tiny\" id=\"statusText\">설계 단계 1 · 기본 질량</div>\n          </div>\n          <div class=\"toolbar\">\n            <button id=\"zoomIn\" aria-label=\"확대\">확대 +</button>\n            <button id=\"zoomOut\" aria-label=\"축소\">축소 −</button>\n            <button id=\"frontView\">정면</button>\n            <button id=\"isoView\">사시</button>\n          </div>\n        </div>\n        <div class=\"overlayBottom\">\n          <div class=\"pill\">\n            <strong>조작</strong>\n            <div class=\"tiny\">마우스/손가락으로 회전, 확대/축소, 이동. 키보드: 1~4 단계 선택, F 완성 모델, C 비교, R 초기화, ←/→ 층 이동.</div>\n          </div>\n          <div class=\"pill\" id=\"mappingPill\">\n            <strong>도면 대응</strong>\n            <div class=\"tiny\" id=\"mappingText\">배치도는 타워의 대지 내 위치와 기준 축을, 평면도는 선택 층의 윤곽 변화를, 입면도·단면도는 높이 555m와 상부 축소를 함께 보여줍니다.</div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"bottomGrid\">\n      <section class=\"card\">\n        <div class=\"hd\"><h2>설명용 도면 세트</h2></div>\n        <div class=\"bd drawings\">\n          <article class=\"drawingCard card\" style=\"overflow:hidden;\">\n            <canvas id=\"siteCanvas\" width=\"700\" height=\"460\" aria-label=\"배치도\"></canvas>\n            <div class=\"drawingMeta\">\n              <div class=\"title\">배치도</div>\n              <div class=\"desc\">대지 안에서 타워의 위치, 접근 방향, 기준 축, 개념적 포디움 범위를 표시합니다. 단위는 m이며, 대지와 포디움 크기는 공개 자료에 없는 부분을 설명용으로 단순 추정했습니다.</div>\n            </div>\n          </article>\n\n          <article class=\"drawingCard card\" style=\"overflow:hidden;\">\n            <canvas id=\"planCanvas\" width=\"700\" height=\"460\" aria-label=\"기준층 평면도\"></canvas>\n            <div class=\"drawingMeta\">\n              <div class=\"title\">기준층 평면도</div>\n              <div class=\"desc\">선택 층의 개념적 기준층 윤곽과 중심 코어를 보여줍니다. 상부로 갈수록 외곽이 줄어드는 관계를 확인할 수 있습니다. 실제 코어·실 배치는 공개 자료에 없는 추정입니다.</div>\n            </div>\n          </article>\n\n          <article class=\"drawingCard card\" style=\"overflow:hidden;\">\n            <canvas id=\"elevCanvas\" width=\"700\" height=\"460\" aria-label=\"입면도\"></canvas>\n            <div class=\"drawingMeta\">\n              <div class=\"title\">입면도</div>\n              <div class=\"desc\">전체 높이 555m와 상부 축소 형상을 정면에서 보여줍니다. 층수는 123층 기준이며, 층고 분포는 설명용 평균화입니다.</div>\n            </div>\n          </article>\n\n          <article class=\"drawingCard card\" style=\"overflow:hidden;\">\n            <canvas id=\"sectionCanvas\" width=\"700\" height=\"460\" aria-label=\"단면도\"></canvas>\n            <div class=\"drawingMeta\">\n              <div class=\"title\">단면도</div>\n              <div class=\"desc\">개념적 중앙 코어와 외곽, 선택 층 위치를 함께 보여줍니다. 구조 부재와 설비층 구성은 실제 상세가 아닌 설명용 단순화입니다.</div>\n            </div>\n          </article>\n        </div>\n      </section>\n\n      <section class=\"card\">\n        <div class=\"hd\"><h2>설계 단계와 도면의 대응 관계</h2></div>\n        <div class=\"bd mapping\" id=\"mappingList\">\n          <div class=\"mapRow\"><strong>1. 기본 질량</strong> — 배치도에서 타워의 자리와 축을 먼저 정하고, 평면도에서는 큰 기준 윤곽을 확인합니다.</div>\n          <div class=\"mapRow\"><strong>2. 테이퍼</strong> — 입면도와 단면도에서 상부로 갈수록 폭이 줄어드는 전체 비례를 읽습니다.</div>\n          <div class=\"mapRow\"><strong>3. 분절/후퇴</strong> — 평면도와 입면도에서 높이에 따라 윤곽이 단계적으로 정제되는 과정을 봅니다.</div>\n          <div class=\"mapRow\"><strong>4. 외피 정제</strong> — 완성 모델에 가까운 매끈한 외피와 도자기 선을 연상시키는 연속 곡선을 확인합니다.</div>\n          <div class=\"mapRow\"><strong>완성 모델</strong> — 선택 층 슬라이더를 움직이면 평면도·입면도·단면도와 3D 모델에서 같은 높이의 윤곽이 동시에 강조됩니다.</div>\n        </div>\n      </section>\n    </section>\n  </main>\n</div>\n\n<script src=\"../runtime/three-runtime.js\"></script>\n<script>\n(() => {\n  const prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  const state = {\n    mode: 'stage',\n    stage: 0,\n    floor: 60,\n    showWire: false,\n    showDims: true\n  };\n\n  const STAGES = [\n    { name:'기본 질량', desc:'대지 위에 세장한 타워 질량을 세우고 전체 높이와 대략적 폭을 먼저 잡는 단계.' },\n    { name:'테이퍼', desc:'상부로 갈수록 기준층 면적과 외곽이 줄어드는 비례를 형성하는 단계.' },\n    { name:'분절/후퇴', desc:'높이에 따라 윤곽이 조금씩 달라지는 분절감을 주어 수직성을 강화하는 단계.' },\n    { name:'외피 정제', desc:'도자기 선을 연상시키는 매끈한 외피와 모서리 정제를 통해 완성 형상에 접근하는 단계.' }\n  ];\n\n  const viewer = document.getElementById('viewer');\n  const renderer = new THREE.WebGLRenderer({ antialias:true, alpha:true });\n  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));\n  viewer.appendChild(renderer.domElement);\n\n  const scene = new THREE.Scene();\n  scene.background = null;\n\n  const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 5000);\n  camera.position.set(180, 140, 220);\n\n  const controls = new THREE.OrbitControls(camera, renderer.domElement);\n  controls.enableDamping = !prefersReduced;\n  controls.dampingFactor = 0.08;\n  controls.target.set(0, 110, 0);\n  controls.minDistance = 60;\n  controls.maxDistance = 700;\n  controls.maxPolarAngle = Math.PI * 0.495;\n\n  scene.add(new THREE.AmbientLight(0xffffff, 1.2));\n  const dir1 = new THREE.DirectionalLight(0xffffff, 1.2);\n  dir1.position.set(180, 260, 120);\n  scene.add(dir1);\n  const dir2 = new THREE.DirectionalLight(0x88bbff, 0.7);\n  dir2.position.set(-160, 120, -140);\n  scene.add(dir2);\n\n  const root = new THREE.Group();\n  scene.add(root);\n\n  const ground = new THREE.Mesh(\n    new THREE.CircleGeometry(220, 80),\n    new THREE.MeshPhongMaterial({ color:0x0f1730, transparent:true, opacity:0.9, side:THREE.DoubleSide })\n  );\n  ground.rotation.x = -Math.PI/2;\n  ground.position.y = -0.02;\n  root.add(ground);\n\n  const grid = new THREE.GridHelper(360, 24, 0x3a4a7a, 0x243252);\n  grid.position.y = 0;\n  root.add(grid);\n\n  const axis = new THREE.Group();\n  const axisMatX = new THREE.LineBasicMaterial({ color:0xff9aa2 });\n  const axisMatZ = new THREE.LineBasicMaterial({ color:0x7fd3ff });\n  axis.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(-120,0,0), new THREE.Vector3(120,0,0)]), axisMatX));\n  axis.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0,0,-120), new THREE.Vector3(0,0,120)]), axisMatZ));\n  root.add(axis);\n\n  const modelGroup = new THREE.Group();\n  root.add(modelGroup);\n\n  const stageMaterial = new THREE.MeshPhongMaterial({\n    color:0x7fd3ff, emissive:0x0d1f33, shininess:70, transparent:true, opacity:0.92, side:THREE.DoubleSide\n  });\n  const finalMaterial = new THREE.MeshPhongMaterial({\n    color:0x9ef0c8, emissive:0x10261f, shininess:90, transparent:true, opacity:0.88, side:THREE.DoubleSide\n  });\n  const compareMaterial = new THREE.MeshPhongMaterial({\n    color:0xffffff, emissive:0x111111, shininess:40, transparent:true, opacity:0.18, side:THREE.DoubleSide\n  });\n\n  let stageMesh = null;\n  let finalMesh = null;\n  let compareMesh = null;\n  let wireStage = null;\n  let wireFinal = null;\n  let floorRing = null;\n\n  function widthAtHeight(yNorm, stageIndex, smooth=true){\n    const base = 44;\n    const top = 10.5;\n    let w;\n    if(stageIndex === 0){\n      w = base;\n    }else if(stageIndex === 1){\n      w = base + (top - base) * Math.pow(yNorm, 0.92);\n    }else if(stageIndex === 2){\n      const t = base + (top - base) * Math.pow(yNorm, 0.92);\n      const step = (yNorm > 0.78 ? -2.2 : 0) + (yNorm > 0.58 ? -1.6 : 0) + (yNorm > 0.38 ? -1.0 : 0);\n      w = t + step;\n    }else{\n      const t = base + (top - base) * (0.18*yNorm + 0.82*Math.pow(yNorm, 0.88));\n      const curve = 1.8*Math.sin(yNorm*Math.PI)*0.18;\n      w = t - curve;\n    }\n    return Math.max(8.5, w);\n  }\n\n  function profilePoints(stageIndex){\n    const pts = [];\n    const H = 555;\n    const segs = 80;\n    for(let i=0;i<=segs;i++){\n      const y = H * i / segs;\n      const yn = y / H;\n      pts.push(new THREE.Vector2(widthAtHeight(yn, stageIndex), y));\n    }\n    return pts;\n  }\n\n  function buildTowerGeometry(stageIndex, radialSegs=72){\n    const pts = profilePoints(stageIndex);\n    const geo = new THREE.LatheGeometry(pts, radialSegs);\n    geo.rotateY(Math.PI/4);\n    return geo;\n  }\n\n  function buildFloorRing(stageIndex, floor){\n    const H = 555;\n    const y = H * (floor / 123);\n    const yn = y / H;\n    const w = widthAtHeight(yn, stageIndex);\n    const shape = new THREE.Shape();\n    const r = w * 0.92;\n    shape.moveTo(r,0);\n    shape.absellipse(0,0,r,r*0.92,0,Math.PI*2,false,0);\n    const pts = shape.getPoints(80).map(p => new THREE.Vector3(p.x, y, p.y));\n    const geo = new THREE.BufferGeometry().setFromPoints(pts.concat([pts[0]]));\n    return new THREE.Line(geo, new THREE.LineBasicMaterial({ color:0xffd27a, linewidth:2 }));\n  }\n\n  function buildCore(stageIndex){\n    const H = 555;\n    const geo = new THREE.CylinderGeometry(8.5, 12, H, 24, 1, false);\n    geo.translate(0, H/2, 0);\n    const mat = new THREE.MeshPhongMaterial({ color:0xff9aa2, transparent:true, opacity:0.18 });\n    return new THREE.Mesh(geo, mat);\n  }\n\n  function clearModel(){\n    while(modelGroup.children.length) {\n      const c = modelGroup.children.pop();\n      if(c.geometry) c.geometry.dispose?.();\n      if(c.material){\n        if(Array.isArray(c.material)) c.material.forEach(m=>m.dispose?.());\n        else c.material.dispose?.();\n      }\n    }\n  }\n\n  function rebuildModel(){\n    clearModel();\n\n    stageMesh = new THREE.Mesh(buildTowerGeometry(state.stage), stageMaterial.clone());\n    finalMesh = new THREE.Mesh(buildTowerGeometry(3), finalMaterial.clone());\n    compareMesh = new THREE.Mesh(buildTowerGeometry(3), compareMaterial.clone());\n\n    const core = buildCore(state.stage);\n    modelGroup.add(core);\n\n    wireStage = new THREE.LineSegments(\n      new THREE.WireframeGeometry(stageMesh.geometry),\n      new THREE.LineBasicMaterial({ color:0xdff4ff, transparent:true, opacity:0.35 })\n    );\n    wireFinal = new THREE.LineSegments(\n      new THREE.WireframeGeometry(finalMesh.geometry),\n      new THREE.LineBasicMaterial({ color:0xeafff4, transparent:true, opacity:0.28 })\n    );\n\n    floorRing = buildFloorRing(state.mode === 'final' ? 3 : state.stage, state.floor);\n\n    if(state.mode === 'stage'){\n      modelGroup.add(stageMesh);\n      if(state.showWire) modelGroup.add(wireStage);\n    }else if(state.mode === 'final'){\n      modelGroup.add(finalMesh);\n      if(state.showWire) modelGroup.add(wireFinal);\n    }else{\n      modelGroup.add(compareMesh);\n      modelGroup.add(stageMesh);\n      if(state.showWire) modelGroup.add(wireStage);\n    }\n    modelGroup.add(floorRing);\n\n    updateStatus();\n  }\n\n  function updateStatus(){\n    const statusText = document.getElementById('statusText');\n    const mappingText = document.getElementById('mappingText');\n    if(state.mode === 'stage'){\n      statusText.textContent = `설계 단계 ${state.stage+1} · ${STAGES[state.stage].name}`;\n      mappingText.textContent = `현재는 \"${STAGES[state.stage].name}\" 단계입니다. 선택 층 ${state.floor}층의 윤곽이 평면도와 3D에서 함께 강조됩니다. 입면도·단면도에서는 555m 전체 높이 안에서 이 단계의 비례를 읽을 수 있습니다.`;\n    }else if(state.mode === 'final'){\n      statusText.textContent = `완성 모델 · 선택 층 ${state.floor}층`;\n      mappingText.textContent = `완성 모델에서 ${state.floor}층 높이의 개념적 기준층 윤곽을 강조합니다. 평면도는 해당 층의 외곽, 입면도·단면도는 같은 높이의 위치를 동시에 보여줍니다.`;\n    }else{\n      statusText.textContent = `비교 오버레이 · 단계 ${state.stage+1} vs 완성 모델`;\n      mappingText.textContent = `반투명 완성 형상 위에 단계 ${state.stage+1} 형상을 겹쳐 보여줍니다. 도면에서는 같은 층 높이와 전체 비례를 비교해 설계 발전 방향을 읽을 수 있습니다.`;\n    }\n  }\n\n  function resize(){\n    const w = viewer.clientWidth;\n    const h = viewer.clientHeight;\n    renderer.setSize(w,h,false);\n    camera.aspect = w/h;\n    camera.updateProjectionMatrix();\n  }\n  window.addEventListener('resize', resize);\n\n  function animate(){\n    requestAnimationFrame(animate);\n    controls.update();\n    renderer.render(scene, camera);\n  }\n\n  function setView(kind){\n    if(kind === 'reset' || kind === 'iso'){\n      camera.position.set(180, 140, 220);\n      controls.target.set(0, 110, 0);\n    }else if(kind === 'top'){\n      camera.position.set(0, 420, 0.01);\n      controls.target.set(0, 120, 0);\n    }else if(kind === 'front'){\n      camera.position.set(0, 150, 280);\n      controls.target.set(0, 140, 0);\n    }\n    camera.updateProjectionMatrix();\n    controls.update();\n  }\n\n  function setMode(mode){\n    state.mode = mode;\n    document.querySelectorAll('#modeButtons button').forEach(b=>{\n      const active = b.dataset.mode === mode;\n      b.classList.toggle('active', active);\n      b.setAttribute('aria-selected', active ? 'true' : 'false');\n    });\n    rebuildModel();\n    drawAll();\n  }\n\n  function setStage(stage){\n    state.stage = stage;\n    document.querySelectorAll('#stageButtons button').forEach(b=>{\n      b.classList.toggle('active', Number(b.dataset.stage) === stage);\n    });\n    rebuildModel();\n    drawAll();\n  }\n\n  function setFloor(floor){\n    state.floor = Math.max(1, Math.min(123, floor));\n    document.getElementById('floorSlider').value = state.floor;\n    document.getElementById('floorOut').value = `${state.floor}층`;\n    rebuildModel();\n    drawAll();\n  }\n\n  document.getElementById('modeButtons').addEventListener('click', e=>{\n    const btn = e.target.closest('button[data-mode]');\n    if(!btn) return;\n    setMode(btn.dataset.mode);\n  });\n  document.getElementById('stageButtons').addEventListener('click', e=>{\n    const btn = e.target.closest('button[data-stage]');\n    if(!btn) return;\n    setStage(Number(btn.dataset.stage));\n  });\n  document.getElementById('floorSlider').addEventListener('input', e=>setFloor(Number(e.target.value)));\n  document.getElementById('toggleWire').addEventListener('click', ()=>{\n    state.showWire = !state.showWire;\n    rebuildModel();\n  });\n  document.getElementById('toggleDims').addEventListener('click', ()=>{\n    state.showDims = !state.showDims;\n    drawAll();\n  });\n  document.getElementById('resetView').addEventListener('click', ()=>setView('reset'));\n  document.getElementById('topView').addEventListener('click', ()=>setView('top'));\n  document.getElementById('frontView').addEventListener('click', ()=>setView('front'));\n  document.getElementById('isoView').addEventListener('click', ()=>setView('iso'));\n  document.getElementById('zoomIn').addEventListener('click', ()=>{\n    camera.position.multiplyScalar(0.88); controls.update();\n  });\n  document.getElementById('zoomOut').addEventListener('click', ()=>{\n    camera.position.multiplyScalar(1.14); controls.update();\n  });\n\n  window.addEventListener('keydown', e=>{\n    if(['INPUT','TEXTAREA'].includes(document.activeElement.tagName)) return;\n    if(e.key === '1') setStage(0);\n    if(e.key === '2') setStage(1);\n    if(e.key === '3') setStage(2);\n    if(e.key === '4') setStage(3);\n    if(e.key.toLowerCase() === 'f') setMode('final');\n    if(e.key.toLowerCase() === 'c') setMode('compare');\n    if(e.key.toLowerCase() === 'r') setView('reset');\n    if(e.key === 'ArrowRight') setFloor(state.floor + 1);\n    if(e.key === 'ArrowLeft') setFloor(state.floor - 1);\n  });\n\n  function drawSheetBase(ctx, w, h, title){\n    ctx.clearRect(0,0,w,h);\n    ctx.fillStyle = '#f7fbff';\n    ctx.fillRect(0,0,w,h);\n    ctx.strokeStyle = '#d7e4ff';\n    ctx.lineWidth = 1;\n    for(let x=20;x<w;x+=40){ ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,h); ctx.stroke(); }\n    for(let y=20;y<h;y+=40){ ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(w,y); ctx.stroke(); }\n    ctx.fillStyle = '#1b2748';\n    ctx.font = '700 18px system-ui, sans-serif';\n    ctx.fillText(title, 18, 28);\n    ctx.font = '12px system-ui, sans-serif';\n    ctx.fillStyle = '#4a5d8f';\n    ctx.fillText('설명용 개념 재구성 · 단위 m', 18, 46);\n  }\n\n  function drawDim(ctx, x1,y1,x2,y2,label, vertical=false){\n    if(!state.showDims) return;\n    ctx.save();\n    ctx.strokeStyle = '#6f84b8';\n    ctx.fillStyle = '#42598f';\n    ctx.lineWidth = 1.2;\n    ctx.beginPath(); ctx.moveTo(x1,y1); ctx.lineTo(x2,y2); ctx.stroke();\n    const ah = 6;\n    if(vertical){\n      ctx.beginPath();\n      ctx.moveTo(x1-ah,y1+ah); ctx.lineTo(x1,y1); ctx.lineTo(x1+ah,y1+ah);\n      ctx.moveTo(x2-ah,y2-ah); ctx.lineTo(x2,y2); ctx.lineTo(x2+ah,y2-ah);\n      ctx.stroke();\n      ctx.save();\n      ctx.translate(x1-10,(y1+y2)/2);\n      ctx.rotate(-Math.PI/2);\n      ctx.font = '12px system-ui, sans-serif';\n      ctx.fillText(label,0,0);\n      ctx.restore();\n    }else{\n      ctx.beginPath();\n      ctx.moveTo(x1+ah,y1-ah); ctx.lineTo(x1,y1); ctx.lineTo(x1+ah,y1+ah);\n      ctx.moveTo(x2-ah,y2-ah); ctx.lineTo(x2,y2); ctx.lineTo(x2-ah,y2+ah);\n      ctx.stroke();\n      ctx.font = '12px system-ui, sans-serif';\n      ctx.fillText(label,(x1+x2)/2-18,y1-8);\n    }\n    ctx.restore();\n  }\n\n  function currentStageForDrawings(){\n    return state.mode === 'final' ? 3 : state.stage;\n  }\n\n  function drawSite(){\n    const c = document.getElementById('siteCanvas');\n    const ctx = c.getContext('2d');\n    const w = c.width, h = c.height;\n    drawSheetBase(ctx,w,h,'배치도');\n    const pad = 70;\n    ctx.save();\n    ctx.translate(w/2, h/2+20);\n\n    ctx.strokeStyle = '#1b2748';\n    ctx.lineWidth = 2;\n    ctx.strokeRect(-220,-130,440,260);\n    ctx.fillStyle = 'rgba(127,211,255,.08)';\n    ctx.fillRect(-220,-130,440,260);\n\n    ctx.fillStyle = 'rgba(158,240,200,.18)';\n    ctx.strokeStyle = '#2f8f73';\n    ctx.lineWidth = 2;\n    ctx.fillRect(-95,-55,190,110);\n    ctx.strokeRect(-95,-55,190,110);\n\n    ctx.save();\n    ctx.rotate(Math.PI/4);\n    ctx.fillStyle = 'rgba(255,154,162,.28)';\n    ctx.strokeStyle = '#b84f5a';\n    ctx.beginPath();\n    ctx.ellipse(0,0,42,38,0,0,Math.PI*2);\n    ctx.fill(); ctx.stroke();\n    ctx.restore();\n\n    ctx.strokeStyle = '#ff9aa2';\n    ctx.lineWidth = 1.5;\n    ctx.beginPath(); ctx.moveTo(-140,0); ctx.lineTo(140,0); ctx.stroke();\n    ctx.strokeStyle = '#7fd3ff';\n    ctx.beginPath(); ctx.moveTo(0,-100); ctx.lineTo(0,100); ctx.stroke();\n\n    ctx.fillStyle = '#1b2748';\n    ctx.font = '12px system-ui, sans-serif';\n    ctx.fillText('개념적 대지 경계', -210, -138);\n    ctx.fillText('개념적 포디움 범위', -92, -64);\n    ctx.fillText('타워 중심', 18, -8);\n    ctx.fillText('N', 0, -112);\n\n    drawDim(ctx, w/2-220, h/2+160, w/2+220, h/2+160, '약 220 m');\n    drawDim(ctx, w/2+240, h/2-110, w/2+240, h/2+150, '약 130 m', true);\n    ctx.restore();\n  }\n\n  function drawPlan(){\n    const c = document.getElementById('planCanvas');\n    const ctx = c.getContext('2d');\n    const w = c.width, h = c.height;\n    drawSheetBase(ctx,w,h,`기준층 평면도 · ${state.floor}층`);\n    ctx.save();\n    ctx.translate(w/2, h/2+20);\n\n    const stage = currentStageForDrawings();\n    const yn = (555 * (state.floor/123)) / 555;\n    const width = widthAtHeight(yn, stage);\n    const scale = 3.2;\n    const rx = width * scale;\n    const ry = width * scale * 0.92;\n\n    ctx.save();\n    ctx.rotate(Math.PI/4);\n    ctx.fillStyle = 'rgba(127,211,255,.18)';\n    ctx.strokeStyle = '#2f6f9f';\n    ctx.lineWidth = 3;\n    ctx.beginPath();\n    ctx.ellipse(0,0,rx,ry,0,0,Math.PI*2);\n    ctx.fill(); ctx.stroke();\n\n    ctx.fillStyle = 'rgba(255,154,162,.28)';\n    ctx.strokeStyle = '#b84f5a';\n    ctx.beginPath();\n    ctx.roundRect(-rx*0.22,-ry*0.22,rx*0.44,ry*0.44,10);\n    ctx.fill(); ctx.stroke();\n    ctx.restore();\n\n    ctx.strokeStyle = '#ffd27a';\n    ctx.lineWidth = 2;\n    ctx.beginPath(); ctx.moveTo(-rx-30,0); ctx.lineTo(rx+30,0); ctx.stroke();\n    ctx.beginPath(); ctx.moveTo(0,-ry-30); ctx.lineTo(0,ry+30); ctx.stroke();\n\n    ctx.fillStyle = '#1b2748';\n    ctx.font = '12px system-ui, sans-serif';\n    ctx.fillText('외곽 윤곽(선택 층)', -rx, -ry-18);\n    ctx.fillText('개념적 중심 코어', 14, 0);\n\n    drawDim(ctx, w/2-rx, h/2+20+ry+42, w/2+rx, h/2+20+ry+42, `약 ${Math.round(width*2)} m`);\n    drawDim(ctx, w/2+rx+42, h/2+20-ry, w/2+rx+42, h/2+20+ry, `약 ${Math.round(width*2*0.92)} m`, true);\n    ctx.restore();\n  }\n\n  function drawElevation(){\n    const c = document.getElementById('elevCanvas');\n    const ctx = c.getContext('2d');\n    const w = c.width, h = c.height;\n    drawSheetBase(ctx,w,h,'입면도');\n    const stage = currentStageForDrawings();\n    const Hpx = 330;\n    const baseY = h - 55;\n    const centerX = w/2;\n    const scaleY = Hpx / 555;\n\n    ctx.save();\n    ctx.translate(centerX, baseY);\n\n    ctx.beginPath();\n    for(let i=0;i<=80;i++){\n      const y = 555 * i/80;\n      const yn = y/555;\n      const ww = widthAtHeight(yn, stage) * 2.2;\n      const px = ww;\n      const py = -y*scaleY;\n      if(i===0) ctx.moveTo(px, py);\n      else ctx.lineTo(px, py);\n    }\n    for(let i=80;i>=0;i--){\n      const y = 555 * i/80;\n      const yn = y/555;\n      const ww = widthAtHeight(yn, stage) * 2.2;\n      const px = -ww;\n      const py = -y*scaleY;\n      ctx.lineTo(px, py);\n    }\n    ctx.closePath();\n    ctx.fillStyle = 'rgba(127,211,255,.18)';\n    ctx.strokeStyle = '#2f6f9f';\n    ctx.lineWidth = 3;\n    ctx.fill(); ctx.stroke();\n\n    const fy = -(555 * (state.floor/123)) * scaleY;\n    ctx.strokeStyle = '#ff9aa2';\n    ctx.lineWidth = 2;\n    ctx.beginPath(); ctx.moveTo(-90, fy); ctx.lineTo(90, fy); ctx.stroke();\n\n    ctx.strokeStyle = '#6f84b8';\n    ctx.setLineDash([5,5]);\n    for(let i=0;i<=123;i+=20){\n      const y = -(555 * (i/123)) * scaleY;\n      ctx.beginPath(); ctx.moveTo(-120,y); ctx.lineTo(120,y); ctx.stroke();\n    }\n    ctx.setLineDash([]);\n\n    ctx.fillStyle = '#1b2748';\n    ctx.font = '12px system-ui, sans-serif';\n    ctx.fillText('선택 층 높이', 98, fy+4);\n    ctx.fillText('상부로 갈수록 축소', 58, -250);\n\n    drawDim(ctx, centerX+140, baseY, centerX+140, baseY-Hpx, '555 m', true);\n    ctx.restore();\n  }\n\n  function drawSection(){\n    const c = document.getElementById('sectionCanvas');\n    const ctx = c.getContext('2d');\n    const w = c.width, h = c.height;\n    drawSheetBase(ctx,w,h,'단면도');\n    const stage = currentStageForDrawings();\n    const Hpx = 330;\n    const baseY = h - 55;\n    const centerX = w/2;\n    const scaleY = Hpx / 555;\n\n    ctx.save();\n    ctx.translate(centerX, baseY);\n\n    ctx.beginPath();\n    for(let i=0;i<=80;i++){\n      const y = 555 * i/80;\n      const yn = y/555;\n      const ww = widthAtHeight(yn, stage) * 1.8;\n      const py = -y*scaleY;\n      if(i===0) ctx.moveTo(ww, py);\n      else ctx.lineTo(ww, py);\n    }\n    for(let i=80;i>=0;i--){\n      const y = 555 * i/80;\n      const yn = y/555;\n      const ww = widthAtHeight(yn, stage) * 1.8;\n      const py = -y*scaleY;\n      ctx.lineTo(-ww, py);\n    }\n    ctx.closePath();\n    ctx.fillStyle = 'rgba(158,240,200,.16)';\n    ctx.strokeStyle = '#2f8f73';\n    ctx.lineWidth = 3;\n    ctx.fill(); ctx.stroke();\n\n    ctx.fillStyle = 'rgba(255,154,162,.28)';\n    ctx.strokeStyle = '#b84f5a';\n    ctx.beginPath();\n    ctx.roundRect(-18, -Hpx, 36, Hpx, 8);\n    ctx.fill(); ctx.stroke();\n\n    const fy = -(555 * (state.floor/123)) * scaleY;\n    ctx.strokeStyle = '#ffd27a';\n    ctx.lineWidth = 2;\n    ctx.beginPath(); ctx.moveTo(-100, fy); ctx.lineTo(100, fy); ctx.stroke();\n\n    ctx.fillStyle = '#1b2748';\n    ctx.font = '12px system-ui, sans-serif';\n    ctx.fillText('개념적 코어', 24, -180);\n    ctx.fillText(`${state.floor}층`, 106, fy+4);\n\n    drawDim(ctx, centerX+140, baseY, centerX+140, baseY-Hpx, '555 m', true);\n    ctx.restore();\n  }\n\n  function drawAll(){\n    drawSite();\n    drawPlan();\n    drawElevation();\n    drawSection();\n  }\n\n  resize();\n  rebuildModel();\n  drawAll();\n  setView('iso');\n  animate();\n})();\n</script>\n</body>\n</html>",
