{
  "text": "<!doctype html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\" />\n<title>롯데월드타워 설계 개념 재구성 인터랙티브 — gpt-5.5</title>\n<style>\n  :root{\n    --bg:#0b1020; --panel:#121a2f; --panel2:#17213b; --ink:#eef5ff; --muted:#b9c7dd;\n    --line:#5fd0ff; --accent:#f6c85f; --accent2:#9ff3c7; --warn:#ffb4a8; --grid:#2b3a5f;\n    --shadow:0 16px 46px rgba(0,0,0,.35); --radius:18px;\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0;height:100%;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,Segoe UI,Roboto,\"Noto Sans KR\",Arial,sans-serif}\n  body{overflow:hidden}\n  a{color:#bdeaff}\n  button,input,select{font:inherit}\n  .app{height:100dvh;display:grid;grid-template-rows:auto 1fr;background:\n    radial-gradient(circle at 75% 8%,rgba(95,208,255,.18),transparent 34%),\n    linear-gradient(180deg,#0b1020,#090d19 68%,#070a12)}\n  header{padding:12px 16px;border-bottom:1px solid rgba(255,255,255,.09);display:flex;gap:12px;align-items:center;justify-content:space-between;background:rgba(9,14,28,.72);backdrop-filter:blur(10px)}\n  h1{font-size:clamp(17px,2.3vw,25px);margin:0;letter-spacing:-.03em}\n  .badge{font-size:12px;color:#07101e;background:var(--accent2);padding:5px 9px;border-radius:999px;font-weight:800;white-space:nowrap}\n  .main{min-height:0;display:grid;grid-template-columns:380px 1fr 360px;gap:12px;padding:12px}\n  .panel{min-height:0;background:rgba(18,26,47,.88);border:1px solid rgba(255,255,255,.10);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}\n  .left,.right{display:flex;flex-direction:column}\n  .tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;padding:10px;background:rgba(255,255,255,.035)}\n  .tab,.btn{border:1px solid rgba(255,255,255,.16);background:#1a2644;color:var(--ink);border-radius:12px;padding:9px 8px;cursor:pointer}\n  .tab[aria-selected=\"true\"],.btn.primary{background:linear-gradient(180deg,#2e84a6,#1c5876);border-color:#8ee6ff;color:white}\n  .content{padding:13px;overflow:auto}\n  .drawingWrap{background:#f7fbff;color:#112; border-radius:14px; padding:8px;box-shadow:inset 0 0 0 1px #c7d7e8}\n  svg{width:100%;height:auto;display:block}\n  .caption{font-size:13px;line-height:1.45;color:var(--muted);margin-top:10px}\n  .small{font-size:12px;color:#aebbd0;line-height:1.45}\n  .legend{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}\n  .chip{font-size:12px;border:1px solid rgba(255,255,255,.18);border-radius:999px;padding:5px 8px;background:rgba(255,255,255,.05)}\n  .viewer{position:relative;overflow:hidden;background:linear-gradient(180deg,#0e1730,#060912)}\n  #three{width:100%;height:100%;display:block;touch-action:none}\n  .hud{position:absolute;left:14px;top:14px;right:14px;display:flex;gap:8px;justify-content:space-between;align-items:flex-start;pointer-events:none}\n  .hudBox{pointer-events:auto;background:rgba(7,12,24,.72);border:1px solid rgba(255,255,255,.14);border-radius:14px;padding:10px;backdrop-filter:blur(8px)}\n  .hudTitle{font-weight:800;font-size:14px}\n  .controls{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}\n  .controls .btn{padding:8px 10px;font-size:13px;background:rgba(26,38,68,.88)}\n  .steps{padding:12px;display:grid;gap:9px;overflow:auto}\n  .step{border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.045);border-radius:14px;padding:10px;text-align:left;color:var(--ink);cursor:pointer}\n  .step.active{border-color:var(--accent);box-shadow:0 0 0 2px rgba(246,200,95,.22) inset;background:rgba(246,200,95,.08)}\n  .step b{display:block;margin-bottom:3px}\n  .rangeBox{padding:12px;border-top:1px solid rgba(255,255,255,.09)}\n  input[type=range]{width:100%;accent-color:var(--accent)}\n  .note{margin:12px;padding:11px;border-radius:14px;background:rgba(255,180,168,.09);border:1px solid rgba(255,180,168,.26);color:#ffe0db;font-size:13px;line-height:1.45}\n  .kpi{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0}\n  .kpi div{background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.10);border-radius:12px;padding:8px}\n  .kpi b{display:block;color:#fff;font-size:18px}\n  .match{border-left:3px solid var(--line);padding-left:10px;margin-top:10px}\n  @media(max-width:1050px){\n    body{overflow:auto}.app{height:auto;min-height:100dvh}.main{grid-template-columns:1fr;grid-template-rows:auto 70dvh auto}.viewer{min-height:560px}.left,.right{min-height:420px}\n  }\n  @media(max-width:560px){\n    header{align-items:flex-start;flex-direction:column}.main{padding:8px;gap:8px}.tabs{grid-template-columns:1fr 1fr}.viewer{min-height:520px}.hud{position:absolute;flex-direction:column}.controls{justify-content:flex-start}\n  }\n  @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}.badge{background:#d8fff0}}\n</style>\n</head>\n<body>\n<div class=\"app\">\n  <header>\n    <div>\n      <h1>롯데월드타워 설계 과정 개념 재구성: 도면 × 단계별 3D × 완성형</h1>\n      <div class=\"small\">공개 설명 자료를 바탕으로 한 교육용 시각화이며, 공식 시공도면·검증 구조설계가 아닙니다.</div>\n    </div>\n    <div class=\"badge\">실제 모델 이름: gpt-5.5</div>\n  </header>\n\n  <main class=\"main\">\n    <section class=\"panel left\" aria-label=\"도면 패널\">\n      <div class=\"tabs\" role=\"tablist\" aria-label=\"도면 선택\">\n        <button class=\"tab\" data-drawing=\"site\" aria-selected=\"true\">배치도</button>\n        <button class=\"tab\" data-drawing=\"plan\" aria-selected=\"false\">기준층</button>\n        <button class=\"tab\" data-drawing=\"elev\" aria-selected=\"false\">입면</button>\n        <button class=\"tab\" data-drawing=\"section\" aria-selected=\"false\">단면</button>\n      </div>\n      <div class=\"content\">\n        <div class=\"drawingWrap\" id=\"drawing\"></div>\n        <div class=\"caption\" id=\"drawingText\"></div>\n        <div class=\"legend\">\n          <span class=\"chip\">하늘색: 외곽/매스</span>\n          <span class=\"chip\">노랑: 현재 단계 대응</span>\n          <span class=\"chip\">초록: 코어/수직 동선 개념</span>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"panel viewer\" aria-label=\"3D 모델 뷰어\">\n      <canvas id=\"three\"></canvas>\n      <div class=\"hud\">\n        <div class=\"hudBox\">\n          <div class=\"hudTitle\" id=\"hudTitle\">완성형 개념 모델</div>\n          <div class=\"small\" id=\"hudSub\">마우스/터치 드래그: 회전 · 휠/핀치: 확대축소</div>\n        </div>\n        <div class=\"hudBox controls\">\n          <button class=\"btn primary\" id=\"showFinal\">완성 모델</button>\n          <button class=\"btn\" id=\"toggleGhost\">단계 겹쳐보기</button>\n          <button class=\"btn\" id=\"resetView\">시점 초기화</button>\n        </div>\n      </div>\n    </section>\n\n    <aside class=\"panel right\" aria-label=\"설계 단계 및 설명\">\n      <div class=\"steps\" id=\"steps\"></div>\n      <div class=\"rangeBox\">\n        <label for=\"stageRange\"><b>설계 발전 단계</b> <span id=\"rangeLabel\">5 / 5</span></label>\n        <input id=\"stageRange\" type=\"range\" min=\"1\" max=\"5\" value=\"5\" />\n        <div class=\"kpi\">\n          <div><span class=\"small\">공개 기준 높이</span><b>555 m</b></div>\n          <div><span class=\"small\">공개 기준 층수</span><b>123 F</b></div>\n        </div>\n        <div class=\"match\" id=\"matchText\"></div>\n      </div>\n      <div class=\"note\">\n        <b>주의</b><br>\n        KPF와 LERA의 공개 프로젝트 설명, 555m·123층이라는 공통 공개 정보를 참고했습니다.\n        평면 폭, 코어 크기, 층별 면적, 구조부재, 단면 비율은 공개 자료에 없는 부분이므로\n        실제 치수가 아니라 “위로 갈수록 좁아지는 한국 도자기 선”을 설명하기 위한 추정 개념입니다.\n        출처 텍스트: kpf.com/project/lotte-world-tower, lera.com/lotte-world-tower\n      </div>\n    </aside>\n  </main>\n</div>\n\n<script src=\"../runtime/three-runtime.js\"></script>\n<script>\n(function(){\n'use strict';\n\nconst H=555, FLOORS=123;\nconst stages=[\n {n:1,t:'대지와 수직 기준선',d:'서울 잠실 대지 위에 555m 수직 기준축과 저층 포디움 영역을 먼저 놓습니다.',scale:.55,twist:0,notch:0,tip:false},\n {n:2,t:'기준층 적층',d:'반복 가능한 기준층을 쌓되, 상부로 갈수록 기준층 외곽을 점진적으로 줄이는 원칙을 둡니다.',scale:.72,twist:0,notch:0,tip:false},\n {n:3,t:'테이퍼 조정',d:'하부는 넓고 상부는 가는 매스로 정리하여 123층 높이를 하나의 연속 외피로 읽히게 합니다.',scale:.88,twist:.06,notch:0,tip:false},\n {n:4,t:'도자기 선 외피',d:'KPF가 언급한 한국 도자기의 부드러운 선을 참고하여 모서리와 수직 곡선을 완만하게 다듬습니다.',scale:1,twist:.12,notch:.18,tip:false},\n {n:5,t:'완성형 개념 모델',d:'중앙 코어, 포디움, 테이퍼 외곽, 상부 첨탑 느낌을 함께 보여주는 설명용 완성 3D 형상입니다.',scale:1,twist:.16,notch:.28,tip:true}\n];\nlet current=5, showGhost=false, drawing='site';\n\nconst stepsEl=document.getElementById('steps'), range=document.getElementById('stageRange'), rangeLabel=document.getElementById('rangeLabel');\nstages.forEach(s=>{\n const b=document.createElement('button'); b.className='step'; b.innerHTML=`<b>${s.n}. ${s.t}</b><span class=\"small\">${s.d}</span>`;\n b.onclick=()=>setStage(s.n,false); stepsEl.appendChild(b);\n});\n\nfunction svgBase(content){return `<svg viewBox=\"0 0 640 470\" role=\"img\" aria-label=\"개념 도면\">\n<defs><pattern id=\"grid\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\"><path d=\"M20 0H0V20\" fill=\"none\" stroke=\"#d9e6f2\" stroke-width=\"1\"/></pattern></defs>\n<rect width=\"640\" height=\"470\" fill=\"#f7fbff\"/><rect x=\"20\" y=\"20\" width=\"600\" height=\"410\" fill=\"url(#grid)\" stroke=\"#94abc0\"/>\n${content}<text x=\"26\" y=\"456\" font-size=\"14\" fill=\"#334\">단위: m 개념 스케일. 공개 확정값: 높이 555m, 지상 123층. 기타 치수는 설명용 추정.</text></svg>`}\n\nfunction draw(){\n let y=stageY(current);\n let html='', text='';\n if(drawing==='site'){\n  html=svgBase(`<path d=\"M110 90 L530 70 L560 355 L95 380 Z\" fill=\"#eef6ff\" stroke=\"#5b6e80\" stroke-width=\"3\"/>\n  <rect x=\"70\" y=\"40\" width=\"500\" height=\"360\" fill=\"none\" stroke=\"#9aa\" stroke-dasharray=\"8 8\"/>\n  <ellipse cx=\"320\" cy=\"230\" rx=\"78\" ry=\"92\" fill=\"rgba(95,208,255,.28)\" stroke=\"#1489b1\" stroke-width=\"4\"/>\n  <rect x=\"255\" y=\"292\" width=\"130\" height=\"58\" rx=\"12\" fill=\"rgba(246,200,95,.35)\" stroke=\"#a87400\" stroke-width=\"3\"/>\n  <path d=\"M320 230 L320 82\" stroke=\"#1a9f65\" stroke-width=\"4\"/><text x=\"332\" y=\"92\" font-size=\"16\" fill=\"#184\">555m 수직 기준축</text>\n  <text x=\"250\" y=\"224\" font-size=\"17\" fill=\"#123\">타워 풋프린트</text><text x=\"270\" y=\"328\" font-size=\"16\" fill=\"#123\">포디움 개념</text>`);\n  text='배치도는 대지 안에서 타워 풋프린트, 포디움, 555m 수직 기준축의 관계를 보여줍니다. 대지 경계와 도로 폭은 실제 측량값이 아니라 화면 구성을 위한 개념선입니다.';\n } else if(drawing==='plan'){\n  let r=130-current*10;\n  html=svgBase(`<g transform=\"translate(320 225)\">\n  <path d=\"M0 ${-r} C${r*.9} ${-r*.75} ${r} ${r*.65} 0 ${r} C${-r} ${r*.65} ${-r*.9} ${-r*.75} 0 ${-r}Z\" fill=\"rgba(95,208,255,.22)\" stroke=\"#1388b2\" stroke-width=\"5\"/>\n  <rect x=\"-38\" y=\"-58\" width=\"76\" height=\"116\" rx=\"12\" fill=\"rgba(159,243,199,.45)\" stroke=\"#16885d\" stroke-width=\"4\"/>\n  <path d=\"M-115 0H115M0-115V115\" stroke=\"#89a\" stroke-dasharray=\"7 7\"/>\n  <text x=\"-34\" y=\"6\" font-size=\"17\" fill=\"#123\">코어</text>\n  <text x=\"-120\" y=\"-138\" font-size=\"16\" fill=\"#123\">기준층 외곽: 상부로 갈수록 축소</text>\n  </g><path d=\"M130 405 H510\" stroke=\"#333\" stroke-width=\"3\"/><path d=\"M150 395v20M490 395v20\" stroke=\"#333\" stroke-width=\"3\"/>\n  <text x=\"236\" y=\"392\" font-size=\"15\" fill=\"#333\">외곽 폭: 비공개, 개념 비율</text>`);\n  text='기준층 평면도는 반복층의 외곽과 중앙 코어의 대응을 보여줍니다. 실제 코어 치수, 임대/호텔/전망층 구획은 공개 자료만으로 확정할 수 없어 단순화했습니다.';\n } else if(drawing==='elev'){\n  html=svgBase(`<line x1=\"105\" y1=\"385\" x2=\"535\" y2=\"385\" stroke=\"#334\" stroke-width=\"3\"/>\n  <path d=\"M260 385 C250 300 260 160 305 55 C350 160 390 300 380 385 Z\" fill=\"rgba(95,208,255,.22)\" stroke=\"#1388b2\" stroke-width=\"5\"/>\n  <path d=\"M305 55 L305 30\" stroke=\"#1388b2\" stroke-width=\"5\"/>\n  <rect x=\"224\" y=\"350\" width=\"192\" height=\"35\" fill=\"rgba(246,200,95,.35)\" stroke=\"#a87400\" stroke-width=\"3\"/>\n  <line x1=\"455\" y1=\"385\" x2=\"455\" y2=\"55\" stroke=\"#333\" stroke-width=\"2\"/><path d=\"M445 385h20M445 55h20\" stroke=\"#333\" stroke-width=\"2\"/>\n  <text x=\"468\" y=\"225\" font-size=\"18\" fill=\"#333\">555m</text>\n  <line x1=\"238\" y1=\"${y}\" x2=\"402\" y2=\"${y}\" stroke=\"#f0a000\" stroke-width=\"5\"/><text x=\"410\" y=\"${y+5}\" font-size=\"15\" fill=\"#8a5b00\">현재 단계 높이 대응</text>\n  <text x=\"190\" y=\"35\" font-size=\"16\" fill=\"#123\">완만한 테이퍼와 상부 첨탑 개념</text>`);\n  text='입면도는 전체 555m 높이, 123층 수직성, 위로 갈수록 좁아지는 외곽선을 보여줍니다. 노란 선은 선택 단계가 3D 모델의 어느 높이 감각과 대응하는지 나타냅니다.';\n } else {\n  html=svgBase(`<path d=\"M260 385 C250 300 260 160 305 55 C350 160 390 300 380 385 Z\" fill=\"rgba(95,208,255,.18)\" stroke=\"#1388b2\" stroke-width=\"4\"/>\n  <rect x=\"286\" y=\"92\" width=\"38\" height=\"293\" fill=\"rgba(159,243,199,.45)\" stroke=\"#16885d\" stroke-width=\"3\"/>\n  ${[1,2,3,4,5,6,7,8].map(i=>`<line x1=\"${260+i*7}\" y1=\"${385-i*36}\" x2=\"${380-i*4}\" y2=\"${385-i*36}\" stroke=\"#789\" stroke-width=\"1.5\"/>`).join('')}\n  <rect x=\"220\" y=\"350\" width=\"200\" height=\"35\" fill=\"rgba(246,200,95,.32)\" stroke=\"#a87400\" stroke-width=\"3\"/>\n  <text x=\"330\" y=\"230\" font-size=\"16\" fill=\"#184\">중앙 코어 개념</text><text x=\"425\" y=\"370\" font-size=\"15\" fill=\"#764\">포디움/저층부</text>\n  <text x=\"70\" y=\"80\" font-size=\"16\" fill=\"#123\">단면: 층 적층, 코어, 외피 테이퍼의 설명용 관계</text>`);\n  text='단면도는 층 적층과 중앙 코어, 저층 포디움, 테이퍼 외피의 개념적 관계를 보여줍니다. 구조 시스템·부재 크기·피난 동선은 공식 구조도면이 아니므로 표현하지 않았습니다.';\n }\n document.getElementById('drawing').innerHTML=html; document.getElementById('drawingText').textContent=text;\n}\nfunction stageY(n){return 385-(n/5)*330}\n\ndocument.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{drawing=b.dataset.drawing;document.querySelectorAll('.tab').forEach(x=>x.setAttribute('aria-selected','false'));b.setAttribute('aria-selected','true');draw();});\n\nlet scene,camera,renderer,controls,root,ghostGroup;\ninit3D(); setStage(5,true); animate();\n\nfunction init3D(){\n const canvas=document.getElementById('three');\n scene=new THREE.Scene(); scene.background=new THREE.Color(0x070b15);\n camera=new THREE.PerspectiveCamera(45,1,.1,5000); camera.position.set(430,360,720);\n renderer=new THREE.WebGLRenderer({canvas,antialias:true}); renderer.setPixelRatio(Math.min(devicePixelRatio,2));\n controls=new THREE.OrbitControls(camera,canvas); controls.enableDamping=true; controls.target.set(0,190,0);\n scene.add(new THREE.HemisphereLight(0xdff7ff,0x182030,1.5));\n const dl=new THREE.DirectionalLight(0xffffff,2.2); dl.position.set(300,650,420); scene.add(dl);\n const grid=new THREE.GridHelper(520,26,0x436184,0x223250); grid.position.y=0; scene.add(grid);\n root=new THREE.Group(); ghostGroup=new THREE.Group(); scene.add(ghostGroup,root);\n addAxes();\n window.addEventListener('resize',resize); resize();\n}\nfunction makeTower(s,mat){\n const g=new THREE.Group(), seg=96, levels=34, verts=[], faces=[];\n for(let j=0;j<=levels;j++){\n  const v=j/levels, height=H*v*s.scale, base=82*(1-.52*v)*(1+.05*Math.sin(v*Math.PI*2));\n  const neck=1-s.notch*.14*Math.sin(v*Math.PI);\n  for(let i=0;i<seg;i++){\n   const a=i/seg*Math.PI*2+s.twist*v, ceramic=1+.07*Math.cos(4*a+v*1.5);\n   const rx=base*ceramic*neck, rz=base*(.82+.08*Math.sin(2*a))*neck;\n   verts.push(new THREE.Vector3(Math.cos(a)*rx,height,Math.sin(a)*rz));\n  }\n }\n for(let j=0;j<levels;j++) for(let i=0;i<seg;i++){let a=j*seg+i,b=j*seg+(i+1)%seg,c=(j+1)*seg+(i+1)%seg,d=(j+1)*seg+i; faces.push(a,b,d,b,c,d);}\n const geo=new THREE.BufferGeometry().setFromPoints(verts); geo.setIndex(faces); geo.computeVertexNormals();\n const mesh=new THREE.Mesh(geo,mat); g.add(mesh);\n const core=new THREE.Mesh(new THREE.BoxGeometry(34,H*s.scale*.92,34),new THREE.MeshStandardMaterial({color:0x78f0bd,transparent:true,opacity:.35,roughness:.45}));\n core.position.y=H*s.scale*.46; g.add(core);\n const pod=new THREE.Mesh(new THREE.BoxGeometry(185,42,135),new THREE.MeshStandardMaterial({color:0xf6c85f,transparent:true,opacity:.55,roughness:.55}));\n pod.position.y=21; g.add(pod);\n if(s.tip){const cone=new THREE.Mesh(new THREE.ConeGeometry(13,55,32),new THREE.MeshStandardMaterial({color:0xcff7ff,metalness:.25,roughness:.2})); cone.position.y=H+27; g.add(cone);}\n return g;\n}\nfunction setStage(n,finalButton){\n current=n; range.value=n; rangeLabel.textContent=n+' / 5';\n [...stepsEl.children].forEach((b,i)=>b.classList.toggle('active',i+1===n));\n root.clear(); ghostGroup.clear();\n const mat=new THREE.MeshPhysicalMaterial({color:0x7bdcff,transparent:true,opacity:.72,roughness:.25,metalness:.08,clearcoat:.7});\n root.add(makeTower(stages[n-1],mat));\n if(showGhost){ stages.slice(0,n-1).forEach((s,i)=>{const gm=new THREE.MeshStandardMaterial({color:0xffffff,transparent:true,opacity:.08,wireframe:true}); const gg=makeTower(s,gm); ghostGroup.add(gg);});}\n document.getElementById('hudTitle').textContent=stages[n-1].t;\n document.getElementById('matchText').innerHTML=`<b>대응 관계</b><br>${stages[n-1].d}<br>도면의 노란 요소와 3D의 현재 매스가 같은 설계 단계를 가리킵니다.`;\n draw();\n}\nrange.oninput=()=>setStage(+range.value,false);\ndocument.getElementById('showFinal').onclick=()=>setStage(5,true);\ndocument.getElementById('toggleGhost').onclick=()=>{showGhost=!showGhost;setStage(current,false)};\ndocument.getElementById('resetView').onclick=()=>{camera.position.set(430,360,720);controls.target.set(0,190,0);controls.update();};\n\nfunction addAxes(){\n const mat=new THREE.LineBasicMaterial({color:0xf6c85f}); const pts=[new THREE.Vector3(-120,H,0),new THREE.Vector3(120,H,0)];\n scene.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts),mat));\n const hmat=new THREE.LineBasicMaterial({color:0x9ff3c7}); scene.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(120,0,0),new THREE.Vector3(120,H,0)]),hmat));\n}\nfunction resize(){const el=document.querySelector('.viewer'), w=el.clientWidth,h=el.clientHeight; renderer.setSize(w,h,false); camera.aspect=w/h; camera.updateProjectionMatrix();}\nfunction animate(){requestAnimationFrame(animate); controls.update(); renderer.render(scene,camera);}\ndocument.addEventListener('keydown',e=>{\n if(e.key>='1'&&e.key<='5') setStage(+