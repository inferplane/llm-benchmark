{
  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Lotte World Tower — 555 m Crown-Fit Study</title>\n<style>\n  :root{\n    --night:#07111f;\n    --ink:#eaf6ff;\n    --muted:#b9d8e8;\n    --glass:#9de8ff;\n    --glass2:#e6fbff;\n    --rose:#ff8fb8;\n    --amber:#ffd06a;\n    --line:rgba(234,246,255,.55);\n    --panel:rgba(6,18,32,.78);\n    --panel2:rgba(14,38,63,.78);\n    --good:#85ffc8;\n  }\n  *{box-sizing:border-box}\n  html,body{height:100%;margin:0}\n  body{\n    font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, \"Apple Color Emoji\",\"Segoe UI Emoji\";\n    color:var(--ink);\n    background:\n      radial-gradient(circle at 50% 15%, rgba(64,184,255,.20), transparent 34%),\n      radial-gradient(circle at 12% 84%, rgba(255,143,184,.16), transparent 28%),\n      linear-gradient(180deg,#08172a 0%,#050914 65%,#03050a 100%);\n    overflow:hidden;\n  }\n  main{\n    min-height:100%;\n    display:grid;\n    grid-template-columns: minmax(330px, 1fr) 360px;\n    gap:16px;\n    padding:18px;\n  }\n  .stage{\n    position:relative;\n    min-height:620px;\n    border:1px solid rgba(234,246,255,.22);\n    border-radius:28px;\n    background:\n      linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.015)),\n      radial-gradient(circle at 52% 72%, rgba(99,211,255,.10), transparent 34%);\n    box-shadow:0 24px 80px rgba(0,0,0,.42), inset 0 0 70px rgba(157,232,255,.08);\n    overflow:hidden;\n  }\n  .stage:before{\n    content:\"\";\n    position:absolute; inset:-40px;\n    background-image:\n      radial-gradient(circle, rgba(255,255,255,.75) 0 1px, transparent 1.8px),\n      radial-gradient(circle, rgba(157,232,255,.50) 0 1px, transparent 1.6px);\n    background-size:96px 96px,147px 147px;\n    background-position:11px 22px, 54px 18px;\n    opacity:.26;\n    pointer-events:none;\n  }\n  .caption{\n    position:absolute;\n    left:22px; top:18px;\n    z-index:2;\n    max-width:min(560px, calc(100% - 44px));\n    padding:14px 16px;\n    border-radius:20px;\n    background:rgba(3,10,20,.58);\n    border:1px solid rgba(234,246,255,.20);\n    backdrop-filter: blur(8px);\n  }\n  h1{\n    margin:0 0 6px;\n    font-size:clamp(25px,3vw,42px);\n    letter-spacing:.02em;\n    line-height:1.05;\n  }\n  .caption p{\n    margin:0;\n    font-size:19px;\n    line-height:1.35;\n    color:var(--muted);\n  }\n  svg{\n    position:absolute;\n    inset:0;\n    width:100%;\n    height:100%;\n    display:block;\n    overflow:visible;\n    touch-action:none;\n  }\n  text{\n    font-size:20px;\n    fill:var(--ink);\n    paint-order:stroke;\n    stroke:rgba(4,10,18,.78);\n    stroke-width:3px;\n    stroke-linejoin:round;\n    font-weight:650;\n  }\n  .axis text,.note text{font-size:20px}\n  .smallText{font-size:19px}\n  .controls{\n    display:flex;\n    flex-direction:column;\n    gap:14px;\n    min-width:0;\n  }\n  .panel{\n    border:1px solid rgba(234,246,255,.22);\n    border-radius:26px;\n    background:linear-gradient(180deg,var(--panel),rgba(4,12,24,.76));\n    box-shadow:0 18px 58px rgba(0,0,0,.35), inset 0 0 42px rgba(157,232,255,.05);\n    padding:16px;\n  }\n  h2{\n    margin:0 0 10px;\n    font-size:24px;\n    line-height:1.15;\n  }\n  .panel p,.readout,.hint{\n    font-size:19px;\n    line-height:1.38;\n    color:var(--muted);\n    margin:8px 0 0;\n  }\n  .readout strong{color:var(--ink)}\n  .buttonGrid{\n    display:grid;\n    grid-template-columns:1fr 1fr;\n    gap:10px;\n    margin-top:12px;\n  }\n  button{\n    appearance:none;\n    border:1px solid rgba(234,246,255,.28);\n    border-radius:16px;\n    color:var(--ink);\n    background:linear-gradient(180deg, rgba(42,102,150,.72), rgba(16,44,77,.80));\n    padding:12px 12px;\n    font-size:19px;\n    line-height:1.15;\n    font-weight:750;\n    cursor:pointer;\n    box-shadow:0 8px 18px rgba(0,0,0,.28);\n  }\n  button:hover,button:focus-visible{\n    outline:3px solid rgba(255,208,106,.75);\n    outline-offset:2px;\n  }\n  button[aria-pressed=\"true\"]{\n    border-color:rgba(133,255,200,.85);\n    background:linear-gradient(180deg, rgba(23,124,102,.86), rgba(10,62,74,.88));\n  }\n  .cameraGrid{\n    display:grid;\n    grid-template-columns:repeat(3,1fr);\n    gap:10px;\n    margin-top:12px;\n  }\n  .cameraGrid button:nth-child(1){grid-column:2}\n  .cameraGrid button:nth-child(2){grid-column:1}\n  .cameraGrid button:nth-child(3){grid-column:3}\n  .wide{grid-column:1 / -1}\n  .legend{\n    display:grid;\n    grid-template-columns:22px 1fr;\n    gap:9px 10px;\n    align-items:center;\n    margin-top:12px;\n    font-size:19px;\n    color:var(--muted);\n  }\n  .swatch{width:22px;height:22px;border-radius:7px;border:1px solid rgba(255,255,255,.35)}\n  .s1{background:linear-gradient(135deg,#69dfff,#e6fbff)}\n  .s2{background:linear-gradient(135deg,#ff8fb8,#ffd06a)}\n  .s3{background:linear-gradient(135deg,#85ffc8,#65a7ff)}\n  @media (max-width:900px){\n    body{overflow:auto}\n    main{grid-template-columns:1fr; padding:12px}\n    .stage{min-height:680px}\n    .controls{padding-bottom:12px}\n  }\n</style>\n</head>\n<body>\n<main>\n  <section class=\"stage\" aria-label=\"Interactive 3D height study of Lotte World Tower\">\n    <div class=\"caption\">\n      <h1>Lotte World Tower, drawn to 555 m</h1>\n      <p>The tapered glass body and crown are one complete 555 m form; the reset camera is pulled back to keep the full crown visible.</p>\n    </div>\n\n    <svg id=\"view\" viewBox=\"0 0 980 760\" role=\"img\" aria-labelledby=\"svgTitle svgDesc\">\n      <title id=\"svgTitle\">Lotte World Tower 555 metre massing diagram</title>\n      <desc id=\"svgDesc\">A stylized interactive tower model with elevation ticks, construction stages, and keyboard camera controls.</desc>\n\n      <defs>\n        <linearGradient id=\"skyGlow\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n          <stop offset=\"0\" stop-color=\"#dffaff\" stop-opacity=\".98\"/>\n          <stop offset=\".45\" stop-color=\"#83ddff\" stop-opacity=\".82\"/>\n          <stop offset=\"1\" stop-color=\"#276899\" stop-opacity=\".70\"/>\n        </linearGradient>\n        <linearGradient id=\"facetLeft\" x1=\"0\" x2=\"1\">\n          <stop offset=\"0\" stop-color=\"#387ca8\" stop-opacity=\".62\"/>\n          <stop offset=\".5\" stop-color=\"#a7efff\" stop-opacity=\".82\"/>\n          <stop offset=\"1\" stop-color=\"#eafbff\" stop-opacity=\".90\"/>\n        </linearGradient>\n        <linearGradient id=\"facetRight\" x1=\"0\" x2=\"1\">\n          <stop offset=\"0\" stop-color=\"#eafbff\" stop-opacity=\".92\"/>\n          <stop offset=\".48\" stop-color=\"#7cd6ff\" stop-opacity=\".76\"/>\n          <stop offset=\"1\" stop-color=\"#19466f\" stop-opacity=\".72\"/>\n        </linearGradient>\n        <linearGradient id=\"crown\" x1=\"0\" x2=\"1\" y1=\"0\" y2=\"1\">\n          <stop offset=\"0\" stop-color=\"#fff7d7\"/>\n          <stop offset=\".45\" stop-color=\"#9ff5ff\"/>\n          <stop offset=\"1\" stop-color=\"#ff8fb8\"/>\n        </linearGradient>\n        <radialGradient id=\"baseGlow\" cx=\"50%\" cy=\"50%\" r=\"55%\">\n          <stop offset=\"0\" stop-color=\"#7be8ff\" stop-opacity=\".60\"/>\n          <stop offset=\"1\" stop-color=\"#7be8ff\" stop-opacity=\"0\"/>\n        </radialGradient>\n        <filter id=\"soft\">\n          <feGaussianBlur stdDeviation=\"7\"/>\n        </filter>\n        <filter id=\"shine\">\n          <feDropShadow dx=\"0\" dy=\"0\" stdDeviation=\"5\" flood-color=\"#9de8ff\" flood-opacity=\".70\"/>\n        </filter>\n      </defs>\n\n      <g id=\"camera\">\n        <ellipse cx=\"490\" cy=\"666\" rx=\"290\" ry=\"56\" fill=\"url(#baseGlow)\" filter=\"url(#soft)\"/>\n        <g id=\"axis\" class=\"axis\">\n          <line x1=\"770\" y1=\"620\" x2=\"770\" y2=\"65\" stroke=\"rgba(234,246,255,.72)\" stroke-width=\"3\"/>\n          <line x1=\"752\" y1=\"620\" x2=\"800\" y2=\"620\" stroke=\"rgba(234,246,255,.72)\" stroke-width=\"3\"/>\n          <line x1=\"752\" y1=\"65\" x2=\"800\" y2=\"65\" stroke=\"rgba(234,246,255,.72)\" stroke-width=\"3\"/>\n          <text x=\"812\" y=\"626\">0 m</text>\n          <text x=\"812\" y=\"72\">555 m crown top</text>\n          <line x1=\"745\" y1=\"370\" x2=\"800\" y2=\"370\" stroke=\"rgba(255,208,106,.82)\" stroke-width=\"2.5\"/>\n          <text x=\"812\" y=\"377\">250 m sky band</text>\n          <line x1=\"745\" y1=\"115\" x2=\"800\" y2=\"115\" stroke=\"rgba(133,255,200,.82)\" stroke-width=\"2.5\"/>\n          <text x=\"812\" y=\"122\">505 m body shoulder</text>\n        </g>\n\n        <g id=\"tower\" filter=\"url(#shine)\">\n          <path id=\"shadow\" d=\"M352 624 C415 646 566 646 628 624 C592 604 387 604 352 624Z\" fill=\"rgba(0,0,0,.33)\"/>\n          <g id=\"stage1\">\n            <path d=\"M382 620 C397 520 420 396 450 236 C462 176 474 128 490 115 C506 128 518 176 530 236 C560 396 583 520 598 620 C552 638 428 638 382 620Z\" fill=\"url(#skyGlow)\" opacity=\".46\"/>\n            <path d=\"M490 115 C455 175 421 431 382 620 C424 637 459 635 490 625 Z\" fill=\"url(#facetLeft)\"/>\n            <path d=\"M490 115 C525 175 559 431 598 620 C556 637 521 635 490 625 Z\" fill=\"url(#facetRight)\"/>\n            <path d=\"M490 115 C470 205 466 520 490 625 C514 520 510 205 490 115Z\" fill=\"rgba(255,255,255,.22)\"/>\n          </g>\n\n          <g id=\"stage2\">\n            <path d=\"M407 452 C445 466 535 466 573 452 L598 620 C552 638 428 638 382 620Z\" fill=\"rgba(255,143,184,.19)\"/>\n            <path d=\"M415 520 C456 532 524 532 565 520\" fill=\"none\" stroke=\"rgba(255,208,106,.78)\" stroke-width=\"4\"/>\n            <path d=\"M399 584 C442 601 538 601 581 584\" fill=\"none\" stroke=\"rgba(255,208,106,.75)\" stroke-width=\"4\"/>\n          </g>\n\n          <g id=\"stage3\">\n            <path d=\"M450 236 C462 176 474 128 490 115 C506 128 518 176 530 236 C512 248 468 248 450 236Z\" fill=\"rgba(133,255,200,.18)\"/>\n            <path d=\"M438 304 C470 318 510 318 542 304\" fill=\"none\" stroke=\"rgba(133,255,200,.85)\" stroke-width=\"4\"/>\n            <path d=\"M429 360 C466 376 514 376 551 360\" fill=\"none\" stroke=\"rgba(133,255,200,.68)\" stroke-width=\"4\"/>\n          </g>\n\n          <g id=\"crownGroup\">\n            <path d=\"M490 65 L456 116 C472 126 508 126 524 116 Z\" fill=\"url(#crown)\"/>\n            <path d=\"M490 65 L490 126\" stroke=\"rgba(255,255,255,.90)\" stroke-width=\"4\"/>\n            <path d=\"M456 116 C471 104 508 104 524 116\" fill=\"none\" stroke=\"rgba(255,255,255,.80)\" stroke-width=\"3\"/>\n          </g>\n\n          <g opacity=\".48\">\n            <path d=\"M409 510 C458 526 522 526 571 510\" fill=\"none\" stroke=\"#eafbff\" stroke-width=\"2\"/>\n            <path d=\"M421 430 C463 444 517 444 559 430\" fill=\"none\" stroke=\"#eafbff\" stroke-width=\"2\"/>\n            <path d=\"M435 346 C469 358 511 358 545 346\" fill=\"none\" stroke=\"#eafbff\" stroke-width=\"2\"/>\n            <path d=\"M447 262 C473 272 507 272 533 262\" fill=\"none\" stroke=\"#eafbff\" stroke-width=\"2\"/>\n            <path d=\"M472 152 C482 157 498 157 508 152\" fill=\"none\" stroke=\"#eafbff\" stroke-width=\"2\"/>\n          </g>\n        </g>\n\n        <g class=\"note\">\n          <path d=\"M250 118 C315 90 392 76 454 75\" fill=\"none\" stroke=\"rgba(255,208,106,.78)\" stroke-width=\"3\" stroke-dasharray=\"9 8\"/>\n          <text x=\"82\" y=\"104\">50 m crown included</text>\n          <text x=\"82\" y=\"130\" class=\"smallText\">505 m body + 50 m crown = 555 m total</text>\n\n          <path d=\"M650 604 C704 606 737 613 770 620\" fill=\"none\" stroke=\"rgba(157,232,255,.68)\" stroke-width=\"3\" stroke-dasharray=\"8 7\"/>\n          <text x=\"92\" y=\"665\">Full tower fits inside reset view</text>\n        </g>\n      </g>\n    </svg>\n  </section>\n\n  <aside class=\"controls\" aria-label=\"Diagram controls\">\n    <section class=\"panel\">\n      <h2>Construction stages</h2>\n      <p>Choose a stage without losing the completed 555 m reference.</p>\n      <div class=\"buttonGrid\" id=\"stageButtons\">\n        <button type=\"button\" data-stage=\"1\" aria-pressed=\"false\">1 Structure</button>\n        <button type=\"button\" data-stage=\"2\" aria-pressed=\"false\">2 Podium</button>\n        <button type=\"button\" data-stage=\"3\" aria-pressed=\"false\">3 Upper glass</button>\n        <button type=\"button\" data-stage=\"4\" aria-pressed=\"true\">4 Complete</button>\n      </div>\n      <p class=\"readout\" id=\"stageReadout\"><strong>Complete:</strong> body and crown align to the 555 m elevation.</p>\n    </section>\n\n    <section class=\"panel\">\n      <h2>Camera orbit and zoom</h2>\n      <p>Native buttons and keyboard controls both move the camera.</p>\n      <div class=\"cameraGrid\">\n        <button type=\"button\" id=\"tiltUp\" aria-label=\"Tilt camera up\">Tilt ↑</button>\n        <button type=\"button\" id=\"orbitLeft\" aria-label=\"Orbit camera left\">Orbit ←</button>\n        <button type=\"button\" id=\"orbitRight\" aria-label=\"Orbit camera right\">Orbit →</button>\n        <button type=\"button\" id=\"tiltDown\" aria-label=\"Tilt camera down\">Tilt ↓</button>\n        <button type=\"button\" id=\"zoomIn\" aria-label=\"Zoom camera in\">Zoom +</button>\n        <button type=\"button\" id=\"zoomOut\" aria-label=\"Zoom camera out\">Zoom −</button>\n        <button type=\"button\" class=\"wide\" id=\"reset\">Reset full 555 m view</button>\n      </div>\n      <p class=\"hint\">Keyboard: Arrow keys orbit and tilt, +/− zoom, 1–4 stages, R reset.</p>\n      <p class=\"readout\" id=\"cameraReadout\"><strong>Camera:</strong> orbit 0°, tilt 0°, zoom 0.86×.</p>\n    </section>\n\n    <section class=\"panel\">\n      <h2>Legend</h2>\n      <div class=\"legend\">\n        <span class=\"swatch s1\"></span><span>Blue glass taper, expressive massing shell</span>\n        <span class=\"swatch s2\"></span><span>Warm crown and height annotations</span>\n        <span class=\"swatch s3\"></span><span>Stage highlights and elevation agreement</span>\n      </div>\n      <p>The model uses an artistic measured section: top of crown, not just the body, is the stated 555 m.</p>\n    </section>\n  </aside>\n</main>\n\n<script>\n(function(){\n  const camera = document.getElementById('camera');\n  const readout = document.getElementById('cameraReadout');\n  const stageReadout = document.getElementById('stageReadout');\n  const stages = [\n    document.getElementById('stage1'),\n    document.getElementById('stage2'),\n    document.getElementById('stage3'),\n    document.getElementById('crownGroup')\n  ];\n  const stageButtons = Array.from(document.querySelectorAll('[data-stage]'));\n  let orbit = 0;\n  let tilt = 0;\n  let zoom = 0.86;\n  let activeStage = 4;\n\n  function clamp(v,min,max){ return Math.max(min, Math.min(max, v)); }\n\n  function updateCamera(){\n    const sx = 1 + Math.sin(orbit * Math.PI / 180) * 0.16;\n    const skew = Math.sin(orbit * Math.PI / 180) * 6;\n    const ySquash = 1 - Math.abs(tilt) * 0.003;\n    camera.setAttribute(\n      'transform',\n      'translate(490 382) scale(' + zoom.toFixed(3) + ') skewX(' + skew.toFixed(2) + ') scale(' + sx.toFixed(3) + ' ' + ySquash.toFixed(3) + ') translate(-490 -382)'\n    );\n    readout.innerHTML = '<strong>Camera:</strong> orbit ' + orbit + '°, tilt ' + tilt + '°, zoom ' + zoom.toFixed(2) + '×.';\n  }\n\n  function updateStage(){\n    stages.forEach((g, i) => {\n      g.style.display = i < activeStage ? '' : 'none';\n    });\n    stageButtons.forEach(b => b.setAttribute('aria-pressed', String(Number(b.dataset.stage) === activeStage)));\n    const copy = [\n      '<strong>Structure:</strong> the tapered core begins the measured rise.',\n      '<strong>Podium:</strong> lower bands are added while the full 555 m ghost remains legible.',\n      '<strong>Upper glass:</strong> the shoulder reaches 505 m before the crown.',\n      '<strong>Complete:</strong> body and crown align to the 555 m elevation.'\n    ];\n    stageReadout.innerHTML = copy[activeStage - 1];\n  }\n\n  function reset(){\n    orbit = 0;\n    tilt = 0;\n    zoom = 0.86;\n    activeStage = 4;\n    updateCamera();\n    updateStage();\n  }\n\n  document.getElementById('orbitLeft').addEventListener('click', () => { orbit = clamp(orbit - 12, -36, 36); updateCamera(); });\n  document.getElementById('orbitRight').addEventListener('click', () => { orbit = clamp(orbit + 12, -36, 36); updateCamera(); });\n  document.getElementById('tiltUp').addEventListener('click', () => { tilt = clamp(tilt - 8, -24, 24); updateCamera(); });\n  document.getElementById('tiltDown').addEventListener('click', () => { tilt = clamp(tilt + 8, -24, 24); updateCamera(); });\n  document.getElementById('zoomIn').addEventListener('click', () => { zoom = clamp(zoom + 0.07, 0.70, 1.16); updateCamera(); });\n  document.getElementById('zoomOut').addEventListener('click', () => { zoom = clamp(zoom - 0.07, 0.70, 1.16); updateCamera(); });\n  document.getElementById('reset').addEventListener('click', reset);\n\n  stageButtons.forEach(button => {\n    button.addEventListener('click', () => {\n      activeStage = Number(button.dataset.stage);\n      updateStage();\n    });\n  });\n\n  window.addEventListener('keydown', (e) => {\n    if (e.target && /input|textarea|select|button/i.test(e.target.tagName)) return;\n    let used = true;\n    if (e.key === 'ArrowLeft') orbit = clamp(orbit - 12, -36, 36);\n    else if (e.key === 'ArrowRight') orbit = clamp(orbit + 12, -36, 36);\n    else if (e.key === 'ArrowUp') tilt = clamp(tilt - 8, -24, 24);\n    else if (e.key === 'ArrowDown') tilt = clamp(tilt + 8, -24, 24);\n    else if (e.key === '+' || e.key === '=') zoom = clamp(zoom + 0.07, 0.70, 1.16);\n    else if (e.key === '-' || e.key === '_') zoom = clamp(zoom - 0.07, 0.70, 1.16);\n    else if (/^[1-4]$/.test(e.key)) { activeStage = Number(e.key); updateStage(); used = false; }\n    else if (e.key === 'r' || e.key === 'R') { reset(); used = true; }\n    else used = false;\n\n    if (used) {\n      e.preventDefault();\n      updateCamera();\n    }\n  });\n\n  updateCamera();\n  updateStage();\n})();\n</script>\n</body>\n</html>",
