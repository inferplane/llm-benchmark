{
  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Lotte Tower — Night Signal</title>\n<style>\n  :root {\n    --ink: #f7f1df;\n    --muted: #d6cdb8;\n    --night: #07111f;\n    --panel: rgba(12, 25, 43, 0.88);\n    --line: #edb85f;\n    --cyan: #74e6e1;\n    --pink: #f27ca7;\n  }\n\n  * { box-sizing: border-box; }\n\n  html, body {\n    margin: 0;\n    min-height: 100%;\n    background: var(--night);\n    color: var(--ink);\n    font-family: Georgia, \"Times New Roman\", serif;\n  }\n\n  body {\n    overflow-x: hidden;\n  }\n\n  main {\n    width: min(1180px, 100%);\n    margin: 0 auto;\n    padding: 28px clamp(18px, 4vw, 56px) 48px;\n  }\n\n  header {\n    display: grid;\n    gap: 12px;\n    margin-bottom: 22px;\n  }\n\n  .eyebrow {\n    color: var(--cyan);\n    font-size: 19px;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n  }\n\n  h1 {\n    margin: 0;\n    max-width: 850px;\n    font-size: clamp(34px, 7vw, 76px);\n    line-height: .96;\n    font-weight: 500;\n    letter-spacing: -.035em;\n  }\n\n  .intro {\n    max-width: 760px;\n    margin: 0;\n    color: var(--muted);\n    font-size: 21px;\n    line-height: 1.45;\n  }\n\n  .tabs {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n    margin: 22px 0 14px;\n  }\n\n  button {\n    min-height: 48px;\n    padding: 10px 17px;\n    border: 1px solid var(--line);\n    border-radius: 999px;\n    background: transparent;\n    color: var(--ink);\n    cursor: pointer;\n    font: inherit;\n    font-size: 19px;\n  }\n\n  button:hover, button:focus-visible {\n    background: var(--line);\n    color: #101722;\n    outline: 3px solid var(--cyan);\n    outline-offset: 3px;\n  }\n\n  button[aria-selected=\"true\"] {\n    background: var(--line);\n    color: #101722;\n  }\n\n  .view {\n    display: none;\n  }\n\n  .view.active {\n    display: block;\n  }\n\n  .frame {\n    position: relative;\n    width: 100%;\n    height: clamp(390px, 58vw, 650px);\n    min-height: 390px;\n    overflow: hidden;\n    border: 1px solid rgba(237,184,95,.68);\n    border-radius: 18px;\n    background: #081426;\n    box-shadow: 0 18px 70px rgba(0,0,0,.34);\n  }\n\n  canvas {\n    display: block;\n    width: 100%;\n    height: 100%;\n    outline: none;\n  }\n\n  canvas:focus-visible {\n    box-shadow: inset 0 0 0 4px var(--cyan);\n  }\n\n  .caption {\n    display: grid;\n    gap: 8px;\n    margin-top: 14px;\n    color: var(--muted);\n    font-size: 19px;\n    line-height: 1.4;\n  }\n\n  .caption strong {\n    color: var(--ink);\n    font-size: 21px;\n    font-weight: 600;\n  }\n\n  .controls {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n    align-items: center;\n    margin-top: 15px;\n  }\n\n  .hint {\n    color: var(--muted);\n    font-size: 19px;\n    line-height: 1.4;\n    flex-basis: 100%;\n  }\n\n  @media (max-width: 520px) {\n    main { padding-inline: 14px; }\n    .frame { height: 480px; min-height: 360px; }\n    .controls button { flex: 1 1 44%; }\n  }\n</style>\n</head>\n<body>\n<main>\n  <header>\n    <div class=\"eyebrow\">Seoul / atmospheric study / 01</div>\n    <h1>Lotte Tower: a signal held in the night.</h1>\n    <p class=\"intro\">A quiet, luminous interpretation of the landmark as a tuning fork between earth and sky. Drag the scene, or use the keyboard camera controls to orbit through its changing weather.</p>\n  </header>\n\n  <nav class=\"tabs\" role=\"tablist\" aria-label=\"Artwork views\">\n    <button id=\"tab1\" role=\"tab\" aria-selected=\"true\" aria-controls=\"view1\">Signal view</button>\n    <button id=\"tab2\" role=\"tab\" aria-selected=\"false\" aria-controls=\"view2\">Completed view</button>\n  </nav>\n\n  <section id=\"view1\" class=\"view active\" role=\"tabpanel\" aria-labelledby=\"tab1\">\n    <div class=\"frame\">\n      <canvas id=\"scene1\" tabindex=\"0\" aria-label=\"Interactive night view of Lotte Tower. Use the arrow keys to rotate, plus and minus to zoom.\"></canvas>\n    </div>\n    <div class=\"caption\">\n      <strong>01 — The first transmission</strong>\n      <span>The tower rises as a slender amber frequency, while the river keeps the last blue of dusk.</span>\n    </div>\n    <div class=\"controls\" aria-label=\"Signal view controls\">\n      <button type=\"button\" data-action=\"left\">Rotate left</button>\n      <button type=\"button\" data-action=\"right\">Rotate right</button>\n      <button type=\"button\" data-action=\"in\">Zoom in</button>\n      <button type=\"button\" data-action=\"out\">Zoom out</button>\n      <span class=\"hint\">Keyboard: Left and Right rotate. Up and Down, or Plus and Minus, zoom.</span>\n    </div>\n  </section>\n\n  <section id=\"view2\" class=\"view\" role=\"tabpanel\" aria-labelledby=\"tab2\" hidden>\n    <div class=\"frame\">\n      <canvas id=\"scene2\" tabindex=\"0\" aria-label=\"Interactive completed night view of Lotte Tower. Use the arrow keys to rotate, plus and minus to zoom.\"></canvas>\n    </div>\n    <div class=\"caption\">\n      <strong>02 — The city answers</strong>\n      <span>When the signal completes its circuit, scattered windows become a constellation around the tower.</span>\n    </div>\n    <div class=\"controls\" aria-label=\"Completed view controls\">\n      <button type=\"button\" data-action=\"left\">Rotate left</button>\n      <button type=\"button\" data-action=\"right\">Rotate right</button>\n      <button type=\"button\" data-action=\"in\">Zoom in</button>\n      <button type=\"button\" data-action=\"out\">Zoom out</button>\n      <button type=\"button\" data-action=\"reset\">Reset camera</button>\n      <span class=\"hint\">Keyboard: Left and Right rotate. Up and Down, or Plus and Minus, zoom.</span>\n    </div>\n  </section>\n</main>\n\n<script>\n(() => {\n  const worlds = new Map();\n\n  function createWorld(canvas, completed) {\n    const ctx = canvas.getContext(\"2d\");\n    const state = { angle: completed ? 0.2 : -0.18, zoom: 1, completed };\n    let width = 1, height = 1, raf;\n\n    function resize() {\n      const box = canvas.getBoundingClientRect();\n      const ratio = Math.max(1, Math.min(2, window.devicePixelRatio || 1));\n      width = Math.max(1, box.width);\n      height = Math.max(1, box.height);\n      canvas.width = Math.round(width * ratio);\n      canvas.height = Math.round(height * ratio);\n      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);\n      draw();\n    }\n\n    function camera(action) {\n      if (action === \"left\") state.angle -= .13;\n      if (action === \"right\") state.angle += .13;\n      if (action === \"in\") state.zoom = Math.min(1.55, state.zoom + .1);\n      if (action === \"out\") state.zoom = Math.max(.72, state.zoom - .1);\n      if (action === \"reset\") {\n        state.angle = completed ? .2 : -.18;\n        state.zoom = 1;\n      }\n      draw();\n    }\n\n    function draw() {\n      cancelAnimationFrame(raf);\n      raf = requestAnimationFrame(() => {\n        const w = width, h = height;\n        const horizon = h * .70;\n        const scale = Math.min(w / 900, h / 650) * state.zoom;\n        const cx = w * .52 + Math.sin(state.angle) * w * .12;\n        const towerH = 475 * scale;\n        const baseY = horizon + 18;\n        const topY = baseY - towerH;\n\n        const sky = ctx.createLinearGradient(0, 0, 0, h);\n        sky.addColorStop(0, completed ? \"#101d46\" : \"#081b35\");\n        sky.addColorStop(.58, completed ? \"#263c68\" : \"#123553\");\n        sky.addColorStop(1, \"#090f20\");\n        ctx.fillStyle = sky;\n        ctx.fillRect(0, 0, w, h);\n\n        ctx.fillStyle = \"rgba(116,230,225,.12)\";\n        ctx.beginPath();\n        ctx.arc(w * .78, h * .19, Math.min(w,h) * .12, 0, Math.PI * 2);\n        ctx.fill();\n\n        const stars = completed ? 80 : 46;\n        for (let i = 0; i < stars; i++) {\n          const x = (i * 83 + 31) % w;\n          const y = 25 + ((i * 47) % Math.max(40, horizon - 70));\n          ctx.fillStyle = i % 5 === 0 ? \"#edb85f\" : \"rgba(215,235,235,.72)\";\n          ctx.fillRect(x, y, i % 5 === 0 ? 2.5 : 1.5, i % 5 === 0 ? 2.5 : 1.5);\n        }\n\n        ctx.fillStyle = \"#07101c\";\n        ctx.beginPath();\n        ctx.moveTo(0, horizon);\n        for (let x = 0; x <= w; x += 34) {\n          const bh = 18 + ((x * 13) % 95);\n          ctx.lineTo(x, horizon - bh);\n          ctx.lineTo(x + 25, horizon - bh);\n        }\n        ctx.lineTo(w, h); ctx.lineTo(0, h); ctx.closePath(); ctx.fill();\n\n        ctx.fillStyle = \"rgba(27,74,98,.65)\";\n        ctx.fillRect(0, horizon, w, h - horizon);\n        ctx.strokeStyle = \"rgba(116,230,225,.26)\";\n        ctx.lineWidth = 1;\n        for (let y = horizon + 26; y < h; y += 27) {\n          ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(w,y); ctx.stroke();\n        }\n\n        ctx.save();\n        ctx.translate(cx, 0);\n        ctx.shadowColor = completed ? \"#f27ca7\" : \"#edb85f\";\n        ctx.shadowBlur = 24;\n\n        const half = 73 * scale;\n        const body = ctx.createLinearGradient(-half, 0, half, 0);\n        body.addColorStop(0, \"#613c52\");\n        body.addColorStop(.22, \"#d18a58\");\n        body.addColorStop(.5, \"#ffe19a\");\n        body.addColorStop(.78, \"#c76b65\");\n        body.addColorStop(1, \"#412c4d\");\n        ctx.fillStyle = body;\n        ctx.beginPath();\n        ctx.moveTo(-half * .64, baseY);\n        ctx.lineTo(-half * .30, topY + 92 * scale);\n        ctx.quadraticCurveTo(0, topY, half * .30, topY + 92 * scale);\n        ctx.lineTo(half * .64, baseY);\n        ctx.closePath(); ctx.fill();\n\n        ctx.shadowBlur = 0;\n        ctx.strokeStyle = \"rgba(255,240,185,.76)\";\n        ctx.lineWidth = Math.max(1, 2 * scale);\n        for (let i = -2; i <= 2; i++) {\n          ctx.beginPath();\n          ctx.moveTo(i * 19 * scale, baseY);\n          ctx.lineTo(i * 9 * scale, topY + 74 * scale);\n          ctx.stroke();\n        }\n\n        ctx.fillStyle = completed ? \"#f27ca7\" : \"#74e6e1\";\n        ctx.fillRect(-3 * scale, topY - 63 * scale, 6 * scale, 72 * scale);\n        ctx.beginPath();\n        ctx.arc(0, topY - 69 * scale, 7 * scale, 0, Math.PI * 2);\n        ctx.fill();\n\n        if (completed) {\n          ctx.strokeStyle = \"rgba(242,124,167,.45)\";\n          ctx.lineWidth = 2;\n          ctx.beginPath();\n          ctx.arc(0, topY + 80 * scale, 150 * scale, Math.PI * 1.08, Math.PI * 1.92);\n          ctx.stroke();\n        }\n        ctx.restore();\n\n        ctx.fillStyle = \"rgba(237,184,95,.8)\";\n        for (let i = 0; i < 16; i++) {\n          const x = (i * 71 + 18) % w;\n          ctx.fillRect(x, horizon + 12 + (i % 4) * 18, 3, 2);\n        }\n\n        ctx.fillStyle = \"rgba(7,13,26,.55)\";\n        ctx.fillRect(0, h - 34, w, 34);\n        ctx.fillStyle = \"#d6cdb8\";\n        ctx.font = \"19px Georgia\";\n        ctx.fillText(completed ? \"TRANSMISSION COMPLETE\" : \"LISTENING FOR THE CITY\", 18, h - 11);\n      });\n    }\n\n    canvas.addEventListener(\"keydown\", e => {\n      const keys = [\"ArrowLeft\",\"ArrowRight\",\"ArrowUp\",\"ArrowDown\",\"+\",\"=\",\"-\",\"_\",\"0\"];\n      if (!keys.includes(e.key)) return;\n      e.preventDefault();\n      if (e.key === \"ArrowLeft\") camera(\"left\");\n      if (e.key === \"ArrowRight\") camera(\"right\");\n      if (e.key === \"ArrowUp\" || e.key === \"+\" || e.key === \"=\") camera(\"in\");\n      if (e.key === \"ArrowDown\" || e.key === \"-\" || e.key === \"_\") camera(\"out\");\n      if (e.key === \"0\") camera(\"reset\");\n    });\n\n    let dragging = false, lastX = 0;\n    canvas.addEventListener(\"pointerdown\", e => { dragging = true; lastX = e.clientX; canvas.setPointerCapture(e.pointerId); });\n    canvas.addEventListener(\"pointermove\", e => {\n      if (!dragging) return;\n      state.angle += (e.clientX - lastX) * .006;\n      lastX = e.clientX;\n      draw();\n    });\n    canvas.addEventListener(\"pointerup\", () => dragging = false);\n    canvas.addEventListener(\"pointercancel\", () => dragging = false);\n    new ResizeObserver(resize).observe(canvas);\n    resize();\n    return { camera, reset: () => camera(\"reset\") };\n  }\n\n  const canvas1 = document.getElementById(\"scene1\");\n  const canvas2 = document.getElementById(\"scene2\");\n  worlds.set(\"view1\", createWorld(canvas1, false));\n  worlds.set(\"view2\", createWorld(canvas2, true));\n\n  function show(id) {\n    document.querySelectorAll(\".view\").forEach(view => {\n      const on = view.id === id;\n      view.classList.toggle(\"active\", on);\n      view.hidden = !on;\n    });\n    document.querySelectorAll('[role=\"tab\"]').forEach(tab => {\n      tab.setAttribute(\"aria-selected\", tab.getAttribute(\"aria-controls\") === id ? \"true\" : \"false\");\n    });\n    worlds.get(id).reset();\n  }\n\n  document.querySelectorAll('[role=\"tab\"]').forEach(tab => {\n    tab.addEventListener(\"click\", () => show(tab.getAttribute(\"aria-controls\")));\n  });\n\n  document.querySelectorAll(\".controls\").forEach(controlGroup => {\n    controlGroup.addEventListener(\"click\", e => {\n      const button = e.target.closest(\"button\");\n      if (!button) return;\n      const view = controlGroup.closest(\".view\");\n      const world = worlds.get(view.id);\n      if (button.dataset.action === \"reset\") world.reset();\n      else world.camera(button.dataset.action);\n    });\n  });\n})();\n</script>\n</body>\n</html>",
