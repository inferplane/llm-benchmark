{
  "text": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\" />\n  <title>롯데월드타워 설계 과정 · 개념 3D 아틀라스</title>\n  <script src=\"../runtime/three-runtime.js\"></script>\n  <style>\n    :root{\n      --ink:#15212b; --muted:#61707c; --paper:#f4f1ea; --panel:#fffdf8;\n      --line:#c8d0d2; --blue:#157c92; --blue2:#0d5063; --gold:#b97d2d;\n      --red:#b94d43; --grid:#dfe4e2; --dark:#12212a;\n    }\n    *{box-sizing:border-box}\n    html{scroll-behavior:smooth}\n    body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,\"Apple SD Gothic Neo\",\"Malgun Gothic\",sans-serif;line-height:1.5}\n    button,a{font:inherit}\n    button{cursor:pointer}\n    a{color:var(--blue2)}\n    .topbar{\n      background:var(--dark);color:#fff;padding:14px clamp(16px,3vw,42px);\n      display:flex;gap:18px;align-items:center;justify-content:space-between;flex-wrap:wrap;\n      border-bottom:4px solid var(--gold)\n    }\n    .brand{display:flex;align-items:center;gap:12px}\n    .brand-mark{width:34px;height:34px;border:1px solid #d9b36e;position:relative}\n    .brand-mark:after{content:\"\";position:absolute;left:14px;bottom:0;width:5px;height:29px;background:#d9b36e;clip-path:polygon(50% 0,100% 100%,0 100%)}\n    .brand h1{font-size:16px;margin:0;letter-spacing:.03em}\n    .brand small{display:block;color:#b5c8cc;font-size:11px;letter-spacing:.08em}\n    .tag{font-size:12px;padding:5px 9px;border:1px solid #49606a;border-radius:99px;color:#d8e7e8}\n    main{max-width:1540px;margin:auto;padding:22px clamp(14px,3vw,38px) 50px}\n    .intro{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(260px,.8fr);gap:22px;align-items:end;margin:4px 0 25px}\n    .eyebrow{font-size:12px;color:var(--blue2);font-weight:bold;letter-spacing:.12em;text-transform:uppercase}\n    h2{font-size:clamp(25px,3.2vw,43px);line-height:1.15;margin:5px 0 10px;letter-spacing:-.04em}\n    .intro p{max-width:850px;margin:0;color:#40515c}\n    .notice{border-left:4px solid var(--gold);background:#fff8eb;padding:13px 16px;font-size:13px;color:#55452d}\n    .stage-nav{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 15px}\n    .stage-btn{background:var(--panel);border:1px solid var(--line);color:var(--ink);padding:9px 13px;border-radius:4px;text-align:left;min-width:142px}\n    .stage-btn span{display:block;color:var(--muted);font-size:11px}\n    .stage-btn.active{background:var(--blue2);color:white;border-color:var(--blue2)}\n    .stage-btn.active span{color:#b9e0e5}\n    .main-grid{display:grid;grid-template-columns:minmax(380px,1.17fr) minmax(330px,.83fr);gap:18px}\n    .card{background:var(--panel);border:1px solid #d8d9d2;box-shadow:0 5px 18px #2430390b}\n    .card-head{padding:14px 17px 10px;border-bottom:1px solid #e4e4de;display:flex;justify-content:space-between;align-items:flex-start;gap:10px}\n    .card-head h3{font-size:16px;margin:0}\n    .card-head p{font-size:12px;color:var(--muted);margin:2px 0 0}\n    .status{font-size:11px;color:var(--blue2);background:#e5f2f3;padding:3px 7px;white-space:nowrap}\n    #sceneWrap{height:590px;position:relative;background:linear-gradient(145deg,#e5ece9,#bac8cc);overflow:hidden}\n    #scene{width:100%;height:100%}\n    #scene canvas{display:block;width:100%;height:100%}\n    .scene-label{position:absolute;left:16px;top:15px;background:#ffffffdb;padding:8px 10px;border-left:3px solid var(--gold);font-size:12px;pointer-events:none}\n    .scene-label strong{display:block;font-size:14px}\n    .scene-controls{position:absolute;right:12px;bottom:12px;display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}\n    .scene-controls button{border:1px solid #9eafb3;background:#fffc;color:var(--ink);padding:7px 9px;border-radius:3px;font-size:12px}\n    .scene-controls button:hover{background:#fff}\n    .legend{position:absolute;left:15px;bottom:13px;font-size:11px;background:#ffffffcf;padding:7px 9px}\n    .dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:4px;background:var(--gold)}\n    .steps{padding:14px 17px}\n    .step-title{font-size:21px;margin:0 0 5px;line-height:1.2}\n    .steps p{margin:0 0 13px;font-size:13px;color:#40515c}\n    .metrics{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:13px 0}\n    .metric{background:#f1f5f4;padding:9px 10px;border-left:3px solid #7da1a6}\n    .metric b{font-size:17px;display:block}\n    .metric span{font-size:11px;color:var(--muted)}\n    .correspond{background:#f9f5eb;border:1px solid #e7d9b9;padding:12px;font-size:12px}\n    .correspond strong{display:block;color:#76541e;margin-bottom:4px}\n    .draw-card{margin-top:18px}\n    .drawing-tabs{padding:11px 14px 0;display:flex;gap:6px;flex-wrap:wrap}\n    .draw-tab{border:1px solid var(--line);background:#f6f5f0;padding:7px 9px;font-size:12px;color:#40515c}\n    .draw-tab.active{color:#fff;background:var(--blue2);border-color:var(--blue2)}\n    .drawing-body{padding:8px 14px 14px}\n    #drawing{width:100%;height:355px;display:block;background:#fbfaf5;border:1px solid #e2e2dc}\n    .drawing-note{font-size:12px;color:var(--muted);margin:8px 1px 0}\n    .bottom-grid{margin-top:18px;display:grid;grid-template-columns:1fr 1fr;gap:18px}\n    .info-card{padding:18px}\n    .info-card h3{margin:0 0 8px;font-size:16px}\n    .info-card p,.info-card li{font-size:13px;color:#465762}\n    .info-card ul{padding-left:18px;margin:8px 0}\n    .key{display:inline-block;width:10px;height:10px;margin-right:6px;background:var(--blue)}\n    .source{font-size:12px;color:var(--muted);word-break:break-all}\n    footer{margin-top:22px;border-top:1px solid var(--line);padding-top:13px;font-size:11px;color:var(--muted)}\n    kbd{font-size:11px;border:1px solid #adb9bb;border-bottom-width:2px;border-radius:3px;background:#fff;padding:1px 4px;color:#334}\n    @media(max-width:920px){.main-grid,.intro{grid-template-columns:1fr}.intro{gap:12px}#sceneWrap{height:480px}.bottom-grid{grid-template-columns:1fr}}\n    @media(max-width:520px){main{padding:14px 10px 35px}.topbar{padding:11px 13px}.tag{display:none}#sceneWrap{height:410px}.stage-btn{flex:1;min-width:130px}.metrics{grid-template-columns:1fr 1fr}#drawing{height:290px}}\n    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}\n  </style>\n</head>\n<body>\n  <header class=\"topbar\">\n    <div class=\"brand\">\n      <div class=\"brand-mark\" aria-hidden=\"true\"></div>\n      <div><h1>롯데월드타워 · 설계 과정 아틀라스</h1><small>CONCEPTUAL DRAWING + 3D STUDY</small></div>\n    </div>\n    <div class=\"tag\">model · gpt-5.6-terra</div>\n  </header>\n\n  <main>\n    <section class=\"intro\">\n      <div>\n        <div class=\"eyebrow\">555 m / 123 floors / Seoul</div>\n        <h2>도면에서 올라오는<br>테이퍼형 수직 도시</h2>\n        <p>배치·평면·입면·단면의 읽는 법과 단계별 매스를 한 화면에서 연결한 설명용 재구성입니다. 아래 버튼으로 설계 단계를 바꾸면 3D 형상과 도면의 강조 영역이 함께 갱신됩니다.</p>\n      </div>\n      <aside class=\"notice\">\n        <strong>중요한 구분</strong><br>\n        높이 555m, 지상 123층은 공개된 공통 기준입니다. 그 밖의 폭·코어·층고·주변 배치 및 모든 선은 교육용 <b>추정 개념</b>이며, 공식 시공도면·구조도 또는 검증된 단면이 아닙니다.\n      </aside>\n    </section>\n\n    <nav class=\"stage-nav\" aria-label=\"설계 단계 선택\">\n      <button class=\"stage-btn active\" data-stage=\"0\"><b>01 · 도시 매스</b><span>직육면체 기준량</span></button>\n      <button class=\"stage-btn\" data-stage=\"1\"><b>02 · 점진적 테이퍼</b><span>층 면적의 감소</span></button>\n      <button class=\"stage-btn\" data-stage=\"2\"><b>03 · 도자기 선</b><span>곡면과 모서리 정리</span></button>\n      <button class=\"stage-btn\" data-stage=\"3\"><b>04 · 완성 형상</b><span>상부 첨탑까지</span></button>\n    </nav>\n\n    <section class=\"main-grid\">\n      <article class=\"card\">\n        <div class=\"card-head\">\n          <div><h3>단계별 3D 형상</h3><p>드래그 회전 · 휠/핀치 확대 · 두 손가락 이동</p></div>\n          <span class=\"status\" id=\"modeStatus\">01 MASSING</span>\n        </div>\n        <div id=\"sceneWrap\">\n          <div id=\"scene\" aria-label=\"선택한 설계 단계의 3D 모델\"></div>\n          <div class=\"scene-label\"><strong id=\"sceneStage\">01 · 도시 매스</strong><span id=\"sceneSub\">555m 높이의 기준량을 세우다</span></div>\n          <div class=\"legend\"><span class=\"dot\"></span>금색 = 현재 단계 &nbsp; <span style=\"color:#6f8990\">회색선 = 123개 층의 개념적 분할</span></div>\n          <div class=\"scene-controls\">\n            <button id=\"viewFront\" title=\"정면 보기\">정면</button>\n            <button id=\"viewSide\" title=\"측면 보기\">측면</button>\n            <button id=\"viewTop\" title=\"위에서 보기\">평면</button>\n            <button id=\"resetView\" title=\"기본 시점으로 초기화\">시점 초기화</button>\n          </div>\n        </div>\n      </article>\n\n      <article class=\"card\">\n        <div class=\"card-head\"><div><h3>선택 단계의 설계 논리</h3><p>도면의 강조 표식과 같은 색으로 연결됩니다.</p></div></div>\n        <div class=\"steps\">\n          <h4 class=\"step-title\" id=\"stepTitle\">도시 매스: 높이의 기준량</h4>\n          <p id=\"stepText\"></p>\n          <div class=\"metrics\">\n            <div class=\"metric\"><b id=\"metric1\">555 m</b><span id=\"metric1label\">공개 기준 높이</span></div>\n            <div class=\"metric\"><b id=\"metric2\">123층</b><span id=\"metric2label\">공개 기준 지상층</span></div>\n          </div>\n          <div class=\"correspond\">\n            <strong>도면 ↔ 모델 대응</strong>\n            <span id=\"correspondText\"></span>\n          </div>\n        </div>\n      </article>\n    </section>\n\n    <section class=\"card draw-card\">\n      <div class=\"card-head\">\n        <div><h3>설명용 도면 세트</h3><p>현재 선택 단계가 청록·금색으로 강조됩니다. 치수 표기는 근거를 분리해 읽습니다.</p></div>\n        <span class=\"status\">SVG · 개념 도면</span>\n      </div>\n      <div class=\"drawing-tabs\" role=\"tablist\">\n        <button class=\"draw-tab active\" data-draw=\"site\">배치도</button>\n        <button class=\"draw-tab\" data-draw=\"plan\">기준층 평면도</button>\n        <button class=\"draw-tab\" data-draw=\"elevation\">입면도</button>\n        <button class=\"draw-tab\" data-draw=\"section\">단면도</button>\n      </div>\n      <div class=\"drawing-body\">\n        <svg id=\"drawing\" viewBox=\"0 0 900 390\" role=\"img\" aria-label=\"건축 개념 도면\"></svg>\n        <p class=\"drawing-note\" id=\"drawingNote\"></p>\n      </div>\n    </section>\n\n    <section class=\"bottom-grid\">\n      <article class=\"card info-card\">\n        <h3>읽는 순서</h3>\n        <ul>\n          <li><span class=\"key\"></span><b>배치도</b>: 도시 블록 안의 탑 위치와 기준 방향을 봅니다.</li>\n          <li><span class=\"key\"></span><b>기준층 평면</b>: 외곽과 중앙 코어의 관계를 봅니다. 폭은 공개 수치가 아닌 개념값입니다.</li>\n          <li><span class=\"key\"></span><b>입면·단면</b>: 555m / 123층이라는 공개 기준과 위로 좁아지는 경향을 비교합니다.</li>\n          <li>3D에서 <kbd>1</kbd>~<kbd>4</kbd>로 단계 변경, <kbd>R</kbd>로 시점 초기화가 가능합니다.</li>\n        </ul>\n      </article>\n      <article class=\"card info-card\">\n        <h3>자료 범위와 출처</h3>\n        <p>KPF는 타워의 형태와 외관이 한국 도자기의 선에서 영감을 받았다고 설명합니다. 이 페이지는 그 설명과 공개 기본 수치를 바탕으로 만든 독립적인 시각적 학습 모델입니다.</p>\n        <p class=\"source\">원 설계사: <a href=\"https://www.kpf.com/project/lotte-world-tower\" target=\"_blank\" rel=\"noopener\">kpf.com/project/lotte-world-tower</a><br>\n        구조 설계사: <a href=\"https://www.lera.com/lotte-world-tower\" target=\"_blank\" rel=\"noopener\">lera.com/lotte-world-tower</a></p>\n      </article>\n    </section>\n    <footer>표현 범위: 공개 정보 기반의 개념 재구성. 실제 외피 패널, 구조 부재, 코어 구성, 정확한 층별 면적 및 시공 치수는 본 화면에 제시하지 않습니다.</footer>\n  </main>\n\n<script>\n(() => {\n  const stages = [\n    {\n      name:\"01 · 도시 매스\", code:\"01 MASSING\", sub:\"555m 높이의 기준량을 세우다\",\n      title:\"도시 매스: 높이의 기준량\",\n      text:\"먼저 공개 기준인 555m와 지상 123층을 하나의 수직 기준량으로 놓습니다. 이 단계는 최종 외곽선을 주장하지 않고, 도시 속 높이와 비례를 비교하기 위한 출발점입니다.\",\n      m1:\"555 m\", l1:\"공개 기준 높이\", m2:\"123층\", l2:\"공개 기준 지상층\",\n      corr:\"입면도의 직선 외곽과 단면의 균등한 층선이 3D의 단순 기준 매스에 대응합니다.\"\n    },\n    {\n      name:\"02 · 점진적 테이퍼\", code:\"02 TAPER\", sub:\"높이에 따라 기준층 외곽을 줄이다\",\n      title:\"점진적 테이퍼: 면적의 감소\",\n      text:\"위로 갈수록 기준층 면적과 외곽이 좁아지는 공개적 특징을 연속적인 테이퍼로 번역합니다. 각 높이의 정확한 폭은 공개 도면이 아니므로 이 화면에서는 비율만 추정해 표시합니다.\",\n      m1:\"상부 축소\", l1:\"공개 특징의 개념화\", m2:\"72 m\", l2:\"저층 폭 · 추정 개념\",\n      corr:\"평면도의 안쪽 외곽과 입면의 기울어진 선이, 3D에서 위로 줄어드는 단면 변화에 대응합니다.\"\n    },\n    {\n      name:\"03 · 도자기 선\", code:\"03 CERAMIC LINE\", sub:\"한국 도자기에서 참조한 부드러운 선\",\n      title:\"도자기 선: 모서리와 곡률의 조정\",\n      text:\"KPF가 언급한 한국 도자기의 선이라는 참조를 따라, 단순 테이퍼의 모서리를 부드럽게 다듬고 높이별 수축 속도에 완만한 변화를 주었습니다. 이는 형태 언어의 설명이지 외피 제작도는 아닙니다.\",\n      m1:\"곡률 조정\", l1:\"형태 언어 · 개념\", m2:\"4면 모서리\", l2:\"둥근 외곽 · 추정\",\n      corr:\"입면의 완만한 곡선과 평면의 둥근 모서리 표기가 3D의 연속적인 외피 윤곽으로 이어집니다.\"\n    },\n    {\n      name:\"04 · 완성 형상\", code:\"04 FINAL FORM\", sub:\"테이퍼, 상부 크라운, 첨탑의 통합\",\n      title:\"완성 형상: 수직선의 마감\",\n      text:\"하부의 넓은 기반, 점진적으로 수축하는 몸체, 상부의 가늘어진 크라운과 첨탑을 한 개념 모델로 통합했습니다. 이것은 공개 사진과 설명을 읽기 위한 완성 형상이며, 실측 BIM·시공 모델이 아닙니다.\",\n      m1:\"555 m\", l1:\"공개 기준 높이\", m2:\"123층\", l2:\"공개 기준 지상층\",\n      corr:\"배치·평면·입면·단면의 금색 강조가 통합된 3D 형상의 해당 높이 및 윤곽과 대응합니다.\"\n    }\n  ];\n  let stage = 0, drawMode = \"site\";\n  const $ = s => document.querySelector(s);\n  const svg = $(\"#drawing\");\n\n  const NS=\"http://www.w3.org/2000/svg\";\n  function el(tag, attrs={}, text=\"\"){\n    const x=document.createElementNS(NS,tag);\n    Object.entries(attrs).forEach(([k,v])=>x.setAttribute(k,v));\n    if(text) x.textContent=text;\n    return x;\n  }\n  function add(tag,a,t){const n=el(tag,a,t);svg.appendChild(n);return n}\n  function line(x1,y1,x2,y2,cls=\"line\"){return add(\"line\",{x1,y1,x2,y2,class:cls})}\n  function txt(x,y,t,cls=\"label\",anchor=\"start\"){return add(\"text\",{x,y,class:cls,\"text-anchor\":anchor},t)}\n  function defs(){\n    svg.innerHTML=`<defs>\n      <pattern id=\"grid\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\"><path d=\"M20 0H0V20\" fill=\"none\" stroke=\"#e3e7e4\" stroke-width=\"1\"/></pattern>\n      <marker id=\"arrow\" markerWidth=\"7\" markerHeight=\"7\" refX=\"3.5\" refY=\"3.5\" orient=\"auto\"><path d=\"M0,0 L7,3.5 L0,7z\" fill=\"#607780\"/></marker>\n      <style>\n       .title{font:700 16px Arial,sans-serif;fill:#15212b}.label{font:12px Arial,sans-serif;fill:#40515c}.small{font:10px Arial,sans-serif;fill:#61707c}.dim{font:11px Arial,sans-serif;fill:#0d5063}.line{stroke:#789097;stroke-width:1.1;fill:none}.heavy{stroke:#15212b;stroke-width:2;fill:none}.accent{stroke:#b97d2d;stroke-width:3;fill:none}.dash{stroke:#789097;stroke-width:1;stroke-dasharray:4 3;fill:none}.fill{fill:#e6f0f0;stroke:#15212b;stroke-width:1.5}.core{fill:#d9e7e8;stroke:#157c92;stroke-width:1.2}.road{fill:#ece8dd;stroke:#c7c1b4}.water{fill:#deedf0;stroke:#9ac4ca}\n      </style></defs>`;\n  }\n  function dim(x1,y1,x2,y2,label, vertical=false){\n    add(\"line\",{x1,y1,x2,y2,stroke:\"#0d5063\",\"stroke-width\":\"1\",\"marker-start\":\"url(#arrow)\",\"marker-end\":\"url(#arrow)\"});\n    txt((x1+x2)/2+(vertical?9:0),(y1+y2)/2-4,label,\"dim\",vertical?\"start\":\"middle\");\n  }\n  function towerPath(cx, baseY, H, variant){\n    const top=baseY-H;\n    if(variant===0) return `M${cx-45},${baseY} L${cx-45},${top} L${cx+45},${top} L${cx+45},${baseY}Z`;\n    if(variant===1) return `M${cx-50},${baseY} C${cx-47},${baseY-70} ${cx-31},${top+58} ${cx-17},${top} L${cx+17},${top} C${cx+31},${top+58} ${cx+47},${baseY-70} ${cx+50},${baseY}Z`;\n    return `M${cx-52},${baseY} C${cx-49},${baseY-55} ${cx-40},${baseY-150} ${cx-25},${baseY-220} C${cx-16},${baseY-267} ${cx-11},${top+28} ${cx-5},${top+16} L${cx},${top} L${cx+5},${top+16} C${cx+11},${top+28} ${cx+16},${baseY-267} ${cx+25},${baseY-220} C${cx+40},${baseY-150} ${cx+49},${baseY-55} ${cx+52},${baseY}Z`;\n  }\n  function draw(){\n    defs();\n    add(\"rect\",{x:0,y:0,width:900,height:390,fill:\"url(#grid)\"});\n    if(drawMode===\"site\"){\n      txt(28,30,\"배치도 · 개념적 도시 맥락\",\"title\"); txt(28,48,\"북쪽 ↑ / 건물 위치와 방향만을 설명하는 비축척 도식\",\"small\");\n      add(\"rect\",{x:55,y:75,width:790,height:265,class:\"road\"});\n      add(\"rect\",{x:83,y:99,width:320,height:74,fill:\"#f8f7f1\",stroke:\"#c7c1b4\"});\n      add(\"rect\",{x:510,y:99,width:292,height:74,fill:\"#f8f7f1\",stroke:\"#c7c1b4\"});\n      add(\"rect\",{x:83,y:247,width:220,height:60,fill:\"#f8f7f1\",stroke:\"#c7c1b4\"});\n      add(\"rect\",{x:620,y:240,width:182,height:67,class:\"water\"});\n      add(\"path\",{d:\"M420 112 C475 125 491 155 486 210 C482 258 452 278 416 290 C380 272 359 250 357 210 C355 164 373 129 420 112Z\",class:\"fill\"});\n      add(\"path\",{d:\"M420 120 C459 140 465 166 460 212 C457 245 438 265 420 277 C401 265 384 243 380 212 C375 166 382 140 420 120Z\",class:stage>=2?\"accent\":\"heavy\"});\n      txt(420,323,\"타워 부지 · 개념 위치\",\"label\",\"middle\");\n      line(420,88,420,55,\"heavy\"); add(\"path\",{d:\"M420 53l-6 10h12z\",fill:\"#15212b\"}); txt(420,47,\"N\",\"label\",\"middle\");\n      dim(360,350,480,350,\"방향·관계 중심 도식 (비축척)\");\n      $(\"#drawingNote\").textContent=\"배치도: 실제 대지 경계·인접 시설·도로 폭을 재현하지 않습니다. 도자기 선 단계에서는 외곽의 부드러운 윤곽을 강조합니다.\";\n    }\n    if(drawMode===\"plan\"){\n      txt(28,30,\"기준층 평면도 · 개념 재구성\",\"title\"); txt(28,48,\"대표적인 중층 기준층의 외곽/코어 관계 · 폭은 공개 자료의 확정 치수가 아님\",\"small\");\n      const rounded = stage>=2;\n      const outer = rounded ? \"M300 87 Q260 87 245 130 L220 205 Q210 250 245 287 Q280 305 450 305 Q620 305 655 287 Q690 250 680 205 L655 130 Q640 87 600 87Z\" : stage===1 ? \"M275 90 L625 90 L670 300 L230 300Z\":\"M245 90 L655 90 L655 300 L245 300Z\";\n      add(\"path\",{d:outer,class:\"fill\"});\n      add(\"path\",{d:outer,class:stage>0?\"accent\":\"heavy\"});\n      add(\"rect\",{x:390,y:158,width:120,height:82,rx:stage>=2?14:0,class:\"core\"});\n      add(\"rect\",{x:365,y:142,width:170,height:114,fill:\"none\",stroke:\"#157c92\",\"stroke-dasharray\":\"5 4\"});\n      txt(450,199,\"중앙 코어\",\"label\",\"middle\"); txt(450,216,\"추정 개념\",\"small\",\"middle\");\n      for(let x=280;x<630;x+=45) line(x,105,x-15,285,\"dash\");\n      dim(245,330,655,330,\"저층 기준 폭 약 72m · 추정 개념\");\n      dim(390,145,510,145,\"코어 폭 · 추정\",false);\n      txt(700,135,\"외곽: 위로 갈수록 축소\",\"label\"); line(690,140,640,140,\"line\");\n      $(\"#drawingNote\").textContent=\"기준층 평면: 72m 및 코어 치수는 화면상 비례를 설명하기 위한 추정값입니다. 실제 층별 평면·임대 구성·구조 그리드가 아닙니다.\";\n    }\n    if(drawMode===\"elevation\"){\n      txt(28,30,\"입면도 · 높이와 외곽선\",\"title\"); txt(28,48,\"전체 높이 555m / 지상 123층은 공개 기준 · 폭과 세부 층 분할은 개념\",\"small\");\n      const baseY=350,H=285,cx=455;\n      add(\"path\",{d:towerPath(cx,baseY,H,stage),fill:\"#e6f0f0\",stroke:\"#15212b\",\"stroke-width\":\"1.5\"});\n      add(\"path\",{d:towerPath(cx,baseY,H,stage),class:stage>0?\"accent\":\"heavy\"});\n      for(let i=1;i<13;i++){\n        const y=baseY-i*H/13; line(390,y,520,y,\"dash\");\n      }\n      line(610,350,610,65,\"line\"); line(585,350,620,350,\"line\"); line(585,65,620,65,\"line\"); dim(610,350,610,65,\"555m · 공개 기준\",true);\n      txt(535,215,\"123층 · 지상 공개 기준\",\"label\");\n      line(530,220,505,220,\"line\");\n      txt(70,115,\"단계별 외곽선\", \"label\");\n      [\"기준량\",\"테이퍼\",\"도자기 선\",\"완성\"].forEach((n,i)=>{ const y=142+i*27; add(\"line\",{x1:72,y1:y,x2:104,y2:y,stroke:i===stage?\"#b97d2d\":\"#789097\",\"stroke-width\":i===stage?3:1.5}); txt(113,y+4,n,\"small\"); });\n      $(\"#drawingNote\").textContent=\"입면도: 세로 치수 555m와 지상 123층만 공개 기준으로 표기합니다. 수평 폭·곡률·층고는 설명용 모델에서 설정한 추정값입니다.\";\n    }\n    if(drawMode===\"section\"){\n      txt(28,30,\"개념 단면도 · 수직 프로그램의 읽기\",\"title\"); txt(28,48,\"구조 부재·피난·설비·정확한 프로그램은 표현하지 않은 설명용 절단\",\"small\");\n      const baseY=350,H=285,cx=400;\n      add(\"path\",{d:towerPath(cx,baseY,H,stage),fill:\"#edf4f2\",stroke:\"#15212b\",\"stroke-width\":\"1.5\"});\n      add(\"path\",{d:towerPath(cx,baseY,H,stage),class:stage>0?\"accent\":\"heavy\"});\n      add(\"rect\",{x:385,y:125,width:30,height:225,fill:\"#d4e5e3\",stroke:\"#157c92\"});\n      [0,.18,.42,.68,.86].forEach((v,i)=>{\n        const y=350-H*v; line(350,y,454,y,\"line\");\n        const labels=[\"저층부\",\"중층부\",\"상층부\",\"상부 기계·전환부?\",\"크라운/첨탑\"];\n        txt(520,y+4,labels[i],\"label\"); line(458,y,510,y,\"dash\");\n      });\n      txt(400,240,\"수직 코어\",\"small\",\"middle\");\n      line(610,350,610,65,\"line\"); dim(610,350,610,65,\"555m · 공개 기준\",true);\n      txt(65,330,\"층선: 123층을 간략화한 구간 표시\",\"small\");\n      $(\"#drawingNote\").textContent=\"단면도: 층별 용도·코어·상부 전환부의 위치는 개념적 읽기 보조입니다. 실제 구조 시스템이나 안전·설비 계획을 뜻하지 않습니다.\";\n    }\n  }\n\n  let renderer, scene, camera, controls, modelGroup;\n  function init3D(){\n    const holder=$(\"#scene\");\n    renderer=new THREE.WebGLRenderer({antialias:true,alpha:true});\n    renderer.setPixelRatio(Math.min(devicePixelRatio,2));\n    renderer.setSize(holder.clientWidth,holder.clientHeight);\n    renderer.outputColorSpace=THREE.SRGBColorSpace;\n    holder.appendChild(renderer.domElement);\n    scene=new THREE.Scene();\n    scene.fog=new THREE.Fog(0xd7e1e0,260,740);\n    camera=new THREE.PerspectiveCamera(34,holder.clientWidth/holder.clientHeight,.1,2000);\n    controls=new THREE.OrbitControls(camera,renderer.domElement);\n    controls.enableDamping=!matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n    controls.dampingFactor=.06; controls.maxPolarAngle=Math.PI*.49; controls.minDistance=145; controls.maxDistance=700;\n    scene.add(new THREE.HemisphereLight(0xffffff,0x506b72,2.3));\n    const light=new THREE.DirectionalLight(0xfff3d5,3); light.position.set(220,340,180); scene.add(light);\n    const ground=new THREE.Mesh(new THREE.CircleGeometry(210,64),new THREE.MeshStandardMaterial({color:0x9faca8,roughness:1,transparent:true,opacity:.75}));\n    ground.rotation.x=-Math.PI/2; ground.position.y=-3; scene.add(ground);\n    const grid=new THREE.GridHelper(350,18,0x80989a,0xaabbb9); grid.position.y=-2; grid.material.opacity=.35; grid.material.transparent=true; scene.add(grid);\n    modelGroup=new THREE.Group();scene.add(modelGroup); setCamera(\"reset\"); buildModel();\n    function animate(){requestAnimationFrame(animate);controls.update();renderer.render(scene,camera)} animate();\n    new ResizeObserver(()=>{const w=holder.clientWidth,h=holder.clientHeight;camera.aspect=w/h;camera.updateProjectionMatrix();renderer.setSize(w,h)}).observe(holder);\n  }\n  function profile(s, z){\n    const t=z/555;\n    if(s===0) return 43;\n    if(s===1) return 43*(1-.59*Math.pow(t,.85));\n    if(s===2) return 43*(1-.48*Math.pow(t,1.35)-.12*Math.sin(Math.PI*t)*t);\n    return 43*(1-.43*Math.pow(t,1.3)-.15*Math.pow(t,4))*(t>.89 ? (1-(t-.89)*1.6):1);\n  }\n  function buildModel(){\n    while(modelGroup.children.length)modelGroup.remove(modelGroup.children[0]);\n    const segments=stage===0?16:stage===1?28:44, radial=stage<2?4:20;\n    const vertices=[],indices=[];\n    for(let j=0;j<=segments;j++){\n      let z=555*j/segments, r=profile(stage,z);\n      if(stage===3 && z>500) r=Math.max(2,r);\n      for(let i=0;i<=radial;i++){\n        const a=2*Math.PI*i/radial + Math.PI/4;\n        let rr=r;\n        if(radial===4){ // squared-ish footprint\n          const c=Math.max(Math.abs(Math.cos(a)),Math.abs(Math.sin(a))); rr=r/c;\n        }\n        vertices.push(rr*Math.cos(a),z-277.5,rr*Math.sin(a));\n      }\n    }\n    for(let j=0;j<segments;j++)for(let i=0;i<radial;i++){\n      const a=j*(radial+1)+i,b=a+radial+1;indices.push(a,b,a+1,a+1,b,b+1);\n    }\n    const geom=new THREE.BufferGeometry();geom.setAttribute(\"position\",new THREE.Float32BufferAttribute(vertices,3));geom.setIndex(indices);geom.computeVertexNormals();\n    const mat=new THREE.MeshStandardMaterial({color:0xb8d1d1,metalness:.15,roughness:.48,side:THREE.DoubleSide,transparent:true,opacity:.94});\n    const mesh=new THREE.Mesh(geom,mat);modelGroup.add(mesh);\n    const edges=new THREE.LineSegments(new THREE.EdgesGeometry(geom,17),new THREE.LineBasicMaterial({color:0x185769,transparent:true,opacity:.55}));modelGroup.add(edges);\n    const rings=new THREE.Group();\n    const count=stage===0?12:18;\n    for(let i=1;i<count;i++){\n      const z=555*i/count, r=profile(stage,z), pts=[];\n      for(let q=0;q<=48;q++){let a=2*Math.PI*q/48+Math.PI/4, 