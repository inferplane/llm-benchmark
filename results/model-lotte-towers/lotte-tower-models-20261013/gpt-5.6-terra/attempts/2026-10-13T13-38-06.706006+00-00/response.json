{
  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Lotte World Tower — Vertical Atlas</title>\n<style>\n  :root{\n    --ink:#162238;\n    --night:#081427;\n    --paper:#f4efe4;\n    --cream:#fffaf0;\n    --gold:#d8a847;\n    --gold-light:#f4d889;\n    --blue:#59c7df;\n    --line:rgba(22,34,56,.22);\n    --shadow:0 18px 45px rgba(4,14,31,.18);\n  }\n  *{box-sizing:border-box}\n  html{background:var(--night)}\n  body{\n    margin:0;\n    min-width:0;\n    color:var(--ink);\n    font-family:Georgia, \"Times New Roman\", serif;\n    font-size:19px;\n    line-height:1.42;\n    background:\n      radial-gradient(circle at 12% 4%, rgba(89,199,223,.18), transparent 26rem),\n      radial-gradient(circle at 88% 22%, rgba(216,168,71,.14), transparent 24rem),\n      var(--night);\n  }\n  button, input{font:inherit}\n  .page{\n    width:min(1180px, calc(100% - 28px));\n    margin:0 auto;\n    padding:28px 0 42px;\n  }\n  header{\n    color:var(--cream);\n    border-bottom:1px solid rgba(244,239,228,.38);\n    padding:0 0 24px;\n    margin-bottom:22px;\n  }\n  .eyebrow{\n    margin:0 0 8px;\n    color:var(--gold-light);\n    font-family:Arial, sans-serif;\n    font-size:19px;\n    font-weight:700;\n    letter-spacing:.08em;\n    text-transform:uppercase;\n  }\n  h1{\n    margin:0;\n    font-size:clamp(38px, 7vw, 72px);\n    line-height:.94;\n    letter-spacing:-.055em;\n    font-weight:700;\n  }\n  .intro{\n    max-width:780px;\n    margin:17px 0 0;\n    font-size:20px;\n  }\n  .atlas{\n    display:grid;\n    grid-template-columns:minmax(0, 1fr) minmax(280px, .42fr);\n    gap:22px;\n    align-items:start;\n  }\n  .panel{\n    min-width:0;\n    background:var(--paper);\n    box-shadow:var(--shadow);\n  }\n  .stage-panel{padding:15px}\n  .stage-head{\n    display:flex;\n    flex-wrap:wrap;\n    align-items:baseline;\n    justify-content:space-between;\n    gap:8px 18px;\n    padding:3px 5px 12px;\n  }\n  h2,h3{margin:0}\n  h2{font-size:27px; line-height:1.1}\n  .stage-head p{\n    margin:0;\n    font-family:Arial,sans-serif;\n    font-size:19px;\n  }\n  .stage{\n    width:100%;\n    overflow:hidden;\n    background:\n      linear-gradient(180deg, #11243c 0%, #183c57 60%, #e8d4a4 60.2%, #d9b771 100%);\n    outline:2px solid var(--ink);\n    outline-offset:-2px;\n  }\n  svg{\n    display:block;\n    width:100%;\n    height:auto;\n    aspect-ratio:600 / 680;\n  }\n  .controls{\n    display:flex;\n    flex-wrap:wrap;\n    gap:9px;\n    margin:14px 0 0;\n  }\n  button{\n    min-height:46px;\n    border:2px solid var(--ink);\n    border-radius:0;\n    padding:8px 13px;\n    color:var(--ink);\n    background:var(--cream);\n    cursor:pointer;\n    font-weight:700;\n  }\n  button:hover{background:var(--gold-light)}\n  button:focus-visible{\n    outline:4px solid var(--blue);\n    outline-offset:3px;\n  }\n  .hint{\n    margin:12px 4px 0;\n    font-family:Arial,sans-serif;\n    font-size:19px;\n  }\n  .side{\n    display:grid;\n    gap:22px;\n  }\n  .note{\n    padding:23px;\n    background:var(--cream);\n    border-top:7px solid var(--gold);\n    box-shadow:var(--shadow);\n  }\n  .note h2{margin-bottom:12px}\n  .note p{margin:0}\n  .facts{\n    list-style:none;\n    padding:0;\n    margin:17px 0 0;\n    border-top:1px solid var(--line);\n  }\n  .facts li{\n    display:grid;\n    grid-template-columns:92px minmax(0,1fr);\n    gap:12px;\n    padding:13px 0;\n    border-bottom:1px solid var(--line);\n    font-family:Arial,sans-serif;\n    font-size:19px;\n  }\n  .facts strong{color:#77571a}\n  .key{\n    padding:22px;\n    color:var(--cream);\n    border:1px solid rgba(244,239,228,.4);\n  }\n  .key h2{color:var(--gold-light); margin-bottom:14px}\n  .key-item{\n    display:flex;\n    gap:11px;\n    align-items:flex-start;\n    margin:11px 0;\n    font-family:Arial,sans-serif;\n    font-size:19px;\n  }\n  .swatch{\n    flex:0 0 22px;\n    width:22px;\n    height:22px;\n    margin-top:3px;\n    border:1px solid rgba(255,255,255,.6);\n  }\n  .gold{background:var(--gold)}\n  .cyan{background:var(--blue)}\n  .ivory{background:#f7edd2}\n  footer{\n    margin-top:22px;\n    color:var(--cream);\n    font-family:Arial,sans-serif;\n    font-size:19px;\n  }\n  @media (max-width:800px){\n    .atlas{grid-template-columns:1fr}\n    .side{grid-template-columns:1fr 1fr}\n  }\n  @media (max-width:560px){\n    .page{width:min(100% - 20px, 1180px); padding-top:18px}\n    .stage-panel{padding:9px}\n    .side{grid-template-columns:1fr}\n    .note,.key{padding:18px}\n    .facts li{grid-template-columns:84px minmax(0,1fr)}\n    button{flex:1 1 130px}\n  }\n</style>\n</head>\n<body>\n<main class=\"page\">\n  <header>\n    <p class=\"eyebrow\">Seoul / a measured skyline study</p>\n    <h1>Lotte World Tower</h1>\n    <p class=\"intro\">A vertical atlas of 555 metres: one continuous silhouette, from its grounded podium to its lantern-like crown.</p>\n  </header>\n\n  <section class=\"atlas\" aria-label=\"Interactive architectural atlas\">\n    <section class=\"panel stage-panel\">\n      <div class=\"stage-head\">\n        <h2 id=\"drawing-title\">The whole elevation</h2>\n        <p id=\"view-status\" aria-live=\"polite\">Home view · full height visible</p>\n      </div>\n\n      <div class=\"stage\" tabindex=\"0\" role=\"application\" aria-labelledby=\"drawing-title stage-instructions\">\n        <svg viewBox=\"0 0 600 680\" aria-label=\"Elevation drawing of Lotte World Tower showing a 555 metre total height including a 46 metre crown\">\n          <defs>\n            <linearGradient id=\"towerGlass\" x1=\"0\" x2=\"1\">\n              <stop offset=\"0\" stop-color=\"#9dd7e4\"/>\n              <stop offset=\".22\" stop-color=\"#eaf5ee\"/>\n              <stop offset=\".52\" stop-color=\"#91c8d6\"/>\n              <stop offset=\".78\" stop-color=\"#eaf5ee\"/>\n              <stop offset=\"1\" stop-color=\"#65aabf\"/>\n            </linearGradient>\n            <linearGradient id=\"crownGlass\" x1=\"0\" x2=\"1\">\n              <stop offset=\"0\" stop-color=\"#d8a847\"/>\n              <stop offset=\".5\" stop-color=\"#fff0ad\"/>\n              <stop offset=\"1\" stop-color=\"#b9872b\"/>\n            </linearGradient>\n            <pattern id=\"floors\" width=\"18\" height=\"13\" patternUnits=\"userSpaceOnUse\">\n              <path d=\"M0 12.5H18\" stroke=\"#183c57\" stroke-opacity=\".42\" stroke-width=\"1\"/>\n              <path d=\"M5 0V12\" stroke=\"#ffffff\" stroke-opacity=\".32\" stroke-width=\"1\"/>\n            </pattern>\n            <clipPath id=\"bodyClip\">\n              <path d=\"M223 567 L241 238 L267 104 L333 104 L359 238 L377 567 Z\"/>\n            </clipPath>\n          </defs>\n\n          <g id=\"camera\">\n            <g aria-hidden=\"true\">\n              <circle cx=\"81\" cy=\"91\" r=\"2.2\" fill=\"#f4d889\"/>\n              <circle cx=\"132\" cy=\"145\" r=\"1.6\" fill=\"#f4d889\"/>\n              <circle cx=\"472\" cy=\"119\" r=\"2\" fill=\"#f4d889\"/>\n              <circle cx=\"526\" cy=\"189\" r=\"1.3\" fill=\"#f4d889\"/>\n              <path d=\"M34 568 C135 536 180 555 223 545 C337 520 428 548 566 523\" fill=\"none\" stroke=\"#f7edd2\" stroke-opacity=\".75\" stroke-width=\"2\"/>\n            </g>\n\n            <g id=\"tower-art\">\n              <path d=\"M223 567 L241 238 L267 104 L333 104 L359 238 L377 567 Z\" fill=\"url(#towerGlass)\" stroke=\"#13243b\" stroke-width=\"3\"/>\n              <rect x=\"214\" y=\"567\" width=\"172\" height=\"23\" fill=\"#183c57\" stroke=\"#13243b\" stroke-width=\"3\"/>\n              <path d=\"M223 567 L241 238 L267 104 L333 104 L359 238 L377 567 Z\" fill=\"url(#floors)\" clip-path=\"url(#bodyClip)\" opacity=\".92\"/>\n              <path d=\"M267 104 L280 72 L300 58 L320 72 L333 104 Z\" fill=\"url(#crownGlass)\" stroke=\"#13243b\" stroke-width=\"3\"/>\n              <path d=\"M300 58 L300 43\" stroke=\"#f4d889\" stroke-width=\"3\"/>\n              <path d=\"M241 238 H359 M232 399 H368\" stroke=\"#f7edd2\" stroke-opacity=\".72\" stroke-width=\"2\"/>\n              <path d=\"M300 104 V567\" stroke=\"#183c57\" stroke-opacity=\".35\" stroke-width=\"2\"/>\n            </g>\n\n            <g font-family=\"Arial, sans-serif\" font-size=\"20\" fill=\"#fffaf0\" font-weight=\"700\">\n              <path d=\"M454 58 V590 M443 58 H465 M443 590 H465\" fill=\"none\" stroke=\"#f4d889\" stroke-width=\"2\"/>\n              <text x=\"477\" y=\"310\">555 m total</text>\n              <text x=\"477\" y=\"335\">crown included</text>\n\n              <path d=\"M198 58 H260 M198 104 H266 M205 58 V104\" fill=\"none\" stroke=\"#f4d889\" stroke-width=\"2\"/>\n              <text x=\"39\" y=\"77\">46 m crown</text>\n              <text x=\"39\" y=\"101\">inside total</text>\n\n              <path d=\"M390 238 H436\" fill=\"none\" stroke=\"#59c7df\" stroke-width=\"2\"/>\n              <text x=\"397\" y=\"223\">tapering glass</text>\n\n              <path d=\"M182 578 H213\" fill=\"none\" stroke=\"#59c7df\" stroke-width=\"2\"/>\n              <text x=\"42\" y=\"615\">ground / podium</text>\n            </g>\n          </g>\n        </svg>\n      </div>\n\n      <div class=\"controls\" aria-label=\"View controls\">\n        <button type=\"button\" data-action=\"home\">Home: full tower</button>\n        <button type=\"button\" data-action=\"zoom-in\" aria-label=\"Zoom in on drawing\">Zoom in +</button>\n        <button type=\"button\" data-action=\"zoom-out\" aria-label=\"Zoom out on drawing\">Zoom out −</button>\n        <button type=\"button\" data-action=\"crown\">Crown view</button>\n        <button type=\"button\" data-action=\"base\">Podium view</button>\n      </div>\n      <p class=\"hint\" id=\"stage-instructions\">Keyboard: use + and − to zoom, H for home, C for crown, B for podium, and arrow keys to move the view.</p>\n    </section>\n\n    <aside class=\"side\">\n      <section class=\"note\">\n        <h2>One measured line</h2>\n        <p>The elevation is deliberately calibrated as a single 555 m object. The gold crown occupies the upper 46 m of that same total; it is not an added extension.</p>\n        <ul class=\"facts\">\n          <li><strong>555 m</strong><span>represented full height</span></li>\n          <li><strong>46 m</strong><span>crown within the height</span></li>\n          <li><strong>123</strong><span>storeys above Seoul</span></li>\n        </ul>\n      </section>\n\n      <section class=\"key\" aria-label=\"Drawing key\">\n        <h2>Elevation key</h2>\n        <div class=\"key-item\"><span class=\"swatch gold\"></span><span>Lantern crown and height marks</span></div>\n        <div class=\"key-item\"><span class=\"swatch cyan\"></span><span>Glass mass and sectional callouts</span></div>\n        <div class=\"key-item\"><span class=\"swatch ivory\"></span><span>Ground line and night atmosphere</span></div>\n      </section>\n    </aside>\n  </section>\n\n  <footer>Interactive drawing: all view changes preserve the same 555 m architectural model.</footer>\n</main>\n\n<script>\n(() => {\n  const camera = document.getElementById('camera');\n  const stage = document.querySelector('.stage');\n  const status = document.getElementById('view-status');\n  let zoom = 1, panX = 0, panY = 0;\n\n  function render(label) {\n    camera.setAttribute('transform', `translate(${panX} ${panY}) scale(${zoom})`);\n    status.textContent = label;\n  }\n  function home() {\n    zoom = 1;\n    panX = 0;\n    panY = 0;\n    render('Home view · full height visible');\n  }\n  function zoomIn() {\n    zoom = Math.min(2.25, +(zoom + .2).toFixed(2));\n    render(`Zoom ${Math.round(zoom * 100)}%`);\n  }\n  function zoomOut() {\n    zoom = Math.max(.8, +(zoom - .2).toFixed(2));\n    render(`Zoom ${Math.round(zoom * 100)}%`);\n  }\n  function crown() {\n    zoom = 1.8;\n    panX = -240;\n    panY = -35;\n    render('Crown view · upper 46 m');\n  }\n  function base() {\n    zoom = 1.55;\n    panX = -165;\n    panY = -285;\n    render('Podium view · grounded base');\n  }\n\n  document.querySelectorAll('[data-action]').forEach(button => {\n    button.addEventListener('click', () => {\n      const action = button.dataset.action;\n      if (action === 'home') home();\n      if (action === 'zoom-in') zoomIn();\n      if (action === 'zoom-out') zoomOut();\n      if (action === 'crown') crown();\n      if (action === 'base') base();\n    });\n  });\n\n  stage.addEventListener('keydown', event => {\n    const key = event.key.toLowerCase();\n    const moves = {\n      arrowleft: [-24, 0],\n      arrowright: [24, 0],\n      arrowup: [0, -24],\n      arrowdown: [0, 24]\n    };\n    if (key === '+' || key === '=') {\n      event.preventDefault();\n      zoomIn();\n    } else if (key === '-' || key === '_') {\n      event.preventDefault();\n      zoomOut();\n    } else if (key === 'h') {\n      event.preventDefault();\n      home();\n    } else if (key === 'c') {\n      event.preventDefault();\n      crown();\n    } else if (key === 'b') {\n      event.preventDefault();\n      base();\n    } else if (moves[key]) {\n      event.preventDefault();\n      panX += moves[key][0];\n      panY += moves[key][1];\n      render(`Moved view · zoom ${Math.round(zoom * 100)}%`);\n    }\n  });\n\n  home();\n})();\n</script>\n</body>\n</html>",
