50,42)+txt(545,32,'N*')+txt(480,303,'* 방위는 도식 가정',10);}\n else{content+=`<path d=\"${outline(0,stage,cx,cy,scale)}\" fill=\"none\" stroke=\"#98aab2\" stroke-dasharray=\"5 5\"/>`;content+=txt(30,45,'점선: 지면 외곽',11);content+=line(180,163,430,163,'#b0bec5','stroke-dasharray=\"3 4\"')+line(305,35,305,280,'#b0bec5','stroke-dasharray=\"3 4\"');}\n const y=kind==='site'?0:height,w=radius(y,stage)*2,a=w*scale/2;\n content+=`<path d=\"${outline(y,stage,cx,cy,scale)}\" fill=\"#dbe8ec\" fill-opacity=\".75\" stroke=\"${kind==='plan'?'#be4b25':'#31566a'}\" stroke-width=\"2\"/>`;\n if(kind==='plan'){let core=w*.36*scale;content+=`<rect x=\"${cx-core/2}\" y=\"${cy-core/2}\" width=\"${core}\" height=\"${core}\" fill=\"#c1d2d9\" stroke=\"#31566a\"/>`;content+=txt(cx-23,cy+4,'개념 코어',10);content+=line(cx-a,cy+a+20,cx+a,cy+a+20)+line(cx-a,cy+a+14,cx-a,cy+a+26)+line(cx+a,cy+a+14,cx+a,cy+a+26)+txt(cx-55,cy+a+40,`${w.toFixed(1)} m · 추정`);content+=txt(30,300,`절단 높이 ${height} m / 단계 0${stage+1}`,12,'#be4b25');}\n }else{\n const cx=310,base=287,scale=.46;\n let path='';for(let i=0;i<=80;i++){let y=i/80*555;path+=`${i?'L':'M'}${cx-radius(y,stage)*1.6},${base-y*scale}`;}for(let i=80;i>=0;i--){let y=i/80*555;path+=`L${cx+radius(y,stage)*1.6},${base-y*scale}`;}path+='Z';\n content+=`<path d=\"${path}\" fill=\"#e1eaed\" stroke=\"#31566a\" stroke-width=\"1.8\"/>`;\n if(kind==='section'){content+=`<path d=\"M287 287V51H333V287\" stroke=\"#31566a\" fill=\"#c4d4dc\"/>`;for(let f=1;f<123;f++){let y=f*530/123,r=radius(y,stage)*1.6;content+=line(cx-r,base-y*scale,cx+r,base-y*scale,'#6d8c9b','stroke-width=\".45\"');}content+=txt(400,80,'개념 코어 / 균등 층고',11)+line(333,84,392,75);}\n else if(stage>=2){for(let k=-2;k<=2;k++){let p='';for(let i=0;i<=50;i++){let y=i*555/50;p+=`${i?'L':'M'}${cx+k*.43*radius(y,stage)},${base-y*scale}`;}content+=`<path d=\"${p}\" stroke=\"#9bb2bd\" fill=\"none\"/>`;}}\n const sy=base-height*scale;content+=line(190,sy,440,sy,'#be4b25','stroke-dasharray=\"5 3\"')+txt(445,sy+4,`${height} m`,12,'#be4b25');\n content+=line(170,base,170,base-555*scale)+line(162,base,178,base)+line(162,base-555*scale,178,base-555*scale)+txt(62,155,'555 m',18)+txt(62,175,'공개 높이',11)+line(200,base,410,base)+txt(205,310,'±0.0 m · 개념 지면')+txt(365,32,'상부 외형 근사',11);\n }\n svg.innerHTML=`<title id=\"svgtitle\">${title}</title><desc id=\"svgdesc\">${text} 단위 미터. 선택 높이 ${height} 미터.</desc>${content}<text x=\"20\" y=\"325\" font-size=\"10\" fill=\"#687c85\">CONCEPT ONLY · 단위 m · 화면 맞춤 비축척 · 치수는 별도 표기</text>`;\n}\ndocument.querySelectorAll('.step').forEach(b=>b.addEventListener('click',()=>{\n stage=+b.dataset.step;document.querySelectorAll('.step').forEach(el=>{const active=+el.dataset.step===stage;el.classList.toggle('active',active);el.setAttribute('aria-pressed',active);});\n if(views[0]){const v=views[0];v.scene.remove(v.model);dispose(v.model);v.model=build(stage);v.scene.add(v.model);v.s=stage;}update();\n}));\ndocument.querySelectorAll('.tab').forEach(b=>b.addEventListener('click',()=>{kind=b.dataset.drawing;document.querySelectorAll('.tab').forEach(t=>{const a=t===b;t.classList.toggle('active',a);t.setAttribute('aria-pressed',a);});draw();}));\n$('#level').addEventListener('input',e=>{height=+e.target.value;update();});\n$('#reset').onclick=()=>views.forEach(v=>v.reset());\nfunction zoom(f){views.forEach(v=>{const target=new THREE.Vector3(0,265,0),d=v.camera.position.clone().sub(target);d.multiplyScalar(f);if(d.length()<180||d.length()>1800)return;v.camera.position.copy(target.add(d));if(v.controls)v.controls.update();v.render();});}\n$('#zoomIn').onclick=()=>zoom(.85);$('#zoomOut').onclick=()=>zoom(1.18);\n$('#front').onclick=()=>views.forEach(v=>{v.camera.position.set(0,265,950);v.camera.lookAt(0,265,0);if(v.controls)v.controls.update();v.render();});\nupdate();\n})();\n</script>\n</body>\n</html>",
