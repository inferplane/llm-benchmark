{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<title>롯데월드타워 설계 과정 인터랙티브</title>\n<style>\n  body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f5f5f5;color:#333;display:flex;height:100vh;overflow:hidden;}\n  #sidebar{width:260px;background:#fff;border-right:1px solid #ddd;display:flex;flex-direction:column;}\n  #sidebar h2{margin:0;padding:12px 16px;background:#1976d2;color:#fff;font-size:1.1rem;}\n  #menu{flex:1;overflow-y:auto;}\n  .menu-item{padding:10px 16px;cursor:pointer;border-bottom:1px solid #eee;}\n  .menu-item:hover,.menu-item.active{background:#e3f2fd;}\n  #content{flex:1;position:relative;display:flex;flex-direction:column;}\n  #info{padding:8px 12px;background:#fafafa;border-top:1px solid #ddd;font-size:0.9rem;}\n  #canvasContainer{flex:1;position:relative;}\n  canvas{display:block;width:100%;height:100%;}\n  .plan{position:absolute;top:0;left:0;width:100%;height:100%;background:#fff;display:none;overflow:auto;}\n  .plan.active{display:block;}\n  .plan svg{width:100%;height:auto;}\n  #modelInfo{position:absolute;top:8px;right:8px;background:rgba(255,255,255,0.8);padding:4px 8px;border-radius:4px;font-size:0.85rem;}\n</style>\n</head>\n<body>\n<div id=\"sidebar\">\n  <h2>롯데월드타워</h2>\n  <div id=\"menu\">\n    <div class=\"menu-item active\" data-mode=\"site\">배치도</div>\n    <div class=\"menu-item\" data-mode=\"floor\">기준층 평면도</div>\n    <div class=\"menu-item\" data-mode=\"elevation\">입면도</div>\n    <div class=\"menu-item\" data-mode=\"section\">단면도</div>\n    <div class=\"menu-item\" data-mode=\"stage0\">설계 단계 0 (스케치)</div>\n    <div class=\"menu-item\" data-mode=\"stage1\">설계 단계 1 (기본 형태)</div>\n    <div class=\"menu-item\" data-mode=\"stage2\">설계 단계 2 (디테일링)</div>\n    <div class=\"menu-item\" data-mode=\"final\">완성 모델</div>\n  </div>\n  <div id=\"info\">\n    모델: <strong>gpt-oss-120b</strong><br>\n    높이: 555 m / 123층\n  </div>\n</div>\n\n<div id=\"content\">\n  <div id=\"canvasContainer\">\n    <div id=\"planSite\" class=\"plan active\">\n      <svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n        <rect x=\"10\" y=\"10\" width=\"180\" height=\"180\" fill=\"#e0e0e0\" stroke=\"#777\" stroke-width=\"2\"/>\n        <text x=\"100\" y=\"105\" font-size=\"14\" text-anchor=\"middle\" fill=\"#555\">Site Plan (Concept)</text>\n      </svg>\n    </div>\n    <div id=\"planFloor\" class=\"plan\">\n      <svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n        <rect x=\"30\" y=\"30\" width=\"140\" height=\"140\" fill=\"#c8e6c9\" stroke=\"#388e3c\" stroke-width=\"2\"/>\n        <text x=\"100\" y=\"105\" font-size=\"14\" text-anchor=\"middle\" fill=\"#2e7d32\">Floor Plan (Typical)</text>\n      </svg>\n    </div>\n    <div id=\"planElevation\" class=\"plan\">\n      <svg viewBox=\"0 0 200 400\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M100,0 L120,400 L80,400 Z\" fill=\"#ffe0b2\" stroke=\"#e65100\" stroke-width=\"2\"/>\n        <text x=\"100\" y=\"210\" font-size=\"14\" text-anchor=\"middle\" fill=\"#bf360c\" transform=\"rotate(90 100 210)\">Elevation</text>\n      </svg>\n    </div>\n    <div id=\"planSection\" class=\"plan\">\n      <svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n        <line x1=\"50\" y1=\"150\" x2=\"150\" y2=\"50\" stroke=\"#1976d2\" stroke-width=\"3\"/>\n        <text x=\"100\" y=\"120\" font-size=\"14\" text-anchor=\"middle\" fill=\"#0d47a1\">Section</text>\n      </svg>\n    </div>\n    <canvas id=\"threeCanvas\"></canvas>\n    <div id=\"modelInfo\"></div>\n  </div>\n</div>\n\n<script src=\"../runtime/three-runtime.js\"></script>\n<script>\n(() => {\n  const menuItems = document.querySelectorAll('.menu-item');\n  const plans = {\n    site: document.getElementById('planSite'),\n    floor: document.getElementById('planFloor'),\n    elevation: document.getElementById('planElevation'),\n    section: document.getElementById('planSection')\n  };\n  const canvas = document.getElementById('threeCanvas');\n  const modelInfo = document.getElementById('modelInfo');\n\n  // Three.js setup\n  const renderer = new THREE.WebGLRenderer({canvas, antialias:true, alpha:true});\n  const scene = new THREE.Scene();\n  const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 2000);\n  camera.position.set(0, 200, 400);\n  const controls = new THREE.OrbitControls(camera, renderer.domElement);\n  controls.enableDamping = true;\n  controls.dampingFactor = 0.1;\n  controls.minDistance = 100;\n  controls.maxDistance = 800;\n\n  // Light\n  const ambient = new THREE.AmbientLight(0xffffff,0.6);\n  const dirLight = new THREE.DirectionalLight(0xffffff,0.8);\n  dirLight.position.set(200,400,200);\n  scene.add(ambient, dirLight);\n\n  // Helper to create tower geometry for a given stage\n  function createTower(stage) {\n    // stage 0: simple box 100x100x200\n    // stage 1: tapered cylinder (base radius 80, top radius 30, height 400)\n    // stage 2: more segmented taper (3 sections)\n    // final: detailed taper matching 555m height (scaled)\n    const group = new THREE.Group();\n    const material = new THREE.MeshStandardMaterial({color:0x8d6e63, roughness:0.6, metalness:0.2});\n    if (stage===0){\n      const geo = new THREE.BoxGeometry(100,200,100);\n      const mesh = new THREE.Mesh(geo, material);\n      group.add(mesh);\n    } else if (stage===1){\n      const geo = new THREE.CylinderGeometry(80,30,400,32);\n      const mesh = new THREE.Mesh(geo, material);\n      group.add(mesh);\n    } else if (stage===2){\n      const heights = [150,150,100];\n      const radiiTop = [60,40,20];\n      const radiiBottom = [80,60,40];\n      let y = -200;\n      for(let i=0;i<3;i++){\n        const geo = new THREE.CylinderGeometry(radiiBottom[i],radiiTop[i],heights[i],32);\n        const mesh = new THREE.Mesh(geo, material);\n        mesh.position.y = y + heights[i]/2;\n        y += heights[i];\n        group.add(mesh);\n      }\n    } else { // final\n      const totalHeight = 555; // scale factor 1 = 1m\n      const segments = 12;\n      const baseRadius = 80;\n      const topRadius = 15;\n      const geo = new THREE.CylinderGeometry(baseRadius, topRadius, totalHeight, 64, segments, true);\n      const mesh = new THREE.Mesh(geo, material);\n      group.add(mesh);\n    }\n    return group;\n  }\n\n  let currentModel = null;\n  function showModel(stageKey){\n    if(currentModel){\n      scene.remove(currentModel);\n      currentModel.traverse(child=>{if(child.geometry) child.geometry.dispose();});\n    }\n    let stageIdx;\n    switch(stageKey){\n      case 'stage0': stageIdx=0; break;\n      case 'stage1': stageIdx=1; break;\n      case 'stage2': stageIdx=2; break;\n      case 'final': stageIdx=3; break;\n      default: stageIdx=null;\n    }\n    if(stageIdx!==null){\n      currentModel = createTower(stageIdx);\n      scene.add(currentModel);\n      modelInfo.textContent = `현재 모델: ${stageKey}`;\n    } else {\n      currentModel = null;\n      modelInfo.textContent = '';\n    }\n    render();\n  }\n\n  function render(){\n    const width = canvas.clientWidth;\n    const height = canvas.clientHeight;\n    if (canvas.width !== width || canvas.height !== height){\n      renderer.setSize(width, height, false);\n      camera.aspect = width/height;\n      camera.updateProjectionMatrix();\n    }\n    controls.update();\n    renderer.render(scene, camera);\n  }\n  renderer.setClearColor(0x000000,0);\n  function animate(){\n    requestAnimationFrame(animate);\n    render();\n  }\n  animate();\n\n  // UI handling\n  menuItems.forEach(item=>{\n    item.addEventListener('click',()=>{\n      menuItems.forEach(i=>i.classList.remove('active'));\n      item.classList.add('active');\n      const mode = item.dataset.mode;\n      // hide all plans\n      Object.values(plans).forEach(p=>p.classList.remove('active'));\n      // hide canvas by default\n      canvas.style.display='none';\n      // show appropriate content\n      if(plans[mode]){\n        plans[mode].classList.add('active');\n        canvas.style.display='none';\n      } else {\n        canvas.style.display='block';\n        showModel(mode);\n      }\n    });\n  });\n\n  // Resize handling\n  window.addEventListener('resize',()=>{render();});\n})();\n</script>\n</body>\n</html>",
