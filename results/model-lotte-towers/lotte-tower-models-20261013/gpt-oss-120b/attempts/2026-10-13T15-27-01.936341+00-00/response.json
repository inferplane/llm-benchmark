{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<title>롯데월드타워 설계 과정 시각화 - gpt-oss-120b</title>\n<style>\n    body{margin:0;font-family:Arial,sans-serif;background:#f5f5f5;color:#222;display:flex;flex-direction:column;height:100vh;}\n    header{background:#003366;color:#fff;padding:0.5rem 1rem;display:flex;align-items:center;justify-content:space-between;}\n    header h1{margin:0;font-size:1.2rem;}\n    main{flex:1;display:flex;overflow:hidden;}\n    #sidebar{width:260px;background:#fff;border-right:1px solid #ccc;overflow-y:auto;padding:0.5rem;}\n    #sidebar h2{font-size:1rem;margin:0.5rem 0 0.2rem;}\n    .navBtn{background:#e0e0e0;border:none;padding:0.4rem 0.6rem;margin:0.2rem 0;cursor:pointer;font-size:1rem;width:100%;text-align:left;}\n    .navBtn:focus{outline:2px solid #0066cc;background:#d0eaff;}\n    #content{flex:1;position:relative;display:flex;flex-direction:column;}\n    #canvasContainer{flex:1;position:relative;}\n    canvas{display:block;width:100%;height:100%;}\n    #infoPanel{background:#fff;padding:0.5rem;border-top:1px solid #ccc;font-size:19px;line-height:1.4;}\n    #resetBtn{position:absolute;top:10px;right:10px;background:#0066cc;color:#fff;border:none;padding:0.4rem 0.8rem;cursor:pointer;font-size:1rem;z-index:10;}\n    #resetBtn:focus{outline:2px solid #ffcc00;}\n    .drawing{border:1px solid #999;background:#fff;margin:0.5rem 0;padding:0.3rem;}\n    .drawing svg{width:100%;height:auto;display:block;}\n    .drawing text{font-size:19px;fill:#333;}\n    .hidden{display:none;}\n</style>\n</head>\n<body>\n<header>\n    <h1>롯데월드타워 설계 과정 시각화</h1>\n    <div>모델: <strong>gpt-oss-120b</strong></div>\n</header>\n<main>\n    <aside id=\"sidebar\" aria-label=\"설계 단계 선택\">\n        <h2>도면</h2>\n        <div class=\"drawing\" id=\"sitePlan\">\n            <svg viewBox=\"0 0 200 150\" aria-label=\"배치도\">\n                <rect x=\"10\" y=\"10\" width=\"180\" height=\"130\" fill=\"#eaeaea\" stroke=\"#666\"/>\n                <text x=\"100\" y=\"80\" text-anchor=\"middle\" fill=\"#333\">배치도 (예시)</text>\n            </svg>\n        </div>\n        <div class=\"drawing\" id=\"floorPlan\">\n            <svg viewBox=\"0 0 200 150\" aria-label=\"기준층 평면도\">\n                <rect x=\"20\" y=\"20\" width=\"160\" height=\"110\" fill=\"#e0f7fa\" stroke=\"#006064\"/>\n                <text x=\"100\" y=\"80\" text-anchor=\"middle\" fill=\"#006064\">기준층 평면도 (예시)</text>\n            </svg>\n        </div>\n        <div class=\"drawing\" id=\"elevation\">\n            <svg viewBox=\"0 0 200 300\" aria-label=\"입면도\">\n                <polygon points=\"100,0 180,300 20,300\" fill=\"#fff3e0\" stroke=\"#bf360c\"/>\n                <text x=\"100\" y=\"180\" text-anchor=\"middle\" fill=\"#bf360c\">입면도 (예시)</text>\n            </svg>\n        </div>\n        <div class=\"drawing\" id=\"section\">\n            <svg viewBox=\"0 0 200 300\" aria-label=\"단면도\">\n                <polygon points=\"100,0 150,300 50,300\" fill=\"#e8f5e9\" stroke=\"#1b5e20\"/>\n                <text x=\"100\" y=\"180\" text-anchor=\"middle\" fill=\"#1b5e20\">단면도 (예시)</text>\n            </svg>\n        </div>\n        <h2>모델 단계</h2>\n        <button class=\"navBtn\" data-stage=\"concept\" tabindex=\"0\">개념 단계</button>\n        <button class=\"navBtn\" data-stage=\"mid\" tabindex=\"0\">중간 단계</button>\n        <button class=\"navBtn\" data-stage=\"final\" tabindex=\"0\">완성 모델</button>\n    </aside>\n    <section id=\"content\">\n        <button id=\"resetBtn\" aria-label=\"시점 초기화\" tabindex=\"0\">시점 초기화</button>\n        <div id=\"canvasContainer\"></div>\n        <div id=\"infoPanel\" aria-live=\"polite\">\n            <strong>설명:</strong> 선택된 단계와 도면을 확인하세요.\n        </div>\n    </section>\n</main>\n\n<script src=\"../runtime/three-runtime.js\"></script>\n<script>\n(() => {\n    const container = document.getElementById('canvasContainer');\n    const info = document.getElementById('infoPanel');\n    const resetBtn = document.getElementById('resetBtn');\n    const stageButtons = document.querySelectorAll('.navBtn');\n\n    // Three.js 기본 설정\n    const scene = new THREE.Scene();\n    const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 1, 3000);\n    camera.position.set(0, 300, 800);\n    const renderer = new THREE.WebGLRenderer({antialias:true});\n    renderer.setSize(container.clientWidth, container.clientHeight);\n    container.appendChild(renderer.domElement);\n\n    const controls = new THREE.OrbitControls(camera, renderer.domElement);\n    controls.enableDamping = true;\n    controls.dampingFactor = 0.05;\n    controls.screenSpacePanning = false;\n    controls.minDistance = 200;\n    controls.maxDistance = 2000;\n    controls.maxPolarAngle = Math.PI/2;\n\n    // 조명\n    const hemi = new THREE.HemisphereLight(0xffffff,0x444444,1);\n    scene.add(hemi);\n    const dirLight = new THREE.DirectionalLight(0xffffff,0.8);\n    dirLight.position.set(300,400,200);\n    scene.add(dirLight);\n\n    const mat = new THREE.MeshStandardMaterial({color:0x8da5b3, roughness:0.6, metalness:0.2});\n\n    const baseHeight = 555; // 전체 높이 (예시)\n    const baseRadius = 30;  // 바닥 반경 (예시)\n    const topRadius = 5;    // 꼭대기 반경 (예시)\n\n    function createTaperedCylinder(height, bottomR, topR) {\n        const geo = new THREE.CylinderGeometry(bottomR, topR, height, 32, 1, true);\n        const mesh = new THREE.Mesh(geo, mat);\n        return mesh;\n    }\n\n    // 개념 단계: 단순 원통형 (높이 40%)\n    const concept = createTaperedCylinder(baseHeight*0.4, baseRadius, baseRadius);\n    concept.position.y = (baseHeight*0.4)/2;\n    // 중간 단계: 두 구간 테이퍼\n    const groupMid = new THREE.Group();\n    const part1 = createTaperedCylinder(baseHeight*0.5, baseRadius, baseRadius*0.6);\n    part1.position.y = (baseHeight*0.5)/2;\n    const part2 = createTaperedCylinder(baseHeight*0.5, baseRadius*0.6, topRadius);\n    part2.position.y = baseHeight*0.5 + (baseHeight*0.5)/2;\n    groupMid.add(part1, part2);\n    // 최종 단계: 연속 테이퍼 전체 높이\n    const final = createTaperedCylinder(baseHeight, baseRadius, topRadius);\n    final.position.y = baseHeight/2;\n\n    const models = {concept, mid: groupMid, final};\n\n    let current = null;\n    function showStage(stage){\n        if(current) scene.remove(current);\n        current = models[stage];\n        scene.add(current);\n        info.innerHTML = `<strong>설명:</strong> 현재 <em>${stage}</em> 단계 모델을 표시합니다.`;\n        highlightDrawing(stage);\n    }\n\n    function highlightDrawing(stage){\n        const ids = ['sitePlan','floorPlan','elevation','section'];\n        ids.forEach(id=>document.getElementById(id).style.borderColor='#999');\n        if(stage==='concept') document.getElementById('sitePlan').style.borderColor='#0066cc';\n        else if(stage==='mid') document.getElementById('floorPlan').style.borderColor='#0066cc';\n        else if(stage==='final') document.getElementById('elevation').style.borderColor='#0066cc';\n    }\n\n    // 초기 표시\n    showStage('concept');\n\n    stageButtons.forEach(btn=>{\n        btn.addEventListener('click',()=>showStage(btn.dataset.stage));\n        btn.addEventListener('keydown',e=>{\n            if(e.key==='Enter' || e.key===' ') {e.preventDefault(); showStage(btn.dataset.stage);}\n        });\n    });\n\n    function resetView(){\n        camera.position.set(0,300,800);\n        controls.target.set(0,baseHeight/2,0);\n        controls.update();\n    }\n    resetBtn.addEventListener('click',resetView);\n    resetBtn.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' ') resetView();});\n\n    // 키보드 제어\n    window.addEventListener('keydown',e=>{\n        if(e.target.tagName==='INPUT' || e.target.isContentEditable) return;\n        switch(e.key){\n            case 'r': case 'R': resetView(); break;\n            case '+': controls.dollyOut(1.1); controls.update(); break; // zoom in\n            case '-': controls.dollyIn(1.1); controls.update(); break;  // zoom out\n            case 'ArrowUp': controls.rotateUp(0.05); controls.update(); break;\n            case 'ArrowDown': controls.rotateDown(0.05); controls.update(); break;\n            case 'ArrowLeft': controls.rotateLeft(0.05); controls.update(); break;\n            case 'ArrowRight': controls.rotateRight(0.05); controls.update(); break;\n            case 'w': case 'W': controls.rotateUp(0.05); controls.update(); break;\n            case 's': case 'S': controls.rotateDown(0.05); controls.update(); break;\n            case 'a': case 'A': controls.rotateLeft(0.05); controls.update(); break;\n            case 'd': case 'D': controls.rotateRight(0.05); controls.update(); break;\n        }\n    });\n\n    // 반응형\n    window.addEventListener('resize',()=>{\n        const w = container.clientWidth, h = container.clientHeight;\n        camera.aspect = w/h;\n        camera.updateProjectionMatrix();\n        renderer.setSize(w,h);\n    });\n\n    function animate(){\n        requestAnimationFrame(animate);\n        controls.update();\n        renderer.render(scene,camera);\n    }\n    animate();\n})();\n</script>\n</body>\n</html>",
