{
  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Lotte Tower Artwork</title>\n<style>\n  body{margin:0;font-family:sans-serif;background:#111;color:#eee;}\n  #container{display:flex;height:100vh;}\n  #sidebar{width:250px;padding:20px;box-sizing:border-box;background:#222;overflow:auto;}\n  #sidebar h2{font-size:22px;margin-top:0;}\n  #sidebar p{font-size:19px;line-height:1.4;}\n  #sidebar button{font-size:19px;margin:5px 0;padding:8px 12px;background:#444;color:#eee;border:none;cursor:pointer;}\n  #sidebar button:hover{background:#555;}\n  #viewer{flex:1;position:relative;}\n  canvas{display:block;}\n  .view-tab{display:inline-block;margin:5px;padding:4px 8px;background:#333;color:#eee;font-size:18px;cursor:pointer;}\n  .view-tab.active{background:#555;}\n</style>\n</head>\n<body>\n<div id=\"container\">\n  <div id=\"sidebar\">\n    <h2>Lotte Tower</h2>\n    <p>Explore the tower through four distinct views. Use the keyboard arrows to rotate, the mouse wheel to zoom, and the <strong>R</strong> key to reset the camera. Click the tabs below to switch between views.</p>\n    <div id=\"tabs\">\n      <div class=\"view-tab active\" data-view=\"base\">Base View</div>\n      <div class=\"view-tab\" data-view=\"side\">Side View</div>\n      <div class=\"view-tab\" data-view=\"top\">Top View</div>\n      <div class=\"view-tab\" data-view=\"interior\">Interior View</div>\n    </div>\n    <button id=\"resetBtn\">Reset Camera</button>\n  </div>\n  <div id=\"viewer\"></div>\n</div>\n\n<script type=\"module\">\nimport * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.158.0/build/three.module.js';\nimport { OrbitControls } from 'https://cdn.jsdelivr.net/npm/three@0.158.0/examples/jsm/controls/OrbitControls.js';\n\nconst scene = new THREE.Scene();\nscene.background = new THREE.Color(0x111111);\n\nconst camera = new THREE.PerspectiveCamera(45, window.innerWidth/2/window.innerHeight, 0.1, 1000);\ncamera.position.set(30, 30, 30);\n\nconst renderer = new THREE.WebGLRenderer({antialias:true});\nrenderer.setSize(window.innerWidth/2, window.innerHeight);\ndocument.getElementById('viewer').appendChild(renderer.domElement);\n\nconst controls = new OrbitControls(camera, renderer.domElement);\ncontrols.enableDamping = true;\ncontrols.dampingFactor = 0.05;\ncontrols.enablePan = false;\ncontrols.minDistance = 10;\ncontrols.maxDistance = 100;\n\n// Lighting\nconst hemi = new THREE.HemisphereLight(0xffffff, 0x444444, 1.0);\nhemi.position.set(0, 20, 0);\nscene.add(hemi);\nconst dir = new THREE.DirectionalLight(0xffffff, 0.8);\ndir.position.set(-3, 10, -10);\nscene.add(dir);\n\n// Tower geometry\nconst towerGroup = new THREE.Group();\nscene.add(towerGroup);\n\n// Base\nconst baseGeom = new THREE.CylinderGeometry(10, 10, 2, 32);\nconst baseMat = new THREE.MeshStandardMaterial({color:0x888888});\nconst base = new THREE.Mesh(baseGeom, baseMat);\nbase.position.y = 1;\ntowerGroup.add(base);\n\n// Walls\nconst wallGeom = new THREE.CylinderGeometry(10, 10, 30, 32, 1, true);\nconst wallMat = new THREE.MeshStandardMaterial({color:0x555555, side:THREE.DoubleSide});\nconst walls = new THREE.Mesh(wallGeom, wallMat);\nwalls.position.y = 16;\ntowerGroup.add(walls);\n\n// Roof\nconst roofGeom = new THREE.ConeGeometry(10, 4, 32);\nconst roofMat = new THREE.MeshStandardMaterial({color:0x222222});\nconst roof = new THREE.Mesh(roofGeom, roofMat);\nroof.position.y = 32;\ntowerGroup.add(roof);\n\n// Interior placeholder (simple box)\nconst interiorGeom = new THREE.BoxGeometry(18, 28, 18);\nconst interiorMat = new THREE.MeshBasicMaterial({color:0x333333, wireframe:true});\nconst interior = new THREE.Mesh(interiorGeom, interiorMat);\ninterior.position.y = 16;\ntowerGroup.add(interior);\n\n// View presets\nconst views = {\n  base: {pos:new THREE.Vector3(30,10,30), target:new THREE.Vector3(0,1,0)},\n  side: {pos:new THREE.Vector3(0,30,30), target:new THREE.Vector3(0,1,0)},\n  top:  {pos:new THREE.Vector3(0,50,0), target:new THREE.Vector3(0,1,0)},\n  interior: {pos:new THREE.Vector3(0,20,0), target:new THREE.Vector3(0,1,0)}\n};\n\nfunction setView(name){\n  const v = views[name];\n  camera.position.copy(v.pos);\n  controls.target.copy(v.target);\n  controls.update();\n  document.querySelectorAll('.view-tab').forEach(t=>t.classList.toggle('active', t.dataset.view===name));\n}\n\ndocument.getElementById('tabs').addEventListener('click', e=>{\n  if(e.target.classList.contains('view-tab')){\n    setView(e.target.dataset.view);\n  }\n});\n\ndocument.getElementById('resetBtn').addEventListener('click', ()=>setView('base'));\n\nwindow.addEventListener('resize', ()=>{\n  const w = window.innerWidth/2;\n  const h = window.innerHeight;\n  camera.aspect = w/h;\n  camera.updateProjectionMatrix();\n  renderer.setSize(w,h);\n});\n\nwindow.addEventListener('keydown', e=>{\n  if(e.key==='r' || e.key==='R'){setView('base');}\n});\n\nfunction animate(){\n  requestAnimationFrame(animate);\n  controls.update();\n  renderer.render(scene,camera);\n}\nanimate();\n</script>\n</body>\n</html>",
