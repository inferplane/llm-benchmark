  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<title>롯데월드타워 설계 과정</title>\n<style>\nbody{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f0f0f0;color:#222}\nheader{background:#004b8d;color:#fff;padding:10px 20px;font-size:22px;display:flex;justify-content:space-between;align-items:center}\nheader span{font-size:18px}\n#content{display:flex;flex-direction:column;gap:20px;padding:20px}\n@media(min-width:600px){#content{flex-direction:row}}\n#drawings{flex:1 1 300px;display:flex;flex-direction:column;gap:10px}\n.drawing{border:1px solid #ccc;background:#fff;padding:10px;flex:1 1 200px;overflow:auto}\n.drawing h3{font-size:20px;margin:0 0 5px}\n.drawing svg{width:100%;height:auto}\n#viewer{flex:2 1 500px;position:relative;background:#000;min-height:300px}\n#viewer canvas{display:block;width:100%;height:100%}\n#controls{position:absolute;top:10px;right:10px;display:flex;gap:10px}\nbutton{font-size:19px;padding:5px 10px;background:#fff;border:1px solid #888;border-radius:4px;cursor:pointer}\nbutton:hover{background:#e0e0e0}\n#info{position:absolute;bottom:10px;left:10px;color:#fff;font-size:18px;background:rgba(0,0,0,0.5);padding:5px 10px;border-radius:4px}\n</style>\n</head>\n<body>\n<header>\n<span>롯데월드타워 설계 과정</span>\n<span id=\"modelName\">gpt-oss-20b</span>\n</header>\n<div id=\"content\">\n<div id=\"drawings\">\n<div class=\"drawing\">\n<h3>배치도 (Site Plan)</h3>\n<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n<rect x=\"10\" y=\"10\" width=\"180\" height=\"180\" fill=\"#e0e0e0\" stroke=\"#888\" stroke-width=\"2\"/>\n<text x=\"100\" y=\"30\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-size=\"18\" fill=\"#444\">서울 시내</text>\n<text x=\"100\" y=\"50\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-size=\"18\" fill=\"#444\">롯데월드타워 부지</text>\n<text x=\"100\" y=\"70\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-size=\"18\" fill=\"#444\">공개 자료 기반</text>\n</svg>\n</div>\n<div class=\"drawing\">\n<h3>기준층 평면도 (Floor Plan)</h3>\n<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n<rect x=\"20\" y=\"20\" width=\"160\" height=\"160\" fill=\"#f5f5f5\" stroke=\"#888\" stroke-width=\"2\"/>\n<rect x=\"60\" y=\"60\" width=\"80\" height=\"80\" fill=\"#c0c0c0\" stroke=\"#555\" stroke-width=\"1\"/>\n<text x=\"100\" y=\"190\" text-anchor=\"middle\" font-size=\"18\" fill=\"#444\">기준층 평면도 (공개 자료 기반)</text>\n</svg>\n</div>\n<div class=\"drawing\">\n<h3>입면도 (Elevation)</h3>\n<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n<rect x=\"10\" y=\"10\" width=\"180\" height=\"180\" fill=\"#e0e0e0\" stroke=\"#888\" stroke-width=\"2\"/>\n<polygon points=\"100,20 120,180 80,180\" fill=\"#c0c0c0\" stroke=\"#555\" stroke-width=\"1\"/>\n<text x=\"100\" y=\"190\" text-anchor=\"middle\" font-size=\"18\" fill=\"#444\">입면도 (공개 자료 기반)</text>\n</svg>\n</div>\n<div class=\"drawing\">\n<h3>단면도 (Section)</h3>\n<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n<rect x=\"10\" y=\"10\" width=\"180\" height=\"180\" fill=\"#e0e0e0\" stroke=\"#888\" stroke-width=\"2\"/>\n<rect x=\"90\" y=\"20\" width=\"20\" height=\"160\" fill=\"#c0c0c0\" stroke=\"#555\" stroke-width=\"1\"/>\n<text x=\"100\" y=\"190\" text-anchor=\"middle\" font-size=\"18\" fill=\"#444\">단면도 (공개 자료 기반)</text>\n</svg>\n</div>\n</div>\n<div id=\"viewer\">\n<canvas id=\"threeCanvas\"></canvas>\n<div id=\"controls\">\n<button id=\"resetBtn\">Reset View</button>\n<button id=\"stagePrev\">◀︎</button>\n<button id=\"stageNext\">▶︎</button>\n</div>\n<div id=\"info\">현재 단계: <span id=\"stageLabel\">완성 모델</span></div>\n</div>\n</div>\n<script src=\"../runtime/three-runtime.js\"></script>\n<script>\nconst stages = [\n{label:'기본형', height:200, radiusTop:30, radiusBottom:50},\n{label:'중간형', height:350, radiusTop:20, radiusBottom:40},\n{label:'상단형', height:500, radiusTop:10, radiusBottom:30},\n{label:'완성 모델', height:555, radiusTop:5, radiusBottom:25}\n];\nlet currentStage = 3;\nconst stageLabel = document.getElementById('stageLabel');\nconst resetBtn = document.getElementById('resetBtn');\nconst stagePrev = document.getElementById('stagePrev');\nconst stageNext = document.getElementById('stageNext');\nconst canvas = document.getElementById('threeCanvas');\nconst renderer = new THREE.WebGLRenderer({canvas, antialias:true});\nconst container = document.getElementById('viewer');\nfunction resize(){\nconst width = container.clientWidth;\nconst height = container.clientHeight;\nrenderer.setSize(width, height);\ncamera.aspect = width / height;\ncamera.updateProjectionMatrix();\n}\nresize();\nconst scene = new THREE.Scene();\nconst camera = new THREE.PerspectiveCamera(45, container.clientWidth/container.clientHeight, 0.1, 2000);\ncamera.position.set(0, -400, 300);\nconst controls = new THREE.OrbitControls(camera, canvas);\ncontrols.enableDamping = true;\ncontrols.dampingFactor = 0.05;\ncontrols.enablePan = false;\ncontrols.minDistance = 200;\ncontrols.maxDistance = 1000;\nconst light = new THREE.DirectionalLight(0xffffff, 1);\nlight.position.set(0, -1, 1);\nscene.add(light);\nconst ambient = new THREE.AmbientLight(0x404040);\nscene.add(ambient);\nlet tower;\nfunction createTower(stage){\nif(tower){scene.remove(tower);}\nconst geom = new THREE.CylinderGeometry(stage.radiusTop, stage.radiusBottom, stage.height, 64, 1, true);\nconst mat = new THREE.MeshPhongMaterial({color:0x8888ff, flatShading:true});\ntower = new THREE.Mesh(geom, mat);\ntower.position.y = stage.height/2;\nscene.add(tower);\n}\nfunction updateStage(){\nstageLabel.textContent = stages[currentStage].label;\ncreateTower(stages[currentStage]);\n}\nstagePrev.onclick = () =>{currentStage=Math.max(0,currentStage-1);updateStage();};\nstageNext.onclick = () =>{currentStage=Math.min(stages.length-1,currentStage+1);updateStage();};\nresetBtn.onclick = () =>{controls.reset();};\nwindow.addEventListener('resize',resize);\nwindow.addEventListener('keydown',(e)=>{\nif(e.key==='ArrowLeft'){stagePrev.click();}\nif(e.key==='ArrowRight'){stageNext.click();}\nif(e.key==='r'||e.key==='R'){resetBtn.click();}\nif(e.key==='w'){controls.target.y+=10;controls.update();}\nif(e.key==='s'){controls.target.y-=10;controls.update();}\nif(e.key==='a'){controls.target.x-=10;controls.update();}\nif(e.key==='d'){controls.target.x+=10;controls.update();}\nif(e.key==='q'){controls.target.z+=10;controls.update();}\nif(e.key==='e'){controls.target.z-=10;controls.update();}\n});\nupdateStage();\nfunction animate(){requestAnimationFrame(animate);controls.update();renderer.render(scene,camera);}\nanimate();\n</script>\n</body>\n</html>",
