  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>LOTTE TOWER • ARTWORK</title>\n<style>\n  body { margin:0; background:#0a0a12; color:#e0e0ff; font-family: system-ui, -apple-system, sans-serif; overflow:hidden; }\n  #container { display:flex; flex-direction:column; align-items:center; height:100vh; }\n  h1 { font-size:28px; margin:16px 0 8px; letter-spacing:4px; }\n  canvas { border:1px solid #334; background:#111; touch-action:none; }\n  #controls { margin-top:16px; display:flex; gap:12px; flex-wrap:wrap; justify-content:center; }\n  button { font-size:19px; padding:12px 24px; background:#1a1a2e; color:#e0e0ff; border:1px solid #556; border-radius:6px; cursor:pointer; min-width:120px; }\n  button:active { background:#334; }\n  .label { font-size:19px; margin:0 8px; }\n</style>\n</head>\n<body>\n<div id=\"container\">\n  <h1>LOTTE TOWER</h1>\n  <canvas id=\"c\" width=\"800\" height=\"620\"></canvas>\n  <div id=\"controls\">\n    <button id=\"rotL\">⟲ ROTATE LEFT</button>\n    <button id=\"rotR\">ROTATE RIGHT ⟳</button>\n    <button id=\"zoomIn\">ZOOM IN +</button>\n    <button id=\"zoomOut\">ZOOM OUT −</button>\n    <button id=\"reset\">RESET VIEW</button>\n  </div>\n</div>\n<script>\nconst canvas = document.getElementById('c');\nconst ctx = canvas.getContext('2d');\n\nlet angle = 0.4;\nlet zoom = 1.15;\nlet offsetY = 110;\nlet isDragging = false;\nlet lastX = 0;\nlet touchStartDist = 0;\n\nconst TOWER_HEIGHT = 520;\nconst BASE_W = 210;\nconst TOP_W = 78;\nconst SECTIONS = 18;\n\nfunction project(x, y, z, a, s) {\n  const rotX = x * Math.cos(a) - z * Math.sin(a);\n  const rotZ = x * Math.sin(a) + z * Math.cos(a);\n  const px = canvas.width / 2 + rotX * s;\n  const py = canvas.height / 2 + (y * s) + offsetY;\n  return { x: px, y: py };\n}\n\nfunction draw() {\n  ctx.fillStyle = '#0a0a12';\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n\n  const s = zoom * 0.95;\n  const halfBase = BASE_W / 2;\n  const halfTop = TOP_W / 2;\n\n  ctx.strokeStyle = '#7cf';\n  ctx.lineWidth = 2.2;\n  ctx.shadowColor = '#7cf';\n  ctx.shadowBlur = 8;\n\n  // base\n  const b1 = project(-halfBase, TOWER_HEIGHT, -halfBase, angle, s);\n  const b2 = project(halfBase, TOWER_HEIGHT, -halfBase, angle, s);\n  const b3 = project(halfBase, TOWER_HEIGHT, halfBase, angle, s);\n  const b4 = project(-halfBase, TOWER_HEIGHT, halfBase, angle, s);\n\n  // top\n  const t1 = project(-halfTop, 0, -halfTop, angle, s);\n  const t2 = project(halfTop, 0, -halfTop, angle, s);\n  const t3 = project(halfTop, 0, halfTop, angle, s);\n  const t4 = project(-halfTop, 0, halfTop, angle, s);\n\n  // vertical edges\n  ctx.beginPath();\n  ctx.moveTo(b1.x, b1.y); ctx.lineTo(t1.x, t1.y);\n  ctx.moveTo(b2.x, b2.y); ctx.lineTo(t2.x, t2.y);\n  ctx.moveTo(b3.x, b3.y); ctx.lineTo(t3.x, t3.y);\n  ctx.moveTo(b4.x, b4.y); ctx.lineTo(t4.x, t4.y);\n  ctx.stroke();\n\n  // horizontal sections\n  ctx.strokeStyle = '#59f';\n  ctx.lineWidth = 1.6;\n  ctx.shadowBlur = 4;\n  for (let i = 0; i <= SECTIONS; i++) {\n    const t = i / SECTIONS;\n    const w = halfBase + (halfTop - halfBase) * t;\n    const y = TOWER_HEIGHT * (1 - t);\n    const p1 = project(-w, y, -w, angle, s);\n    const p2 = project(w, y, -w, angle, s);\n    const p3 = project(w, y, w, angle, s);\n    const p4 = project(-w, y, w, angle, s);\n    ctx.beginPath();\n    ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y);\n    ctx.lineTo(p3.x, p3.y); ctx.lineTo(p4.x, p4.y);\n    ctx.closePath();\n    ctx.stroke();\n  }\n\n  // crown\n  ctx.strokeStyle = '#aef';\n  ctx.lineWidth = 3;\n  ctx.shadowBlur = 12;\n  ctx.beginPath();\n  ctx.moveTo(t1.x, t1.y); ctx.lineTo(t2.x, t2.y);\n  ctx.lineTo(t3.x, t3.y); ctx.lineTo(t4.x, t4.y);\n  ctx.closePath();\n  ctx.stroke();\n\n  ctx.shadowBlur = 0;\n}\n\nfunction resetView() {\n  angle = 0.4;\n  zoom = 1.15;\n  offsetY = 110;\n  draw();\n}\n\nfunction changeZoom(delta) {\n  zoom = Math.max(0.6, Math.min(3.2, zoom + delta));\n  draw();\n}\n\nfunction changeAngle(delta) {\n  angle += delta;\n  draw();\n}\n\n// Mouse\ncanvas.addEventListener('mousedown', e => {\n  isDragging = true;\n  lastX = e.clientX;\n});\nwindow.addEventListener('mouseup', () => isDragging = false);\nwindow.addEventListener('mousemove', e => {\n  if (!isDragging) return;\n  angle += (e.clientX - lastX) * 0.0035;\n  lastX = e.clientX;\n  draw();\n});\ncanvas.addEventListener('wheel', e => {\n  e.preventDefault();\n  changeZoom(e.deltaY < 0 ? 0.12 : -0.12);\n}, { passive: false });\n\n// Touch\ncanvas.addEventListener('touchstart', e => {\n  if (e.touches.length === 1) {\n    isDragging = true;\n    lastX = e.touches[0].clientX;\n  } else if (e.touches.length === 2) {\n    const dx = e.touches[0].clientX - e.touches[1].clientX;\n    const dy = e.touches[0].clientY - e.touches[1].clientY;\n    touchStartDist = Math.hypot(dx, dy);\n  }\n});\ncanvas.addEventListener('touchmove', e => {\n  e.preventDefault();\n  if (e.touches.length === 1 && isDragging) {\n    angle += (e.touches[0].clientX - lastX) * 0.0035;\n    lastX = e.touches[0].clientX;\n    draw();\n  } else if (e.touches.length === 2) {\n    const dx = e.touches[0].clientX - e.touches[1].clientX;\n    const dy = e.touches[0].clientY - e.touches[1].clientY;\n    const dist = Math.hypot(dx, dy);\n    if (touchStartDist > 0) {\n      const factor = dist / touchStartDist;\n      zoom = Math.max(0.6, Math.min(3.2, zoom * factor));\n      touchStartDist = dist;\n      draw();\n    }\n  }\n}, { passive: false });\ncanvas.addEventListener('touchend', () => {\n  isDragging = false;\n  touchStartDist = 0;\n});\n\n// Keyboard\ncanvas.setAttribute('tabindex', '0');\ncanvas.addEventListener('keydown', e => {\n  if (e.key === 'ArrowLeft') { changeAngle(-0.12); e.preventDefault(); }\n  if (e.key === 'ArrowRight') { changeAngle(0.12); e.preventDefault(); }\n  if (e.key === '+' || e.key === '=') { changeZoom(0.12); e.preventDefault(); }\n  if (e.key === '-') { changeZoom(-0.12); e.preventDefault(); }\n  if (e.key.toLowerCase() === 'r') { resetView(); e.preventDefault(); }\n});\n\n// Buttons\ndocument.getElementById('rotL').onclick = () => changeAngle(-0.18);\ndocument.getElementById('rotR').onclick = () => changeAngle(0.18);\ndocument.getElementById('zoomIn').onclick = () => changeZoom(0.18);\ndocument.getElementById('zoomOut').onclick = () => changeZoom(-0.18);\ndocument.getElementById('reset').onclick = resetView;\n\n// Initial render\nresetView();\n</script>\n</body>\n</html>",
