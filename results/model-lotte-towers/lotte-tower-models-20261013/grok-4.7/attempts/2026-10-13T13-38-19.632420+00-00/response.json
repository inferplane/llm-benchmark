{
  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Lotte World Tower — Elevation Study</title>\n<style>\n  html, body { margin: 0; height: 100%; background: #07080c; color: #f4efe6; font-family: Georgia, \"Times New Roman\", serif; }\n  #stage { position: fixed; inset: 0; }\n  canvas { display: block; width: 100%; height: 100%; }\n  .panel {\n    position: fixed; left: 18px; bottom: 18px; max-width: min(460px, 92vw);\n    background: rgba(8,9,14,0.78); border: 1px solid rgba(232,210,160,0.35);\n    padding: 16px 18px 14px; pointer-events: auto;\n  }\n  h1 { font-size: 22px; font-weight: normal; letter-spacing: 0.08em; margin: 0 0 8px; color: #f3e6c4; }\n  p, button, .note { font-size: 19px; line-height: 1.35; margin: 0 0 8px; }\n  button {\n    font-family: inherit; background: transparent; color: #f4efe6;\n    border: 1px solid #e8d2a0; padding: 6px 12px; margin: 4px 8px 0 0; cursor: pointer;\n  }\n  button:focus { outline: 2px solid #f3e6c4; }\n  .hud {\n    position: fixed; right: 18px; top: 18px; text-align: right; pointer-events: none;\n    font-size: 19px; line-height: 1.4; color: #f3e6c4; text-shadow: 0 1px 4px #000;\n  }\n</style>\n</head>\n<body>\n<div id=\"stage\"><canvas id=\"c\"></canvas></div>\n<div class=\"hud\" id=\"hud\">Entire height 555 m<br>including crown</div>\n<div class=\"panel\">\n  <h1>LOTTE WORLD TOWER</h1>\n  <p>Night elevation of the completed tower. The taper, glass shaft and crown together measure 555 m.</p>\n  <p class=\"note\">Arrows orbit. R resets the fitted view. Drag to look around.</p>\n  <button type=\"button\" id=\"reset\">Reset view</button>\n</div>\n<script>\n(function () {\n  const canvas = document.getElementById(\"c\");\n  const ctx = canvas.getContext(\"2d\");\n  const reduce = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n  const TOTAL = 555;\n  const profile = [];\n  for (let i = 0; i <= 64; i++) {\n    const t = i / 64;\n    const y = t * TOTAL;\n    let r;\n    if (t < 0.08) r = 42 - t * 30;\n    else if (t < 0.78) r = 38 - (t - 0.08) * 18;\n    else if (t < 0.90) r = 22 - (t - 0.78) * 40;\n    else r = Math.max(2.2, 16 * (1 - (t - 0.90) / 0.10));\n    profile.push({ y: y, r: r });\n  }\n  let yaw = 0.55, pitch = 0.18, dist = 980;\n  let drag = false, lx = 0, ly = 0;\n  function fit() {\n    yaw = 0.42; pitch = 0.12; dist = 980;\n  }\n  fit();\n  function resize() {\n    canvas.width = innerWidth * devicePixelRatio;\n    canvas.height = innerHeight * devicePixelRatio;\n    canvas.style.width = innerWidth + \"px\";\n    canvas.style.height = innerHeight + \"px\";\n  }\n  addEventListener(\"resize\", resize);\n  resize();\n  function project(x, y, z) {\n    const cy = Math.cos(yaw), sy = Math.sin(yaw);\n    const cp = Math.cos(pitch), sp = Math.sin(pitch);\n    let x1 = x * cy - z * sy;\n    let z1 = x * sy + z * cy;\n    let y1 = y * cp - z1 * sp;\n    let z2 = y * sp + z1 * cp;\n    const f = 900;\n    const s = f / (z2 + dist);\n    const cx = canvas.width * 0.48;\n    const cy0 = canvas.height * 0.56;\n    const scale = Math.min(canvas.width, canvas.height) / 920;\n    return { x: cx + x1 * s * scale * 7.2, y: cy0 - y1 * s * scale * 7.2, s: s };\n  }\n  function draw() {\n    const w = canvas.width, h = canvas.height;\n    ctx.setTransform(1, 0, 0, 1, 0, 0);\n    const g = ctx.createLinearGradient(0, 0, 0, h);\n    g.addColorStop(0, \"#12151f\");\n    g.addColorStop(1, \"#05060a\");\n    ctx.fillStyle = g;\n    ctx.fillRect(0, 0, w, h);\n    const segs = 28;\n    const faces = [];\n    for (let i = 0; i < profile.length - 1; i++) {\n      for (let k = 0; k < segs; k++) {\n        const a0 = (k / segs) * Math.PI * 2;\n        const a1 = ((k + 1) / segs) * Math.PI * 2;\n        const p = [profile[i], profile[i + 1]];\n        const pts = [\n          [p[0].r * Math.cos(a0), p[0].y - TOTAL / 2, p[0].r * Math.sin(a0)],\n          [p[0].r * Math.cos(a1), p[0].y - TOTAL / 2, p[0].r * Math.sin(a1)],\n          [p[1].r * Math.cos(a1), p[1].y - TOTAL / 2, p[1].r * Math.sin(a1)],\n          [p[1].r * Math.cos(a0), p[1].y - TOTAL / 2, p[1].r * Math.sin(a0)]\n        ];\n        const pr = pts.map(function (q) { return project(q[0], q[1], q[2]); });\n        const depth = (pts[0][2] + pts[1][2] + pts[2][2] + pts[3][2]) / 4;\n        const nx = Math.cos((a0 + a1) / 2);\n        const light = 0.35 + 0.65 * Math.max(0, nx * 0.6 + 0.4);\n        faces.push({ pr: pr, depth: depth, light: light, band: i });\n      }\n    }\n    faces.sort(function (a, b) { return b.depth - a.depth; });\n    faces.forEach(function (f) {\n      ctx.beginPath();\n      ctx.moveTo(f.pr[0].x, f.pr[0].y);\n      for (let n = 1; n < 4; n++) ctx.lineTo(f.pr[n].x, f.pr[n].y);\n      ctx.closePath();\n      const crown = f.band > 52;\n      const gold = crown ? 210 : 168 + f.band;\n      ctx.fillStyle = \"rgb(\" + Math.floor(gold * f.light) + \",\" + Math.floor((crown ? 190 : 150) * f.light) + \",\" + Math.floor((crown ? 120 : 90) * f.light) + \")\";\n      ctx.fill();\n    });\n    ctx.font = (19 * devicePixelRatio) + \"px Georgia, serif\";\n    ctx.fillStyle = \"#f3e6c4\";\n    const base = project(0, -TOTAL / 2, 0);\n    const top = project(0, TOTAL / 2, 0);\n    ctx.fillText(\"0 m  podium\", base.x + 24 * devicePixelRatio, base.y);\n    ctx.fillText(\"555 m  crown tip\", top.x + 18 * devicePixelRatio, top.y - 8 * devicePixelRatio);\n    ctx.strokeStyle = \"rgba(243,230,196,0.7)\";\n    ctx.lineWidth = devicePixelRatio;\n    ctx.beginPath();\n    ctx.moveTo(top.x, top.y);\n    ctx.lineTo(top.x + 14 * devicePixelRatio, top.y);\n    ctx.moveTo(base.x, base.y);\n    ctx.lineTo(base.x + 20 * devicePixelRatio, base.y);\n    ctx.stroke();\n  }\n  function frame() {\n    if (!reduce) yaw += 0.0022;\n    draw();\n    requestAnimationFrame(frame);\n  }\n  frame();\n  function aim() { draw(); }\n  addEventListener(\"keydown\", function (e) {\n    const step = 0.08;\n    if (e.key === \"ArrowLeft\") yaw -= step;\n    else if (e.key === \"ArrowRight\") yaw += step;\n    else if (e.key === \"ArrowUp\") pitch = Math.min(1.1, pitch + step);\n    else if (e.key === \"ArrowDown\") pitch = Math.max(-0.4, pitch - step);\n    else if (e.key === \"r\" || e.key === \"R\") fit();\n    else return;\n    e.preventDefault();\n    aim();\n  });\n  canvas.addEventListener(\"pointerdown\", function (e) { drag = true; lx = e.clientX; ly = e.clientY; });\n  addEventListener(\"pointerup\", function () { drag = false; });\n  addEventListener(\"pointermove\", function (e) {\n    if (!drag) return;\n    yaw += (e.clientX - lx) * 0.008;\n    pitch = Math.max(-0.4, Math.min(1.1, pitch + (e.clientY - ly) * 0.006));\n    lx = e.clientX; ly = e.clientY;\n    aim();\n  });\n  document.getElementById(\"reset\").addEventListener(\"click\", function () { fit(); aim(); });\n})();\n</script>\n</body>\n</html>",
