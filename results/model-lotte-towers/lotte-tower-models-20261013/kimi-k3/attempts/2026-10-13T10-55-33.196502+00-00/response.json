{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>롯데월드타워 설계 과정 · 개념 재구성 아카이브</title>\n<style>\n:root{\n  --bg:#081527; --panel:#0d2137; --panel2:#0a1a2e; --line:#1c3a5c;\n  --ink:#dceefb; --muted:#9db8d0; --cyan:#7fd4ff; --amber:#ffc857;\n  --green:#7dffa8; --accent:#e8b4a0; --danger:#ff9d9d;\n  --rad:14px;\n}\n*{box-sizing:border-box}\nhtml,body{margin:0;padding:0}\nbody{\n  background:radial-gradient(1200px 700px at 70% -10%, #10294a 0%, var(--bg) 55%) fixed, var(--bg);\n  color:var(--ink);\n  font-family:\"Pretendard\",\"Apple SD Gothic Neo\",\"Malgun Gothic\",system-ui,-apple-system,\"Segoe UI\",sans-serif;\n  font-size:16px; line-height:1.55; -webkit-text-size-adjust:100%;\n}\na{color:var(--cyan)}\na:focus-visible, button:focus-visible, input:focus-visible, [tabindex]:focus-visible{\n  outline:3px solid var(--cyan); outline-offset:2px; border-radius:6px;\n}\nheader.top{\n  padding:18px clamp(14px,3vw,32px) 12px;\n  border-bottom:1px solid var(--line);\n  display:flex; flex-wrap:wrap; gap:10px 18px; align-items:baseline;\n  background:linear-gradient(180deg,#0c1f38cc,transparent);\n}\nheader.top h1{font-size:clamp(1.15rem,2.6vw,1.6rem); margin:0; letter-spacing:-.01em}\nheader.top .sub{color:var(--muted); font-size:.9rem; flex-basis:100%}\n.badge{\n  display:inline-block; padding:3px 10px; border:1px solid var(--line); border-radius:999px;\n  background:#0f2742; color:var(--cyan); font-size:.8rem; white-space:nowrap;\n}\n.badge.model{border-color:#3b6ea6; color:#cfe8ff; background:#103154}\n.notice{\n  margin:12px clamp(14px,3vw,32px) 0; padding:10px 14px; font-size:.88rem; color:#ffe9c9;\n  border:1px dashed #7a5a20; background:#2a2110; border-radius:10px;\n}\nmain{\n  display:grid; gap:16px; padding:16px clamp(14px,3vw,32px) 24px;\n  grid-template-columns:minmax(330px,480px) minmax(0,1fr); align-items:start;\n}\n@media (max-width:980px){ main{grid-template-columns:1fr} }\nsection.panel{\n  background:linear-gradient(180deg,var(--panel),var(--panel2));\n  border:1px solid var(--line); border-radius:var(--rad);\n  padding:14px; box-shadow:0 10px 30px #0006;\n}\nh2{font-size:1.05rem; margin:2px 0 10px; color:var(--cyan); letter-spacing:.02em}\nh2 small{color:var(--muted); font-weight:400; font-size:.78rem; margin-left:6px}\n\n/* ── 탭 & 도면 ───────────────────────── */\n.tabs{display:flex; flex-wrap:wrap; gap:6px; margin-bottom:10px}\n.tabs button, .stages button, .tool button{\n  font:inherit; color:var(--ink); background:#102a48; border:1px solid var(--line);\n  border-radius:9px; padding:8px 12px; cursor:pointer; font-size:.9rem;\n}\n.tabs button[aria-selected=\"true\"]{background:var(--accent); color:#081527; border-color:transparent; font-weight:700}\n.stages button[aria-pressed=\"true\"]{background:var(--accent); color:#081527; border-color:transparent; font-weight:700}\n.tool button[aria-pressed=\"true\"]{border-color:var(--cyan); color:var(--cyan)}\n.tabs button:hover, .stages button:hover, .tool button:hover{border-color:var(--cyan)}\n.drawing-box{\n  background:#071224; border:1px solid var(--line); border-radius:10px; overflow:hidden;\n}\n.drawing-box svg{display:block; width:100%; height:auto}\n.legend{display:flex; flex-wrap:wrap; gap:6px 16px; margin-top:10px; font-size:.82rem; color:var(--muted)}\n.legend .k{display:inline-flex; align-items:center; gap:7px}\n.sw{width:26px; height:0; border-top:3px solid var(--green); border-radius:2px}\n.sw.est{border-top-style:dashed; border-top-color:var(--amber)}\n.sw.acc{border-top-color:var(--accent)}\n.caption{\n  margin-top:10px; padding:10px 12px; font-size:.88rem; color:#d3e6f8;\n  border-left:3px solid var(--accent); background:#0e2540; border-radius:0 8px 8px 0;\n}\n.caption b{color:var(--accent)}\n\n/* ── 3D 뷰어 ───────────────────────── */\n.viewer-wrap{position:relative; border-radius:10px; overflow:hidden; border:1px solid var(--line);\n  background:linear-gradient(180deg,#0b1f3a 0%, #071224 70%, #050d18 100%);}\n#gl{display:block; width:100%; height:clamp(380px,62vh,640px); touch-action:none; cursor:grab}\n#gl:active{cursor:grabbing}\n.viewer-tag{\n  position:absolute; top:10px; left:12px; font-size:.8rem; color:var(--muted);\n  background:#071224cc; padding:4px 10px; border-radius:999px; border:1px solid var(--line);\n  pointer-events:none;\n}\n.viewer-tag b{color:var(--accent)}\n.viewer-note{position:absolute; right:12px; bottom:10px; font-size:.72rem; color:#6f8cab; pointer-events:none}\n.fallback{padding:30px; color:var(--danger); font-size:.95rem}\n.tool{display:flex; flex-wrap:wrap; gap:8px; margin-top:10px; align-items:center}\n.stages{display:flex; flex-wrap:wrap; gap:6px; margin-top:12px}\n.stages button{flex:1 1 30%; min-width:110px; text-align:left; font-size:.82rem; line-height:1.3}\n.stages button .num{display:inline-block; min-width:1.4em; font-weight:800}\n.slider-row{display:flex; gap:12px; align-items:center; margin-top:12px; flex-wrap:wrap}\n.slider-row label{font-size:.88rem; color:var(--muted); white-space:nowrap}\ninput[type=\"range\"]{flex:1 1 160px; accent-color:var(--accent); height:28px}\noutput{font-variant-numeric:tabular-nums; font-size:.88rem; color:var(--amber); white-space:nowrap}\n.chk{display:inline-flex; gap:7px; align-items:center; font-size:.85rem; color:var(--muted); cursor:pointer}\n.chk input{width:18px;height:18px; accent-color:var(--cyan)}\n.info{\n  margin-top:12px; padding:12px 14px; background:#0e2540; border:1px solid var(--line);\n  border-radius:10px; font-size:.92rem;\n}\n.info h3{margin:0 0 6px; font-size:1rem; color:var(--accent)}\n.info p{margin:6px 0}\n.kbd-hint{font-size:.78rem; color:var(--muted); margin-top:8px}\nkbd{background:#102a48; border:1px solid var(--line); border-bottom-width:2px; border-radius:5px; padding:1px 6px; font-size:.78em}\n\nfooter{\n  border-top:1px solid var(--line); padding:16px clamp(14px,3vw,32px) 30px;\n  color:var(--muted); font-size:.85rem;\n}\nfooter p{margin:6px 0}\n\n/* SVG 공통 */\nsvg text{font-family:inherit; fill:var(--ink)}\n.svg-title{font-size:15px; font-weight:700; fill:var(--cyan)}\n.svg-sub{font-size:10.5px; fill:var(--muted)}\n.svg-dim{font-size:12px; font-weight:700}\n.svg-official{fill:var(--green)}\n.svg-est{fill:var(--amber)}\n.line{stroke:var(--cyan); stroke-width:1.4; fill:none}\n.line-thin{stroke:#4a6f95; stroke-width:.8; fill:none}\n.line-official{stroke:var(--green); stroke-width:1.6; fill:none}\n.line-est{stroke:var(--amber); stroke-width:1.3; stroke-dasharray:5 4; fill:none}\n.accent-stroke{stroke:var(--accent); transition:stroke .3s}\n#elevSil,#sectSil{stroke:var(--accent); transition:stroke .3s}\n.hl{transition:opacity .3s}\nbody[data-stage=\"3\"] .hl-belt{opacity:1 !important}\nbody[data-stage=\"3\"] .hl-core{opacity:1 !important}\n@media (prefers-reduced-motion:reduce){ *{transition:none !important; animation:none !important} }\n</style>\n</head>\n<body data-stage=\"1\">\n\n<header class=\"top\">\n  <h1>롯데월드타워 설계 과정 — 도면 × 3D 인터랙티브 아카이브</h1>\n  <span class=\"badge\">개념 재구성 · 공식 시공도면 아님</span>\n  <span class=\"badge model\">생성 모델: kimi-k3 (us.moonshotai.kimi-k3)</span>\n  <span class=\"sub\">서울 잠실 · 높이 555 m · 지상 123층 · 형태는 한국 도자기의 곡선에서 참고(KPF 설명) · 구조 LERA</span>\n</header>\n\n<div class=\"notice\" role=\"note\">\n  이 페이지는 공개 자료를 바탕으로 한 <b>설명용 개념 재구성</b>입니다. 공식 시공 도면이나 검증된 구조 설계가 아니며,\n  공개 자료에 없는 치수·단면·부재는 <b style=\"color:var(--amber)\">황색 점선/‘추정’ 표기</b>로 구분했습니다.\n  공개 수치(555 m·123층)는 <b style=\"color:var(--green)\">녹색</b>으로 표기합니다.\n</div>\n\n<main>\n  <!-- ═══ 좌: 도면 ═══ -->\n  <section class=\"panel\" aria-label=\"설계 도면\">\n    <h2>① 설계 도면 <small>개념 재구성 · 단위: m(미터)</small></h2>\n    <div class=\"tabs\" role=\"tablist\" aria-label=\"도면 종류 선택\">\n      <button role=\"tab\" aria-selected=\"true\"  data-draw=\"site\">배치도</button>\n      <button role=\"tab\" aria-selected=\"false\" data-draw=\"plan\">기준층 평면도</button>\n      <button role=\"tab\" aria-selected=\"false\" data-draw=\"elev\">입면도</button>\n      <button role=\"tab\" aria-selected=\"false\" data-draw=\"sect\">단면도</button>\n    </div>\n    <div class=\"drawing-box\">\n      <div id=\"d-site\" role=\"tabpanel\" aria-label=\"배치도\"></div>\n      <div id=\"d-plan\" role=\"tabpanel\" aria-label=\"기준층 평면도\" hidden></div>\n      <div id=\"d-elev\" role=\"tabpanel\" aria-label=\"입면도\" hidden></div>\n      <div id=\"d-sect\" role=\"tabpanel\" aria-label=\"단면도\" hidden></div>\n    </div>\n    <div class=\"legend\" aria-label=\"범례\">\n      <span class=\"k\"><span class=\"sw\"></span>공개 수치 (555 m · 123층)</span>\n      <span class=\"k\"><span class=\"sw est\"></span>추정 개념 (폭·코어·부재)</span>\n      <span class=\"k\"><span class=\"sw acc\"></span>현재 설계 단계 강조</span>\n    </div>\n    <div class=\"caption\" id=\"drawCaption\" aria-live=\"polite\"></div>\n  </section>\n\n  <!-- ═══ 우: 3D ═══ -->\n  <section class=\"panel\" aria-label=\"3D 모델 뷰어\">\n    <h2>② 단계별 3D 형상 &amp; 완성 모델 <small>드래그 회전 · 휠/핀치 확대 · R 초기화</small></h2>\n    <div class=\"viewer-wrap\">\n      <div id=\"gl\" tabindex=\"0\" role=\"img\"\n           aria-label=\"롯데월드타워 3D 개념 모형. 화살표 키로 회전, 더하기 빼기로 확대, R로 시점 초기화, 숫자 1~5로 설계 단계 선택.\"></div>\n      <div class=\"viewer-tag\">단계 <b id=\"stageTag\">1 · 콘셉트</b></div>\n      <div class=\"viewer-note\">개념 재구성 모형 · 실제 설계 아님</div>\n    </div>\n\n    <div class=\"stages\" role=\"group\" aria-label=\"설계 단계 선택 (단축키 1~5)\">\n      <button data-stage=\"1\" aria-pressed=\"true\"><span class=\"num\">1</span>콘셉트 — 도자기의 선</button>\n      <button data-stage=\"2\" aria-pressed=\"false\"><span class=\"num\">2</span>매스 스터디 — 테이퍼</button>\n      <button data-stage=\"3\" aria-pressed=\"false\"><span class=\"num\">3</span>구조 개념 — 코어+골조</button>\n      <button data-stage=\"4\" aria-pressed=\"false\"><span class=\"num\">4</span>외피 정제 — 커튼월</button>\n      <button data-stage=\"5\" aria-pressed=\"false\"><span class=\"num\">5</span>완성 — 555 m · 123층</button>\n    </div>\n\n    <div class=\"tool\">\n      <button id=\"btnRotate\" aria-pressed=\"true\">⏸ 자동 회전 끄기</button>\n      <button id=\"btnReset\">⌂ 시점 초기화 (R)</button>\n      <label class=\"chk\"><input type=\"checkbox\" id=\"chkSlice\" checked> 높이 단면 표시</label>\n    </div>\n\n    <div class=\"slider-row\">\n      <label for=\"heightSlider\">높이 선택 (도면 ↔ 3D 연동)</label>\n      <input type=\"range\" id=\"heightSlider\" min=\"0\" max=\"555\" step=\"1\" value=\"90\"\n             aria-label=\"건물 높이 선택, 0에서 555미터\">\n      <output id=\"heightOut\" for=\"heightSlider\"></output>\n    </div>\n\n    <div class=\"info\" aria-live=\"polite\">\n      <h3 id=\"stageTitle\"></h3>\n      <p id=\"stageDesc\"></p>\n      <p id=\"stageMap\" style=\"color:var(--muted); font-size:.87rem\"></p>\n      <div class=\"kbd-hint\">키보드: <kbd>←→↑↓</kbd> 회전 · <kbd>+</kbd>/<kbd>-</kbd> 확대·축소 · <kbd>R</kbd> 초기화 · <kbd>1</kbd>~<kbd>5</kbd> 단계</div>\n    </div>\n  </section>\n</main>\n\n<footer>\n  <p>참고 출처(텍스트 링크, 실행 중 자동으로 가져오지 않음):\n    원 설계사 <a href=\"https://www.kpf.com/project/lotte-world-tower\" rel=\"noopener\">KPF — Lotte World Tower</a> ·\n    구조 설계사 <a href=\"https://www.lera.com/lotte-world-tower\" rel=\"noopener\">LERA — Lotte World Tower</a></p>\n  <p>공개 수치: 높이 555 m, 지상 123층, 상향 테이퍼 형태, 한국 도자기 곡선 참고(KPF 설명). 그 외 폭·코어·기둥·벨트 위치 등은 설명을 위한 추정 개념입니다.</p>\n  <p>본 인터랙티브 문서는 <b>kimi-k3</b> 모델이 생성했습니다.</p>\n</footer>\n\n<script src=\"../runtime/three-runtime.js\"></script>\n<script>\n(function(){\n\"use strict\";\n/* ════════ 0. 공통 수치/함수 ════════ */\nconst H=555, FLOORS=123, BASE_W=72, TOP_W=44; // 폭·코어 등은 추정 개념\nconst clamp=(v,a,b)=>Math.min(Math.max(v,a),b);\nfunction widthAt(h){ const t=clamp(h/H,0,1); return BASE",
