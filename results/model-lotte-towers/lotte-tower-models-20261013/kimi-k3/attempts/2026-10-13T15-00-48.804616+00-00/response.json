{
  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"/>\n<title>Trunnion Bascule Bridge — Interactive Study Model</title>\n<style>\n  :root{\n    --ink:#0b1626; --chip:rgba(13,26,44,.88); --line:#2c4d70; --txt:#e9eef5;\n    --dim:#9db4c8; --accent:#e08a3c; --accent-ink:#221304;\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0;height:100%;overflow:hidden;background:var(--ink);color:var(--txt);\n    font:14px/1.45 system-ui,-apple-system,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif}\n  #app{position:fixed;inset:0}\n  #gl{position:absolute;inset:0;width:100%;height:100%;display:block;touch-action:none;outline:none}\n  #labels{position:absolute;inset:0;pointer-events:none;overflow:hidden}\n  .lbl{position:absolute;left:0;top:0;transform:translate(-50%,-135%);background:var(--chip);\n    border:1px solid var(--line);color:var(--txt);padding:3px 9px;border-radius:20px;\n    font-size:12px;letter-spacing:.02em;white-space:nowrap}\n  .lbl::after{content:\"\";position:absolute;left:50%;top:100%;width:1px;height:9px;background:var(--line)}\n  header{position:absolute;top:0;left:0;right:0;display:flex;align-items:flex-start;gap:8px;\n    padding:10px 12px;pointer-events:none;flex-wrap:wrap}\n  header .title{pointer-events:none;background:var(--chip);border:1px solid var(--line);\n    border-radius:12px;padding:7px 12px}\n  header h1{font-size:14px;margin:0;font-weight:650;letter-spacing:.09em}\n  header .sub{font-size:11px;color:var(--dim);letter-spacing:.05em}\n  .spacer{flex:1}\n  .btn{pointer-events:auto;appearance:none;border:1px solid var(--line);background:var(--chip);\n    color:var(--txt);border-radius:10px;padding:8px 12px;font-size:13px;line-height:1.1;\n    cursor:pointer;min-height:42px;min-width:42px}\n  .btn:hover{border-color:#4a7396}\n  .btn[aria-pressed=\"true\"]{background:var(--accent);color:var(--accent-ink);\n    border-color:var(--accent);font-weight:650}\n  .btn:focus-visible{outline:2px solid #ffd27a;outline-offset:2px}\n  #stagebar{position:absolute;left:50%;bottom:12px;transform:translateX(-50%);display:flex;\n    gap:6px;align-items:stretch;justify-content:center;flex-wrap:wrap;max-width:97vw}\n  .stage{padding:6px 10px}\n  .stage small{display:block;font-size:10px;color:var(--dim);letter-spacing:.03em}\n  .stage[aria-pressed=\"true\"] small{color:#3a2200}\n  #stagename{position:absolute;left:12px;bottom:12px;max-width:36ch;background:var(--chip);\n    border:1px solid var(--line);border-radius:12px;padding:9px 12px}\n  #stagename b{display:block;font-size:13px;letter-spacing:.04em}\n  #stagename span{font-size:12px;color:var(--dim)}\n  aside.panel{position:absolute;top:64px;right:12px;width:min(400px,94vw);\n    max-height:calc(100% - 150px);overflow:auto;background:var(--chip);\n    border:1px solid var(--line);border-radius:14px;padding:10px;backdrop-filter:blur(5px)}\n  aside.panel[hidden]{display:none}\n  #draw{width:100%;height:auto;display:block;border-radius:8px;background:#f2e7d3}\n  #pInfo h2{font-size:13px;margin:10px 0 4px;letter-spacing:.06em}\n  #pInfo h2:first-child{margin-top:2px}\n  #pInfo p,#pInfo li{font-size:12.5px}\n  #pInfo ul{margin:4px 0 8px;padding-left:18px}\n  #pInfo table{border-collapse:collapse;font-size:12px;margin:4px 0 8px}\n  #pInfo td{border:1px solid var(--line);padding:2px 8px}\n  kbd{background:#0009;border:1px solid var(--line);border-radius:4px;padding:0 5px;font-size:11px}\n  #hint{position:absolute;top:64px;left:12px;font-size:11.5px;color:var(--dim);\n    background:var(--chip);border:1px solid var(--line);padding:6px 10px;border-radius:10px;max-width:44ch}\n  #fallback{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;\n    text-align:center;padding:24px;background:var(--ink);z-index:10}\n  #fallback[hidden]{display:none}\n  @media (max-width:720px){\n    #hint{display:none}\n    #stagename{display:none}\n    header h1{font-size:12px}\n    aside.panel{top:auto;bottom:78px;right:8px;left:8px;width:auto;max-height:44vh}\n  }\n</style>\n</head>\n<body>\n<div id=\"app\">\n  <canvas id=\"gl\" aria-label=\"Interactive 3D model of a trunnion bascule drawbridge\"></canvas>\n  <div id=\"labels\" aria-hidden=\"true\"></div>\n\n  <header>\n    <div class=\"title\">\n      <h1>TRUNNION BASCULE BRIDGE</h1>\n      <div class=\"sub\">interactive study model &middot; ink &amp; blueprint</div>\n    </div>\n    <div class=\"spacer\"></div>\n    <button class=\"btn\" id=\"bLabels\" aria-pressed=\"true\" title=\"Toggle part labels (L)\">Labels</button>\n    <button class=\"btn\" id=\"bDraw\" aria-pressed=\"false\" title=\"Toggle dimensioned drawings (G)\">Drawings</button>\n    <button class=\"btn\" id=\"bInfo\" aria-pressed=\"false\" title=\"Toggle source &amp; dimensions (I)\">Info</button>\n    <button class=\"btn\" id=\"bMotion\" aria-pressed=\"true\" title=\"Toggle motion (M)\">Motion</button>\n    <button class=\"btn\" id=\"bReset\" title=\"Reset camera (R)\">Reset view</button>\n  </header>\n\n  <div id=\"hint\">Drag to orbit &middot; wheel / pinch to zoom &middot; <kbd>&larr;</kbd><kbd>&rarr;</kbd> stages &middot; <kbd>O</kbd> open/close &middot; <kbd>Space</kbd> pause</div>\n\n  <aside class=\"panel\" id=\"pDraw\" hidden aria-label=\"Dimensioned technical drawings\">\n    <canvas id=\"draw\" width=\"760\" height=\"1180\"></canvas>\n  </aside>\n\n  <aside class=\"panel\" id=\"pInfo\" hidden aria-label=\"Source basis and assumed dimensions\">\n    <h2>SOURCE BASIS</h2>\n    <p>Original interpretation of classic <em>trunnion bascule</em> practice (Chicago-type\n    single leaf): the deck and a rear counterweight rotate as one rigid body about a fixed\n    horizontal axle, the counterweight sinking into a bankside pit as the leaf rises.\n    Proportions, colours and details are the author&rsquo;s own; no specific bridge is reproduced.</p>\n    <h2>ASSUMED DIMENSIONS (metres)</h2>\n    <table>\n      <tr><td>Moving leaf</td><td>12.00 &times; 6.00 &times; 0.60</td></tr>\n      <tr><td>Navigation channel (clear)</td><td>14.00</td></tr>\n      <tr><td>Trunnion axis above water</td><td>1.60</td></tr>\n      <tr><td>Counterweight block</td><td>2.60 &times; 2.00 &times; 3.20</td></tr>\n      <tr><td>Maximum opening angle</td><td>62&deg;</td></tr>\n      <tr><td>Tug: length / beam / air draft</td><td>8.00 / 2.60 / 5.40</td></tr>\n    </table>\n    <p style=\"color:var(--dim)\">Diagrammatic study model — not for construction.</p>\n    <h2>CONTROLS</h2>\n    <ul>\n      <li>Pointer / touch: drag to orbit, wheel or pinch to zoom, two-finger drag to pan.</li>\n      <li><kbd>&larr;</kbd> <kbd>&rarr;</kbd> build stages &middot; <kbd>&uarr;</kbd> <kbd>&darr;</kbd> zoom</li>\n      <li><kbd>O</kbd> open / close leaf &middot; <kbd>1</kbd>–<kbd>5</kbd> jump to stage</li>\n      <li><kbd>L</kbd> labels &middot; <kbd>G</kbd> drawings &middot; <kbd>I</kbd> info &middot; <kbd>M</kbd> motion &middot; <kbd>R</kbd> reset view &middot; <kbd>Space</kbd> pause ambience</li>\n    </ul>\n    <h2>MOTION</h2>\n    <p>Honours the operating system&rsquo;s <em>prefers-reduced-motion</em> setting: stage changes,\n    water and vessel movement become instantaneous or static. The Motion button overrides it manually.</p>\n  </aside>\n\n  <div id=\"stagename\"><b id=\"stTitle\"></b><span id=\"stDesc\"></span></div>\n\n  <nav id=\"stagebar\" aria-label=\"Build and operating stages\">\n    <button class=\"btn\" id=\"bPrev\" title=\"Previous stage (Left arrow)\">&#9664;</button>\n    <button class=\"btn\" id=\"bNext\" title=\"Next stage (Right arrow)\">&#9654;</button>\n  </nav>\n\n  <div id=\"fallback\" hidden>\n    <div>\n      <h1 style=\"font-size:16px;letter-spacing:.08em\">3D UNAVAILABLE</h1>\n      <p>This exhibit needs WebGL and the provided three-runtime. The\n      <button class=\"btn\" id=\"bDraw2\">Drawings</button> and\n      <button class=\"btn\" id=\"bInfo2\">Info</button> panels still work.</p>\n    </div>\n  </div>\n</div>\n\n<script src=\"../runtime/three-runtime.js\"></script>\n<script>\n(function(){\n\"use strict\";\n\n/* ---------- environment & motion preference ---------- */\nvar mq = window.matchMedia ? window.matchMedia(\"(prefers-reduced-motion: reduce)\")\n                           : {matches:false, addEventListener:function(){}};\nvar reduced = !!mq.matches;\nvar paused  = false;                 // ambient pause (Space)\nvar glOK    = true;\n\n/* ---------- dom refs ---------- */\nfunction $(id){ return document.getElementById(id); }\nvar glCanvas=$(\"gl\"), labelsRoot=$(\"labels\"), fallback=$(\"fallback\");\n\n/* ---------- 2D drawings (independent of WebGL) ---------- */\nvar INK=\"#1d2a3a\", DIMC=\"#33507a\", RED=\"#b3402a\", WATERC=\"#2a7d9c\";\nfunction arrow(c,x,y,ang){\n  var s=6;\n  c.beginPath();\n  c.moveTo(x,y);\n  c.lineTo(x-s*Math.cos(ang-0.42), y-s*Math.sin(ang-0.42));\n  c.lineTo(x-s*Math.cos(ang+0.42), y-s*Math.sin(ang+0.42));\n  c.closePath(); c.fill();\n}\nfunction dimH(c,x1,x2,y,text){           // horizontal dimension\n  c.strokeStyle=DIMC; c.fillStyle=DIMC; c.lineWidth=1;\n  c.beginPath(); c.moveTo(x1,y-5); c.lineTo(x1,y+5);\n  c.moveTo(x2,y-5); c.lineTo(x2,y+5);\n  c.moveTo(x1,y); c.lineTo(x2,y); c.stroke();\n  arrow(c,x1,y,0); arrow(c,x2,y,Math.PI);\n  c.font=\"10px ui-monospace,Menlo,Consolas,monospace\"; c.textAlign=\"center\";\n  c.fillText(text,(x1+x2)/2,y-4);\n}\nfunction dimV(c,x,y1,y2,text){           // vertical dimension\n  c.strokeStyle=DIMC; c.fillStyle=DIMC; c.lineWidth=1;\n  c.beginPath(); c.moveTo(x-5,y1); c.lineTo(x+5,y1);\n  c.moveTo(x-5,y2); c.lineTo(x+5,y2);\n  c.moveTo(x,y1); c.lineTo(x,y2); c.stroke();\n  arrow(c,x,y1,Math.PI/2); arrow(c,x,y2,-Math.PI/2);\n  c.font=\"10px ui-monospace,Menlo,Consolas,monospace\"; c.textAlign=\"left\";\n  c.save(); c.translate(x+4,(y1+y2)/2); c.rotate(-Math.PI/2); c.textAlign=\"center\";\n  c.fillText(text,0,0); c.restore();\n}\nfunction hatch(c,x1,x2,y){\n  c.strokeStyle=INK; c.lineWidth=1;\n  c.beginPath(); c.moveTo(x1,y); c.lineTo(x2,y); c.stroke();\n  c.beginPath();\n  for(var x=x1+6;x<x2;x+=9){ c.moveTo(x,y); c.lineTo(x-5,y+6); }\n  c.stroke();\n}\nfunction drawDrawings(){\n  var cv=$(\"draw\"), c=cv.getContext(\"2d\"); if(!c) return;\n  var W=cv.width, H=cv.height;\n  c.fillStyle=\"#f2e7d3\"; c.fillRect(0,0,W,H);\n  c.strokeStyle=INK; c.lineWidth=2; c.strokeRect(10,10,W-20,H-20);\n  c.fillStyle=INK; c.textAlign=\"center\";\n  c.font=\"bold 15px ui-monospace,Menlo,Consolas,monospace\";\n  c.fillText(\"TRUNNION BASCULE BRIDGE — STUDY DRAWINGS\", W/2, 34);\n  c.font=\"10px ui-monospace,Menlo,Consolas,monospace\"; c.fillStyle=DIMC;\n  c.fillText(\"DIAGRAMMATIC · ASSUMED DIMENSIONS IN METRES · NOT FOR CONSTRUCTION\", W/2, 50);\n\n  /* --- side elevation --- */\n  c.fillStyle=INK; c.font=\"bold 11px ui-monospace,Menlo,Consolas,monospace\"; c.textAlign=\"left\";\n  c.fillText(\"SIDE ELEVATION — LEAF AT FULL OPENING (62°)\", 34, 78);\n  var S=21, gx=110, gy=250;                    // pivot pixel; S px per metre\n  function px(mx){ return gx + mx*S; }\n  function py(my){ return gy - my*S; }\n  // ground lines (deck level 3.5, water 1.6, pivot y 3.2, pivot x 0)\n  hatch(c, px(-9), px(-1), py(3.5));\n  hatch(c, px(13), px(21), py(3.5));\n  // water\n  c.strokeStyle=WATERC; c.lineWidth=1.4; c.beginPath();\n  for(var i=0;i<=28;i++){ var wx=px(-1)+i*(px(13)-px(-1))/28;\n    var wy=py(1.6)+((i%2)?3:-3); if(i===0)c.moveTo(wx,wy); else c.lineTo(wx,wy); }\n  c.stroke();\n  // channel walls\n  c.strokeStyle=INK; c.lineWidth=2; c.beginPath();\n  c.moveTo(px(-1),py(3.5)); c.lineTo(px(-1),py(0.6));\n  c.moveTo(px(13),py(3.5)); c.lineTo(px(13),py(0.6)); c.stroke();\n  // east rest pier\n  c.fillStyle=\"#c9bfa8\"; c.strokeStyle=INK; c.lineWidth=1.4;\n  c.fillRect(px(11.4),py(2.9),(13.4-11.4)*S,(2.9-0.6)*S);\n  c.strokeRect(px(11.4),py(2.9),(13.4-11.4)*S,(2.9-0.6)*S);\n  // pit mouth + counterweight closed (ghost) and open positions\n  c.fillStyle=\"#241f18\"; c.fillRect(px(-3.6),py(3.5),2.8*S,0.35*S);\n  c.strokeStyle=RED; c.setLineDash([4,3]); c.lineWidth=1.2;\n  c.beginPath(); c.arc(px(0),py(3.2),2.56*S, -Math.PI+Math.atan2(1.3,2.2), Math.atan2(1.3,2.2)-Math.PI+1.08,false); c.stroke();\n  c.setLineDash([]);\n  c.fillStyle=\"rgba(176,58,38,.85)\"; c.strokeStyle=INK;\n  c.fillRect(px(-3.5),py(5.5),2.6*S,2.0*S); c.strokeRect(px(-3.5),py(5.5),2.6*S,2.0*S);\n  c.fillStyle=RED; c.font=\"9px ui-monospace,monospace\"; c.textAlign=\"center",
  "tokens_in": 7,
  "tokens_out": 16384,
