  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>롯데월드타워 설계 과정 — 인터랙티브 개념 재구성</title>\n<script src=\"../runtime/three-runtime.js\"></script>\n<style>\n:root{--bg:#0d1117;--panel:#151b24;--line:#2a3442;--txt:#e8edf4;--sub:#9fb0c3;--acc:#6fb3e8;--acc2:#e8b96f;--warn:#f0d9a8}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--bg);color:var(--txt);font-family:\"Segoe UI\",system-ui,-apple-system,\"Malgun Gothic\",sans-serif;line-height:1.5}\nheader{padding:14px 18px;border-bottom:1px solid var(--line);display:flex;flex-wrap:wrap;gap:8px 16px;align-items:baseline}\nh1{font-size:1.15rem;margin:0}\n.badge{font-size:.72rem;background:#1d2a3a;border:1px solid var(--line);border-radius:20px;padding:3px 10px;color:var(--acc)}\n.note{flex-basis:100%;font-size:.75rem;color:var(--warn)}\nmain{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding:14px}\n@media(max-width:920px){main{grid-template-columns:1fr}}\n.panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px}\nh2{font-size:.95rem;margin:0 0 8px;color:var(--acc)}\nh3{font-size:.82rem;margin:10px 0 4px;color:var(--sub)}\n.tabs{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}\nbutton{font:inherit;cursor:pointer;border-radius:8px;border:1px solid var(--line);background:#1c2531;color:var(--txt);padding:7px 11px;font-size:.8rem}\nbutton:hover{border-color:var(--acc)}\nbutton.on{background:var(--acc);color:#08131f;border-color:var(--acc);font-weight:700}\nbutton:focus-visible,.viewer:focus-visible{outline:3px solid var(--acc2);outline-offset:2px}\n.drawing{display:none}\n.drawing.on{display:block}\nsvg{width:100%;height:auto;background:#101720;border:1px solid var(--line);border-radius:8px}\n.cap{font-size:.74rem;color:var(--sub);margin-top:6px}\n.cap b{color:var(--txt)}\n#gl{position:relative;height:460px;border-radius:8px;overflow:hidden;background:#0a0e14}\n@media(max-width:600px){#gl{height:340px}}\n#gl canvas{display:block}\n.vbar{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;align-items:center}\n.vbar label{font-size:.78rem;color:var(--sub);display:flex;gap:4px;align-items:center}\n.sbtns{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}\n#sdesc{font-size:.78rem;color:var(--sub);background:#101720;border:1px solid var(--line);border-radius:8px;padding:8px;min-height:3.2em}\n#corr{margin:14px;padding:10px 14px;border:1px solid var(--acc2);border-radius:10px;background:#1a1812;font-size:.8rem}\n#corr b{color:var(--acc2)}\nfooter{padding:0 14px 18px;font-size:.72rem;color:var(--sub)}\nfooter a{color:var(--acc)}\n.dim{stroke:#e8b96f;stroke-width:1;fill:none}\n.dt{fill:#e8b96f;font-size:9px}\n.lb{fill:#9fb0c3;font-size:9px}\n.lbb{fill:#e8edf4;font-size:10px;font-weight:700}\n.st{stroke:#6fb3e8;fill:none;stroke-width:1.4}\n.stf{fill:rgba(111,179,232,.08);stroke:#6fb3e8;stroke-width:1.4}\n.dash{stroke:#3a4656;stroke-dasharray:4 3;fill:none}\n.fl{stroke:#2f4a63;stroke-width:.6}\n.col{fill:#e8b96f}\n#fallback{display:none;padding:20px;color:var(--warn);font-size:.85rem}\n@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}\n</style>\n</head>\n<body>\n<header>\n<h1>롯데월드타워 건축 설계 과정 · 인터랙티브 개념 재구성</h1>\n<span class=\"badge\">모델: kimi-k3 · us.moonshotai.kimi-k3</span>\n<span class=\"note\">본 페이지는 공개 자료 기반의 <b>설명용 개념 재구성</b>입니다. 공식 시공 도면이나 검증된 구조 설계가 아니며, 공개 자료에 없는 치수·단면·부재는 <b>추정 개념</b>으로 표기했습니다.</span>\n</header>\n<main>\n<section class=\"panel\" aria-label=\"설계 도면\">\n<h2>① 설계 도면 (단위: m)</h2>\n<div class=\"tabs\" role=\"tablist\">\n<button class=\"dtab on\" data-d=\"d1\" data-s=\"1\" role=\"tab\">배치도</button>\n<button class=\"dtab\" data-d=\"d2\" data-s=\"3\" role=\"tab\">기준층 평면도</button>\n<button class=\"dtab\" data-d=\"d3\" data-s=\"2\" role=\"tab\">입면도</button>\n<button class=\"dtab\" data-d=\"d4\" data-s=\"5\" role=\"tab\">단면도</button>\n</div>\n\n<div class=\"drawing on\" id=\"d1\">\n<svg viewBox=\"0 0 400 300\" aria-label=\"배치도\">\n<rect x=\"0\" y=\"0\" width=\"400\" height=\"300\" fill=\"#101720\"/>\n<path d=\"M0,40 C60,30 90,70 70,120 C55,160 20,180 0,170 Z\" fill=\"#16324a\" stroke=\"#2a5a80\"/>\n<text x=\"8\" y=\"105\" class=\"lb\">석촌호수(개념)</text>\n<line x1=\"0\" y1=\"255\" x2=\"400\" y2=\"255\" class=\"dash\" stroke-width=\"6\" stroke=\"#3a4656\"/>\n<text x=\"300\" y=\"248\" class=\"lb\">올림픽로 방면(개념)</text>\n<rect x=\"130\" y=\"60\" width=\"210\" height=\"170\" fill=\"none\" stroke=\"#e8b96f\" stroke-dasharray=\"6 4\"/>\n<text x=\"136\" y=\"55\" class=\"dt\">대지 경계(개념)</text>\n<rect x=\"190\" y=\"115\" width=\"90\" height=\"90\" rx=\"24\" class=\"stf\"/>\n<text x=\"196\" y=\"163\" class=\"lbb\">타워</text>\n<rect x=\"150\" y=\"90\" width=\"30\" height=\"20\" fill=\"#22303f\"/><rect x=\"295\" y=\"150\" width=\"36\" height=\"24\" fill=\"#22303f\"/><rect x=\"200\" y=\"215\" width=\"46\" height=\"14\" fill=\"#22303f\"/>\n<text x=\"150\" y=\"84\" class=\"lb\">주변 저층부·몰(개념)</text>\n<line x1=\"300\" y1=\"285\" x2=\"360\" y2=\"285\" class=\"dim\"/><line x1=\"300\" y1=\"281\" x2=\"300\" y2=\"289\" class=\"dim\"/><line x1=\"360\" y1=\"281\" x2=\"360\" y2=\"289\" class=\"dim\"/>\n<text x=\"312\" y=\"278\" class=\"dt\">50 (추정 축척)</text>\n<text x=\"8\" y=\"295\" class=\"lb\">배치도: 대지 내 타워 위치·주변 관계를 보여주는 개념도</text>\n</svg>\n<div class=\"cap\"><b>배치도</b> · 단위 m · 치수 근거: 공개된 대지 이미지의 <b>추정 개념</b>. 실제 측량 배치도가 아닙니다. 대응: <b>설계 단계 01 매스 스터디</b></div>\n</div>\n\n<div class=\"drawing\" id=\"d2\">\n<svg viewBox=\"0 0 400 380\" aria-label=\"기준층 평면도\">\n<line x1=\"200\" y1=\"20\" x2=\"200\" y2=\"330\" class=\"dash\"/><line x1=\"30\" y1=\"175\" x2=\"370\" y2=\"175\" class=\"dash\"/>\n<rect x=\"60\" y=\"35\" width=\"280\" height=\"280\" rx=\"58\" class=\"stf\"/>\n<text x=\"120\" y=\"180\" class=\"lb\">사무실 공간(개념)</text>\n<rect x=\"165\" y=\"140\" width=\"70\" height=\"70\" fill=\"rgba(232,185,111,.15)\" stroke=\"#e8b96f\"/>\n<text x=\"172\" y=\"178\" class=\"dt\">코어</text>\n<g class=\"col\"><rect x=\"66\" y=\"41\" width=\"12\" height=\"12\"/><rect x=\"322\" y=\"41\" width=\"12\" height=\"12\"/><rect x=\"66\" y=\"297\" width=\"12\" height=\"12\"/><rect x=\"322\" y=\"297\" width=\"12\" height=\"12\"/><rect x=\"194\" y=\"38\" width=\"12\" height=\"12\"/><rect x=\"194\" y=\"300\" width=\"12\" height=\"12\"/><rect x=\"63\" y=\"169\" width=\"12\" height=\"12\"/><rect x=\"325\" y=\"169\" width=\"12\" height=\"12\"/></g>\n<text x=\"252\" y=\"100\" class=\"dt\">메가기둥 8(치수 추정)</text>\n<line x1=\"60\" y1=\"345\" x2=\"340\" y2=\"345\" class=\"dim\"/><line x1=\"60\" y1=\"340\" x2=\"60\" y2=\"350\" class=\"dim\"/><line x1=\"340\" y1=\"340\" x2=\"340\" y2=\"350\" class=\"dim\"/>\n<text x=\"130\" y=\"360\" class=\"dt\">약 70 (저층 기준층, 추정 개념)</text>\n<line x1=\"355\" y1=\"35\" x2=\"355\" y2=\"315\" class=\"dim\"/><line x1=\"350\" y1=\"35\" x2=\"360\" y2=\"35\" class=\"dim\"/><line x1=\"350\" y1=\"315\" x2=\"360\" y2=\"315\" class=\"dim\"/>\n<text x=\"363\" y=\"178\" class=\"dt\">약 70 (추정)</text>\n<text x=\"30\" y=\"25\" class=\"lb\">기준층 평면도: 저층부 예시. 층이 올라갈수록 외곽·면적 축소</text>\n</svg>\n<div class=\"cap\"><b>기준층 평면도</b> · 단위 m · 근거: 8개 메가기둥+코어 체계는 KPF/LERA 공개 설명, 폭 70m·코어 30m는 <b>추정 개념</b>. 대응: <b>단계 03 구조 시스템</b></div>\n</div>\n\n<div class=\"drawing\" id=\"d3\">\n<svg viewBox=\"0 0 300 560\" aria-label=\"입면도\">\n<path d=\"M95,540 C100,380 88,300 118,170 C128,120 130,60 133,24 L167,24 C170,60 172,120 182,170 C212,300 200,380 205,540 Z\" class=\"stf\"/>\n<g class=\"fl\"><line x1=\"97\" y1=\"480\" x2=\"203\" y2=\"480\"/><line x1=\"99\" y1=\"420\" x2=\"201\" y2=\"420\"/><line x1=\"101\" y1=\"360\" x2=\"199\" y2=\"360\"/><line x1=\"105\" y1=\"300\" x2=\"195\" y2=\"300\"/><line x1=\"111\" y1=\"240\" x2=\"189\" y2=\"240\"/><line x1=\"118\" y1=\"180\" x2=\"182\" y2=\"180\"/><line x1=\"125\" y1=\"120\" x2=\"175\" y2=\"120\"/><line x1=\"129\" y1=\"60\" x2=\"171\" y2=\"60\"/></g>\n<line x1=\"150\" y1=\"24\" x2=\"150\" y2=\"540\" class=\"dash\"/>\n<line x1=\"235\" y1=\"24\" x2=\"235\" y2=\"540\" class=\"dim\"/><line x1=\"228\" y1=\"24\" x2=\"242\" y2=\"24\" class=\"dim\"/><line x1=\"228\" y1=\"540\" x2=\"242\" y2=\"540\" class=\"dim\"/>\n<text x=\"244\" y=\"285\" class=\"dt\">555 (공개 수치)</text>\n<line x1=\"40\" y1=\"24\" x2=\"133\" y2=\"24\" class=\"dim\" opacity=\".5\"/>\n<text x=\"18\" y=\"20\" class=\"lb\">랜턴 상부(개념)</text>\n<text x=\"18\" y=\"545\" class=\"lb\">±0.00 · 지상 123층(공개 수치)</text>\n<text x=\"60\" y=\"300\" class=\"lb\" transform=\"rotate(-90 60 300)\">도자기 곡선(추정 재현)</text>\n</svg>\n<div class=\"cap\"><b>입면도</b> · 단위 m · 근거: 높이 555m·123층은 공개 수치, 상부로 좁아지는 S곡선은 KPF가 밝힌 한국 도자기 선의 <b>추정 재현</b>. 대응: <b>단계 02 도자기 곡선</b></div>\n</div>\n\n<div class=\"drawing\" id=\"d4\">\n<svg viewBox=\"0 0 340 560\" aria-label=\"단면도\">\n<path d=\"M85,540 C90,380 78,300 108,170 C118,120 120,60 123,24 L147,24 C150,60 152,120 162,170 C192,300 180,380 185,540 Z\" class=\"stf\"/>\n<rect x=\"125\" y=\"60\" width=\"20\" height=\"480\" fill=\"rgba(232,185,111,.14)\" stroke=\"#e8b96f\" stroke-dasharray=\"3 2\"/>\n<text x=\"152\" y=\"70\" class=\"dt\">코어(개념)</text>\n<g class=\"fl\"><line x1=\"87\" y1=\"480\" x2=\"183\" y2=\"480\"/><line x1=\"89\" y1=\"420\" x2=\"181\" y2=\"420\"/><line x1=\"91\" y1=\"360\" x2=\"179\" y2=\"360\"/><line x1=\"95\" y1=\"300\" x2=\"175\" y2=\"300\"/><line x1=\"101\" y1=\"240\" x2=\"169\" y2=\"240\"/><line x1=\"108\" y1=\"180\" x2=\"162\" y2=\"180\"/><line x1=\"115\" y1=\"120\" x2=\"155\" y2=\"120\"/></g>\n<line x1=\"85\" y1=\"540\" x2=\"185\" y2=\"540\" class=\"st\"/>\n<rect x=\"95\" y=\"548\" width=\"80\" height=\"9\" fill=\"#22303f\" stroke=\"#3a4656\"/>\n<text x=\"195\" y=\"556\" class=\"lb\">기초·지하(개념)</text>\n<line x1=\"240\" y1=\"24\" x2=\"240\" y2=\"540\" class=\"dim\"/><line x1=\"233\" y1=\"24\" x2=\"247\" y2=\"24\" class=\"dim\"/><line x1=\"233\" y1=\"540\" x2=\"247\" y2=\"540\" class=\"dim\"/>\n<text x=\"250\" y=\"285\" class=\"dt\">555</text>\n<text x=\"200\" y=\"130\" class=\"lb\">벨트 트러스층(개념, 위치 추정)</text>\n<line x1=\"160\" y1=\"180\" x2=\"198\" y2=\"132\" class=\"dash\"/>\n<text x=\"200\" y=\"350\" class=\"lb\">기둥↔코어 협력(공개 개념)</text>\n<line x1=\"150\" y1=\"360\" x2=\"198\" y2=\"352\" class=\"dash\"/>\n<text x=\"14\" y=\"20\" class=\"lb\">단면도: 내부 구조·수직 동선을 보여주는 개념 절단면</text>\n</svg>\n<div class=\"cap\"><b>단면도</b> · 단위 m · 근거: 코어+외곽 기둥 협력 구조는 LERA 공개 설명, 벨트 트러스 위치·기초 형상·층고 배분은 <b>추정 개념</b>. 대응: <b>단계 05 / 완성 모델</b></div>\n</div>\n</section>\n\n<section class=\"panel\" aria-label=\"3D 모델\">\n<h2>② 설계 단계별 3D 형상 & 완성 모델</h2>\n<div class=\"sbtns\" role=\"group\" aria-label=\"설계 단계 선택\">\n<button class=\"sbtn on\" data-s=\"1\">01 매스</button>\n<button class=\"sbtn\" data-s=\"2\">02 도자기 곡선</button>\n<button class=\"sbtn\" data-s=\"3\">03 구조</button>\n<button class=\"sbtn\" data-s=\"4\">04 층·커튼월</button>\n<button class=\"sbtn\" data-s=\"5\">05 완성·랜턴</button>\n<button class=\"sbtn\" data-s=\"F\">★ 완성 모델</button>\n</div>\n<div id=\"gl\" class=\"viewer\" tabindex=\"0\" role=\"application\" aria-label=\"3D 뷰어: 드래그 회전, 휠 확대, 화살표 키 회전, 더하기 빼기 확대축소, R 초기화\">\n<div id=\"fallback\">3D 런타임(three-runtime.js)을 불러오지 못했습니다. 도면과 단계 설명은 정상 동작합니다.</div>\n</div>\n<div class=\"vbar\">\n<button id=\"zin\">확대 ＋</button><button id=\"zout\">축소 －</button><button id=\"rst\">시점 초기화 ⟲</button>\n<label><input type=\"checkbox\" id=\"spin\"> 자동 회전</label>\n</div>\n<h3>단계 설명</h3>\n<div id=\"sdesc\"></div>\n<h3>조작 안내</h3>\n<div class=\"cap\">드래그=회전 · 휠/두 손가락=확대축소 · 키보드: ←→ 회전, ↑↓ 확대축소, R 초기화</div>\n</section>\n</main>\n\n<div id=\"corr\" aria-live=\"polite\"></div>\n<footer>\n참고 출처(텍스트 링크, 실행 중 가져오지 않음): 원 설계사 <a href=\"https://www.kpf.com/project/lotte-world-tower\" rel=\"noreferrer\">KPF – Lotte World Tower</a> · 구조 설계사 <a href=\"https://www.lera.com/lotte-world-tower\" rel=\"noreferrer\">LERA – Lotte World Tower</a>. 공개 수치: 높이 555m, 지상 123층. 그 외 모든 치수·부재·단면은 설명을 위한 <b>추정 개념</b>입니다.\n</footer>\n\n<script>\n(function(){\n\"use strict\";\nvar $=function(q){return document.querySelector(q)},qa=function(q){return document.querySelectorAll(q)};\nvar RM=window.matchMedia&&matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n/* ---------- 단계 설명 / 대응 관계 ---------- */\nvar SINFO={\n\"1\":\"단계 01 매스 스터디: 대지 조건과 층별 면적 축소 요구를 반영한 초기 볼륨. 상부로 갈수록 외곽이 좁아지는 큰 틀만 결정합니다. ↔ 배치도의 타워 위치와 대응합니다.\",\n\"2\":\"단계 02 도자기 곡선: KPF가 밝힌 한국 도자기의 선을 참고해 직선 테이퍼를 부드러운 S곡선 실루엣으로 다듬습니다. ↔ 입면도의 곡선과 대응합니다.\",\n\"3\":\"단계 03 구조 시스템: 중앙 코어와 8개 메가기둥이 하중을 나누는 공개된 구조 개념을 형상화했습니다(부재 크기는 추정). ↔ 기준층 평면도와 대응합니다.\",\n\"4\":\"단계 04 층·커튼월: 123개 층(표시는 일부)과 유리 커튼월 마감을 입히고 층선을 드러냅니다. ↔ 입면도의 층 표시와 대응합니다.\",\n\"5\":\"단계 05 완성·랜턴: 상부 랜턴과 외곽 리브를 더해 실루엣을 완성합니다. ↔ 단면도의 내부 구조·상부 형상과 대응합니다.\",\n\"F\":\"완성 모델: 555m, 지상 123층의 최종 형상(개념 재구성). 모든 도면은 이 모델의 어느 한 면을 자르거나 펼쳐 본 것입니다. 자유롭게 회전·확대해 도면과 비교하세요.\"\n};\nvar DNAME={d1:\"배치도\",d2:\"기준층 평면도\",d3:\"입면도\",d4:\"단면도\"};\nvar curD=\"d1\",curS=\"1\";\nfunction corr(){\n $(\"#corr\").innerHTML=\"현재 대응 관계 — <b>\"+DNAME[curD]+\"</b> ↔ <b>\"+(curS===\"F\"?\"완성 모델\":(\"설계 단계 \"+SINFO[curS].slice(0,7)) )+\"</b> ↔ 완성 모델: 도면은 완성 모델을 투영·절단한 것이고, 각 설계 단계는 그 형상이 결정되는 순서를 보여줍니다.\";\n}\n\n/* ---------- 탭/단계 UI ---------- */\nfunction selD(id,btn){\n qa(\".drawing\").forEach(function(d){d.classList.remove(\"on\")});\n $(\"#\"+id).classList.add(\"on\");\n qa(\".dtab\").forEach(function(b){b.classList.remove(\"on\")});btn.classList.add(\"on\");\n curD=id; var s=btn.getAttribute(\"data-s\"); if(s)selS(s); corr();\n}\nfunction selS(s){\n curS=s;\n qa(\".sbtn\").forEach(function(b){b.classList.toggle(\"on\",b.getAttribute(\"data-s\")===s)});\n $(\"#sdesc\").textContent=SINFO[s];\n if(window.showStage)showStage(s);\n corr();\n}\nqa(\".dtab\").forEach(function(b){b.addEventListener(\"click\",function(){selD(b.getAttribute(\"data-d\"),b)})});\nqa(\".sbtn\").forEach(function(b){b.addEventListener(\"click\",function(){selS(b.getAttribute(\"data-s\"))})});\n\n/* ---------- Three.js ---------- */\nvar H=555;\nfunction rad(t){return 35*(1-0.55*Math.pow(t,1.3))*(1+0.05*Math.sin(Math.PI*t));}\nfunction supXY(t,th){var a=rad(t),e=2/(4-2*t),c=Math.cos(th),s=Math.sin(th);\n return [a*Math.sign(c)*Math.pow(Math.abs(c),e),a*Math.sign(s)*Math.pow(Math.abs(s),e)];}\n\nif(!window.THREE||!THREE.OrbitControls){$(\"#fallback\").style.display=\"block\";}\nelse{\nvar renderer=new THREE.WebGLRenderer({antialias:true});\nrenderer.setPixelRatio(Math.min(devicePixelRatio||1,2));\n$(\"#gl\").appendChild(renderer.domElement);\nvar scene=new THREE.Scene();scene.background=new THREE.Color(0x0a0e14);\nscene.fog=new THREE.Fog(0x0a0e14,1400,3200);\nvar cam=new THREE.PerspectiveCamera(45,1,1,6000);\nvar HOME=new THREE.Vector3(700,470,700),TGT=new THREE.Vector3(0,250,0);\ncam.position.copy(HOME);\nvar ctl=new THREE.OrbitControls(cam,renderer.domElement);\nctl.target.copy(TGT);ctl.enableDamping=true;ctl.dampingFactor=RM?1:0.08;\nscene.add(new THREE.HemisphereLight(0xbcd4ee,0x1a2028,1.1));\nvar dl=new THREE.DirectionalLight(0xffffff,1.6);dl.position.set(600,900,400);scene.add(dl);\nvar dl2=new THREE.DirectionalLight(0x88aaff,0.5);dl2.position.set(-500,300,-600);scene.add(dl2);\nvar gnd=new THREE.Mesh(new THREE.CircleGeometry(900,64),new THREE.MeshStandardMaterial({color:0x151b24,roughness:1}));\ngnd.rotation.x=-Math.PI/2;scene.add(gnd);\nvar grid=new THREE.GridHelper(1400,28,0x2a3442,0x1c2531);grid.position.y=0.2;scene.add(grid);\n\nfunction shellGeo(t0,t1,hs,rs){var pos=[],idx=[],i,j;\n for(i=0;i<=hs;i++){var t=t0+(t1-t0)*i/hs;\n  for(j=0;j<=rs;j++){var p=supXY(t,j/rs*Math.PI*2);pos.push(p[0],t*H,p[1]);}}\n for(i=0;i<hs;i++)for(j=0;j<rs;j++){var a=i*(rs+1)+j,b=a+rs+1;idx.push(a,b,a+1,b,b+1,a+1);}\n var g=new THREE.BufferGeometry();\n g.setAttribute(\"position\",new THREE.Float32BufferAttribute(pos,3));\n g.setIndex(idx);g.computeVertexNormals();return g;}\n\nfunction ring(t,seg,col,op){var pts=[];\n for(var j=0;j<=seg;j++){var p=supXY(t,j/seg*Math.PI*2);pts.push(new THREE.Vector3(p[0],t*H,p[1]));}\n var g=new THREE.BufferGeometry().setFromPoints(pts);\n return new THREE.Line(g,new THREE.LineBasicMaterial({color:col,transparent:true,opacity:op}));}\n\nfunction rib(th,col,op){var pts=[];\n for(var i=0;i<=40;i++){var t=i/40,p=supXY(t,th);pts.push(new THREE.Vector3(p[0]*1.01,t*H,p[1]*1.01));}\n var g=new THREE.BufferGeometry().setFromPoints(pts);\n return new THREE.Line(g,new THREE.LineBasicMaterial({color:col,transparent:true,opacity:op}));}\n\nfunction cap(){var g=new THREE.CircleGeometry(rad(1)*0.99,48);\n var m=new THREE.Mesh(g,new THREE.MeshStandardMaterial({color:0x2c3a48,roughness:0.6}));\n m.rotation.x=-Math.PI/2;m.position.y=H-0.5;return m;}\n\nfunction colBetween(x1,z1,x2,z2,r,mat){\n var p1=new THREE.Vector3(x1,0,z1),p2=new THREE.Vector3(x2,545,z2);\n var d=p2.clone().sub(p1),len=d.length();\n var m=new THREE.Mesh(new THREE.CylinderGeometry(r*0.65,r,len,8),mat);\n m.position.copy(p1).add(p2).multiplyScalar(0.5);\n m.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),d.normalize());\n return m;}\n\nfunction shell(mat){return new THREE.Mesh(shellGeo(0,1,60,56),mat);}\nfunction lantern(em){\n var m=new THREE.Mesh(shellGeo(0.84,1,12,48),\n  new THREE.MeshStandardMaterial({color:0xbfe0f2,transparent:true,opacity:0.55,emissive:em,emissiveIntensity:0.8,roughness:0.3}));\n return m;}\n\nvar groups={};\n(function build(){\n var g;\n g=new THREE.Group(); // 01 매스\n g.add(shell(new THREE.MeshStandardMaterial({color:0x8fa8bf,transparent:true,opacity:0.55,roughness:0.9})));\n g.add(new THREE.Mesh(shellGeo(0,1,20,28),new THREE.MeshBasicMaterial({color:0xcfe0f0,wireframe:true,transparent:true,opacity:0.12})));\n var bx=new THREE.MeshStandardMaterial({color:0x2a3543,roughness:1});\n [[220,0,120,60,90],[-260,-160,90,45,120],[80,-280,140,80,70],[-140,260,110,55,95]].forEach(function(a){\n  var m=new THREE.Mesh(new THREE.BoxGeometry(a[3],a[4],a[3]),bx);m.position.set(a[0],a[4]/2,a[1]);g.add(m);});\n groups[\"1\"]=g;\n\n g=new THREE.Group(); // 02 도자기 곡선\n g.add(shell(new THREE.MeshStandardMaterial({color:0xe7e0d2,roughness:0.85})));g.add(cap());\n groups[\"2\"]=g;\n\n g=new THREE.Group(); // 03 구조\n g.add(shell(new THREE.MeshStandardMaterial({color:0x9fc0d8,transparent:true,opacity:0.15,roughness:0.4})));\n var core=new THREE.Mesh(new THREE.BoxGeometry(30,545,30),new THREE.MeshStandardMaterial({color:0xd8c8a8,transparent:true,opacity:0.85}));\n core.position.y=272.5;g.add(core);\n var cm=new THREE.MeshStandardMaterial({color:0xe8b96f,roughness:0.5});\n [[27,27],[-27,27],[27,-27],[-27,-27],[29,0],[-29,0],[0,29],[0,-29]].forEach(function(p){\n  g.add(colBetween(p[0],p[1],p[0]*0.47,p[1]*0.47,2.4,cm));});\n groups[\"3\"]=g;\n\n g=new THREE.Group(); // 04 층·커튼월\n g.add(shell(new THREE.MeshStandardMaterial({color:0xaec6d8,metalness:0.35,roughness:0.35})));g.add(cap());\n for(var f=0;f<=123;f+=12)g.add(ring(f/123,56,0x3f6residual=0,0));\n groups[\"4\"]=g;\n})();\n})();\n</script>\n</body>\n</html>",
