  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>롯데월드타워 설계도면 및 3D 모델</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            font-size: 19px;\n            margin: 0;\n            padding: 0;\n        }\n        #canvas {\n            width: 100%;\n            height: 600px;\n            border: 1px solid black;\n        }\n        #controls {\n            position: absolute;\n            top: 10px;\n            left: 10px;\n        }\n        #controls button {\n            margin: 5px;\n        }\n        #description {\n            position: absolute;\n            top: 50px;\n            left: 10px;\n            font-size: 16px;\n        }\n    </style>\n</head>\n<body>\n    <canvas id=\"canvas\"></canvas>\n    <div id=\"controls\">\n        <button id=\"orbit-left\">좌회전</button>\n        <button id=\"orbit-right\">우회전</button>\n        <button id=\"orbit-up\">상향</button>\n        <button id=\"orbit-down\">하향</button>\n        <button id=\"zoom-in\">확대</button>\n        <button id=\"zoom-out\">축소</button>\n        <button id=\"reset\">초기화</button>\n    </div>\n    <div id=\"description\">\n        롯데월드타워 설계도면 및 3D 모델\n        <br>\n        모델 이름: llama-3.1-8b\n    </div>\n    <script src=\"../runtime/three-runtime.js\"></script>\n    <script>\n        const canvas = document.getElementById('canvas');\n        const controls = document.getElementById('controls');\n        const description = document.getElementById('description');\n        const scene = new THREE.Scene();\n        const camera = new THREE.PerspectiveCamera(75, canvas.offsetWidth / canvas.offsetHeight, 0.1, 1000);\n        const renderer = new THREE.WebGLRenderer({\n            canvas: canvas,\n            antialias: true\n        });\n        renderer.setSize(canvas.offsetWidth, canvas.offsetHeight);\n        renderer.setClearColor(0xAAAAAA);\n        const controlsObject = {\n            orbitLeft: controls.querySelector('#orbit-left'),\n            orbitRight: controls.querySelector('#orbit-right'),\n            orbitUp: controls.querySelector('#orbit-up'),\n            orbitDown: controls.querySelector('#orbit-down'),\n            zoomIn: controls.querySelector('#zoom-in'),\n            zoomOut: controls.querySelector('#zoom-out'),\n            reset: controls.querySelector('#reset')\n        };\n        controlsObject.orbitLeft.addEventListener('click', () => {\n            camera.rotation.y -= 0.1;\n        });\n        controlsObject.orbitRight.addEventListener('click', () => {\n            camera.rotation.y += 0.1;\n        });\n        controlsObject.orbitUp.addEventListener('click', () => {\n            camera.position.z += 0.1;\n        });\n        controlsObject.orbitDown.addEventListener('click', () => {\n            camera.position.z -= 0.1;\n        });\n        controlsObject.zoomIn.addEventListener('click', () => {\n            camera.zoom += 0.1;\n            renderer.setSize(canvas.offsetWidth, canvas.offsetHeight);\n        });\n        controlsObject.zoomOut.addEventListener('click', () => {\n            camera.zoom -= 0.1;\n            renderer.setSize(canvas.offsetWidth, canvas.offsetHeight);\n        });\n        controlsObject.reset.addEventListener('click', () => {\n            camera.position.set(0, 0, 5);\n            camera.rotation.set(0, 0, 0);\n            camera.zoom = 1;\n            renderer.setSize(canvas.offsetWidth, canvas.offsetHeight);\n        });\n        const geometry = new THREE.BoxGeometry(10, 10, 10);\n        const material = new THREE.MeshBasicMaterial({ color: 0x00ff00 });\n        const cube = new THREE.Mesh(geometry, material);\n        scene.add(cube);\n        camera.position.set(0, 0, 5);\n        camera.rotation.set(0, 0, 0);\n        camera.zoom = 1;\n        renderer.setSize(canvas.offsetWidth, canvas.offsetHeight);\n        function animate() {\n            requestAnimationFrame(animate);\n            renderer.render(scene, camera);\n        }\n        animate();\n    </script>\n</body>\n</html>",
