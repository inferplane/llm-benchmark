{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Lotte World Tower</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            font-size: 19px;\n            margin: 0;\n            padding: 0;\n        }\n        #controls {\n            position: absolute;\n            top: 10px;\n            left: 10px;\n            font-size: 19px;\n        }\n        #diagrams {\n            position: absolute;\n            top: 100px;\n            left: 10px;\n            font-size: 19px;\n        }\n        #canvas {\n            width: 800px;\n            height: 600px;\n            border: 1px solid black;\n        }\n        #diagram-canvas {\n            width: 400px;\n            height: 200px;\n            border: 1px solid black;\n        }\n    </style>\n</head>\n<body>\n    <div id=\"controls\">\n        <button id=\"reset-button\">Reset</button>\n        <button id=\"previous-button\">Previous</button>\n        <button id=\"next-button\">Next</button>\n        <button id=\"zoom-in-button\">+</button>\n        <button id=\"zoom-out-button\">-</button>\n    </div>\n    <div id=\"diagrams\">\n        <canvas id=\"diagram-canvas\"></canvas>\n        <p>Site Plan (1:1000)</p>\n        <p>Floor Plan (1:500)</p>\n        <p>Elevation (1:200)</p>\n        <p>Section (1:100)</p>\n    </div>\n    <canvas id=\"canvas\"></canvas>\n    <script src=\"../runtime/three-runtime.js\"></script>\n    <script>\n        // Define the tower geometry\n        const towerGeometry = {\n            height: 555,\n            baseRadius: 50,\n            taperRatio: 0.9,\n            numFloors: 123,\n            floorHeight: 4.5,\n        };\n\n        // Define the diagram geometry\n        const diagramGeometry = {\n            width: 400,\n            height: 200,\n        };\n\n        // Initialize the Three.js scene\n        const scene = new THREE.Scene();\n        const camera = new THREE.PerspectiveCamera(75, diagramGeometry.width / diagramGeometry.height, 0.1, 1000);\n        const renderer = new THREE.WebGLRenderer({\n            canvas: document.getElementById('canvas'),\n            antialias: true,\n        });\n        renderer.setSize(diagramGeometry.width, diagramGeometry.height);\n        camera.position.set(0, 0, 100);\n\n        // Initialize the diagram canvas\n        const diagramCanvas = document.getElementById('diagram-canvas');\n        const diagramContext = diagramCanvas.getContext('2d');\n        diagramContext.fillStyle = 'white';\n        diagramContext.fillRect(0, 0, diagramGeometry.width, diagramGeometry.height);\n\n        // Define the diagram drawing functions\n        function drawSitePlan() {\n            diagramContext.fillStyle = 'lightgray';\n            diagramContext.fillRect(50, 50, 300, 100);\n            diagramContext.fillStyle = 'black';\n            diagramContext.font = '14px Arial';\n            diagramContext.textAlign = 'left';\n            diagramContext.textBaseline = 'top';\n            diagramContext.fillText('Site Plan (1:1000)', 60, 60);\n        }\n\n        function drawFloorPlan() {\n            diagramContext.fillStyle = 'lightgray';\n            diagramContext.fillRect(50, 150, 300, 50);\n            diagramContext.fillStyle = 'black';\n            diagramContext.font = '14px Arial';\n            diagramContext.textAlign = 'left';\n            diagramContext.textBaseline = 'top';\n            diagramContext.fillText('Floor Plan (1:500)', 60, 160);\n        }\n\n        function drawElevation() {\n            diagramContext.fillStyle = 'lightgray';\n            diagramContext.fillRect(50, 250, 300, 50);\n            diagramContext.fillStyle = 'black';\n            diagramContext.font = '14px Arial';\n            diagramContext.textAlign = 'left';\n            diagramContext.textBaseline = 'top';\n            diagramContext.fillText('Elevation (1:200)', 60, 260);\n        }\n\n        function drawSection() {\n            diagramContext.fillStyle = 'lightgray';\n            diagramContext.fillRect(50, 350, 300, 50);\n            diagramContext.fillStyle = 'black';\n            diagramContext.font = '14px Arial';\n            diagramContext.textAlign = 'left';\n            diagramContext.textBaseline = 'top';\n            diagramContext.fillText('Section (1:100)', 60, 360);\n        }\n\n        // Define the tower drawing functions\n        function drawTower() {\n            const geometry = new THREE.CylinderGeometry(towerGeometry.baseRadius, towerGeometry.baseRadius, towerGeometry.height, 32);\n            const material = new THREE.MeshBasicMaterial({ color: 0xffffff });\n            const mesh = new THREE.Mesh(geometry, material);\n            scene.add(mesh);\n        }\n\n        function drawFloor() {\n            const geometry = new THREE.BoxGeometry(towerGeometry.baseRadius * 2, towerGeometry.floorHeight, towerGeometry.baseRadius * 2);\n            const material = new THREE.MeshBasicMaterial({ color: 0xffffff });\n            const mesh = new THREE.Mesh(geometry, material);\n            scene.add(mesh);\n        }\n\n        // Initialize the tower and diagram stages\n        let stage = 0;\n        const stages = [\n            { name: 'Base', geometry: drawTower },\n            { name: 'Floors', geometry: drawFloor },\n        ];\n\n        // Define the controls\n        const resetButton = document.getElementById('reset-button');\n        const previousButton = document.getElementById('previous-button');\n        const nextButton = document.getElementById('next-button');\n        const zoomInButton = document.getElementById('zoom-in-button');\n        const zoomOutButton = document.getElementById('zoom-out-button');\n\n        resetButton.addEventListener('click', () => {\n            stage = 0;\n            scene.clear();\n            drawTower();\n        });\n\n        previousButton.addEventListener('click', () => {\n            if (stage > 0) {\n                stage--;\n                scene.clear();\n                stages[stage].geometry();\n            }\n        });\n\n        nextButton.addEventListener('click', () => {\n            if (stage < stages.length - 1) {\n                stage++;\n                scene.clear();\n                stages[stage].geometry();\n            }\n        });\n\n        zoomInButton.addEventListener('click', () => {\n            camera.zoom += 0.1;\n            camera.updateProjectionMatrix();\n            renderer.setSize(diagramGeometry.width, diagramGeometry.height);\n        });\n\n        zoomOutButton.addEventListener('click', () => {\n            camera.zoom -= 0.1;\n            camera.updateProjectionMatrix();\n            renderer.setSize(diagramGeometry.width, diagramGeometry.height);\n        });\n\n        // Draw the initial diagram\n        drawSitePlan();\n        drawFloorPlan();\n        drawElevation();\n        drawSection();\n\n        // Draw the initial tower stage\n        drawTower();\n\n        // Animate the scene\n        function animate() {\n            requestAnimationFrame(animate);\n            renderer.render(scene, camera);\n        }\n        animate();\n    </script>\n    <script>\n        // Display the model name\n        document.getElementById('canvas').parentElement.parentElement.innerHTML += '<p>Model: llama-3.1-8b</p>';\n    </script>\n</body>\n</html>",
