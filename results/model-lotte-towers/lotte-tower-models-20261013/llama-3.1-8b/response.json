  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Lotte World Tower</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            font-size: 19px;\n            margin: 0;\n            padding: 0;\n        }\n        #controls {\n            position: absolute;\n            top: 10px;\n            left: 10px;\n            font-size: 19px;\n        }\n        #canvas {\n            width: 100%;\n            height: 600px;\n            border: 1px solid black;\n        }\n        #diagrams {\n            width: 100%;\n            height: 300px;\n            border: 1px solid black;\n            display: flex;\n            flex-direction: row;\n        }\n        #diagram1, #diagram2, #diagram3, #diagram4 {\n            width: 25%;\n            height: 100%;\n            border: 1px solid black;\n            display: inline-block;\n        }\n        #model-name {\n            position: absolute;\n            top: 10px;\n            right: 10px;\n            font-size: 19px;\n        }\n    </style>\n</head>\n<body>\n    <div id=\"controls\">\n        <button id=\"stage-button\">Stage</button>\n        <button id=\"zoom-button\">Zoom</button>\n        <button id=\"reset-button\">Reset</button>\n        <button id=\"orbit-button\">Orbit</button>\n        <button id=\"tilt-button\">Tilt</button>\n        <button id=\"pointer-button\">Pointer</button>\n    </div>\n    <canvas id=\"canvas\"></canvas>\n    <div id=\"diagrams\">\n        <canvas id=\"diagram1\"></canvas>\n        <canvas id=\"diagram2\"></canvas>\n        <canvas id=\"diagram3\"></canvas>\n        <canvas id=\"diagram4\"></canvas>\n    </div>\n    <div id=\"model-name\">llama-3.1-8b</div>\n    <script src=\"../runtime/three-runtime.js\"></script>\n    <script>\n        const canvas = document.getElementById('canvas');\n        const diagrams = document.querySelectorAll('#diagrams canvas');\n        const controls = document.getElementById('controls');\n        const modelNameElement = document.getElementById('model-name');\n        \n        const renderer = new THREE.WebGLRenderer({\n            canvas: canvas,\n            antialias: true\n        });\n        renderer.setSize(canvas.width, canvas.height);\n        \n        const camera = new THREE.PerspectiveCamera(75, canvas.width / canvas.height, 0.1, 1000);\n        camera.position.z = 500;\n        \n        const scene = new THREE.Scene();\n        \n        const diagram1 = new THREE.CanvasRenderer();\n        diagram1.setSize(diagrams[0].width, diagrams[0].height);\n        diagrams[0].appendChild(diagram1.domElement);\n        \n        const diagram2 = new THREE.CanvasRenderer();\n        diagram2.setSize(diagrams[1].width, diagrams[1].height);\n        diagrams[1].appendChild(diagram2.domElement);\n        \n        const diagram3 = new THREE.CanvasRenderer();\n        diagram3.setSize(diagrams[2].width, diagrams[2].height);\n        diagrams[2].appendChild(diagram3.domElement);\n        \n        const diagram4 = new THREE.CanvasRenderer();\n        diagram4.setSize(diagrams[3].width, diagrams[3].height);\n        diagrams[3].appendChild(diagram4.domElement);\n        \n        const stageButton = document.getElementById('stage-button');\n        const zoomButton = document.getElementById('zoom-button');\n        const resetButton = document.getElementById('reset-button');\n        const orbitButton = document.getElementById('orbit-button');\n        const tiltButton = document.getElementById('tilt-button');\n        const pointerButton = document.getElementById('pointer-button');\n        \n        let stage = 0;\n        let zoom = 1;\n        let cameraPosition = new THREE.Vector3(0, 0, 500);\n        let cameraTarget = new THREE.Vector3(0, 0, 0);\n        let projection = new THREE.PerspectiveCamera(75, canvas.width / canvas.height, 0.1, 1000);\n        \n        function render() {\n            requestAnimationFrame(render);\n            renderer.render(scene, camera);\n            diagram1.render(scene, camera);\n            diagram2.render(scene, camera);\n            diagram3.render(scene, camera);\n            diagram4.render(scene, camera);\n        }\n        \n        function onStageButtonClick() {\n            stage = (stage + 1) % 4;\n            updateScene();\n        }\n        \n        function onZoomButtonClick() {\n            zoom = (zoom + 0.1) % 2;\n            camera.position.z = 500 * zoom;\n            updateScene();\n        }\n        \n        function onResetButtonClick() {\n            stage = 0;\n            zoom = 1;\n            camera.position.copy(cameraPosition);\n            camera.lookAt(cameraTarget);\n            projection.copy(camera);\n            updateScene();\n        }\n        \n        function onOrbitButtonClick() {\n            camera.position.x += 10;\n            camera.lookAt(cameraTarget);\n            updateScene();\n        }\n        \n        function onTiltButtonClick() {\n            camera.rotation.x += 0.1;\n            updateScene();\n        }\n        \n        function onPointerButtonClick() {\n            camera.position.x += 10;\n            camera.lookAt(cameraTarget);\n            updateScene();\n        }\n        \n        function updateScene() {\n            scene.clear();\n            switch (stage) {\n                case 0:\n                    drawCylinder(scene);\n                    break;\n                case 1:\n                    drawFloor(scene);\n                    break;\n                case 2:\n                    drawSection(scene);\n                    break;\n                case 3:\n                    drawElevation(scene);\n                    break;\n            }\n            camera.position.copy(cameraPosition);\n            camera.lookAt(cameraTarget);\n            projection.copy(camera);\n            renderer.setSize(canvas.width, canvas.height);\n            renderer.render(scene, camera);\n            diagram1.setSize(diagrams[0].width, diagrams[0].height);\n            diagram2.setSize(diagrams[1].width, diagrams[1].height);\n            diagram3.setSize(diagrams[2].width, diagrams[2].height);\n            diagram4.setSize(diagrams[3].width, diagrams[3].height);\n            diagram1.render(scene, camera);\n            diagram2.render(scene, camera);\n            diagram3.render(scene, camera);\n            diagram4.render(scene, camera);\n        }\n        \n        function drawCylinder(scene) {\n            const geometry = new THREE.CylinderGeometry(50, 50, 500, 32);\n            const material = new THREE.MeshBasicMaterial({ color: 0xffffff });\n            const cylinder = new THREE.Mesh(geometry, material);\n            scene.add(cylinder);\n        }\n        \n        function drawFloor(scene) {\n            const geometry = new THREE.PlaneGeometry(100, 100);\n            const material = new THREE.MeshBasicMaterial({ color: 0xffffff });\n            const floor = new THREE.Mesh(geometry, material);\n            floor.position.y = -500;\n            scene.add(floor);\n        }\n        \n        function drawSection(scene) {\n            const geometry = new THREE.BoxGeometry(100, 100, 100);\n            const material = new THREE.MeshBasicMaterial({ color: 0xffffff });\n            const section = new THREE.Mesh(geometry, material);\n            section.position.x = 50;\n            section.position.y = -250;\n            scene.add(section);\n        }\n        \n        function drawElevation(scene) {\n            const geometry = new THREE.BoxGeometry(100, 100, 100);\n            const material = new THREE.MeshBasicMaterial({ color: 0xffffff });\n            const elevation = new THREE.Mesh(geometry, material);\n            elevation.position.x = -50;\n            elevation.position.y = -250;\n            scene.add(elevation);\n        }\n        \n        render();\n        \n        stageButton.addEventListener('click', onStageButtonClick);\n        zoomButton.addEventListener('click', onZoomButtonClick);\n        resetButton.addEventListener('click', onResetButtonClick);\n        orbitButton.addEventListener('click', onOrbitButtonClick);\n        tiltButton.addEventListener('click', onTiltButtonClick);\n        pointerButton.addEventListener('click', onPointerButtonClick);\n        \n        modelNameElement.textContent = 'llama-3.1-8b';\n    </script>\n</body>\n</html>",
