{
  "text": "<html>\n<head>\n<style>\nbody {\n  font-family: Arial, sans-serif;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n}\n\n#container {\n  width: 100%;\n  height: 100vh;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n}\n\n#renderer {\n  width: 100%;\n  height: 100%;\n  border: 1px solid black;\n}\n\n#controls {\n  position: absolute;\n  top: 10px;\n  left: 10px;\n  font-size: 19px;\n}\n\n#drawings {\n  position: absolute;\n  top: 50px;\n  left: 10px;\n  font-size: 19px;\n}\n\n#stages {\n  position: absolute;\n  top: 100px;\n  left: 10px;\n  font-size: 19px;\n}\n\n.button {\n  font-size: 19px;\n  padding: 10px;\n  margin: 10px;\n  border: none;\n  border-radius: 5px;\n  background-color: #4CAF50;\n  color: #fff;\n  cursor: pointer;\n}\n\n.button:hover {\n  background-color: #3e8e41;\n}\n</style>\n</head>\n<body>\n<div id=\"container\">\n  <div id=\"renderer\"></div>\n  <div id=\"controls\">\n    <button class=\"button\" id=\"zoom-in\">Zoom In</button>\n    <button class=\"button\" id=\"zoom-out\">Zoom Out</button>\n    <button class=\"button\" id=\"reset\">Reset</button>\n    <button class=\"button\" id=\"orbit-left\">Orbit Left</button>\n    <button class=\"button\" id=\"orbit-right\">Orbit Right</button>\n  </div>\n  <div id=\"drawings\">\n    <h2>Drawings</h2>\n    <p>Site: <img src=\"site.png\" width=\"200\" height=\"200\"></p>\n    <p>Typical Floor: <img src=\"typical-floor.png\" width=\"200\" height=\"200\"></p>\n    <p>Elevation: <img src=\"elevation.png\" width=\"200\" height=\"200\"></p>\n    <p>Section: <img src=\"section.png\" width=\"200\" height=\"200\"></p>\n  </div>\n  <div id=\"stages\">\n    <h2>Design Stages</h2>\n    <p>Stage 1: Concept <img src=\"stage-1.png\" width=\"200\" height=\"200\"></p>\n    <p>Stage 2: Development <img src=\"stage-2.png\" width=\"200\" height=\"200\"></p>\n    <p>Stage 3: Completion <img src=\"stage-3.png\" width=\"200\" height=\"200\"></p>\n  </div>\n</div>\n<script>\nlet scene, camera, renderer, controls;\n\nfunction init() {\n  scene = new THREE.Scene();\n  camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);\n  renderer = new THREE.WebGLRenderer({\n    canvas: document.getElementById('renderer'),\n    antialias: true\n  });\n  renderer.setSize(window.innerWidth, window.innerHeight);\n  controls = new THREE.OrbitControls(camera, renderer.domElement);\n  controls.enableDamping = true;\n  controls.target.set(0, 0, 0);\n  camera.position.set(10, 10, 10);\n  camera.lookAt(controls.target);\n  const geometry = new THREE.BoxGeometry(10, 555, 10);\n  const material = new THREE.MeshBasicMaterial({ color: 0x00ff00 });\n  const mesh = new THREE.Mesh(geometry, material);\n  mesh.position.set(0, 0, 0);\n  scene.add(mesh);\n  const taperGeometry = new THREE.BoxGeometry(5, 555, 5);\n  const taperMaterial = new THREE.MeshBasicMaterial({ color: 0x00ff00 });\n  const taperMesh = new THREE.Mesh(taperGeometry, taperMaterial);\n  taperMesh.position.set(0, 555 / 2, 0);\n  scene.add(taperMesh);\n  animate();\n}\n\nfunction animate() {\n  requestAnimationFrame(animate);\n  controls.update();\n  renderer.render(scene, camera);\n}\n\ninit();\n\ndocument.getElementById('zoom-in').addEventListener('click', () => {\n  camera.position.multiplyScalar(0.9);\n});\n\ndocument.getElementById('zoom-out').addEventListener('click', () => {\n  camera.position.multiplyScalar(1.1);\n});\n\ndocument.getElementById('reset').addEventListener('click', () => {\n  camera.position.set(10, 10, 10);\n  camera.lookAt(controls.target);\n});\n\ndocument.getElementById('orbit-left').addEventListener('click', () => {\n  controls.rotateLeft(0.1);\n});\n\ndocument.getElementById('orbit-right').addEventListener('click', () => {\n  controls.rotateRight(0.1);\n});\n\nwindow.addEventListener('resize', () => {\n  camera.aspect = window.innerWidth / window.innerHeight;\n  camera.updateProjectionMatrix();\n  renderer.setSize(window.innerWidth, window.innerHeight);\n});\n</script>\n</body>\n</html>",
