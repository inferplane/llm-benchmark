{
  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Lotte Tower Artwork</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 0;\n            overflow-x: hidden;\n        }\n        .container {\n            max-width: 100vw;\n            margin: 0 auto;\n            padding: 20px;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n        }\n        .drawing-controls {\n            display: flex;\n            gap: 20px;\n            margin-bottom: 20px;\n        }\n        .drawing-controls button {\n            font-size: 19px;\n            padding: 10px 20px;\n            border: none;\n            border-radius: 5px;\n            background-color: #4CAF50;\n            color: #fff;\n            cursor: pointer;\n        }\n        .drawing-controls button:hover {\n            background-color: #3e8e41;\n        }\n        .drawing-surface {\n            width: 100%;\n            max-width: 800px;\n            height: 600px;\n            border: 1px solid #ddd;\n            margin-bottom: 20px;\n        }\n        .drawing-surface canvas {\n            width: 100%;\n            height: 100%;\n        }\n        .camera-controls {\n            display: flex;\n            gap: 20px;\n            margin-bottom: 20px;\n        }\n        .camera-controls button {\n            font-size: 19px;\n            padding: 10px 20px;\n            border: none;\n            border-radius: 5px;\n            background-color: #4CAF50;\n            color: #fff;\n            cursor: pointer;\n        }\n        .camera-controls button:hover {\n            background-color: #3e8e41;\n        }\n        .reset-button {\n            font-size: 19px;\n            padding: 10px 20px;\n            border: none;\n            border-radius: 5px;\n            background-color: #f44336;\n            color: #fff;\n            cursor: pointer;\n        }\n        .reset-button:hover {\n            background-color: #e91e63;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"drawing-controls\">\n            <button id=\"site-button\">Site</button>\n            <button id=\"floor-button\">Floor</button>\n            <button id=\"elevation-button\">Elevation</button>\n            <button id=\"section-button\">Section</button>\n        </div>\n        <div class=\"drawing-surface\">\n            <canvas id=\"drawing-canvas\"></canvas>\n        </div>\n        <div class=\"camera-controls\">\n            <button id=\"rotate-left-button\">Rotate Left</button>\n            <button id=\"rotate-right-button\">Rotate Right</button>\n            <button id=\"zoom-in-button\">Zoom In</button>\n            <button id=\"zoom-out-button\">Zoom Out</button>\n        </div>\n        <button class=\"reset-button\" id=\"reset-button\">Reset View</button>\n    </div>\n\n    <script>\n        let canvas = document.getElementById('drawing-canvas');\n        let ctx = canvas.getContext('2d');\n        canvas.width = 800;\n        canvas.height = 600;\n\n        let drawing = 'site';\n        let rotation = 0;\n        let zoom = 1;\n\n        document.getElementById('site-button').addEventListener('click', () => {\n            drawing = 'site';\n            draw();\n        });\n\n        document.getElementById('floor-button').addEventListener('click', () => {\n            drawing = 'floor';\n            draw();\n        });\n\n        document.getElementById('elevation-button').addEventListener('click', () => {\n            drawing = 'elevation';\n            draw();\n        });\n\n        document.getElementById('section-button').addEventListener('click', () => {\n            drawing = 'section';\n            draw();\n        });\n\n        document.getElementById('rotate-left-button').addEventListener('click', () => {\n            rotation -= 10;\n            draw();\n        });\n\n        document.getElementById('rotate-right-button').addEventListener('click', () => {\n            rotation += 10;\n            draw();\n        });\n\n        document.getElementById('zoom-in-button').addEventListener('click', () => {\n            zoom += 0.1;\n            draw();\n        });\n\n        document.getElementById('zoom-out-button').addEventListener('click', () => {\n            zoom -= 0.1;\n            if (zoom < 0.1) zoom = 0.1;\n            draw();\n        });\n\n        document.getElementById('reset-button').addEventListener('click', () => {\n            rotation = 0;\n            zoom = 1;\n            draw();\n        });\n\n        document.addEventListener('keydown', (e) => {\n            switch (e.key) {\n                case 'ArrowLeft':\n                    rotation -= 10;\n                    break;\n                case 'ArrowRight':\n                    rotation += 10;\n                    break;\n                case '+':\n                case '=':\n                    zoom += 0.1;\n                    break;\n                case '-':\n                    zoom -= 0.1;\n                    if (zoom < 0.1) zoom = 0.1;\n                    break;\n                case 'r':\n                case 'R':\n                    rotation = 0;\n                    zoom = 1;\n                    break;\n                default:\n                    return;\n            }\n            draw();\n        });\n\n        function draw() {\n            ctx.clearRect(0, 0, canvas.width, canvas.height);\n            ctx.save();\n            ctx.translate(canvas.width / 2, canvas.height / 2);\n            ctx.rotate(rotation * Math.PI / 180);\n            ctx.scale(zoom, zoom);\n\n            switch (drawing) {\n                case 'site':\n                    drawSite(ctx);\n                    break;\n                case 'floor':\n                    drawFloor(ctx);\n                    break;\n                case 'elevation':\n                    drawElevation(ctx);\n                    break;\n                case 'section':\n                    drawSection(ctx);\n                    break;\n            }\n\n            ctx.restore();\n        }\n\n        function drawSite(ctx) {\n            ctx.fillStyle = '#ccc';\n            ctx.fillRect(-100, -100, 200, 200);\n            ctx.fillStyle = '#666';\n            ctx.font = '24px Arial';\n            ctx.textAlign = 'center';\n            ctx.textBaseline = 'middle';\n            ctx.fillText('Site Plan', 0, 0);\n        }\n\n        function drawFloor(ctx) {\n            ctx.fillStyle = '#ccc';\n            ctx.fillRect(-150, -100, 300, 200);\n            ctx.fillStyle = '#666';\n            ctx.font = '24px Arial';\n            ctx.textAlign = 'center';\n            ctx.textBaseline = 'middle';\n            ctx.fillText('Floor Plan', 0, 0);\n        }\n\n        function drawElevation(ctx) {\n            ctx.fillStyle = '#ccc';\n            ctx.fillRect(-100, -150, 200, 300);\n            ctx.fillStyle = '#666';\n            ctx.font = '24px Arial';\n            ctx.textAlign = 'center';\n            ctx.textBaseline = 'middle';\n            ctx.fillText('Elevation', 0, 0);\n        }\n\n        function drawSection(ctx) {\n            ctx.fillStyle = '#ccc';\n            ctx.fillRect(-150, -150, 300, 300);\n            ctx.fillStyle = '#666';\n            ctx.font = '24px Arial';\n            ctx.textAlign = 'center';\n            ctx.textBaseline = 'middle';\n            ctx.fillText('Section', 0, 0);\n        }\n\n        draw();\n    </script>\n</body>\n</html>",
