{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Lotte World Tower</title>\n    <style>\n        body {\n            margin: 0;\n            font-size: 19px;\n            font-family: Arial, sans-serif;\n        }\n        #container {\n            width: 100%;\n            height: 100vh;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n        }\n        #drawing-controls {\n            margin: 20px 0;\n        }\n        button {\n            font-size: 19px;\n            margin: 0 10px;\n            padding: 10px 20px;\n        }\n        #canvas-container {\n            width: 100%;\n            flex-grow: 1;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n        }\n        #info {\n            position: absolute;\n            top: 10px;\n            left: 10px;\n            font-size: 19px;\n        }\n        #model-name {\n            position: absolute;\n            top: 10px;\n            right: 10px;\n            font-size: 19px;\n        }\n    </style>\n</head>\n<body>\n    <div id=\"container\">\n        <div id=\"drawing-controls\">\n            <button id=\"site-plan-btn\">배치도</button>\n            <button id=\"floor-plan-btn\">기준층 평면도</button>\n            <button id=\"elevation-btn\">입면도</button>\n            <button id=\"section-btn\">단면도</button>\n            <button id=\"stage1-btn\">설계 단계 1</button>\n            <button id=\"stage2-btn\">설계 단계 2</button>\n            <button id=\"stage3-btn\">완성된 모델</button>\n            <button id=\"reset-view-btn\">시점 초기화</button>\n        </div>\n        <div id=\"canvas-container\"></div>\n        <div id=\"info\"></div>\n        <div id=\"model-name\">llama4-maverick</div>\n    </div>\n\n    <script>\n        let scene, camera, renderer, controls;\n        let currentDrawing = null;\n\n        function init() {\n            scene = new THREE.Scene();\n            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);\n            renderer = new THREE.WebGLRenderer({\n                antialias: true\n            });\n            renderer.setSize(window.innerWidth, window.innerHeight * 0.8);\n            document.getElementById('canvas-container').appendChild(renderer.domElement);\n\n            controls = new THREE.OrbitControls(camera, renderer.domElement);\n            camera.position.set(0, 200, 400);\n            controls.target.set(0, 200, 0);\n            controls.update();\n\n            const initialCameraPosition = camera.position.clone();\n            const initialControlsTarget = controls.target.clone();\n\n            document.getElementById('site-plan-btn').addEventListener('click', showSitePlan);\n            document.getElementById('floor-plan-btn').addEventListener('click', showFloorPlan);\n            document.getElementById('elevation-btn').addEventListener('click', showElevation);\n            document.getElementById('section-btn').addEventListener('click', showSection);\n            document.getElementById('stage1-btn').addEventListener('click', showStage1);\n            document.getElementById('stage2-btn').addEventListener('click', showStage2);\n            document.getElementById('stage3-btn').addEventListener('click', showStage3);\n            document.getElementById('reset-view-btn').addEventListener('click', () => {\n                camera.position.copy(initialCameraPosition);\n                controls.target.copy(initialControlsTarget);\n                controls.update();\n            });\n\n            window.addEventListener('resize', onWindowResize);\n            window.addEventListener('keydown', onKeyDown);\n\n            showStage3();\n            animate();\n        }\n\n        function showSitePlan() {\n            clearScene();\n            const geometry = new THREE.PlaneGeometry(200, 200);\n            const material = new THREE.MeshBasicMaterial({ color: 0xffffff, wireframe: true });\n            const plane = new THREE.Mesh(geometry, material);\n            scene.add(plane);\n            currentDrawing = 'site-plan';\n            document.getElementById('info').innerText = '배치도 - 200m x 200m';\n        }\n\n        function showFloorPlan() {\n            clearScene();\n            const shape = new THREE.Shape();\n            shape.moveTo(-50, -50);\n            shape.lineTo(50, -50);\n            shape.lineTo(50, 50);\n            shape.lineTo(-50, 50);\n            shape.lineTo(-50, -50);\n            const geometry = new THREE.ShapeGeometry(shape);\n            const material = new THREE.MeshBasicMaterial({ color: 0xffffff, wireframe: true });\n            const mesh = new THREE.Mesh(geometry, material);\n            scene.add(mesh);\n            currentDrawing = 'floor-plan';\n            document.getElementById('info').innerText = '기준층 평면도 - 100m x 100m';\n        }\n\n        function showElevation() {\n            clearScene();\n            const geometry = new THREE.BoxGeometry(50, 555, 10);\n            const material = new THREE.MeshBasicMaterial({ color: 0xffffff, wireframe: true });\n            const box = new THREE.Mesh(geometry, material);\n            scene.add(box);\n            currentDrawing = 'elevation';\n            document.getElementById('info').innerText = '입면도 - 높이 555m, 폭 50m (개념적 표현)';\n        }\n\n        function showSection() {\n            clearScene();\n            const geometry = new THREE.PlaneGeometry(50, 555);\n            const material = new THREE.MeshBasicMaterial({ color: 0xffffff, wireframe: true });\n            const plane = new THREE.Mesh(geometry, material);\n            scene.add(plane);\n            currentDrawing = 'section';\n            document.getElementById('info').innerText = '단면도 - 높이 555m, 폭 50m (개념적 표현)';\n        }\n\n        function showStage1() {\n            clearScene();\n            const geometry = new THREE.CylinderGeometry(50, 50, 555, 32);\n            const material = new THREE.MeshBasicMaterial({ color: 0xffffff, wireframe: true });\n            const cylinder = new THREE.Mesh(geometry, material);\n            scene.add(cylinder);\n            document.getElementById('info').innerText = '설계 단계 1: 초기 원통형 형태';\n        }\n\n        function showStage2() {\n            clearScene();\n            const geometry = new THREE.ConeGeometry(50, 555, 32);\n            const material = new THREE.MeshBasicMaterial({ color: 0xffffff, wireframe: true });\n            const cone = new THREE.Mesh(geometry, material);\n            scene.add(cone);\n            document.getElementById('info').innerText = '설계 단계 2: 원뿔형태로의 변형';\n        }\n\n        function showStage3() {\n            clearScene();\n            const geometry = new THREE.ConeGeometry(50, 555, 32);\n            const material = new THREE.MeshBasicMaterial({ color: 0xffffff, wireframe: true });\n            const cone = new THREE.Mesh(geometry, material);\n            scene.add(cone);\n            document.getElementById('info').innerText = '완성된 모델: 롯데월드타워';\n        }\n\n        function clearScene() {\n            while (scene.children.length > 0) {\n                scene.remove(scene.children[0]);\n            }\n        }\n\n        function onWindowResize() {\n            camera.aspect = window.innerWidth / window.innerHeight;\n            camera.updateProjectionMatrix();\n            renderer.setSize(window.innerWidth, window.innerHeight * 0.8);\n        }\n\n        function onKeyDown(event) {\n            switch (event.key) {\n                case 'ArrowUp':\n                    camera.rotateX(-0.1);\n                    break;\n                case 'ArrowDown':\n                    camera.rotateX(0.1);\n                    break;\n                case 'ArrowLeft':\n                    camera.rotateOnWorldAxis(new THREE.Vector3(0, 1, 0), -0.1);\n                    break;\n                case 'ArrowRight':\n                    camera.rotateOnWorldAxis(new THREE.Vector3(0, 1, 0), 0.1);\n                    break;\n                case '+':\n                case '=':\n                    camera.zoom = 2;\n                    camera.position.z -= 10;\n                    break;\n                case '-':\n                    camera.position.z += 10;\n                    break;\n                case 'r':\n                case 'R':\n                    camera.position.set(0, 200, 400);\n                    controls.target.set(0, 200, 0);\n                    controls.update();\n                    break;\n            }\n        }\n\n        function animate() {\n            requestAnimationFrame(animate);\n            controls.update();\n            renderer.render(scene, camera);\n        }\n\n        const script = document.createElement('script');\n        script.src = '../runtime/three-runtime.js';\n        document.head.appendChild(script);\n        script.onload = init;\n    </script>\n</body>\n</html>",
