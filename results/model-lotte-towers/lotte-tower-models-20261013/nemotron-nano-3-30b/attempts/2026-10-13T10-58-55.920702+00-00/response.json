{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<title>롯데월드타워 설계 탐험</title>\n<style>\n  body { margin:0; overflow:hidden; font-family:sans-serif; background:#111; color:#eee; }\n  #info { position:absolute; top:10px; left:10px; z-index:10; background:rgba(0,0,0,0.5); padding:10px; border-radius:5px; }\n  #info h2 { margin:0 0 5px; font-size:1.2em; }\n  #info p { margin:0; font-size:0.9em; line-height:1.4; }\n  #info label { display:block; margin-top:5px; font-size:0.8em; }\n  #info input[type=range] { width:150px; }\n  #info .slider { margin-top:5px; }\n  #info .slider span { margin-left:5px; }\n</style>\n</head>\n<body>\n<div id=\"info\">\n  <h2>롯데월드타워 설계 탐험</h2>\n  <p>이 페이지는 <strong>nemotron-nano-3-30b</strong> 모델을 기반으로 한 인터랙티브 시각화입니다.</p>\n  <p>아래 슬라이더로 설계 단계(0~3)를 전환하고, 마우스로 회전·확대·축소·초기화를 할 수 있습니다.</p>\n  <label>설계 단계:</label>\n  <input type=\"range\" id=\"stageSlider\" min=\"0\" max=\"3\" value=\"0\" step=\"1\">\n  <div class=\"slider\"><span id=\"stageLabel\">0</span></div>\n</div>\n\n<script type=\"module\">\nimport * as THREE from '../runtime/three-runtime.js';\nimport { OrbitControls } from '../runtime/three-runtime.js';\n\n// ---------- 기본 설정 ----------\nconst container = document.createElement('div');\ndocument.body.appendChild(container);\ncontainer.style.width = '100%';\ncontainer.style.height = '100vh';\n\n// 씬, 카메라, 렌더러\nconst scene = new THREE.Scene();\nscene.background = new THREE.Color(0x111111);\nconst camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);\ncamera.position.set(0, 150, 300);\nconst renderer = new THREE.WebGLRenderer({ antialias: true });\nrenderer.setSize(window.innerWidth, window.innerHeight);\ncontainer.appendChild(renderer.domElement);\n\n// OrbitControls\nconst controls = new OrbitControls(camera, renderer.domElement);\ncontrols.enableDamping = true;\ncontrols.dampingFactor = 0.05;\ncontrols.enablePan = false;\ncontrols.enableZoom = true;\ncontrols.minDistance = 100;\ncontrols.maxDistance = 800;\n\n// 조명\nconst hemiLight = new THREE.HemisphereLight(0xffffff, 0x444444, 1.2);\nhemiLight.position.set(0, 500, 0);\nscene.add(hemiLight);\nconst dirLight = new THREE.DirectionalLight(0xffffff, 0.8);\ndirLight.position.set(-2, 5, -5);\nscene.add(dirLight);\n\n// ---------- 데이터 ----------\nconst buildingInfo = {\n  height: 555,          // m\n  floors: 123,\n  taperRatio: 0.6,      // 상단 면적 / 하단 면적 비율 (추정)\n  baseRadius: 70,       // 하단 반지름 (추정)\n  topRadius: 30,        // 상단 반지름 (추정)\n  stageCount: 4,        // 시각화 단계 수\n};\n\n// ---------- 단계별 모델 ----------\nconst stages = [];\n\n// 0: 전체 배치도 (평면도)\nstages[0] = createStage(0);\n\n// 1: 기준층 평면도 (지상 1층)\nstages[1] = createStage(1);\n\n// 2: 입면도 (전면 시점)\nstages[2] = createStage(2);\n\n// 3: 단면도 (전면 단면)\nstages[3] = createStage(3);\n\n// ---------- 3D 모델 ----------\nconst buildingMesh = new THREE.Group();\nscene.add(buildingMesh);\n\n// ---------- UI ----------\nconst stageSlider = document.getElementById('stageSlider');\nconst stageLabel = document.getElementById('stageLabel');\nstageSlider.addEventListener('input', () => {\n  const idx = parseInt(stageSlider.value);\n  stageLabel.textContent = idx;\n  updateStage(idx);\n});\n\n// ---------- 초기화 ----------\nupdateStage(0);\n\n// ---------- 애니메이션 ----------\nfunction animate() {\n  requestAnimationFrame(animate);\n  controls.update();\n  renderer.render(scene, camera);\n}\nanimate();\n\n// ---------- 함수 정의 ----------\nfunction createStage(stageIdx) {\n  const group = new THREE.Group();\n\n  // 공통 파라미터\n  const heightPerStage = buildingInfo.height / buildingInfo.floors;\n  const stageHeight = heightPerStage * 3; // 각 단계는 3층을 대표\n\n  // 단계별 치수 계산 (추정)\n  const stageHeightCumulative = stageIdx * stageHeight;\n  const currentHeight = stageHeightCumulative + stageHeight;\n\n  // 반지름 보간 (상단으로 갈수록 작아짐)\n  const t = stageIdx / (buildingInfo.stageCount - 1);\n  const radius = buildingInfo.baseRadius * (1 - t * (1 - buildingInfo.taperRatio));\n  const topRadius = buildingInfo.baseRadius * (1 - (t + 1/(buildingInfo.floors)) * (1 - buildingInfo.taperRatio));\n\n  // 1) 외곽 실루엣 (원형 단면)\n  const geometry = new THREE.CylinderGeometry(radius, topRadius, stageHeight, 32);\n  const material = new THREE.MeshPhongMaterial({ color: 0x222222, side: THREE.DoubleSide });\n  const cylinder = new THREE.Mesh(geometry, material);\n  cylinder.position.y = stageHeightCumulative + stageHeight / 2;\n  group.add(cylinder);\n\n  // 2) 내부 구조 (예: 핵심 파이프)\n  const coreRadius = radius * 0.2;\n  const coreGeom = new THREE.CylinderGeometry(coreRadius, coreRadius * 0.5, stageHeight, 16);\n  const coreMat = new THREE.MeshPhongMaterial({ color: 0x888888 });\n  const core = new THREE.Mesh(coreGeom, coreMat);\n  core.position.y = stageHeightCumulative + stageHeight / 2;\n  group.add(core);\n\n  // 3) 텍스처/라인 (한국 도자기 선)\n  const lineMaterial = new THREE.LineBasicMaterial({ color: 0xbb8800 });\n  const linePoints = [];\n  const lineCount = 8;\n  for (let i = 0; i <= lineCount; i++) {\n    const angle = (i / lineCount) * Math.PI * 2;\n    const r = radius * (0.9 + 0.1 * Math.sin(angle * 2));\n    const x = r * Math.cos(angle);\n    const y = r * Math.sin(angle);\n    linePoints.push(new THREE.Vector3(x, stageHeightCumulative + y, currentHeight));\n  }\n  const lineGeometry = new THREE.BufferGeometry().setFromPoints(linePoints);\n  const line = new THREE.Line(lineGeometry, lineMaterial);\n  group.add(line);\n\n  // 4) 라벨 (설계 단계 이름)\n  const label = new THREE.Mesh(\n    new THREE.PlaneGeometry(10, 2),\n    new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, side: THREE.DoubleSide })\n  );\n  label.position.set(0, stageHeightCumulative + stageHeight + 5, 0);\n  label.lookAt(camera.position);\n  group.add(label);\n\n  return group;\n}\n\n// ---------- 단계 전환 ----------\nfunction updateStage(idx) {\n  // 기존 모델 제거\n  buildingMesh.clear();\n  // 선택된 단계 모델 추가\n  const selected = stages[idx];\n  if (selected) buildingMesh.add(selected);\n}\n\n// ---------- 윈도우 리사이즈 ----------\nwindow.addEventListener('resize', () => {\n  const w = window.innerWidth;\n  const h = window.innerHeight;\n  camera.aspect = w / h;\n  camera.updateProjectionMatrix();\n  renderer.setSize(w, h);\n});\n</script>\n</body>\n</html>",
