  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Lotte Tower Conceptual Model</title>\n<style>\n  body { margin:0; font-family:Arial,Helvetica,sans-serif; background:#111; color:#eee; }\n  #canvas { display:block; width:100vw; height:100vh; }\n  #info { position:absolute; top:10px; left:10px; background:rgba(0,0,0,0.5); padding:10px; border-radius:5px; }\n  button { margin-top:10px; padding:8px 12px; background:#444; color:#fff; border:none; border-radius:4px; cursor:pointer; }\n</style>\n</head>\n<body>\n<div id=\"info\">\n  <strong>Lotte Tower Conceptual Model</strong><br>\n  Use arrow keys or WASD to move, <strong>+ / -</strong> to zoom, <strong>R</strong> to reset view.<br>\n  <button id=\"resetBtn\">Reset View</button>\n</div>\n<canvas id=\"canvas\"></canvas>\n\n<script type=\"module\">\nimport * as THREE from 'https://unpkg.com/three@0.166.0/build/three.module.js';\nimport { OrbitControls } from 'https://unpkg.com/three@0.166.0/examples/jsm/controls/OrbitControls.js';\n\nconst canvas = document.getElementById('canvas');\nconst renderer = new THREE.WebGLRenderer({ canvas, antialias:true });\nrenderer.setSize(window.innerWidth, window.innerHeight);\nrenderer.setPixelRatio(window.devicePixelRatio);\nrenderer.setClearColor(0x111111);\n\nconst scene = new THREE.Scene();\nscene.background = new THREE.Color(0x111111);\n\nconst camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);\ncamera.position.set(0, 5, 12);\ncamera.lookAt(0, 0, 0);\n\nconst controls = new OrbitControls(camera, renderer.domElement);\ncontrols.enableDamping = true;\ncontrols.dampingFactor = 0.05;\ncontrols.enableZoom = true;\ncontrols.enablePan = false;\ncontrols.autoRotate = false;\n\n// Make canvas focusable for keyboard control\nrenderer.domElement.setAttribute('tabindex', '0');\nrenderer.domElement.focus();\n\n// Resize handling\nwindow.addEventListener('resize', () => {\n  const w = window.innerWidth;\n  const h = window.innerHeight;\n  renderer.setSize(w, h);\n  camera.aspect = w / h;\n  camera.updateProjectionMatrix();\n});\n\n// Reset button\ndocument.getElementById('resetBtn').addEventListener('click', () => {\n  camera.position.set(0, 5, 12);\n  camera.lookAt(0, 0, 0);\n  controls.target.set(0, 0, 0);\n  controls.update();\n});\n\n// Render loop\nfunction animate() {\n  requestAnimationFrame(animate);\n  controls.update();\n  renderer.render(scene, camera);\n}\nanimate();\n\n// Simple placeholder geometry to illustrate the tower\nconst geometry = new THREE.CylinderGeometry(1, 1, 20, 12);\nconst material = new THREE.MeshStandardMaterial({ color: 0x2222aa, metalness: 0.3, roughness: 0.4 });\nconst tower = new THREE.Mesh(geometry, material);\nscene.add(tower);\n\n// Add a few lights\nconst hemiLight = new THREE.HemisphereLight(0xffffff, 0x444444, 1.5);\nscene.add(hemiLight);\nconst dirLight = new THREE.DirectionalLight(0xffffff, 1);\ndirLight.position.set(5, 10, 7);\nscene.add(dirLight);\n\n// Floor grid for context\nconst floorSize = 30;\nconst floorGeom = new THREE.PlaneGeometry(floorSize, floorSize);\nconst floorMat = new THREE.MeshStandardMaterial({ color: 0x2a2a2a });\nconst floor = new THREE.Mesh(floorGeom, floorMat);\nfloor.rotation.x = -Math.PI / 2;\nfloor.receiveShadow = true;\nscene.add(floor);\n</script>\n</body>\n</html>",
