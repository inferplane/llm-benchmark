{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<title>롯데월드타워 설계 과정</title>\n<style>\n  body { margin:0; font-family:Arial,Helvetica,sans-serif; background:#111; color:#eee; }\n  #container { width:100vw; height:100vh; display:flex; flex-direction:column; }\n  #info { padding:1rem; background:#222; flex-shrink:0; }\n  #info h2 { margin:0 0 .5rem; font-size:1.2rem; }\n  #info p { margin:0; font-size:1rem; line-height:1.4; }\n  #viewer { flex:1; overflow:hidden; }\n  canvas { display:block; width:100%; height:100%; }\n  .label { font-size:19px; color:#fff; margin-bottom:4px; }\n  .label span { color:#ff0; }\n  button.reset { position:absolute; top:1rem; right:1rem; padding:.5rem 1rem; background:#006; border:none; color:#fff; cursor:pointer; }\n</style>\n</head>\n<body>\n<div id=\"container\">\n  <div id=\"info\">\n    <h2>롯데월드타워 설계 과정</h2>\n    <p>이 페이지는 설계 도면, 단계별 3D 모델, 완성된 3D 모델을 모두 보여줍니다.</p>\n    <p>※ 모든 치수·단면은 공개 자료를 기반으로 한 추정치이며, 실제 설계와는 다를 수 있습니다.</p>\n    <button class=\"reset\">뷰 초기화</button>\n  </div>\n  <div id=\"viewer\"></div>\n</div>\n\n<script src=\"../runtime/three-runtime.js\"></script>\n<script>\n  // -------------------------------------------------\n  // 기본 Three.js 설정\n  // -------------------------------------------------\n  const canvas = document.createElement('canvas');\n  const renderer = new THREE.WebGLRenderer({canvas, antialias:true, alpha:true});\n  renderer.setSize(window.innerWidth, window.innerHeight);\n  renderer.setPixelRatio(window.devicePixelRatio);\n  const scene = new THREE.Scene();\n  scene.background = new THREE.Color(0x111111);\n  const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 2000);\n  camera.position.set(0, 150, 300);\n  camera.lookAt(0, 0, 0);\n  const controls = new THREE.OrbitControls(camera, renderer.domElement);\n  controls.enableDamping = true;\n  controls.dampingFactor = 0.07;\n  controls.enablePan = false;\n  controls.enableZoom = true;\n  controls.enableRotate = true;\n  controls.autoRotate = false;\n  controls.target.set(0, 0, 0);\n  // -------------------------------------------------\n  // 조작성 강화\n  // -------------------------------------------------\n  const viewerDiv = document.getElementById('viewer');\n  viewerDiv.appendChild(renderer.domElement);\n  renderer.domElement.tabIndex = 0;\n  renderer.domElement.focus();\n  // 키보드 조작 (위치, 줌, 회전)\n  const keyHandler = (e) => {\n    switch(e.key) {\n      case 'ArrowUp':    camera.position.y += 10; break;\n      case 'ArrowDown':  camera.position.y -= 10; break;\n      case 'ArrowLeft':  camera.position.x -= 10; break;\n      case 'ArrowRight': camera.position.x += 10; break;\n      case '+': case '=': camera.position.z -= 10; break;\n      case '-': case '_': camera.position.z += 10; break;\n      case 'r': case 'R': controls.reset(); break;\n    }\n  };\n  renderer.domElement.addEventListener('keydown', keyHandler);\n  // -------------------------------------------------\n  // 조명\n  // -------------------------------------------------\n  const hemiLight = new THREE.HemisphereLight(0xffffff, 0x444444, 1.2);\n  scene.add(hemiLight);\n  const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);\n  dirLight.position.set(5, 10, 7);\n  scene.add(dirLight);\n  // -------------------------------------------------\n  // 도면 텍스처 (Canvas 기반)\n  // -------------------------------------------------\n  const makeCanvas = (w, h) => {\n    const c = document.createElement('canvas');\n    c.width = w; c.height = h;\n    const ctx = c.getContext('2d');\n    ctx.fillStyle = '#222';\n    ctx.fillRect(0,0,w,h);\n    ctx.font = '19px Arial';\n    ctx.fillStyle = '#fff';\n    return c;\n  };\n  const sitePlanCanvas = makeCanvas(256, 256);\n  const floorPlanCanvas = makeCanvas(256, 256);\n  const elevationCanvas = makeCanvas(256, 256);\n  const sectionCanvas = makeCanvas(256, 256);\n  // 텍스처 로드\n  const texLoader = new THREE.TextureLoader();\n  const siteTex = texLoader.load(sitePlanCanvas);\n  const floorTex = texLoader.load(floorPlanCanvas);\n  const elevTex = texLoader.load(elevationCanvas);\n  const secTex = texLoader.load(sectionCanvas);\n  // -------------------------------------------------\n  // 도면 표시 (평면도, 입면도, 단면도, 현장 계획도)\n  // -------------------------------------------------\n  const viewPlanes = [\n    {name:'현장 계획도', tex:siteTex,   width:256, height:256, x: -120, y: 80,  size:1.2},\n    {name:'기준층 평면도', tex:floorTex, width:256, height:256, x:-120, y:-80, size:1.2},\n    {name:'입면도',       tex:elevTex,  width:256, height:256, x: 120, y: 80, size:1.2},\n    {name:'단면도',       tex:secTex,   width:256, height:256, x: 120, y:-80, size:1.2}\n  ];\n  const labelStyle = {fontSize:'19px', color:'#fff'};\n  viewPlanes.forEach(v => {\n    const plane = new THREE.PlaneGeometry(v.width, v.height);\n    const mat = new THREE.MeshBasicMaterial({map:v.tex, transparent:true});\n    const mesh = new THREE.Mesh(plane, mat);\n    mesh.position.set(v.x, v.y, 0);\n    mesh.scale.set(v.size, v.size, 1);\n    scene.add(mesh);\n    // 라벨\n    const labelCanvas = makeCanvas(v.width, 30);\n    const ctx = labelCanvas.getContext('2d');\n    ctx.fillStyle = '#ff0';\n    ctx.font = '19px Arial';\n    ctx.fillText(v.name, 5, 20);\n    const labelTex = new THREE.CanvasTexture(labelCanvas);\n    const labelMat = new THREE.SpriteMaterial({map:labelTex, transparent:true});\n    const label = new THREE.Sprite(labelMat);\n    label.position.set(v.x, v.y+15, -0.1);\n    label.scale.set(0.8,0.8,1);\n    scene.add(label);\n  });\n  // -------------------------------------------------\n  // 간단한 기하학 모델 (축소된 타워)\n  // -------------------------------------------------\n  const towerGroup = new THREE.Group();\n  const makeTower = () => {\n    const group = new THREE.Group();\n    const mat = new THREE.MeshStandardMaterial({color:0x222222});\n    // 베이스 (원형)\n    const baseGeo = new THREE.CylinderGeometry(30,30,30,12,1);\n    const base = new THREE.Mesh(baseGeo, mat);\n    base.position.y = -15;\n    group.add(base);\n    // 경사진 단계 (5단)\n    const steps = 5;\n    for(let i=0;i<steps;i++){\n      const scale = 0.85 - i*0.15;\n      const geo = new THREE.CylinderGeometry(30*scale,30*scale,30,12,1);\n      const mesh = new THREE.Mesh(geo, mat);\n      mesh.position.y = -15 + i*30;\n      mesh.rotation.z = Math.PI/4;\n      group.add(mesh);\n    }\n    // 정점 (가느다란)\n    const tipGeo = new THREE.ConeGeometry(10,40,8);\n    const tip = new THREE.Mesh(tipGeo, mat);\n    tip.position.y = 25;\n    tip.rotation.z = Math.PI/4;\n    group.add(tip);\n    return group;\n  };\n  const tower = makeTower();\n  towerGroup.add(tower);\n  scene.add(towerGroup);\n  // -------------------------------------------------\n  // 단계별 3D 모델 (초기, 중간, 최종)\n  // -------------------------------------------------\n  const stages = [\n    {name:'초기 형태', group:new THREE.Group()},\n    {name:'중간 형태', group:new THREE.Group()},\n    {name:'완성 형태', group:new THREE.Group()}\n  ];\n  stages.forEach(stage => {\n    // 초기 형태: 큰 원통형 베이스\n    const baseGeo = new THREE.CylinderGeometry(35,35,70,12,1);\n    const base = new THREE.Mesh(baseGeo, new THREE.MeshStandardMaterial({color:0x333333}));\n    base.position.y = -35;\n    stage.group.add(base);\n    // 중간 형태: 베이스에 단계 추가\n    const stepCount = 3;\n    for(let i=0;i<stepCount;i++){\n      const scale = 0.8 - i*0.2;\n      const geo = new THREE.CylinderGeometry(35*scale,35*scale,70,12,1);\n      const mesh = new THREE.Mesh(geo, new THREE.MeshStandardMaterial({color:0x444444}));\n      mesh.position.y = -35 + i*70;\n      mesh.rotation.z = Math.PI/4;\n      stage.group.add(mesh);\n    }\n    // 완성 형태: 정점 추가\n    const tipGeo = new THREE.ConeGeometry(12,80,8);\n    const tip = new THREE.Mesh(tipGeo, new THREE.MeshStandardMaterial({color:0x555555}));\n    tip.position.y = 45;\n    tip.rotation.z = Math.PI/4;\n    stage.group.add(tip);\n    scene.add(stage.group);\n  });\n  // -------------------------------------------------\n  // 뷰 리셋 버튼\n  // -------------------------------------------------\n  const resetBtn = document.querySelector('.reset');\n  resetBtn.addEventListener('click', () => {\n    controls.reset();\n    camera.position.set(0, 150, 300);\n    camera.lookAt(0, 0, 0);\n  });\n  // -------------------------------------------------\n  // 애니메이션 루프\n  // -------------------------------------------------\n  const animate = () => {\n    requestAnimationFrame(animate);\n    controls.update();\n    renderer.render(scene, camera);\n  };\n  animate();\n  // -------------------------------------------------\n  // 반응형 처리\n  // -------------------------------------------------\n  window.addEventListener('resize', () => {\n    const w = window.innerWidth;\n    const h = window.innerHeight;\n    renderer.setSize(w, h);\n    camera.aspect = w/h;\n    camera.updateProjectionMatrix();\n  });\n</script>\n</body>\n</html>",
