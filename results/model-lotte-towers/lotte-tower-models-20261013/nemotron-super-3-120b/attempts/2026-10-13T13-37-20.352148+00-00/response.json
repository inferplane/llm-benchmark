  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Lotte Tower Artwork</title>\n<style>\n  body { margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #0a0a0a; color: #e0e0e0; overflow: hidden; }\n  #container { position: relative; width: 100vw; height: 100vh; }\n  #threejs-container { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }\n  .ui-panel { position: absolute; top: 20px; left: 20px; background: rgba(0, 0, 0, 0.6); border-radius: 8px; padding: 16px; z-index: 10; max-width: 300px; }\n  .ui-panel h2 { margin-top: 0; font-size: 24px; color: #4fc3f7; }\n  .tab-group { display: flex; margin-bottom: 16px; gap: 8px; }\n  .tab-button { flex: 1; padding: 10px 12px; background: rgba(255, 255, 255, 0.1); border: none; border-radius: 4px; color: #e0e0e0; font-size: 19px; cursor: pointer; transition: background 0.2s; }\n  .tab-button:hover, .tab-button:focus { background: rgba(255, 255, 255, 0.2); outline: 2px solid #4fc3f7; }\n  .tab-button.active { background: rgba(79, 195, 247, 0.3); }\n  .control-label { display: block; margin-bottom: 6px; font-size: 19px; }\n  .slider-container { margin: 12px 0; }\n  input[type=\"range\"] { width: 100%; }\n  .image-preview { margin-top: 16px; }\n  .image-preview img { width: 100%; height: auto; border-radius: 4px; display: block; }\n  .status-text { margin-top: 12px; font-size: 18px; min-height: 20px; }\n</style>\n</head>\n<body>\n<div id=\"container\">\n  <div id=\"threejs-container\"></div>\n  <div class=\"ui-panel\" tabindex=\"-1\">\n    <h2>Lotte Tower Views</h2>\n    <div class=\"tab-group\">\n      <button class=\"tab-button active\" data-view=\"site\" tabindex=\"0\">Site Plan</button>\n      <button class=\"tab-button\" data-view=\"floor\" tabindex=\"0\">Floor Plan</button>\n      <button class=\"tab-button\" data-view=\"elevation\" tabindex=\"0\">Elevation</button>\n      <button class=\"tab-button\" data-view=\"section\" tabindex=\"0\">Section</button>\n    </div>\n    <label class=\"control-label\" for=\"rotation\">Camera Rotation</label>\n    <div class=\"slider-container\">\n      <input type=\"range\" id=\"rotation\" min=\"0\" max=\"360\" value=\"0\">\n    </div>\n    <label class=\"control-label\" for=\"zoom\">Camera Zoom</label>\n    <div class=\"slider-container\">\n      <input type=\"range\" id=\"zoom\" min=\"10\" max=\"100\" value=\"50\">\n    </div>\n    <div class=\"image-preview\">\n      <img id=\"view-image\" src=\"\" alt=\"Selected view\">\n    </div>\n    <div class=\"status-text\" id=\"status\">Ready</div>\n  </div>\n</div>\n\n<script type=\"module\">\n  import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.158.0/build/three.module.js';\n\n  let scene, camera, renderer, controls;\n  let currentView = 'site';\n  const viewImages = {\n    site: 'https://via.placeholder.com/400x300/1a1a1a/4fc3f7?text=Site+Plan+View',\n    floor: 'https://via.placeholder.com/400x300/1a1a1a/4fc3f7?text=Floor+Plan+View',\n    elevation: 'https://via.placeholder.com/400x300/1a1a1a/4fc3f7?text=Elevation+View',\n    section: 'https://via.placeholder.com/400x300/1a1a1a/4fc3f7?text=Section+View'\n  };\n\n  init();\n  animate();\n\n  function init() {\n    scene = new THREE.Scene();\n    scene.background = new THREE.Color(0x0a0a0a);\n\n    camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);\n    camera.position.set(15, 15, 15);\n\n    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n    renderer.setSize(window.innerWidth, window.innerHeight);\n    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n    document.getElementById('threejs-container').appendChild(renderer.domElement);\n\n    // Simple tower geometry\n    const geometry = new THREE.CylinderGeometry(2, 2, 30, 32);\n    const material = new THREE.MeshStandardMaterial({ color: 0x4fc3f7, metalness: 0.2, roughness: 0.3 });\n    const tower = new THREE.Mesh(geometry, material);\n    tower.position.y = 15;\n    scene.add(tower);\n\n    // Lighting\n    const ambientLight = new THREE.AmbientLight(0x404040, 0.6);\n    scene.add(ambientLight);\n    const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);\n    directionalLight.position.set(10, 20, 10);\n    scene.add(directionalLight);\n\n    // Controls\n    const rotationSlider = document.getElementById('rotation');\n    const zoomSlider = document.getElementById('zoom');\n    const statusEl = document.getElementById('status');\n    const viewImageEl = document.getElementById('view-image');\n    const tabButtons = document.querySelectorAll('.tab-button');\n\n    function updateView() {\n      viewImageEl.src = viewImages[currentView];\n      viewImageEl.alt = `${currentView.charAt(0).toUpperCase() + currentView.slice(1)} View`;\n      statusEl.textContent = `Displaying ${currentView} view`;\n    }\n\n    tabButtons.forEach(button => {\n      button.addEventListener('click', () => {\n        tabButtons.forEach(btn => btn.classList.remove('active'));\n        button.classList.add('active');\n        currentView = button.dataset.view;\n        updateView();\n      });\n      button.addEventListener('keydown', (e) => {\n        if (e.key === 'Enter' || e.key === ' ') {\n          e.preventDefault();\n          button.click();\n        }\n      });\n    });\n\n    rotationSlider.addEventListener('input', () => {\n      const angle = THREE.MathUtils.degToRad(parseFloat(rotationSlider.value));\n      camera.position.x = 15 * Math.sin(angle);\n      camera.position.z = 15 * Math.cos(angle);\n      camera.lookAt(0, 15, 0);\n    });\n\n    zoomSlider.addEventListener('input', () => {\n      const zoomFactor = parseFloat(zoomSlider.value) / 50;\n      camera.fov = 45 / zoomFactor;\n      camera.updateProjectionMatrix();\n    });\n\n    window.addEventListener('resize', () => {\n      camera.aspect = window.innerWidth / window.innerHeight;\n      camera.updateProjectionMatrix();\n      renderer.setSize(window.innerWidth, window.innerHeight);\n    });\n\n    updateView();\n  }\n\n  function animate() {\n    requestAnimationFrame(animate);\n    renderer.render(scene, camera);\n  }\n</script>\n</body>\n</html>",
