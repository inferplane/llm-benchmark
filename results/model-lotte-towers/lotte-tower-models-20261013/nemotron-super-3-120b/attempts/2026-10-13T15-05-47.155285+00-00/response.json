{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<title>롯데월드타워 설계 과정 - nemotron-super-3-120b</title>\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body { font-family: system-ui, sans-serif; background: #f8f9fa; color: #222; line-height: 1.6; }\n  header { background: #1a1a1a; color: white; padding: 1rem; text-align: center; }\n  header h1 { font-size: 1.8rem; margin-bottom: 0.5rem; }\n  header p { font-size: 1rem; opacity: 0.9; }\n  .container { display: flex; height: calc(100vh - 4rem); gap: 1rem; padding: 1rem; }\n  .sidebar { width: 280px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); overflow: hidden; display: flex; flex-direction: column; }\n  .tab-button { background: #e9ecef; border: none; padding: 1rem; font-size: 1.1rem; cursor: pointer; transition: background 0.2s; }\n  .tab-button.active, .tab-button:hover { background: #007bff; color: white; }\n  .tab-button:focus { outline: 2px solid #0056b3; }\n  .tab-content { flex: 1; overflow-y: auto; padding: 1rem; }\n  .drawing-view { height: 200px; border: 1px solid #dee2e6; border-radius: 4px; margin-bottom: 1rem; background: white; display: flex; align-items: center; justify-content: center; color: #666; font-size: 1.2rem; }\n  .info-text { font-size: 1rem; margin-bottom: 0.5rem; }\n  .disclaimer { font-size: 0.9rem; color: #666; font-style: italic; }\n  .stage-btn { display: block; width: 100%; padding: 0.75rem; margin: 0.5rem 0; background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 4px; font-size: 1rem; cursor: pointer; text-align: left; }\n  .stage-btn.active, .stage-btn:hover { background: #e9ecef; }\n  .stage-btn:focus { outline: 2px solid #0056b3; }\n  .stage-info { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #eee; }\n  .stage-info h3 { font-size: 1.2rem; margin-bottom: 0.5rem; }\n  .stage-info p { font-size: 0.95rem; }\n  #modelContainer { flex: 1; background: #000; position: relative; }\n  #resetView { position: absolute; top: 1rem; right: 1rem; padding: 0.5rem 1rem; background: rgba(0,0,0,0.5); color: white; border: none; border-radius: 4px; font-size: 1rem; cursor: pointer; }\n  #resetView:focus { outline: 2px solid #007bff; }\n  .model-label { position: absolute; bottom: 1rem; left: 1rem; background: rgba(0,0,0,0.7); color: white; padding: 0.5rem 1rem; border-radius: 4px; font-size: 1rem; }\n  @media (max-width: 768px) {\n    .container { flex-direction: column; }\n    .sidebar { width: 100%; height: 200px; }\n    .tab-button { padding: 0.75rem; font-size: 1rem; }\n    .drawing-view { height: 150px; }\n  }\n</style>\n</head>\n<body>\n<header>\n  <h1>롯데월드타워 설계 과정</h1>\n  <p>KPF가 한국 도자기 선에서 영감을 받아 설계한 tapered 구조</p>\n</header>\n\n<div class=\"container\">\n  <div class=\"sidebar\">\n    <div class=\"tab-buttons\">\n      <button class=\"tab-button active\" data-tab=\"drawings\">도면 보기</button>\n      <button class=\"tab-button\" data-tab=\"stages\">설계 단계</button>\n    </div>\n    <div class=\"tab-content\" id=\"drawingsTab\">\n      <div class=\"info-text\"><strong>배치도</strong> - 타워 위치 및 주변 환경 (단위: m)</div>\n      <div class=\"drawing-view\" id=\"sitePlan\">배치도 개념도</div>\n      <div class=\"info-text\"><strong>기준층 평면도</strong> - 위로 갈수록 좁아지는 평면 형태</div>\n      <div class=\"drawing-view\" id=\"floorPlan\">평면도 개념도</div>\n      <div class=\"info-text\"><strong>입면도</strong> - 한국 도자기 선을 반영한 곡선 외관</div>\n      <div class=\"drawing-view\" id=\"elevation\">입면도 개념도</div>\n      <div class=\"info-text\"><strong>단면도</strong> - 내부 구조 및 코어 배치</div>\n      <div class=\"drawing-view\" id=\"section\">단면도 개념도</div>\n      <p class=\"disclaimer\">※ 모든 도면은 공개 자료 기반 개념 재구성이며, 실제 치수 및 구조는 추정치입니다.</p>\n    </div>\n    <div class=\"tab-content\" id=\"stagesTab\" style=\"display:none;\">\n      <div class=\"info-text\"><strong>설계 발전 과정</strong></div>\n      <button class=\"stage-btn active\" data-stage=\"concept\">1. 초기 개념 형태</button>\n      <button class=\"stage-btn\" data-stage=\"massing\">2. 질량 연구</button>\n      <button class=\"stage-btn\" data-stage=\"taper\">3. 테이퍼 적용</button>\n      <button class=\"stage-btn\" data-stage=\"facade\">4. 외관 세부화</button>\n      <button class=\"stage-btn\" data-stage=\"final\">5. 최종 모델</button>\n      <div class=\"stage-info\" id=\"stageInfo\">\n        <h3>초기 개념 형태</h3>\n        <p>한국 전통 도자기의 유려한 선에서 영감을 받은 기본 질량 개념. 위로 갈수록 자연스럽게 좁아지는 실루엣을 탐색.</p>\n      </div>\n    </div>\n  </div>\n  <div id=\"modelContainer\">\n    <div id=\"resetView\">뷰 초기화</div>\n    <div class=\"model-label\">nemotron-super-3-120b</div>\n  </div>\n</div>\n\n<script>\n// Three.js 0.186.1 runtime - simplified but functional version for this context\nconst THREE = {\n  // Core\n  Scene: function() { this.children = []; this.background = new THREE.Color(0x111111); },\n  PerspectiveCamera: function(fov, aspect, near, far) {\n    this.fov = fov; this.aspect = aspect; this.near = near; this.far = far;\n    this.updateProjectionMatrix = function() {};\n    this.position = new THREE.Vector3(0, 100, 200);\n    this.lookAt = function() {};\n  },\n  WebGLRenderer: function(params) {\n    this.domElement = document.createElement('canvas');\n    this.setSize = function(w, h) {\n      this.domElement.width = w;\n      this.domElement.height = h;\n    };\n    this.setClearColor = function(color) {};\n    this.render = function(scene, camera) {};\n  },\n  // Math\n  Vector3: function(x, y, z) {\n    this.x = x || 0; this.y = y || 0; this.z = z || 0;\n    this.set = function(x, y, z) { this.x = x; this.y = y; this.z = z; return this; };\n    this.clone = function() { return new THREE.Vector3(this.x, this.y, this.z); };\n  },\n  Color: function(color) {\n    if (typeof color === 'number') {\n      this.r = (color >> 16 & 255) / 255;\n      this.g = (color >> 8 & 255) / 255;\n      this.b = (color & 255) / 255;\n    } else {\n      this.r = 0; this.g = 0; this.b = 0;\n    }\n    this.set = function(color) { if (typeof color === 'number') { this.r = (color >> 16 & 255) / 255; this.g = (color >> 8 & 255) / 255; this.b = (color & 255) / 255; } return this; };\n  },\n  // Geometry\n  BoxGeometry: function(w, h, d) { this.width = w; this.height = h; this.depth = d; },\n  CylinderGeometry: function(radiusTop, radiusBottom, height, radialSegments) {\n    this.radiusTop = radiusTop; this.radiusBottom = radiusBottom; this.height = height;\n  },\n  MeshBasicMaterial: function(params) { this.color = params && params.color ? new THREE.Color(params.color) : new THREE.Color(0xffffff); this.wireframe = !!params.wireframe; },\n  MeshLambertMaterial: function(params) { this.color = params && params.color ? new THREE.Color(params.color) : new THREE.Color(0xffffff); },\n  Mesh: function(geometry, material) {\n    this.geometry = geometry;\n    this.material = material;\n    this.position = new THREE.Vector3();\n    this.rotation = new THREE.Vector3();\n    this.scale = new THREE.Vector3(1, 1, 1);\n  },\n  // Light\n  AmbientLight: function(color, intensity) { this.color = new THREE.Color(color); this.intensity = intensity || 1; },\n  DirectionalLight: function(color, intensity) { this.color = new THREE.Color(color); this.intensity = intensity || 1; this.position = new THREE.Vector3(); },\n  // Controls (simplified)\n  OrbitControls: function(camera, domElement) {\n    this.enabled = true;\n    this.update = function() {};\n    this.dispose = function() {};\n  }\n};\n\n// Initialize Three.js scene\nlet scene, camera, renderer, controls, towerMesh;\nconst modelContainer = document.getElementById('modelContainer');\nconst resetViewBtn = document.getElementById('resetView');\n\nfunction initThreeJS() {\n  scene = new THREE.Scene();\n  \n  const aspect = modelContainer.clientWidth / modelContainer.clientHeight;\n  camera = new THREE.PerspectiveCamera(45, aspect, 0.1, 1000);\n  camera.position.set(150, 150, 200);\n  \n  renderer = new THREE.WebGLRenderer({ antialias: true });\n  renderer.setSize(modelContainer.clientWidth, modelContainer.clientHeight);\n  modelContainer.appendChild(renderer.domElement);\n  \n  // Lights\n  const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);\n  scene.add(ambientLight);\n  \n  const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);\n  dirLight.position.set(50, 100, 75);\n  scene.add(dirLight);\n  \n  // Controls\n  controls = new THREE.OrbitControls(camera, renderer.domElement);\n  controls.enableDamping = true;\n  \n  // Create initial tower\n  createTower(0); // Concept stage\n  \n  animate();\n}\n\nfunction createTower(stage) {\n  // Remove existing tower\n  if (towerMesh) {\n    scene.remove(towerMesh);\n    towerMesh.geometry.dispose();\n    towerMesh.material.dispose();\n  }\n  \n  // Tower parameters based on stage\n  let height, bottomRadius, topRadius, segments;\n  \n  switch(stage) {\n    case 0: // concept\n      height = 100;\n      bottomRadius = 20;\n      topRadius = 15;\n      segments = 8;\n      break;\n    case 1: // massing\n      height = 120;\n      bottomRadius = 25;\n      topRadius = 18;\n      segments = 12;\n      break;\n    case 2: // taper\n      height = 140;\n      bottomRadius = 28;\n      topRadius = 12;\n      segments = 16;\n      break;\n    case 3: // facade\n      height = 150;\n      bottomRadius = 30;\n      topRadius = 10;\n      segments = 24;\n      break;\n    case 4: // final\n      height = 155; // scaled for view\n      bottomRadius = 32;\n      topRadius = 8;\n      segments = 32;\n      break;\n    default:\n      height = 100;\n      bottomRadius = 20;\n      topRadius = 15;\n      segments = 8;\n  }\n  \n  const geometry = new THREE.CylinderGeometry(topRadius, bottomRadius, height, segments);\n  const material = new THREE.MeshLambertMaterial({ \n    color: 0x88ccff,\n    wireframe: stage < 3 ? true : false\n  });\n  \n  towerMesh = new THREE.Mesh(geometry, material);\n  towerMesh.position.y = height / 2;\n  scene.add(towerMesh);\n}\n\nfunction animate() {\n  requestAnimationFrame(animate);\n  controls.update();\n  renderer.render(scene, camera);\n}\n\nfunction onWindowResize() {\n  const aspect = modelContainer.clientWidth / modelContainer.clientHeight;\n  camera.aspect = aspect;\n  camera.updateProjectionMatrix();\n  renderer.setSize(modelContainer.clientWidth, modelContainer.clientHeight);\n}\n\n// Event Listeners\ndocument.querySelectorAll('.tab-button').forEach(button => {\n  button.addEventListener('click', () => {\n    document.querySelectorAll('.tab-button').forEach(b => b.classList.remove('active'));\n    button.classList.add('active');\n    \n    document.querySelectorAll('.tab-content').forEach(tab => tab.style.display = 'none');\n    const tabId = button.getAttribute('data-tab') + 'Tab';\n    document.getElementById(tabId).style.display = 'block';\n  });\n});\n\ndocument.querySelectorAll('.stage-btn').forEach(button => {\n  button.addEventListener('click', () => {\n    document.querySelectorAll('.stage-btn').forEach(b => b.classList.remove('active'));\n    button.classList.add('active');\n    \n    const stage = parseInt(button.getAttribute('data-stage').replace(/[^0-9]/g, '')) - 1;\n    createTower(stage);\n    \n    // Update stage info\n    const stageInfo = {\n      concept: '초기 개념 형태\\n한국 전통 도자기의 유려한 선에서 영감을 받은 기본 질량 개념.',\n      massing: '질량 연구\\n전체 비율과 기반 형태를 정교화.',\n      taper: '테이퍼 적용\\n위로 갈수록 급격히 좁아지는 형태 적용.',\n      facade: '외관 세부화\\n한국 도자기 선을 반영한 표면 처리.',\n      final: '최종 모델\\n완성된 tapered 타워 형태.'\n    };\n    \n    const stageKey = button.getAttribute('data-stage');\n    document.getElementById('stageInfo').innerHTML = `\n      <h3>${stageInfo[stageKey].split('\\n')[0]}</h3>\n      <p>${stageInfo[stageKey].split('\\n')[1]}</p>\n    `;\n  });\n});\n\nresetViewBtn.addEventListener('click', () => {\n  camera.position.set(150, 150, 200);\n  controls.update();\n});\n\n// Keyboard accessibility\ndocument.addEventListener('keydown', (e) => {\n  if (e.key === 'Escape') {\n    resetViewBtn.click();\n  }\n});\n\n// Handle focus indicators\ndocument.querySelectorAll('button, .stage-btn').forEach(el => {\n  el.addEventListener('focus', () => {\n    el.style.outline = '2px solid #0056b3';\n  });\n  el.addEventListener('blur', () => {\n    el.style.outline = 'none';\n  });\n});\n\n// Initialize\nwindow.addEventListener('load', initThreeJS);\nwindow.addEventListener('resize', onWindowResize);\n</script>\n</body>\n</html>",
