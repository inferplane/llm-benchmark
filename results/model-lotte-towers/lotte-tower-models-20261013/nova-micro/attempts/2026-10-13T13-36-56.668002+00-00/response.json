  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Nova Micro - Lotte Tower</title>\n    <style>\n        body {\n            margin: 0;\n            font-family: Arial, sans-serif;\n            line-height: 1.6;\n        }\n        header {\n            background: #333;\n            color: #fff;\n            padding: 10px 0;\n            text-align: center;\n        }\n        main {\n            padding: 20px;\n        }\n       .section {\n            margin-bottom: 30px;\n        }\n        .section h2 {\n            font-size: 24px;\n            margin-bottom: 10px;\n        }\n       .description {\n            font-size: 19px;\n            margin-bottom: 20px;\n        }\n       .canvas-container {\n            position: relative;\n            overflow: auto;\n        }\n       .canvas-viewport {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n        }\n        .controls {\n            display: flex;\n            justify-content: space-between;\n            margin-bottom: 20px;\n        }\n        .control-button {\n            background: #ddd;\n            border: none;\n            padding: 10px;\n            cursor: pointer;\n        }\n    </style>\n</head>\n<body>\n    <header>\n        <h1>Nova Micro - Lotte Tower Concept</h1>\n    </header>\n    <main>\n        <div class=\"section\">\n            <h2>Site View</h2>\n            <div class=\"description\">This is the site view of the Lotte Tower project.</div>\n            <div class=\"canvas-container\">\n                <div class=\"canvas-viewport\">\n                    <!-- Placeholder for actual site view -->\n                    <div style=\"width: 100%; height: 500px; background: lightgray;\"></div>\n                </div>\n            </div>\n        </div>\n        <div class=\"section\">\n            <h2>Floor Plan</h2>\n            <div class=\"description\">This is the floor plan of the Lotte Tower.</div>\n            <div class=\"canvas-container\">\n                <div class=\"canvas-viewport\">\n                    <!-- Placeholder for actual floor plan -->\n                    <div style=\"width: 100%; height: 500px; background: lightblue;\"></div>\n                </div>\n            </div>\n        </div>\n        <div class=\"section\">\n            <h2>Elevation</h2>\n            <div class=\"description\">This is the elevation view of the Lotte Tower.</div>\n            <div class=\"canvas-container\">\n                <div class=\"canvas-viewport\">\n                    <!-- Placeholder for actual elevation view -->\n                    <div style=\"width: 100%; height: 500px; background: lightgreen;\"></div>\n                </div>\n            </div>\n        </div>\n        <div class=\"section\">\n            <h2>Section</h2>\n            <div class=\"description\">This is the section view of the Lotte Tower.</div>\n            <div class=\"canvas-container\">\n                <div class=\"canvas-viewport\">\n                    <!-- Placeholder for actual section view -->\n                    <div style=\"width: 100%; height: 500px; background: lightcoral;\"></div>\n                </div>\n            </div>\n        </div>\n        <div class=\"section\">\n            <h2>Design Process</h2>\n            <div class=\"description\">Follow the stages of the design process leading to the final concept.</div>\n            <div class=\"canvas-container\">\n                <div class=\"canvas-viewport\">\n                    <!-- Placeholder for actual design process stages -->\n                    <div style=\"width: 100%; height: 500px; background: #f0f0f0;\"></div>\n                </div>\n            </div>\n        </div>\n        <div class=\"controls\">\n            <button class=\"control-button\" onclick=\"rotateCamera('left')\">Rotate Left</button>\n            <button class=\"control-button\" onclick=\"zoomCamera()\">Zoom</button>\n            <button class=\"control-button\" onclick=\"resetCamera()\">Reset View</button>\n        </div>\n    </main>\n    <script>\n        function rotateCamera(direction) {\n            console.log(`Rotate ${direction}`);\n        }\n        \n        function zoomCamera() {\n            console.log('Zoom');\n        }\n        \n        function resetCamera() {\n            console.log('Reset View');\n        }\n    </script>\n</body>\n</html>",
