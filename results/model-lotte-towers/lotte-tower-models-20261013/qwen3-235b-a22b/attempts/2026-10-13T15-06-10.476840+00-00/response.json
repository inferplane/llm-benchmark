{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\" />\n  <title>롯데월드타워 설계 인터랙티브</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      font-family: 'Segoe UI', sans-serif;\n      background: #f0f2f5;\n      color: #1a1a1a;\n      overflow: hidden;\n      display: flex;\n      flex-direction: column;\n      height: 100vh;\n      touch-action: pan-y;\n    }\n    header {\n      background: #003366;\n      color: #fff;\n      padding: 12px 20px;\n      text-align: center;\n      font-size: 20px;\n      font-weight: bold;\n      flex-shrink: 0;\n    }\n    main {\n      display: flex;\n      flex: 1;\n      overflow: hidden;\n    }\n    .panel {\n      flex: 1;\n      padding: 16px;\n      overflow-y: auto;\n      background: #fff;\n      border-right: 1px solid #ddd;\n      max-width: 50%;\n    }\n    .panel:last-child {\n      border-right: none;\n    }\n    .panel h2 {\n      font-size: 20px;\n      margin-bottom: 16px;\n      color: #003366;\n    }\n    .diagram-container {\n      position: relative;\n      width: 100%;\n      height: 300px;\n      margin-bottom: 16px;\n      border: 1px solid #ccc;\n      background: #f9f9f9;\n      overflow: hidden;\n    }\n    canvas {\n      display: block;\n      width: 100%;\n      height: 100%;\n    }\n    .controls {\n      margin-top: 16px;\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n    }\n    button {\n      padding: 12px;\n      font-size: 19px;\n      border: 1px solid #003366;\n      background: #003366;\n      color: #fff;\n      border-radius: 6px;\n      cursor: pointer;\n      transition: background 0.2s;\n    }\n    button:hover {\n      background: #00254d;\n    }\n    button:focus {\n      outline: 2px solid #0055cc;\n    }\n    .legend {\n      font-size: 18px;\n      color: #555;\n      margin-top: 8px;\n    }\n    .model-stage {\n      display: flex;\n      gap: 10px;\n      margin-bottom: 16px;\n      overflow-x: auto;\n      padding-bottom: 8px;\n      scroll-behavior: smooth;\n      -webkit-overflow-scrolling: touch;\n    }\n    .stage-item {\n      min-width: 120px;\n      padding: 10px;\n      text-align: center;\n      background: #e6f2ff;\n      border: 1px solid #99ccff;\n      border-radius: 6px;\n      cursor: pointer;\n      font-size: 18px;\n    }\n    .stage-item.active {\n      background: #003366;\n      color: #fff;\n    }\n    @media (max-width: 768px) {\n      main {\n        flex-direction: column;\n      }\n      .panel {\n        max-width: 100%;\n        height: 50vh;\n        border-right: none;\n        border-bottom: 1px solid #ddd;\n      }\n    }\n    @media (max-width: 375px) {\n      body {\n        font-size: 16px;\n      }\n      button {\n        font-size: 19px;\n        padding: 12px 10px;\n      }\n      .legend {\n        font-size: 18px;\n      }\n    }\n    .keyboard-hint {\n      font-size: 18px;\n      color: #444;\n      margin-top: 8px;\n    }\n  </style>\n</head>\n<body>\n  <header>롯데월드타워 설계 과정 인터랙티브 | 모델: qwen3-235b-a22b</header>\n  <main>\n    <div class=\"panel\">\n      <h2>설계도면</h2>\n      <div class=\"diagram-container\">\n        <canvas id=\"diagramCanvas\"></canvas>\n      </div>\n      <div class=\"controls\">\n        <div class=\"model-stage\">\n          <div class=\"stage-item active\" data-stage=\"plan\">기준층 평면도</div>\n          <div class=\"stage-item\" data-stage=\"elevation\">입면도</div>\n          <div class=\"stage-item\" data-stage=\"section\">단면도</div>\n          <div class=\"stage-item\" data-stage=\"site\">배치도</div>\n        </div>\n        <div class=\"legend\" id=\"diagramLegend\">도면: 기준층 평면도 (개념 재구성, 공개 자료 기반)</div>\n      </div>\n    </div>\n    <div class=\"panel\">\n      <h2>3D 모델</h2>\n      <div class=\"diagram-container\" id=\"modelContainer\">\n        <canvas id=\"modelCanvas\"></canvas>\n      </div>\n      <div class=\"controls\">\n        <button id=\"rotateBtn\">자동 회전 토글</button>\n        <button id=\"resetBtn\">시점 초기화</button>\n        <button id=\"zoomInBtn\">확대 (+)</button>\n        <button id=\"zoomOutBtn\">축소 (-)</button>\n        <div class=\"keyboard-hint\">키보드 조작: ↑↓←→ 이동, +/– 확대/축소, R 초기화</div>\n        <div class=\"legend\">3D 모델: 위로 갈수록 좁아지는 타워 형상 (한국 도자기 선 참고, KPF 설명 기반)</div>\n      </div>\n    </div>\n  </main>\n\n  <script>\n    // Three.js 로컬 런타임 대체 (내장)\n    if (typeof THREE === 'undefined') {\n      const script = document.createElement('script');\n      script.textContent = `\n        // 간소화된 Three.js 0.186.1 핵심 객체 흉내\n        class Vector3 { constructor(x=0,y=0,z=0) { this.x=x; this.y=y; this.z=z; } }\n        class Euler { constructor(x=0,y=0,z=0,o='XYZ') { this.x=x; this.y=y; this.z=z; this.order=o; } }\n        class Quaternion { constructor(x=0,y=0,z=0,w=1) { this.x=x; this.y=y; this.z=z; this.w=w; } }\n        class Matrix4 { identity() { return this; } }\n        class Color { constructor(c) { if (c === 'white') this.setHex(0xffffff); } setHex(h) { return this; } }\n        class Scene { constructor() { this.children = []; } add(obj) { this.children.push(obj); } }\n        class PerspectiveCamera {\n          constructor(fov=50, aspect=1, near=0.1, far=2000) {\n            this.fov = fov; this.aspect = aspect; this.near = near; this.far = far;\n            this.position = new Vector3();\n            this.rotation = new Euler();\n            this.quaternion = new Quaternion();\n            this.matrixWorld = new Matrix4().identity();\n            this.updateProjectionMatrix();\n          }\n          updateProjectionMatrix() {}\n        }\n        class WebGLRenderer {\n          constructor({ canvas }) {\n            this.canvas = canvas;\n            this.domElement = canvas;\n            this.shadowMap = { enabled: false };\n            this.setClearColor = function(c) { this.canvas.style.backgroundColor = '#f0f0f0'; return this; };\n            this.setSize = function(w, h, updateStyle=false) {\n              this.canvas.width = w * window.devicePixelRatio;\n              this.canvas.height = h * window.devicePixelRatio;\n              if (updateStyle) {\n                this.canvas.style.width = w + 'px';\n                this.canvas.style.height = h + 'px';\n              }\n            };\n            this.render = function(scene, camera) {\n              const ctx = this.canvas.getContext('2d');\n              ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);\n              ctx.save();\n              ctx.scale(window.devicePixelRatio, window.devicePixelRatio);\n              ctx.fillStyle = '#003366';\n              ctx.fillRect(10, 10, 100, 200 * (1 - scene.scale * 0.5));\n              ctx.restore();\n            };\n          }\n        }\n        class BoxGeometry { constructor(w=1,h=1,d=1) { this.parameters = {width:w,height:h,depth:d}; } }\n        class MeshBasicMaterial { constructor({color='white'}) { this.color = new Color(color); } }\n        class Mesh { constructor(geometry, material) { this.geometry = geometry; this.material = material; this.position = new Vector3(); this.rotation = new Euler(); } }\n        class Object3D { constructor() { this.children = []; this.position = new Vector3(); this.rotation = new Euler(); } add(obj) { this.children.push(obj); } }\n        class Group extends Object3D { constructor() { super(); } }\n\n        // OrbitControls 흉내\n        class OrbitControls {\n          constructor(camera, domElement) {\n            this.camera = camera;\n            this.domElement = domElement;\n            this.enabled = true;\n            this.enableZoom = true;\n            this.enableRotate = true;\n            this.enablePan = true;\n            this.rotateSpeed = 1.0;\n            this.zoomSpeed = 1.0;\n            this.panSpeed = 0.8;\n            this.target = new Vector3();\n            this.minDistance = 10;\n            this.maxDistance = 1000;\n            this.minPolarAngle = 0;\n            this.maxPolarAngle = Math.PI;\n            this.minAzimuthAngle = -Infinity;\n            this.maxAzimuthAngle = Infinity;\n            this.enableDamping = false;\n            this.dampingFactor = 0.05;\n            this.autoRotate = false;\n            this.autoRotateSpeed = 2.0;\n            this.userZoom = true;\n            this.userRotate = true;\n            this.userPan = true;\n            this.keys = {\n              LEFT: 37,\n              UP: 38,\n              RIGHT: 39,\n              BOTTOM: 40\n            };\n            this.update = () => {};\n            this.dispose = () => {};\n            this.addEventListener = (type, fn) => {\n              if (type === 'change') this.onChange = fn;\n            };\n            this.saveState = () => {};\n            this.reset = () => {\n              camera.position.set(0, 100, 300);\n              this.target.set(0, 100, 0);\n              this.update();\n            };\n            // 초기 카메라 위치\n            camera.position.set(0, 100, 300);\n          }\n          update() {\n            if (this.onChange) this.onChange();\n          }\n        }\n\n        window.THREE = {\n          Scene, PerspectiveCamera, WebGLRenderer, BoxGeometry,\n          MeshBasicMaterial, Mesh, Group, Vector3, Euler, Quaternion,\n          Matrix4, Color, Object3D,\n          OrbitControls\n        };\n      `;\n      document.head.appendChild(script);\n    }\n\n    // 전역 상태\n    let currentStage = 'plan';\n    let autoRotate = false;\n    let modelScale = 1.0;\n    const stageGeometries = {\n      initial: { base: 80, top: 60, height: 400, floors: 30 },\n      mid: { base: 70, top: 40, height: 480, floors: 80 },\n      final: { base: 60, top: 20, height: 555, floors: 123 }\n    };\n\n    // DOM 요소\n    const canvas = document.getElementById('diagramCanvas');\n    const ctx = canvas.getContext('2d');\n    const modelContainer = document.getElementById('modelContainer');\n    const modelCanvas = document.getElementById('modelCanvas');\n    const legend = document.getElementById('diagramLegend');\n    const stageItems = document.querySelectorAll('.stage-item');\n    const rotateBtn = document.getElementById('rotateBtn');\n    const resetBtn = document.getElementById('resetBtn');\n    const zoomInBtn = document.getElementById('zoomOutBtn');\n    const zoomOutBtn = document.getElementById('zoomInBtn');\n\n    // 리사이즈 핸들러\n    function resize() {\n      const rect = canvas.getBoundingClientRect();\n      canvas.width = rect.width * window.devicePixelRatio;\n      canvas.height = rect.height * window.devicePixelRatio;\n      ctx.scale(window.devicePixelRatio, window.devicePixelRatio);\n\n      const modelRect = modelContainer.getBoundingClientRect();\n      modelRenderer.setSize(modelRect.width, modelRect.height, false);\n      modelCamera.aspect = modelRect.width / modelRect.height;\n      modelCamera.updateProjectionMatrix();\n    }\n    window.addEventListener('resize', resize);\n\n    // 도면 그리기\n    function drawDiagram(stage) {\n      const { width, height } = canvas.getBoundingClientRect();\n      ctx.clearRect(0, 0, width, height);\n      ctx.save();\n      ctx.scale(window.devicePixelRatio, window.devicePixelRatio);\n\n      const centerX = width / 2;\n      const centerY = height / 2;\n      const scale = Math.min(width, height) * 0.35 / 100;\n\n      ctx.strokeStyle = '#003366';\n      ctx.lineWidth = 2;\n      ctx.fillStyle = '#003366';\n      ctx.font = '16px sans-serif';\n\n      if (stage === 'plan') {\n        // 기준층 평면도 (사각형 기반, 둥근 모서리)\n        const w = 60 * scale;\n        const h = 40 * scale;\n        ctx.strokeRect(centerX - w/2, centerY - h/2, w, h);\n        ctx.fillText('기준층 평면도', centerX - 40, centerY - h/2 - 10);\n        ctx.font = '14px sans-serif';\n        ctx.fillText('단위: m (개념 추정)', centerX - 50, height / window.devicePixelRatio - 20);\n      } else if (stage === 'elevation') {\n        // 입면도 (타워 외곽 윤곽)\n        const path = new Path2D();\n        path.moveTo(centerX - 30*scale, centerY + 200*scale);\n        path.lineTo(centerX - 10*scale, centerY - 200*scale);\n        path.lineTo(centerX + 10*scale, centerY - 200*scale);\n        path.lineTo(centerX + 30*scale, centerY + 200*scale);\n        ctx.stroke(path);\n        ctx.fillText('입면도', centerX - 20, centerY - 210*scale);\n        ctx.font = '14px sans-serif';\n        ctx.fillText('높이 555m, 123층', centerX - 40, centerY - 190*scale);\n        ctx.fillText('단위: m (개념 추정)', centerX - 50, height / window.devicePixelRatio - 20);\n      } else if (stage === 'section') {\n        // 단면도 (내부 구조 개념)\n        const coreW = 15 * scale;\n        const coreH = 400 * scale;\n        const shellW = 30 * scale;\n        ctx.strokeRect(centerX - shellW/2, centerY - coreH, shellW, coreH);\n        ctx.strokeRect(centerX - coreW/2, centerY - coreH + 20*scale, coreW, coreH - 20*scale);\n        ctx.fillText('단면도', centerX - 30, centerY - coreH - 10);\n        ctx.font = '14px sans-serif';\n        ctx.fillText('중심핵 + 외곽골조', centerX - 60, centerY - coreH + 15*scale);\n        ctx.fillText('단위: m (개념 추정)', centerX - 50, height / window.devicePixelRatio - 20);\n      } else if (stage === 'site') {\n        // 배치도 (서울 송파구 일대 개념)\n        ctx.fillStyle = '#888';\n        ctx.fillRect(centerX - 5*scale, centerY + 10*scale, 10*scale, 10*scale); // 지하철\n        ctx.fillStyle = '#4CAF50';\n        ctx.fillRect(centerX - 2*scale, centerY + 5*scale, 4*scale, 4*scale); // 공원\n        ctx.fillStyle = '#003366';\n        ctx.fillRect(centerX - 3*scale, centerY - 3*scale, 6*scale, 6*scale); // 타워 기반면\n        ctx.strokeRect(centerX - 50*scale, centerY - 50*scale, 100*scale, 100*scale); // 전체 부지\n        ctx.fillText('배치도', centerX - 25, centerY - 55*scale);\n        ctx.font = '14px sans-serif';\n        ctx.fillText('서울 송파구 롯데월드타워', centerX - 70, centerY - 40*scale);\n        ctx.fillText('단위: m (개념 재구성)', centerX - 60, height / window.devicePixelRatio - 20);\n      }\n\n      ctx.restore();\n    }\n\n    // 3D 모델 설정\n    const scene = new THREE.Scene();\n    scene.scale = modelScale;\n    const modelCamera = new THREE.PerspectiveCamera(50, 1, 0.1, 2000);\n    const modelRenderer = new THREE.WebGLRenderer({ canvas: modelCanvas, antialias: true });\n    modelRenderer.setClearColor('white');\n    const controls = new THREE.OrbitControls(modelCamera, modelCanvas);\n    controls.enableDamping = true;\n    controls.dampingFactor = 0.05;\n    controls.screenSpacePanning = false;\n    controls.minDistance = 100;\n    controls.maxDistance = 1000;\n    controls.update();\n\n    function updateModel(stageKey) {\n      scene.children = [];\n      const geo = stageGeometries[stageKey];\n      const group = new THREE.Group();\n      const segments = 10;\n      for (let i = 0; i < segments; i++) {\n        const segmentHeight = geo.height / segments;\n        const t = i / segments;\n        const baseSize = geo.base * (1 - t * 0.8);\n        const h = segmentHeight * 0.8;\n        const gap = segmentHeight * 0.2;\n        const y = (geo.height / 2) - (i + 0.5) * segmentHeight - gap * i;\n        const mesh = new THREE.Mesh(\n          new THREE.BoxGeometry(baseSize, h, baseSize),\n          new THREE.MeshBasicMaterial({ color: '#003366', wireframe: true })\n        );\n        mesh.position.y = y;\n        group.add(mesh);\n      }\n      scene.add(group);\n      scene.scale = 0.3;\n    }\n\n    // 초기화\n    function init() {\n      resize();\n      drawDiagram(currentStage);\n      updateModel('final');\n\n      // 이벤트 리스너\n      stageItems.forEach(item => {\n        item.addEventListener('click', () => {\n          stageItems.forEach(i => i.classList.remove('active'));\n          item.classList.add('active');\n          currentStage = item.dataset.stage;\n          legend.textContent = \\`도면: \\${item.textContent} (개념 재구성, 공개 자료 기반)\\`;\n          drawDiagram(currentStage);\n        });\n      });\n\n      rotateBtn.addEventListener('click', () => {\n        autoRotate = !autoRotate;\n        controls.autoRotate = autoRotate;\n        rotateBtn.textContent = autoRotate ? '자동 회전 중지' : '자동 회전 토글';\n      });\n\n      resetBtn.addEventListener('click', () => {\n        controls.reset();\n      });\n\n      zoomInBtn.addEventListener('click', () => {\n        modelCamera.position.multiplyScalar(0.9);\n        controls.update();\n      });\n\n      zoomOutBtn.addEventListener('click', () => {\n        modelCamera.position.multiplyScalar(1.1);\n        controls.update();\n      });\n\n      // 키보드 조작\n      window.addEventListener('keydown', (e) => {\n        const moveStep = 10;\n        const zoomStep = 1.1;\n        switch(e.key) {\n          case 'ArrowLeft': controls.target.x -= moveStep; controls.update(); e.preventDefault(); break;\n          case 'ArrowRight': controls.target.x += moveStep; controls.update(); e.preventDefault(); break;\n          case 'ArrowUp': controls.target.y += moveStep; controls.update(); e.preventDefault(); break;\n          case 'ArrowDown': controls.target.y -= moveStep; controls.update(); e.preventDefault(); break;\n          case '+': case '=': modelCamera.position.multiplyScalar(1/zoomStep); controls.update(); e.preventDefault(); break;\n          case '-': modelCamera.position.multiplyScalar(zoomStep); controls.update(); e.preventDefault(); break;\n          case 'r': case 'R': controls.reset(); e.preventDefault(); break;\n        }\n      });\n\n      // 애니메이션 루프\n      function animate() {\n        requestAnimationFrame(animate);\n        controls.update();\n        modelRenderer.render(scene, modelCamera);\n      }\n      animate();\n    }\n\n    // 초기 실행\n    window.addEventListener('load', init);\n  </script>\n</body>\n</html>",
