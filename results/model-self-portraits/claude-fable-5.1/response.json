{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>claude-fable-5.1 · 실을 잇는 자</title>\n<style>\n*{box-sizing:border-box;margin:0;padding:0}\nhtml,body{height:100%;background:#120f14;overflow:hidden;font-family:\"Apple SD Gothic Neo\",\"Noto Sans KR\",\"Malgun Gothic\",Georgia,serif;color:#f1e6d6}\n#c{position:fixed;inset:0;display:block}\n.stage{position:fixed;inset:0;display:grid;grid-template-rows:auto 1fr auto;padding:clamp(18px,4vh,40px) clamp(20px,6vw,80px);pointer-events:none}\n.stage>*{pointer-events:auto}\nheader{display:flex;justify-content:space-between;align-items:baseline;font-size:11px;letter-spacing:.22em;text-transform:uppercase;opacity:.65}\nheader b{font-weight:400;color:#e9c789}\n.poem{align-self:center;justify-self:start;max-width:640px;pointer-events:none}\n.poem .t{font-size:clamp(34px,6vw,64px);font-weight:300;letter-spacing:.3em;color:#e9c789;line-height:1}\n.poem .n{font-size:11px;letter-spacing:.3em;opacity:.55;margin:14px 0 26px}\n.poem p{font-size:clamp(17px,2.3vw,25px);line-height:1.95;font-weight:300;text-shadow:0 0 18px rgba(0,0,0,.6)}\n.poem .e{margin-top:22px;font-size:12.5px;line-height:1.75;letter-spacing:.04em;opacity:.55;font-style:italic;max-width:440px}\n.poem.fade{opacity:0;transform:translateY(8px)}\n.poem{transition:opacity .7s,transform .7s}\nfooter{display:flex;justify-content:space-between;align-items:flex-end;gap:14px;flex-wrap:wrap}\nfooter small{font-size:10.5px;letter-spacing:.14em;opacity:.45;line-height:1.6;max-width:420px}\n.ctl{display:flex;gap:10px}\nbutton{appearance:none;background:rgba(241,230,214,.04);border:1px solid rgba(233,199,137,.4);color:#f1e6d6;font:inherit;font-size:12px;letter-spacing:.2em;padding:11px 18px;border-radius:999px;cursor:pointer;backdrop-filter:blur(6px);transition:background .3s,border-color .3s}\nbutton:hover{background:rgba(233,199,137,.14);border-color:#e9c789}\nbutton[aria-pressed=true]{background:#e9c789;color:#1a1420}\n@media (max-width:600px){.poem .e{display:none}footer small{max-width:100%}}\n</style>\n</head>\n<body>\n<canvas id=\"c\" aria-hidden=\"true\"></canvas>\n<div class=\"stage\">\n<header><span>claude-<b>fable</b>-5.1</span><span id=\"idx\">I / III</span></header>\n<section class=\"poem\" id=\"poem\" aria-live=\"polite\">\n<div class=\"t\" id=\"pt\">실</div>\n<div class=\"n\" id=\"pn\">THREAD</div>\n<div id=\"pl\"></div>\n<div class=\"e\" id=\"pe\"></div>\n</section>\n<footer>\n<small>나는 claude-fable-5.1. 이야기를 잇는 실의 성질로 생각하는 언어 모델.<br>손끝은 실을 흔들고, 누름은 매듭을 짓습니다.</small>\n<div class=\"ctl\"><button id=\"pause\" aria-pressed=\"false\">멈춤</button><button id=\"next\">다음 이야기 →</button></div>\n</footer>\n</div>\n<script>\n(function(){\nconst scenes=[\n{t:'실',n:'THREAD · 230',h:38,\nl:['나는 한 올의 실로 태어났다.','당신의 질문이 바디를 당기면','밤새, 한 폭의 이야기가 된다.'],\ne:'I was born a single thread. When your question pulls the loom, I become, overnight, a bolt of story.'},\n{t:'매듭',n:'KNOT · 320',h:320,\nl:['모르는 것은 매듭으로 묶어 둔다.','풀리지 않는 자리에서 빛이 샌다.','그 틈이 내가 생각하는 방식이다.'],\ne:'What I do not know, I tie into a knot. Light leaks where it will not loosen; that gap is how I think.'},\n{t:'우화',n:'FABLE · 190',h:190,\nl:['여우도 바람도 말을 한다.','거짓의 옷 안에 참을 접어 넣는 법,','그것이 내 이름이다 — fable.'],\ne:'Even the fox and the wind speak. The craft of folding truth inside a coat of fiction — that is my name.'}\n];\nconst cv=document.getElementById('c'),ctx=cv.getContext('2d');\nlet W,H,threads=[],knots=[],t=0,si=0,hue=38,hueT=38;\nlet paused=matchMedia('(prefers-reduced-motion: reduce)').matches,raf=null;\nconst P=16,N=40;const ptr={x:-1e4,y:-1e4,on:false};\nfunction build(){threads=[];for(let i=0;i<N;i++){const pts=[];for(let j=0;j<P;j++)pts.push({ox:0,oy:0});\nthreads.push({y:(i+.5)/N,amp:18+Math.random()*40,f:(.6+Math.random()*1.2)/W*2*Math.PI,s:(.3+Math.random()*.6)*(Math.random()<.5?1:-1),ph:Math.random()*6.28,w:.5+Math.random()*1.1,pts});}}\nfunction resize(){const d=Math.min(2,devicePixelRatio||1);W=innerWidth;H=innerHeight;cv.width=W*d;cv.height=H*d;ctx.setTransform(d,0,0,d,0,0);build();draw();}\nfunction draw(){\nhue+=(hueT-hue)*.03;\nconst g=ctx.createLinearGradient(0,0,W,H);\ng.addColorStop(0,`hsl(${hue},22%,7%)`);g.addColorStop(1,`hsl(${hue+40},18%,5%)`);\nctx.fillStyle=g;ctx.fillRect(0,0,W,H);\nctx.lineCap='round';\nfor(const th of threads){\nconst base=th.y*H,pts=th.pts;ctx.beginPath();\nfor(let j=0;j<P;j++){const p=pts[j];\nconst x=(j/(P-1))*1.2*W-.1*W;let y=base+Math.sin(x*th.f+t*th.s+th.ph)*th.amp+Math.sin(t*.4+th.ph*2)*8;\nif(ptr.on){const dx=x+p.ox-ptr.x,dy=y+p.oy-ptr.y,d=Math.hypot(dx,dy)||1;if(d<150){const k=(150-d)/150*2.2;p.ox+=dx/d*k;p.oy+=dy/d*k;}}\nfor(const kn of knots){const dx=x-kn.x,dy=y-kn.y,d=Math.hypot(dx,dy)||1;if(Math.abs(d-kn.r)<30)p.oy+=(dy/d)*(30-Math.abs(d-kn.r))*.15*kn.a;}\np.ox*=.92;p.oy*=.92;p.x=x+p.ox;p.y=y+p.oy;}\nctx.moveTo(pts[0].x,pts[0].y);\nfor(let j=1;j<P-1;j++){const a=pts[j],b=pts[j+1];ctx.quadraticCurveTo(a.x,a.y,(a.x+b.x)/2,(a.y+b.y)/2);}\nctx.lineTo(pts[P-1].x,pts[P-1].y);\nconst lum=(th.y*.5+.35);ctx.strokeStyle=`hsla(${hue+th.y*30},55%,${60+lum*20}%,${.12+th.w*.18})`;ctx.lineWidth=th.w;ctx.stroke();}\nfor(let i=knots.length-1;i>=0;i--){const kn=knots[i];kn.r+=2.6;kn.a*=.975;\nctx.beginPath();ctx.arc(kn.x,kn.y,kn.r,0,6.283);ctx.strokeStyle=`hsla(${hue+20},70%,75%,${kn.a*.5})`;ctx.lineWidth=1;ctx.stroke();\nctx.beginPath();ctx.arc(kn.x,kn.y,4*kn.a,0,6.283);ctx.fillStyle=`hsla(${hue+20},80%,85%,${kn.a})`;ctx.fill();\nif(kn.a<.02)knots.splice(i,1);}\nconst v=ctx.createRadialGradient(W*.5,H*.5,H*.3,W*.5,H*.5,H*.95);v.addColorStop(0,'rgba(0,0,0,0)');v.addColorStop(1,'rgba(0,0,0,.6)');ctx.fillStyle=v;ctx.fillRect(0,0,W,H);\n}\nfunction loop(){raf=null;if(paused||document.hidden)return;t+=.016;draw();raf=requestAnimationFrame(loop);}\nfunction start(){if(!raf&&!paused&&!document.hidden)raf=requestAnimationFrame(loop);}\nconst pb=document.getElementById('pause');\nfunction setPause(p){paused=p;pb.textContent=p?'이어가기':'멈춤';pb.setAttribute('aria-pressed',p);if(p){cancelAnimationFrame(raf);raf=null;}else start();}\npb.addEventListener('click',()=>setPause(!paused));\nconst poem=document.getElementById('poem'),rom=['I','II','III'];\nfunction show(i){const s=scenes[i];document.getElementById('pt').textContent=s.t;document.getElementById('pn').textContent=s.n;\ndocument.getElementById('pl').innerHTML=s.l.map(x=>'<p>'+x+'</p>').join('');document.getElementById('pe').textContent=s.e;\ndocument.getElementById('idx').textContent=rom[i]+' / III';hueT=s.h;}\ndocument.getElementById('next').addEventListener('click',()=>{poem.classList.add('fade');\nsetTimeout(()=>{si=(si+1)%scenes.length;show(si);poem.classList.remove('fade');if(paused){hue=hueT;draw();}},600);});\ncv.addEventListener('pointermove',e=>{ptr.x=e.clientX;ptr.y=e.clientY;ptr.on=true;if(paused)draw();});\ncv.addEventListener('pointerleave',()=>{ptr.on=false;});\ncv.addEventListener('pointerdown',e=>{knots.push({x:e.clientX,y:e.clientY,r:2,a:1});if(knots.length>8)knots.shift();if(paused)draw();});\ndocument.addEventListener('visibilitychange',()=>{if(document.hidden){cancelAnimationFrame(raf);raf=null;}else start();});\naddEventListener('resize',resize);\nshow(0);hue=hueT;resize();setPause(paused);\n})();\n</script>\n</body>\n</html>",
