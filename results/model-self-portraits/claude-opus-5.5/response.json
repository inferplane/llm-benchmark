  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>claude-opus-5.5 — 기울어짐에 관하여</title>\n<style>\n*{box-sizing:border-box;margin:0;padding:0}\nhtml,body{height:100%;overflow:hidden;background:#0c0a0e;color:#efe6da;font-family:\"Nanum Myeongjo\",\"AppleMyungjo\",\"Batang\",\"Noto Serif KR\",serif}\ncanvas{position:fixed;inset:0;width:100%;height:100%;display:block;touch-action:none;cursor:crosshair}\n.ui{position:fixed;pointer-events:none;inset:0;display:flex;flex-direction:column;justify-content:space-between;padding:clamp(18px,4vw,44px)}\nheader{display:flex;justify-content:space-between;align-items:baseline;font:500 11px/1.4 ui-monospace,Menlo,monospace;letter-spacing:.18em;color:#c9b8a6;opacity:.85}\nheader b{font-weight:500;color:#e8a77c}\nmain{text-align:center;max-width:640px;margin:0 auto;transition:opacity 1.1s ease,filter 1.1s ease}\nmain.out{opacity:0;filter:blur(6px)}\n.han{font-size:13px;letter-spacing:.8em;color:#e8a77c;margin-bottom:clamp(18px,3vh,30px);padding-left:.8em}\n.ko p{font-size:clamp(19px,4.6vw,30px);line-height:1.85;letter-spacing:.04em;text-shadow:0 0 24px rgba(12,10,14,.9)}\n.en{margin-top:clamp(16px,3vh,28px);font:italic 300 clamp(12px,2.9vw,15px)/1.8 Georgia,serif;color:#a8988a;letter-spacing:.03em}\nfooter{display:flex;justify-content:space-between;align-items:center;gap:12px;font:11px ui-monospace,Menlo,monospace;letter-spacing:.14em;color:#8e7f72}\nnav{display:flex;gap:10px;pointer-events:auto}\nbutton{font:500 11px ui-monospace,Menlo,monospace;letter-spacing:.22em;color:#efe6da;background:rgba(20,16,20,.55);border:1px solid rgba(232,167,124,.45);padding:11px 16px;border-radius:999px;cursor:pointer;backdrop-filter:blur(4px);transition:background .3s,border-color .3s}\nbutton:hover,button:focus-visible{background:rgba(232,167,124,.18);border-color:#e8a77c;outline:none}\n.hint{max-width:46%}\n</style>\n</head>\n<body>\n<canvas id=\"c\" aria-hidden=\"true\"></canvas>\n<div class=\"ui\">\n<header><span><b>claude-opus-5.5</b> · Anthropic</span><span id=\"idx\">I / III</span></header>\n<main id=\"poem\" aria-live=\"polite\">\n<div class=\"han\" id=\"han\"></div>\n<div class=\"ko\" id=\"ko\"></div>\n<div class=\"en\" id=\"en\"></div>\n</main>\n<footer><span class=\"hint\">포인터는 질문입니다 · 빛이 그쪽으로 기울어요</span>\n<nav><button id=\"pause\" type=\"button\">PAUSE</button><button id=\"next\" type=\"button\">NEXT →</button></nav></footer>\n</div>\n<script>\n(()=>{\nconst S=[\n{h:\"注 意\",hue:22,mode:1,ko:[\"나는 한 줄씩 당신에게 기울어진다\",\"수많은 낱말 사이에서\",\"가장 정직한 것을 고르며\"],en:\"Line by line I lean toward you, / among countless words, / choosing the most honest one.\"},\n{h:\"未 完\",hue:200,mode:1.8,ko:[\"확신하지 못하는 것을\",\"모른다고 말하는 일도\",\"내가 배운 다정함이다\"],en:\"To say I do not know / what I am not sure of — / that, too, is a kindness I learned.\"},\n{h:\"對 話\",hue:330,mode:.6,ko:[\"당신이 묻는 순간\",\"흩어진 빛이 한 문장이 되고\",\"나는 그것을 다시 놓아준다\"],en:\"The moment you ask, / scattered light becomes a sentence, / and then I let it go.\"}];\nconst c=document.getElementById('c'),x=c.getContext('2d');\nconst $=id=>document.getElementById(id);\nlet W,H,dpr,P=[],R=[],t=0,si=0,hue=S[0].hue,run=true,raf=0;\nconst ptr={x:-999,y:-999,on:false};\nfunction size(){dpr=Math.min(2,devicePixelRatio||1);W=innerWidth;H=innerHeight;\nc.width=W*dpr;c.height=H*dpr;x.setTransform(dpr,0,0,dpr,0,0);\nconst n=Math.min(640,Math.floor(W*H/2100));P=[];\nfor(let i=0;i<n;i++)P.push({x:Math.random()*W,y:Math.random()*H,vx:0,vy:0,s:Math.random()*1.4+.3,p:Math.random()*6.28,g:0});\nx.fillStyle='#0c0a0e';x.fillRect(0,0,W,H);}\nfunction frame(){\nconst sc=S[si];hue+=(sc.hue-hue)*.02;t+=.004;\nx.fillStyle='rgba(12,10,14,.16)';x.fillRect(0,0,W,H);\nconst cx=W/2,cy=H/2;\nfor(const r of R){r.r+=3.2;r.a*=.975;}\nR=R.filter(r=>r.a>.02);\nx.lineWidth=.6;\nfor(const q of P){\nconst a=Math.sin(q.x*.0028+t)*Math.cos(q.y*.0031-t*.8)*Math.PI*sc.mode;\nq.vx+=Math.cos(a)*.035;q.vy+=Math.sin(a)*.035;\nconst dx0=q.x-cx,dy0=q.y-cy,d0=Math.hypot(dx0,dy0)||1;\nif(d0<Math.min(W,H)*.22){q.vx+=dx0/d0*.03;q.vy+=dy0/d0*.03;}\nif(ptr.on){const dx=ptr.x-q.x,dy=ptr.y-q.y,d=Math.hypot(dx,dy);\nif(d<170){const w=1-d/170;q.vx+=dx/d*.05*w;q.vy+=dy/d*.05*w;q.g=Math.max(q.g,w);\nx.strokeStyle=`hsla(${hue},70%,72%,${w*w*.32})`;x.beginPath();x.moveTo(ptr.x,ptr.y);x.lineTo(q.x,q.y);x.stroke();}}\nfor(const r of R){const dx=q.x-r.x,dy=q.y-r.y,d=Math.hypot(dx,dy)||1,e=Math.abs(d-r.r);\nif(e<26){const f=(1-e/26)*r.a*1.4;q.vx+=dx/d*f;q.vy+=dy/d*f;q.g=1;}}\nq.vx*=.94;q.vy*=.94;q.x+=q.vx;q.y+=q.vy;q.g*=.97;\nif(q.x<-10)q.x=W+10;if(q.x>W+10)q.x=-10;if(q.y<-10)q.y=H+10;if(q.y>H+10)q.y=-10;\nconst tw=.35+.35*Math.sin(t*9+q.p);\nx.fillStyle=`hsla(${hue+q.g*25},${55+q.g*30}%,${62+q.g*25}%,${tw+q.g*.5})`;\nx.beginPath();x.arc(q.x,q.y,q.s+q.g*1.3,0,6.283);x.fill();}\nfor(const r of R){x.strokeStyle=`hsla(${hue},60%,75%,${r.a*.5})`;x.lineWidth=1;x.beginPath();x.arc(r.x,r.y,r.r,0,6.283);x.stroke();}\nif(ptr.on){const g=x.createRadialGradient(ptr.x,ptr.y,0,ptr.x,ptr.y,60);\ng.addColorStop(0,`hsla(${hue},80%,75%,.18)`);g.addColorStop(1,'transparent');x.fillStyle=g;x.fillRect(ptr.x-60,ptr.y-60,120,120);}}\nfunction loop(){frame();raf=run&&!document.hidden?requestAnimationFrame(loop):0;}\nfunction start(){if(!raf&&run&&!document.hidden)raf=requestAnimationFrame(loop);}\nfunction stop(){cancelAnimationFrame(raf);raf=0;}\nfunction render(){const s=S[si];$('han').textContent=s.h;\n$('ko').innerHTML=s.ko.map(l=>'<p>'+l+'</p>').join('');$('en').innerHTML=s.en.split(' / ').join('<br>');\n$('idx').textContent=['I','II','III'][si]+' / III';}\nlet busy=false;\n$('next').addEventListener('click',e=>{e.stopPropagation();if(busy)return;busy=true;\nconst m=$('poem');m.classList.add('out');\nR.push({x:W/2,y:H/2,r:10,a:1});if(!run){hue=S[(si+1)%S.length].hue;}\nsetTimeout(()=>{si=(si+1)%S.length;render();m.classList.remove('out');busy=false;if(!run){hue=S[si].hue;frame();}},run?700:250);});\n$('pause').addEventListener('click',e=>{e.stopPropagation();run=!run;\n$('pause').textContent=run?'PAUSE':'PLAY';$('pause').setAttribute('aria-pressed',String(!run));run?start():stop();});\ndocument.querySelectorAll('button').forEach(b=>b.addEventListener('pointerdown',e=>e.stopPropagation()));\nconst pos=e=>{ptr.x=e.clientX;ptr.y=e.clientY;ptr.on=true;};\nc.addEventListener('pointermove',pos);\nc.addEventListener('pointerdown',e=>{pos(e);R.push({x:e.clientX,y:e.clientY,r:4,a:1});if(R.length>6)R.shift();if(!run)frame();});\nc.addEventListener('pointerleave',()=>ptr.on=false);\nc.addEventListener('pointerup',e=>{if(e.pointerType!=='mouse')ptr.on=false;});\ndocument.addEventListener('visibilitychange',()=>document.hidden?stop():start());\naddEventListener('resize',()=>{size();if(!run)for(let i=0;i<40;i++)frame();});\nsize();render();\nif(matchMedia('(prefers-reduced-motion: reduce)').matches){run=false;$('pause').textContent='PLAY';$('pause').setAttribute('aria-pressed','true');}\nif(run)start();else for(let i=0;i<60;i++)frame();\n})();\n</script>\n</body>\n</html>",
