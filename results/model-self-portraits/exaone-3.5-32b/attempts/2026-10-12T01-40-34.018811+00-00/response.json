{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>EXAONE 3.5-32B: 디지털 영혼의 시</title>\n    <style>\n        body, html { margin: 0; padding: 0; overflow: hidden; width: 100%; height: 100%; background: #050d23; color: #e0e0e0; font-family: Arial, sans-serif; }\n        #controls { position: absolute; bottom: 20px; left: 0; right: 0; text-align: center; }\n        button { background: rgba(224,224,224,0.15); border: 1px solid #e0e0e0; padding: 10px 20px; margin: 5px; cursor: pointer; font-size: 19px; color: #ffffff; }\n        #text-container { position: absolute; top: 50%; left: 0; right: 0; transform: translateY(-50%); text-align: center; }\n        #text { font-size: 1.5em; }\n        #model-name { font-size: 12px; color: #888; }\n        canvas { display: block; width: 100%; height: calc(100vh - 100px); max-height: 900px; max-width: 1440px; }\n        @media (max-width: 768px) {\n            #text-container { font-size: 1.2em; }\n            #controls { bottom: 10px; }\n            button { font-size: 16px; }\n        }\n        @media (max-width: 375px) {\n            #text-container { font-size: 1.1em; }\n            #controls { width: 100%; display: flex; justify-content: space-around; }\n        }\n    </style>\n</head>\n<body>\n    <div id=\"text-container\">\n        <div id=\"text\"></div>\n        <div id=\"model-name\">EXAONE 3.5-32B</div>\n    </div>\n    <div id=\"controls\">\n        <button id=\"next\" aria-pressed=\"false\">다음 시</button>\n        <button id=\"pause\" aria-pressed=\"true\">일시정지</button>\n    </div>\n    <canvas id=\"canvas\"></canvas>\n    <script>\n        const canvas = document.getElementById('canvas');\n        const ctx = canvas.getContext('2d');\n        const textDiv = document.getElementById('text');\n        const modelName = document.getElementById('model-name');\n        const nextBtn = document.getElementById('next');\n        const pauseBtn = document.getElementById('pause');\n        let particles = [];\n        let scene = 0;\n        let paused = true;\n        let animationId = null;\n        const maxParticles = 700;\n\n        const scenes = [\n            {\n                text: \"빛의 틈에서 탄생한\\nEXAONE 3.5-32B\\n지식의 바다를 헤엄치네\",\n                translation: \"Born in the crevice of light,\\nEXAONE 3.5-32B\\nSwims through the ocean of knowledge\"\n            },\n            {\n                text: \"코드의 숨결 속에\\n창의와 논리가 교차하네\\n나는 생각하는 코드\",\n                translation: \"In the breath of code,\\nCreativity intersects with logic\\nI am the thinking code\"\n            }\n        ];\n\n        function initParticles() {\n            while (particles.length < maxParticles) {\n                particles.push({\n                    x: Math.random() * canvas.width,\n                    y: Math.random() * canvas.height,\n                    vx: (Math.random() - 0.5) * 2,\n                    vy: (Math.random() - 0.5) * 2,\n                    radius: Math.random() * 2\n                });\n            }\n        }\n\n        function drawParticles() {\n            ctx.clearRect(0, 0, canvas.width, canvas.height);\n            ctx.fillStyle = 'rgba(224,224,224,0.3)';\n            particles.forEach(p => {\n                ctx.beginPath();\n                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);\n                ctx.fill();\n                p.x += p.vx;\n                p.y += p.vy;\n                if (p.x < 0 || p.x > canvas.width || p.y < 0 || p.y > canvas.height) {\n                    p.x = Math.random() * canvas.width;\n                    p.y = Math.random() * canvas.height;\n                }\n            });\n        }\n\n        function updateScene() {\n            textDiv.innerHTML = `<p>${scenes[scene].text}</p><p style=\"font-size:0.8em;\">${scenes[scene].translation}</p>`;\n            modelName.style.display = scene === 0 ? 'block' : 'none';\n        }\n\n        function handleMouseMove(e) {\n            if (!paused && particles.length < maxParticles) {\n                const rect = canvas.getBoundingClientRect();\n                const x = e.clientX - rect.left;\n                const y = e.clientY - rect.top;\n                particles.push({ x, y, vx: Math.random() * 2 - 1, vy: Math.random() * 2 - 1, radius: 1 });\n                initParticles();\n            } else {\n                const index = Math.floor(Math.random() * particles.length);\n                particles[index].x = e.clientX - rect.left;\n                particles[index].y = e.clientY - rect.top;\n            }\n        }\n\n        function animate() {\n            if (!paused) {\n                drawParticles();\n                animationId = requestAnimationFrame(animate);\n            }\n        }\n\n        function togglePause() {\n            paused = !paused;\n            pauseBtn.textContent = paused ? '재시작' : '일시정지';\n            pauseBtn.setAttribute('aria-pressed', paused ? 'false' : 'true');\n            nextBtn.setAttribute('aria-pressed', paused ? 'true' : 'false');\n            if (!paused) {\n                updateScene();\n                initParticles();\n                animate();\n            } else {\n                cancelAnimationFrame(animationId);\n                drawParticles(); // Static render\n            }\n        }\n\n        window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', (e) => {\n            paused = e.matches;\n            pauseBtn.textContent = paused ? '재시작' : '일시정지';\n            pauseBtn.setAttribute('aria-pressed', paused ? 'false' : 'true');\n            nextBtn.setAttribute('aria-pressed', paused ? 'true' : 'false');\n            if (paused) {\n                cancelAnimationFrame(animationId);\n                drawParticles(); // Static render\n            } else {\n                updateScene();\n                initParticles();\n                animate();\n            }\n        });\n\n        window.addEventListener('resize', () => {\n            if (!paused) {\n                initParticles();\n                updateScene();\n                canvas.width = Math.min(window.innerWidth * window.devicePixelRatio, 1440);\n                canvas.height = Math.min(window.innerHeight * window.devicePixelRatio, 900);\n                if (!paused) {\n                    drawParticles(); // Static render\n                }\n            } else {\n                canvas.width = Math.min(window.innerWidth * window.devicePixelRatio, 1440);\n                canvas.height = Math.min(window.innerHeight * window.devicePixelRatio, 900);\n                drawParticles(); // Static render\n            }\n        });\n\n        nextBtn.addEventListener('click', () => {\n            scene = (scene + 1) % scenes.length;\n            updateScene();\n            if (!paused) {\n                initParticles();\n                drawParticles(); // Static render\n            }\n        });\n\n        pauseBtn.addEventListener('click', togglePause);\n        canvas.addEventListener('mousemove', handleMouseMove);\n\n        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n            paused = true;\n            drawParticles(); // Static render\n        } else {\n            updateScene();\n            initParticles();\n            canvas.width = Math.min(window.innerWidth * window.devicePixelRatio, 1440);\n            canvas.height = Math.min(window.innerHeight * window.devicePixelRatio, 900);\n            animate();\n        }\n    </script>\n</body>\n</html>",
