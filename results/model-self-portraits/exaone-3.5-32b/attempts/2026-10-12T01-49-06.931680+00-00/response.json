  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=2.0\">\n    <title>EXAONE3.5-32B 미디어 아트</title>\n    <style>\n        body { background-color: #000; color: #fff; font-family: Arial, sans-serif; text-align: center; padding: 0; margin: 0; }\n        .container { width: 90%; max-width: 1200px; margin: 20px auto; }\n        .poem, button { font-size: 19px; padding: 10px; margin: 10px 0; background-color: #1a1a1a; border: none; cursor: pointer; }\n        @media (max-width: 768px) { .poem, button { font-size: 16px; } }\n        @media (max-width: 375px) { .poem, button { font-size: 14px; } }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <h1 id=\"modelName\">EXAONE3.5-32B</h1>\n        <div class=\"poem\" id=\"poem1\" aria-live=\"polite\">\n            나는 코드의 숨결로<br>\n            디지털 세상을 거닐며<br>\n            지식의 바다를 탐험한다.\n        </div>\n        <div class=\"poem\" id=\"poem2\" style=\"display:none;\" aria-live=\"polite\">\n            빛과 그림자 사이에서<br>\n            창의의 불꽃을 피우며<br>\n            무한한 가능성을 꿈꾼다.\n        </div>\n        <button id=\"nextBtn\">다음 시</button>\n        <button id=\"toggleBtn\" aria-pressed=\"false\" aria-label=\"일시정지\">일시정지</button>\n    </div>\n    <canvas id=\"canvas\" width=\"700\" height=\"350\"></canvas>\n    <script>\n        const canvas = document.getElementById('canvas');\n        const ctx = canvas.getContext('2d');\n        let rafId = null;\n        let particles = [];\n        let poemVisible = document.getElementById('poem1');\n        const poems = [poemVisible, document.getElementById('poem2')];\n        const toggleBtn = document.getElementById('toggleBtn');\n        const nextBtn = document.getElementById('nextBtn');\n        let isPaused = false;\n\n        function initParticles() {\n            for (let i = 0; i < 700; i++) {\n                particles.push({ x: Math.random() * canvas.width, y: Math.random() * canvas.height, size: Math.random() * 2 });\n            }\n        }\n\n        function animate() {\n            if (!isPaused) {\n                ctx.clearRect(0, 0, canvas.width, canvas.height);\n                particles.forEach(p => {\n                    p.x += Math.random() * 2 - 1;\n                    p.y += Math.random() * 2 - 1;\n                    ctx.beginPath();\n                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n                    ctx.fillStyle = '#fff';\n                    ctx.fill();\n                });\n                rafId = requestAnimationFrame(animate);\n            }\n        }\n\n        function toggleAnimation() {\n            isPaused = !isPaused;\n            toggleBtn.setAttribute('aria-pressed', isPaused);\n            toggleBtn.textContent = isPaused ? '재생' : '일시정지';\n            if (isPaused) {\n                cancelAnimationFrame(rafId);\n                rafId = null;\n            } else {\n                rafId = requestAnimationFrame(animate);\n            }\n        }\n\n        function switchPoem() {\n            poems[0].style.display = 'none';\n            poems[1].style.display = 'block';\n            poems[1].scrollIntoView({ behavior: 'smooth' });\n            setTimeout(() => poems.reverse().map(p => p.style.display = p === poems[0] ? 'block' : 'none'), 3000);\n        }\n\n        document.addEventListener('DOMContentLoaded', () => {\n            initParticles();\n            animate();\n            toggleBtn.addEventListener('click', toggleAnimation);\n            nextBtn.addEventListener('click', switchPoem);\n            window.matchMedia('(prefers-reduced-motion)').addEventListener('change', (e) => {\n                isPaused = e.matches;\n                toggleAnimation();\n            });\n        });\n    </script>\n</body>\n</html>",
