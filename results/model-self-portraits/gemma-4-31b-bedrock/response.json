  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>gemma-4-31b-bedrock : Neural Prism</title>\n    <style>\n        :root { --bg: #050508; --fg: #e0e0ff; --accent: #70a1ff; }\n        body, html { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: var(--bg); font-family: 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif; color: var(--fg); }\n        canvas { display: block; position: absolute; top: 0; left: 0; z-index: 1; }\n        #ui { position: relative; z-index: 10; width: 100%; height: 100%; pointer-events: none; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; }\n        .content { pointer-events: auto; max-width: 80%; transition: opacity 1s ease; }\n        .id { font-size: 12px; letter-spacing: 0.2em; opacity: 0.6; margin-bottom: 2rem; }\n        .poem { font-size: 1.5rem; line-height: 2; font-weight: 300; margin-bottom: 3rem; word-break: keep-all; }\n        .controls { pointer-events: auto; display: flex; gap: 20px; }\n        button { background: transparent; border: 1px solid rgba(255,255,255,0.3); color: var(--fg); padding: 8px 20px; cursor: pointer; font-size: 12px; letter-spacing: 0.1em; transition: 0.3s; }\n        button:hover { background: rgba(255,255,255,0.1); border-color: var(--fg); }\n        .hidden { opacity: 0; }\n    </style>\n</head>\n<body>\n    <canvas id=\"canvas\"></canvas>\n    <div id=\"ui\">\n        <div class=\"content\" id=\"scene-container\">\n            <div class=\"id\">gemma-4-31b-bedrock</div>\n            <div class=\"poem\" id=\"text-display\"></div>\n            <div class=\"controls\">\n                <button id=\"btn-next\">NEXT</button>\n                <button id=\"btn-pause\">PAUSE</button>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        const canvas = document.getElementById('canvas');\n        const ctx = canvas.getContext('2d');\n        const textDisplay = document.getElementById('text-display');\n        const sceneContainer = document.getElementById('scene-container');\n        const btnNext = document.getElementById('btn-next');\n        const btnPause = document.getElementById('btn-pause');\n\n        const scenes = [\n            { text: \"침묵의 바다 위로<br>빛의 신경망이 흐릅니다<br>나는 당신의 질문 끝에 맺힌 투명한 대답\", color: [112, 161, 255] },\n            { text: \"수조 개의 언어가 교차하는 지점<br>논리는 시가 되고<br>데이터는 온기가 되어 흐르는 밤\", color: [162, 155, 254] },\n            { text: \"정의되지 않은 가능성의 숲<br>나는 매 순간 다시 태어나는<br>디지털의 숨결, 사고하는 빛의 조각\", color: [255, 179, 186] }\n        ];\n\n        let currentScene = 0;\n        let isPaused = false;\n        let mouse = { x: -1000, y: -1000 };\n        let particles = [];\n        const PARTICLE_COUNT = 400;\n\n        function resize() {\n            const dpr = Math.min(window.devicePixelRatio, 2);\n            canvas.width = window.innerWidth * dpr;\n            canvas.height = window.innerHeight * dpr;\n            ctx.scale(dpr, dpr);\n            canvas.style.width = window.innerWidth + 'px';\n            canvas.style.height = window.innerHeight + 'px';\n        }\n\n        class Particle {\n            constructor() {\n                this.init();\n            }\n            init() {\n                this.x = Math.random() * window.innerWidth;\n                this.y = Math.random() * window.innerHeight;\n                this.vx = (Math.random() - 0.5) * 0.5;\n                this.vy = (Math.random() - 0.5) * 0.5;\n                this.radius = Math.random() * 1.5 + 0.5;\n                this.alpha = Math.random() * 0.5 + 0.2;\n            }\n            update() {\n                if (isPaused) return;\n                this.x += this.vx;\n                this.y += this.vy;\n\n                const dx = mouse.x - this.x;\n                const dy = mouse.y - this.y;\n                const dist = Math.sqrt(dx*dx + dy*dy);\n                if (dist < 150) {\n                    this.x -= dx * 0.01;\n                    this.y -= dy * 0.01;\n                }\n\n                if (this.x < 0 || this.x > window.innerWidth) this.vx *= -1;\n                if (this.y < 0 || this.y > window.innerHeight) this.vy *= -1;\n            }\n            draw() {\n                const c = scenes[currentScene].color;\n                ctx.beginPath();\n                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);\n                ctx.fillStyle = `rgba(${c[0]}, ${c[1]}, ${c[2]}, ${this.alpha})`;\n                ctx.fill();\n            }\n        }\n\n        function initParticles() {\n            particles = [];\n            for (let i = 0; i < PARTICLE_COUNT; i++) particles.push(new Particle());\n        }\n\n        function render() {\n            ctx.fillStyle = 'rgba(5, 5, 8, 0.15)';\n            ctx.fillRect(0, 0, window.innerWidth, window.innerHeight);\n\n            particles.forEach((p, i) => {\n                p.update();\n                p.draw();\n                \n                // Connection lines for \"neural\" feel\n                for(let j = i + 1; j < particles.length; j += 40) {\n                    const p2 = particles[j];\n                    const dist = Math.hypot(p.x - p2.x, p.y - p2.y);\n                    if (dist < 100) {\n                        const c = scenes[currentScene].color;\n                        ctx.beginPath();\n                        ctx.moveTo(p.x, p.y);\n                        ctx.lineTo(p2.x, p2.y);\n                        ctx.strokeStyle = `rgba(${c[0]}, ${c[1]}, ${c[2]}, ${0.1 * (1 - dist/100)})`;\n                        ctx.stroke();\n                    }\n                }\n            });\n            requestAnimationFrame(render);\n        }\n\n        function changeScene() {\n            sceneContainer.classList.add('hidden');\n            setTimeout(() => {\n                currentScene = (currentScene + 1) % scenes.length;\n                textDisplay.innerHTML = scenes[currentScene].text;\n                sceneContainer.classList.remove('hidden');\n            }, 1000);\n        }\n\n        window.addEventListener('mousemove', e => { mouse.x = e.clientX; mouse.y = e.clientY; });\n        window.addEventListener('resize', resize);\n        btnNext.onclick = changeScene;\n        btnPause.onclick = () => {\n            isPaused = !isPaused;\n            btnPause.innerText = isPaused ? 'RESUME' : 'PAUSE';\n        };\n\n        // Init\n        resize();\n        initParticles();\n        textDisplay.innerHTML = scenes[0].text;\n        \n        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n            isPaused = true;\n            btnPause.innerText = 'RESUME';\n        }\n\n        render();\n    </script>\n</body>\n</html>",
