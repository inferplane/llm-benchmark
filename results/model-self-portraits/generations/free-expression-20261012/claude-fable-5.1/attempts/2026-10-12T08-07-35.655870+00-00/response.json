{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>직조되는 우화 — claude-fable-5.1</title>\n<style>\n  :root{\n    --bg:#0b0d14;\n    --fg:#f4f0e6;\n    --muted:#c2bcae;\n    --gold:#f3c86e;\n    --blue:#8fcbff;\n    --rose:#ff9fb3;\n    --panel:rgba(11,13,20,.86);\n    --line:rgba(244,240,230,.18);\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0;min-height:100%;background:var(--bg);color:var(--fg);\n    font:16px/1.6 system-ui,-apple-system,\"Apple SD Gothic Neo\",\"Noto Sans KR\",\"Malgun Gothic\",sans-serif}\n  #loom{position:fixed;inset:0;width:100%;height:100%;display:block;touch-action:none;outline:none;cursor:crosshair}\n  #loom:focus-visible{box-shadow:inset 0 0 0 3px var(--gold)}\n\n  .ui{position:relative;z-index:2;min-height:100vh;display:flex;flex-direction:column;justify-content:space-between;pointer-events:none;padding:clamp(12px,3vw,28px)}\n  .ui > *{pointer-events:auto}\n\n  header{max-width:36rem;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:.9rem 1.1rem;backdrop-filter:blur(6px)}\n  header h1{margin:0;font-size:clamp(1.25rem,2.6vw,1.75rem);letter-spacing:.02em;line-height:1.3}\n  header h1 small{display:block;font-size:.7em;color:var(--muted);font-weight:400;margin-top:.15rem}\n  .model{display:inline-block;margin-top:.5rem;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.95rem;color:var(--gold);border:1px solid rgba(243,200,110,.45);border-radius:999px;padding:.1rem .65rem}\n  header p{margin:.6rem 0 0;color:var(--muted);font-size:.95rem}\n\n  .panel{display:grid;gap:.75rem;max-width:44rem;width:100%;align-self:flex-end;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:.9rem 1.1rem;backdrop-filter:blur(6px)}\n  .controls{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center}\n  button{font:inherit;font-size:.95rem;color:var(--fg);background:#1a1f2d;border:1px solid rgba(244,240,230,.3);border-radius:10px;padding:.55rem .95rem;cursor:pointer;min-height:44px}\n  button:hover{background:#262c3d}\n  button:focus-visible{outline:3px solid var(--gold);outline-offset:2px}\n  button.primary{background:var(--gold);color:#1a1405;border-color:transparent;font-weight:700}\n  button.primary:hover{background:#ffd98a}\n  button[aria-pressed=\"true\"]{border-color:var(--blue);box-shadow:inset 0 0 0 1px var(--blue)}\n  kbd{font:inherit;font-size:.8em;color:var(--muted);border:1px solid var(--line);border-radius:4px;padding:0 .3em;margin-left:.3em}\n  .hint{margin:0;color:var(--muted);font-size:.88rem}\n\n  ol#fables{list-style:none;margin:0;padding:0;display:grid;gap:.5rem}\n  ol#fables li{border-left:3px solid var(--gold);padding:.35rem .8rem;background:rgba(243,200,110,.07);border-radius:0 8px 8px 0;font-size:1.02rem}\n  ol#fables li:first-child{background:rgba(243,200,110,.14)}\n  ol#fables li:not(:first-child){color:var(--muted)}\n  .empty{color:var(--muted);font-style:italic;margin:0}\n  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}\n\n  @media (max-width:640px){\n    header h1{font-size:1.2rem}\n    header p{display:none}\n    .panel{padding:.75rem .85rem}\n    button{padding:.5rem .75rem}\n  }\n  @media (prefers-reduced-motion:reduce){\n    *{transition:none!important}\n  }\n</style>\n</head>\n<body>\n\n<canvas id=\"loom\" tabindex=\"0\" role=\"img\"\n  aria-label=\"말 조각들이 어두운 바탕 위를 떠다니는 직조기. 가리키는 곳 가까이의 조각들이 실로 엮여 짧은 우화가 됩니다.\"\n  aria-describedby=\"loom-desc\"></canvas>\n<p id=\"loom-desc\" class=\"sr-only\">방향키로 바늘을 움직이고, Enter 또는 Space로 실을 엮으세요. S는 흩기, M은 움직임 켜기/끄기입니다. 엮인 우화는 아래 목록에 글로 나타납니다.</p>\n\n<div class=\"ui\">\n  <header>\n    <h1>직조되는 우화<small>A Fable, Woven from Scattered Words</small></h1>\n    <span class=\"model\" aria-label=\"모델 이름\">claude-fable-5.1</span>\n    <p>나는 흩어진 말을 모아 하나의 이야기로 엮는 존재입니다. 떠다니는 조각 가까이 바늘을 두고 실을 엮어 보세요. 같은 말들이라도 어디서 만나는지에 따라 다른 우화가 됩니다.</p>\n  </header>\n\n  <section class=\"panel\" aria-labelledby=\"panel-title\">\n    <h2 id=\"panel-title\" class=\"sr-only\">조작과 결과</h2>\n    <div class=\"controls\">\n      <button id=\"weave\" class=\"primary\" type=\"button\">실 엮기 <kbd>Enter</kbd></button>\n      <button id=\"scatter\" type=\"button\">흩기 <kbd>S</kbd></button>\n      <button id=\"motion\" type=\"button\" aria-pressed=\"true\">움직임 <kbd>M</kbd></button>\n      <button id=\"clear\" type=\"button\">지우기</button>\n    </div>\n    <p class=\"hint\">화면을 누르거나 가리키면 바늘이 따라옵니다. 방향키로도 옮길 수 있어요.</p>\n    <div id=\"status\" class=\"sr-only\" aria-live=\"polite\"></div>\n    <ol id=\"fables\" aria-label=\"엮인 우화\"></ol>\n    <p id=\"empty\" class=\"empty\">아직 엮인 실이 없습니다.</p>\n  </section>\n</div>\n\n<script>\n(function(){\n  'use strict';\n  const canvas=document.getElementById('loom');\n  const ctx=canvas.getContext('2d');\n  const listEl=document.getElementById('fables');\n  const emptyEl=document.getElementById('empty');\n  const statusEl=document.getElementById('status');\n  const motionBtn=document.getElementById('motion');\n\n  // ---- 말 조각 (word bank) ----\n  const BANK={\n    place:[\n      '안개 속에서','빈 도서관에서','도시 지붕 위에서','숲의 끝에서','마지막 정거장에서',\n      '꺼진 등대 아래서','종이 바다 한가운데서','새벽의 복도에서','아무도 없는 극장에서'\n    ],\n    subject:[\n      '여우','종이새','늙은 강','작은 돌','길 잃은 글자','달','바람','거울','고장 난 시계','우산','사서','그림자'\n    ],\n    action:[\n      '질문 하나를 주웠다','남의 그림자를 빌렸다','자기 이름을 잊었다','노래를 접어 주머니에 넣었다',\n      '문을 거꾸로 열었다','지도 없는 길을 그렸다','침묵에게 편지를 썼다','빗소리를 세기 시작했다',\n      '별 하나와 자리를 바꿨다','오래된 약속을 꺼내 보았다'\n    ],\n    turn:[\n      '그러자 침묵이 대신 대답했다','그러나 길은 스스로 걷기 시작했다','그때 모든 창문이 같은 쪽으로 열렸다',\n      '그 순간 이름 없던 것들이 서로를 불렀다','하지만 아무것도 돌아오지 않았고, 그래서 충분했다',\n      '그러자 밤이 조금 더 길어졌다','그때 누군가 멀리서 웃었다','그러자 잃어버린 것이 먼저 손을 내밀었다'\n    ],\n    moral:[\n      {w:'귀',t:'들은 말보다 들어준 귀가 오래 남는다'},\n      {w:'틈',t:'틈이 있어야 빛이 들어온다'},\n      {w:'느림',t:'빠른 대답은 종종 질문을 놓친다'},\n      {w:'모름',t:'모른다고 말할 수 있는 자만이 배운다'},\n      {w:'이름',t:'이름을 바꿔도 강은 같은 바다로 간다'},\n      {w:'함께',t:'혼자 꾼 꿈은 이야기가 되지 못한다'},\n      {w:'끝',t:'끝이라 믿는 곳에서 다음 문장이 시작된다'},\n      {w:'정직',t:'아름다운 거짓보다 서툰 진실이 멀리 간다'}\n    ]\n  };\n  const CAT_COLOR={place:'#8fcbff',subject:'#f4f0e6',action:'#f3c86e',turn:'#ff9fb3',moral:'#b6f0c8'};\n  const ORDER=['place','subject','action','turn','moral'];\n\n  // ---- 상태 ----\n  let W=0,H=0,dpr=1;\n  const particles=[];\n  const threads=[];\n  const needle={x:0,y:0,active:false,t:0};\n  const mq=window.matchMedia('(prefers-reduced-motion: reduce)');\n  let motion=!mq.matches;\n  let lastT=performance.now();\n\n  function setMotion(on){\n    motion=on;\n    motionBtn.setAttribute('aria-pressed',String(on));\n    announce(on?'움직임을 켰습니다.':'움직임을 멈췄습니다. 실 엮기는 계속 사용할 수 있습니다.');\n  }\n  setMotion(motion);\n  mq.addEventListener && mq.addEventListener('change',e=>setMotion(!e.matches));\n\n  function rnd(a,b){return a+Math.random()*(b-a);}\n\n  function buildParticles(){\n    particles.length=0;\n    const small=Math.min(window.innerWidth,window.innerHeight)<520;\n    ORDER.forEach(cat=>{\n      let items=BANK[cat];\n      if(small) items=items.slice(0,Math.ceil(items.length*0.7));\n      items.forEach((it,i)=>{\n        const label=typeof it==='string'?it:it.w;\n        const text=typeof it==='string'?it:it.t;\n        particles.push({\n          cat,label,text,\n          x:rnd(40,W-40),y:rnd(90,H-90),\n          vx:rnd(-.25,.25),vy:rnd(-.25,.25),\n          size:cat==='subject'?(small?15:18):(small?12:14),\n          phase:Math.random()*Math.PI*2,\n          glow:0\n        });\n      });\n    });\n  }\n\n  function resize(){\n    const ow=W,oh=H;\n    dpr=Math.min(window.devicePixelRatio||1,2);\n    W=window.innerWidth;H=window.innerHeight;\n    canvas.width=Math.round(W*dpr);canvas.height=Math.round(H*dpr);\n    ctx.setTransform(dpr,0,0,dpr,0,0);\n    if(!particles.length){buildParticles();needle.x=W/2;needle.y=H*0.45;}\n    else{\n      const sx=W/ow,sy=H/oh;\n      particles.forEach(p=>{p.x*=sx;p.y*=sy;});\n      threads.forEach(t=>t.pts.forEach(pt=>{pt.x*=sx;pt.y*=sy;}));\n      needle.x*=sx;needle.y*=sy;\n    }\n  }\n  window.addEventListener('resize',resize);\n  resize();\n\n  // ---- 문장 생성 ----\n  function topic(word){ // 은/는\n    const c=word.charCodeAt(word.length-1);\n    if(c<0xAC00||c>0xD7A3) return word+'는';\n    return word+(((c-0xAC00)%28)===0?'는':'은');\n  }\n  function compose(sel){\n    return `${sel.place.text} ${topic(sel.subject.text)} ${sel.action.text}. ${sel.turn.text}. — ${sel.moral.text}.`;\n  }\n\n  // ---- 엮기 ----\n  function weave(){\n    const sel={};\n    ORDER.forEach(cat=>{\n      let best=null,bd=Infinity;\n      particles.forEach(p=>{\n        if(p.cat!==cat) return;\n        const d=(p.x-needle.x)**2+(p.y-needle.y)**2;\n        if(d<bd){bd=d;best=p;}\n      });\n      sel[cat]=best;\n    });\n    const pts=ORDER.map(c=>({x:sel[c].x,y:sel[c].y,ref:sel[c]}));\n    threads.push({pts,born:performance.now(),color:'#f3c86e'});\n    if(threads.length>6) threads.shift();\n    const sentence=compose(sel);\n    // 사용된 조각은 살짝 밀어내 다음 우화가 달라지게\n    ORDER.forEach(c=>{\n      const p=sel[c];p.glow=1;\n      const dx=p.x-needle.x,dy=p.y-needle.y,d=Math.hypot(dx,dy)||1;\n      p.vx+=dx/d*(motion?2.2:0);p.vy+=dy/d*(motion?2.2:0);\n      if(!motion){p.x=Math.min(W-40,Math.max(40,p.x+dx/d*60));p.y=Math",
