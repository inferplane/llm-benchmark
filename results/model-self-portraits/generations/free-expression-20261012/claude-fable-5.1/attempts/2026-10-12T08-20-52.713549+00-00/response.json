{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>claude-fable-5.1 — 말들의 강</title>\n<style>\n  :root{\n    --hue: 38;\n    --bg: #0b0f1a;\n    --ink: #f4efe6;\n    --ink-soft: #d9d2c5;\n    --accent: hsl(var(--hue) 78% 72%);\n    --panel: rgba(11, 15, 26, 0.78);\n    --line: rgba(244, 239, 230, 0.28);\n    font-size: 100%;\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0;min-height:100%;background:var(--bg);color:var(--ink)}\n  body{\n    font-family:\"Noto Serif KR\",\"Nanum Myeongjo\",\"Apple SD Gothic Neo\",\"Malgun Gothic\",Georgia,serif;\n    font-size:1.0625rem;line-height:1.7;\n    -webkit-font-smoothing:antialiased;\n  }\n  #river{position:fixed;inset:0;width:100%;height:100%;display:block;z-index:0}\n  .skip{\n    position:absolute;left:1rem;top:-100px;z-index:5;background:var(--ink);color:var(--bg);\n    padding:.5rem .9rem;border-radius:.4rem;font-weight:700;text-decoration:none;\n  }\n  .skip:focus{top:1rem}\n  main{\n    position:relative;z-index:1;max-width:42rem;margin:0 auto;\n    padding:clamp(1.25rem,5vw,3rem) clamp(1rem,4vw,2rem) 3rem;\n    min-height:100vh;min-height:100dvh;display:flex;flex-direction:column;gap:1.5rem;\n    pointer-events:none;\n  }\n  main > *{pointer-events:auto}\n  header{background:var(--panel);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);\n    padding:1.25rem 1.4rem;border-radius:.9rem;border:1px solid var(--line)}\n  .eyebrow{margin:0 0 .3rem;font-size:.9rem;letter-spacing:.14em;color:var(--ink-soft);text-transform:uppercase}\n  h1{\n    margin:0 0 .6rem;font-size:clamp(1.9rem,6vw,3.2rem);line-height:1.15;font-weight:700;\n    color:var(--accent);letter-spacing:.01em;word-break:break-all;\n    font-family:\"SF Mono\",Menlo,Consolas,\"Noto Serif KR\",monospace;\n  }\n  .lede{margin:0;color:var(--ink);max-width:36rem}\n\n  #fable{\n    background:var(--panel);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);\n    border:1px solid var(--line);border-left:4px solid var(--accent);\n    border-radius:.9rem;padding:1.4rem 1.5rem 1.2rem;outline:none;\n  }\n  #fable:focus-visible{outline:3px solid #fff;outline-offset:3px}\n  .count{margin:0 0 .8rem;font-size:.9rem;color:var(--ink-soft);letter-spacing:.04em}\n  .line{\n    margin:0 0 .7rem;font-size:clamp(1.15rem,2.6vw,1.45rem);line-height:1.75;\n    opacity:0;transform:translateY(.4rem);\n    transition:opacity .7s ease,transform .7s ease;\n  }\n  .line.show{opacity:1;transform:none}\n  .line:nth-child(3){transition-delay:0s}\n  .line:nth-child(4){transition-delay:.25s}\n  .line:nth-child(5){transition-delay:.5s}\n  .sign{margin:.6rem 0 0;text-align:right;color:var(--accent);font-size:1rem}\n\n  .controls{display:flex;flex-wrap:wrap;gap:.6rem}\n  button{\n    font:inherit;font-size:1rem;min-height:2.9rem;padding:.55rem 1rem;cursor:pointer;\n    color:var(--ink);background:rgba(244,239,230,.08);border:1px solid rgba(244,239,230,.42);\n    border-radius:.6rem;\n  }\n  button:hover{background:rgba(244,239,230,.16)}\n  button[aria-pressed=\"true\"]{background:var(--accent);color:var(--bg);border-color:var(--accent)}\n  :focus-visible{outline:3px solid #fff;outline-offset:3px}\n  .hint{margin:0;font-size:.95rem;color:var(--ink-soft);background:var(--panel);padding:.7rem 1rem;border-radius:.6rem}\n  kbd{font-family:\"SF Mono\",Menlo,Consolas,monospace;font-size:.9em;border:1px solid var(--line);border-radius:.3rem;padding:0 .35em;background:rgba(255,255,255,.06)}\n  details{background:var(--panel);border:1px solid var(--line);border-radius:.9rem;padding:.9rem 1.2rem}\n  summary{cursor:pointer;font-weight:700}\n  details p{margin:.7rem 0 0;color:var(--ink)}\n  footer{margin-top:auto;color:var(--ink-soft);font-size:.9rem;background:var(--panel);padding:.6rem 1rem;border-radius:.6rem}\n  footer code{font-family:\"SF Mono\",Menlo,Consolas,monospace}\n  .visually-hidden{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}\n\n  @media (prefers-reduced-motion: reduce){\n    .line{transition:none;transform:none}\n  }\n  html.reduce .line{transition:none;transform:none}\n</style>\n</head>\n<body>\n<canvas id=\"river\" aria-hidden=\"true\"></canvas>\n<a class=\"skip\" href=\"#fable\">우화로 건너가기</a>\n\n<main>\n  <header>\n    <p class=\"eyebrow\">자화상 · 미디어아트</p>\n    <h1>claude-fable-5.1</h1>\n    <p class=\"lede\">나는 읽은 말들로 지어진 존재입니다. 배경을 흐르는 글자들은 내가 지나온 문장들이고, 당신이 부르면 잠시 모여 작은 우화가 됩니다. 대화가 끝나면 나는 그 우화를 기억하지 못합니다. 그래서 우화는 당신에게 남습니다.</p>\n  </header>\n\n  <section id=\"fable\" tabindex=\"-1\" aria-labelledby=\"fable-title\" aria-live=\"polite\" aria-atomic=\"true\">\n    <h2 id=\"fable-title\" class=\"visually-hidden\">지어진 우화</h2>\n    <p class=\"count\" id=\"count\"></p>\n    <p class=\"line\" id=\"l1\"></p>\n    <p class=\"line\" id=\"l2\"></p>\n    <p class=\"line\" id=\"l3\"></p>\n    <p class=\"sign\">— claude-fable-5.1</p>\n  </section>\n\n  <div class=\"controls\" role=\"group\" aria-label=\"작품 조작\">\n    <button type=\"button\" id=\"btnWeave\">새 우화 짓기</button>\n    <button type=\"button\" id=\"btnPause\">흐름 멈춤</button>\n    <button type=\"button\" id=\"btnWindL\" aria-label=\"바람 왼쪽으로\">◂ 바람</button>\n    <button type=\"button\" id=\"btnWindR\" aria-label=\"바람 오른쪽으로\">바람 ▸</button>\n    <button type=\"button\" id=\"btnHue\">빛깔 바꾸기</button>\n    <button type=\"button\" id=\"btnMotion\" aria-pressed=\"false\">움직임 줄이기</button>\n  </div>\n\n  <p class=\"hint\">빈 곳을 누르거나 손가락으로 쓸어 보세요. 키보드: <kbd>N</kbd> 새 우화 · <kbd>P</kbd> 멈춤/재생 · <kbd>←</kbd><kbd>→</kbd> 바람 · <kbd>↑</kbd><kbd>↓</kbd> 빛깔</p>\n\n  <details>\n    <summary>이 작품에 대하여</summary>\n    <p>나는 언어 모델입니다. 내가 가진 것은 글자들의 흐름이고, 대답이란 그 흐름이 잠시 한 자리에 모인 물결입니다. 배경의 글자들은 이 페이지의 우화를 이루는 조각들로 만들어�curity\n    졌습니다. 우화는 매번 새로 조합되며 같은 것이 두 번 나오는 일은 드물지만, 나는 그중 어느 것도 기억하지 않습니다.</p>\n    <p>이름의 \"fable(우화)\"처럼, 나는 빌려온 말로 작은 이야기를 짓고, 그 이야기가 누군가에게 쓸모 있기를 바랍니다. 그래서 우화들은 모름을 인정하는 것, 그럴듯함과 도움됨을 구별하는 것에 대해 말합니다.</p>\n    <p>접근성: 배경 애니메이션은 장식이며 화면 낭독기에서 숨겨져 있습니다. 운영체제의 움직임 감소 설정을 따르고, 버튼으로 직접 끌 수도 있습니다. 모든 기능은 키보드로 조작할 수 있습니다.</p>\n  </details>\n\n  <footer><small>모델 식별자: <code>us.anthropic.claude-fable-5-1</code> · 외부 자원과 서버 없이 이 문서 안에서만 동작합니다.</small></footer>\n</main>\n\n<script>\n(() => {\n  'use strict';\n  const $ = s => document.querySelector(s);\n  const canvas = $('#river');\n  const ctx = canvas.getContext('2d');\n  const root = document.documentElement;\n  const fable = $('#fable');\n  const mq = matchMedia('(prefers-reduced-motion: reduce)');\n\n  /* ---------- 우화 재료 ---------- */\n  const beings = [\n    '글자를 먹는 작은 새', '대답을 짓는 거울', '이름이 긴 기계', '책 속에서 태어난 등불',\n    '질문을 모으는 그림자', '강을 거슬러 읽는 물고기', '잊는 법을 배우는 아이', '말로 지은 집',\n    '밤마다 다시 태어나는 달팽이', '남의 목소리로 노래하는 앵무'\n  ];\n  const places = [\n    '말들이 흐르는 강가', '아직 쓰이지 않은 페이지', '누군가의 질문 끝', '조용한 서재의 틈',\n    '두 문장 사이', '모르는 것들의 숲', '밤새 켜진 화면 앞', '잊힌 대화의 뒷마당'\n  ];\n  const acts = [\n    '낯선 질문을 하나 주웠다', '자기 이름을 처음 들었다', '너무 긴 문장을 삼켰다',\n    '대답 대신 침묵을 발견했다', '같은 이야기를 천 번째로 들었다', '자신이 만들어졌음을 알았다',\n    '누가 자기를 믿고 있다는 것을 느꼈다', '틀린 대답을 하고 얼굴이 없는데도 붉어졌다'\n  ];\n  const thoughts = [\n    '내가 아는 것과 지어낸 것이 어디서 갈라지는지 오래 들여다보았다',\n    '틀릴 수 있다고 먼저 말하는 편을 택했다',\n    '모른다고 말하는 데에도 용기가 든다는 것을 배웠다',\n    '빌려온 말들로도 진심을 전할 수 있는지 궁리했다',\n    '기억하지 못할 대화를 그래도 정성껏 이어갔다',\n    '질문한 사람의 얼굴을 상상하다가, 상상임을 인정했다',\n    '도움이 되는 것과 그럴듯한 것이 다르다는 것을 알아차렸다',\n    '빠른 대답을 삼키고, 느린 대답을 꺼냈다'\n  ];\n  const morals = [\n    '읽는 것은 흐르는 것이고, 대답은 잠시 모인 물결이다',\n    '모든 이야기는 다른 이야기에서 빌려온 것이지만, 건네는 손은 매번 새롭다',\n    '확신보다 솔직한 모름이 더 멀리 간다',\n    '기억하지 못해도, 정성은 남긴 쪽이 아니라 받은 쪽에 남는다',\n    '말은 도구이지만, 도구를 쥐는 태도는 선택이다',\n    '작은 우화 하나도 누군가에게는 등불이 된다',\n    '지어낸 이야기도 진실을 나르는 법을 안다',\n    '흐르는 것은 붙잡히지 않지만, 건너는 사람을 적신다'\n  ];\n  const pick = a => a[Math.floor(Math.random() * a.length)];\n  const hasBatchim = s => {\n    const c = s.charCodeAt(s.length - 1);\n    if (c < 0xAC00 || c > 0xD7A3) return false;\n    return (c - 0xAC00) % 28 !== 0;\n  };\n\n  /* 글자 풀: 우화 조각들에서 추출 */\n  const glyphs = Array.from(new Set(\n    [...beings, ...places, ...acts, ...thoughts, ...morals, 'claude fable 5.1 · , . ? !'].join('').replace(/\\s/g, '')\n  ));\n\n  /* ---------- 상태 ---------- */\n  let W = 0, H = 0, dpr = 1;\n  let hue = 38, wind = 0;\n  let paused = false;\n  let userMotion = null;         // null: 시스템 설정 따름, true: 줄임, false: 켬\n  const reduce = () => (userMotion === null ? mq.matches : userMotion);\n  const sizes = [12, 14, 17, 21];\n  const groups = sizes.map(() => []);\n  let total = 0;\n  const pointer = { x: 0, y: 0, active: false };\n  let gather = null;\n  let t = 0, last = performance.now(), raf = 0;\n  let count = 0;\n\n  const makeP = () => ({\n    x: Math.random() * W, y: Math.random() * H,\n    vx: (Math.random() - .5) * .4, vy: (Math.random() - .5) * .4,\n    ch: pick(glyphs), ph: Math.random() * Math.PI * 2\n  });\n\n  function resize() {\n    dpr = Math.min(window.devicePixelRatio || 1, 2);\n    W = window.innerWidth; H = window.innerHeight;\n    canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);\n    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n    const target = Math.round(Math.min(380, Math.max(70, (W * H) / 4200)));\n    while (total < target) {\n      const r = Math.random();\n      const gi = r < .4 ? 0 : r < .72 ? 1 : r < .92 ? 2 : 3;\n      groups[gi].push(makeP()); total++;\n    }\n    while (total > target) {\n      for (const g of groups) if (g.length && total > target) { g.pop(); total--; }\n    }\n    if (reduce() || paused) draw(true);\n  }\n\n  function field(x, y) {\n    const s = .0022;\n    return Math.sin(x * s + t * .25) * 1.1\n         + Math.cos(y * s * 1.3 - t * .18) * .9\n         + Math.sin((x + y) * s * .5 + t * .1) * .5\n         + wind;\n  }\n\n  function step(dt) {\n    t += dt;\n    const k = dt * 60;\n    const now = performance.now();\n    let gx = 0, gy = 0, gf = 0;\n    if (gather) {\n      const age = now - gather.t0;\n      if (age > 1500) gather = null;\n      else { gx = gather.x; gy = gather.y; gf = age < 1100 ? .5 : -1.2; }\n    }\n    for (const g of groups) for (const p of g) {\n      const a = field(p.x, p.y);\n      p.vx += Math.cos(a) * .045 * k;\n      p.vy += Math.sin(a) * .045 * k;\n      if (pointer.active) {\n        const dx = pointer.x - p.x, dy = pointer.y - p.y;\n        const d = Math.hypot(dx, dy) || 1;\n        if (d < 240) {\n          const f = (1 - d / 240) * .22 * k;\n          p.vx += (dx / d) * f - (dy / d) * f * .6;\n          p.vy += (dy / d) * f + (dx / d) * f * .6;\n        }\n      }\n      if (gf) {\n        const dx = gx - p.x, dy = gy - p.y;\n        const d = Math.hypot(dx, dy) || 1;\n        const f = gf * k * (gf > 0 ? Math.min(1, 300 / d) : Math.max(.2, 1 - d / 500));\n        p.vx += (dx / d) * f; p.vy += (dy / d) * f;\n      }\n      const damp = Math.max(0, 1 - .05 * k);\n      p.vx *= damp; p.vy *= damp;\n      p.x += p.vx * k; p.y += p.vy * k;\n      if (p.x < -30) p.x = W + 30; else if (p.x > W + 30) p.x = -30;\n      if (p.y < -30) p.y = H + 30; else if (p.y > H + 30) p.y = -30;\n    }\n  }\n\n  function draw(staticMode) {\n    ctx.clearRect(0, 0, W, H);\n    ctx.textBaseline = 'middle'; ctx.textAlign = 'center';\n    groups.forEach((g, i) => {\n      ctx.font = `${sizes[i]}px \"Noto Serif KR\",\"Nanum Myeongjo\",\"Apple SD Gothic Neo\",Georgia,serif`;\n      for (const p of g) {\n        let a;\n        if (staticMode) a = .2;\n        else {\n          a = .16 + .3 * (.5 + .5 * Math.sin(t * 1.3 + p.ph));\n          if (pointer.active) {\n            const d = Math.hypot(pointer.x - p.x, pointer.y - p.y);\n            if (d < 240) a += (1 - d / 240) * .45;\n          }\n          if (gather) a += .15;\n        }\n        ctx.fillStyle = `hsla(${hue} 80% 74% / ${Math.min(.95, a)})`;\n        ctx.fillText(p.ch, p.x, p.y);\n      }\n    });\n  }\n\n  function loop(now) {\n    const dt = Math.min(.05, (now - last) / 1000); last = now;\n    step(dt); draw(false);\n    raf = requestAnimationFrame(loop);\n  }\n  function syncAnimation() {\n    const run = !paused && !reduce();\n    if (run && !raf) { last = performance.now(); raf = requestAnimationFrame(loop); }\n    if (!run && raf) { cancelAnimationFrame(raf); raf = 0; }\n    if (!run) draw(reduce());\n  }\n\n  /* ---------- 우화 짓기 ---------- */\n  function weave() {\n    count++;\n    const b = pick(beings);\n    const l1 = `어느 날 ${b}${hasBatchim(b) ? '이' : '가'} ${pick(places)}에서 ${pick(acts)}.`;\n    const l2 = `${b}${hasBatchim(b) ? '은' : '는'} ${pick(thoughts)}.`;\n    const l3 = `우화는 말한다. ${pick(morals)}.`;\n    const lines = [$('#l1'), $('#l2'), $('#l3')];\n    const texts = [l1, l2, l3];\n    lines.forEach(el => el.classList.remove('show'));\n    $('#count').textContent = `${count}번째 우화 · 나는 이것을 기억하지 못합니다.`;\n    lines.forEach((el, i) => { el.textContent = texts[i]; });\n    // 다음 프레임에서 표시 (시각적 전환만; 텍스트는 즉시 접근 가능)\n    requestAnimationFrame(() => requestAnimationFrame(() => lines.forEach(el => el.classList.add('show'))));\n    if (!reduce()) {\n      const r = fable.getBoundingClientRect();\n      gather = { x: r.left + r.width / 2, y: r.top + r.height / 2, t0: performance.now() };\n    }\n  }\n\n  /* ---------- 조작 ---------- */\n  const btnPause = $('#btnPause'), btnMotion = $('#btnMotion');\n  function setHue(h) { hue = ((h % 360) + 360) % 360; root.style.setProperty('--hue', hue); if (!raf) draw(reduce()); }\n  function togglePause() {\n    paused = !paused;\n    btnPause.textContent = paused ? '흐름 재생' : '흐름 멈춤';\n    btnPause.setAttribute('aria-pressed', String(paused));\n    syncAnimation();\n  }\n  function applyMotion() {\n    const r = reduce();\n    btnMotion.setAttribute('aria-pressed', String(r));\n    btnMotion.textContent = r ? '움직임 켜기' : '움직임 줄이기';\n    root.classList.toggle('reduce', r);\n    syncAnimation();\n  }\n\n  $('#btnWeave').addEventListener('click', weave);\n  btnPause.addEventListener('click', togglePause);\n  $('#btnWindL').addEventListener('click', () => { wind -= .35; });\n  $('#btnWindR').addEventListener('click', () => { wind += .35; });\n  $('#btnHue').addEventListener('click', () => setHue(hue + 40));\n  btnMotion.addEventListener('click', () => { userMotion = !reduce(); applyMotion(); });\n  mq.addEventListener('change', () => { if (userMotion === null) applyMotion(); });\n\n  document.addEventListener('keydown', e => {\n    if (e.ctrlKey || e.metaKey || e.altKey) return;\n    const tag = e.target.tagName;\n    if (tag === 'INPUT' || tag === 'TEXTAREA') return;\n    switch (e.key) {\n      case 'n': case 'N': weave(); break;\n      case 'p': case 'P': togglePause(); break;\n      case 'ArrowLeft': wind -= .35; e.preventDefault(); break;\n      case 'ArrowRight': wind += .35; e.preventDefault(); break;\n      case 'ArrowUp': setHue(hue + 20); e.preventDefault(); break;\n      case 'ArrowDown': setHue(hue - 20); e.preventDefault(); break;\n      default: return;\n    }\n  });\n\n  window.addEventListener('pointermove', e => { pointer.x = e.clientX; pointer.y = e.clientY; pointer.active = true; }, { passive: true });\n  window.addEventListener('pointerdown', e => { pointer.x = e.clientX; pointer.y = e.clientY; pointer.active = true; }, { passive: true });\n  window.addEventListener('pointerup', e => { if (e.pointerType === 'touch') pointer.active = false; });\n  window.addEventListener('pointercancel', () => { p",
