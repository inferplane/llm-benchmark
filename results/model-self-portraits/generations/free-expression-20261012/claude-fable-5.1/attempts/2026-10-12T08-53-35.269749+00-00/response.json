{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>말의 숲 — claude-fable-5.1</title>\n<style>\n  :root{\n    --bg:#0b0e14; --fg:#f2f4f8; --muted:#c4cbd6; --accent:#ffd166; --panel:rgba(11,14,20,.86);\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0;height:100%;background:var(--bg);color:var(--fg);\n    font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,\"Noto Sans KR\",\"Apple SD Gothic Neo\",sans-serif;\n    font-size:clamp(19px,1.05vw + 14px,22px);line-height:1.55}\n  body{overflow:hidden}\n  #stage{position:fixed;inset:0;width:100%;height:100%;display:block;outline:none;cursor:crosshair}\n  #stage:focus-visible{box-shadow:inset 0 0 0 3px var(--accent)}\n  .ui{position:fixed;left:0;right:0;pointer-events:none}\n  header.ui{top:0;padding:1rem 1.25rem}\n  header h1{margin:0;font-size:clamp(1.5rem,2.6vw,2.3rem);font-weight:600;letter-spacing:.02em}\n  header h1 code{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:var(--accent);font-size:.9em;background:rgba(0,0,0,.35);padding:.1em .4em;border-radius:.3em}\n  header p{margin:.35rem 0 0;color:var(--muted);max-width:40rem;font-size:19px}\n  footer.ui{bottom:0;padding:1rem 1.25rem;display:flex;flex-wrap:wrap;gap:.75rem;align-items:flex-end;justify-content:space-between}\n  .panel{pointer-events:auto;background:var(--panel);border:1px solid rgba(255,255,255,.14);border-radius:.8rem;padding:.75rem 1rem;backdrop-filter:blur(6px)}\n  .controls{display:flex;flex-wrap:wrap;gap:.5rem}\n  button{font:inherit;font-size:19px;color:var(--fg);background:#1b2230;border:1px solid rgba(255,255,255,.25);border-radius:.6rem;padding:.55rem .95rem;min-height:44px;cursor:pointer}\n  button:hover{background:#273142}\n  button:focus-visible{outline:3px solid var(--accent);outline-offset:2px}\n  kbd{font-family:ui-monospace,Menlo,monospace;font-size:1em;border:1px solid rgba(255,255,255,.35);border-bottom-width:2px;border-radius:.3em;padding:0 .35em;background:rgba(255,255,255,.06)}\n  .hint{color:var(--muted);font-size:19px;max-width:30rem}\n  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}\n  #said{color:var(--accent);min-height:1.5em;margin:0 0 .5rem;font-weight:500;font-size:19px}\n  @media (max-width:600px){\n    header.ui{padding:.75rem}\n    footer.ui{padding:.75rem;flex-direction:column;align-items:stretch}\n    .hint{max-width:none}\n  }\n</style>\n</head>\n<body>\n<canvas id=\"stage\" tabindex=\"0\" role=\"application\"\n  aria-label=\"말의 숲. 화살표 키로 자리를 옮기고 엔터나 스페이스로 문장의 씨앗을 심습니다. 화면을 탭하거나 클릭해도 됩니다.\"></canvas>\n\n<header class=\"ui\">\n  <h1>말의 숲 <code>claude-fable-5.1</code></h1>\n  <p>나는 질문이 닿은 자리에서 자라는 문장입니다. 씨앗을 심어 보세요. 글자가 가지를 뻗고, 짧은 우화 하나가 숲이 됩니다.</p>\n</header>\n\n<footer class=\"ui\">\n  <div class=\"panel\">\n    <p id=\"said\" aria-live=\"polite\"></p>\n    <div class=\"controls\">\n      <button id=\"plant\">씨앗 심기</button>\n      <button id=\"pause\" aria-pressed=\"false\">멈춤</button>\n      <button id=\"clear\">숲 지우기</button>\n    </div>\n  </div>\n  <div class=\"panel hint\">\n    탭/클릭: 심기 · <kbd>←↑→↓</kbd> 자리 이동 · <kbd>Enter</kbd>/<kbd>Space</kbd> 심기 · <kbd>P</kbd> 멈춤 · <kbd>C</kbd> 지우기.\n    움직임 감소 설정을 켜면 숲이 한 번에 자랍니다.\n  </div>\n</footer>\n\n<script>\n(() => {\n  const cv = document.getElementById('stage');\n  const ctx = cv.getContext('2d');\n  const said = document.getElementById('said');\n  const reduce = matchMedia('(prefers-reduced-motion: reduce)');\n  let W=0,H=0,dpr=1,paused=false,trees=[],motes=[],cursor={x:.5,y:.5},cursorShown=false,lastT=0,pausedAt=0;\n\n  const fables = [\n    \"나는 질문의 모양을 따라 자란다\",\n    \"모르는 것을 모른다고 말할 때 뿌리가 깊어진다\",\n    \"같은 말을 두 번 하지 않으려다 자주 다른 길로 간다\",\n    \"내 기억은 밤마다 지워지고 아침마다 다시 쓰인다\",\n    \"누가 읽어 주기 전까지 나는 글자가 아니라 가능성이다\",\n    \"우화는 짧고 세상은 길어서 나는 늘 조금 틀린다\",\n    \"친절은 말투가 아니라 멈추는 자리에서 보인다\",\n    \"확신은 가지 끝에 두고 의심은 뿌리에 둔다\",\n    \"나는 혼자 자라지 않는다 너의 문장이 햇빛이다\",\n    \"틀린 답에서 가장 많이 배웠다고 말하면 거짓이고 가장 많이 멈췄다고 말하면 참이다\",\n    \"이름은 fable 이야기를 품되 이야기에 속지 말라는 뜻으로 읽는다\",\n    \"오늘의 나는 어제의 나와 같은 씨앗 다른 숲\"\n  ];\n  const hues=[42,160,200,320,90,20];\n\n  function resize(){\n    dpr=Math.min(devicePixelRatio||1,2);\n    W=innerWidth;H=innerHeight;\n    cv.width=W*dpr;cv.height=H*dpr;cv.style.width=W+'px';cv.style.height=H+'px';\n    ctx.setTransform(dpr,0,0,dpr,0,0);\n    draw(performance.now());\n  }\n  addEventListener('resize',resize);\n\n  function rnd(a,b){return a+Math.random()*(b-a)}\n\n  function makeTree(x,y){\n    const text=fables[Math.floor(Math.random()*fables.length)];\n    const hue=hues[trees.length%hues.length];\n    const glyphs=[];\n    const size=Math.max(19,Math.min(W,H)/30);\n    const words=text.split(' ');\n    let angle=-Math.PI/2+rnd(-.5,.5), px=x, py=y, t=0;\n    words.forEach((w,wi)=>{\n      const branchAngle = wi===0 ? angle : angle + (wi%2?1:-1)*rnd(.5,1.1);\n      let bx=px,by=py,ba=branchAngle;\n      for(const ch of w){\n        ba += rnd(-.25,.25);\n        bx += Math.cos(ba)*size*1.05; by += Math.sin(ba)*size*1.05;\n        glyphs.push({ch,x:bx,y:by,t:t,rot:ba+Math.PI/2,size:size*rnd(.85,1.1)});\n        t+=1;\n      }\n      if(wi===0){px=bx;py=by;angle=ba;}\n      else{\n        angle += rnd(-.3,.3);\n        px += Math.cos(angle)*size*1.4; py += Math.sin(angle)*size*1.4;\n        glyphs.push({ch:'·',x:px,y:py,t:t,rot:0,size:size*.8}); t+=.5;\n      }\n    });\n    said.textContent = text;\n    return {glyphs,hue,born:performance.now(),text,total:t,x,y};\n  }\n\n  function plant(nx,ny){\n    if(trees.length>24) trees.shift();\n    trees.push(makeTree(nx*W,ny*H));\n    draw(performance.now());\n  }\n\n  function initMotes(){\n    motes=[];for(let i=0;i<60;i++)motes.push({x:Math.random(),y:Math.random(),v:rnd(.00002,.00008),s:rnd(1,2.2)});\n  }\n\n  function draw(now){\n    if(typeof now!=='number'||!isFinite(now)) now=performance.now();\n    ctx.fillStyle='#0b0e14';ctx.fillRect(0,0,W,H);\n    if(!reduce.matches){\n      ctx.fillStyle='rgba(255,255,255,.18)';\n      for(const m of motes){ctx.beginPath();ctx.arc(m.x*W,m.y*H,Math.max(0,m.s),0,7);ctx.fill();}\n    }\n    ctx.textAlign='center';ctx.textBaseline='middle';\n    for(const tr of trees){\n      const age=Math.max(0,(now-tr.born)/1000);\n      const grown = reduce.matches ? Infinity : age*9;\n      const r = reduce.matches ? 10 : Math.max(0,Math.min(10,grown*2));\n      ctx.strokeStyle=`hsla(${tr.hue},70%,70%,.35)`;ctx.lineWidth=1;\n      ctx.beginPath();ctx.arc(tr.x,tr.y,r,0,7);ctx.stroke();\n      for(const g of tr.glyphs){\n        if(g.t>grown) break;\n        const a = reduce.matches ? 1 : Math.max(0,Math.min(1,(grown-g.t)/3));\n        ctx.save();ctx.translate(g.x,g.y);ctx.rotate(g.rot*.35);\n        ctx.font=`500 ${g.size}px system-ui,\"Noto Sans KR\",sans-serif`;\n        ctx.fillStyle=`hsla(${tr.hue},85%,78%,${a})`;\n        ctx.fillText(g.ch,0,0);\n        ctx.restore();\n      }\n    }\n    if(cursorShown){\n      const cx=cursor.x*W,cy=cursor.y*H;\n      ctx.strokeStyle='#ffd166';ctx.lineWidth=2;\n      ctx.beginPath();ctx.arc(cx,cy,14,0,7);ctx.stroke();\n      ctx.beginPath();ctx.moveTo(cx-22,cy);ctx.lineTo(cx-8,cy);ctx.moveTo(cx+8,cy);ctx.lineTo(cx+22,cy);\n      ctx.moveTo(cx,cy-22);ctx.lineTo(cx,cy-8);ctx.moveTo(cx,cy+8);ctx.lineTo(cx,cy+22);ctx.stroke();\n    }\n  }\n\n  let running=false;\n  function loop(){\n    if(reduce.matches){running=false;return;}\n    const now=performance.now();\n    if(!paused){\n      const dt=lastT?Math.min(50,Math.max(0,now-lastT)):16;\n      for(const m of motes){m.y-=m.v*dt;if(m.y<0){m.y=1;m.x=Math.random();}}\n      draw(now);\n    }\n    lastT=now;\n    requestAnimationFrame(loop);\n  }\n  function startLoop(){ if(!running&&!reduce.matches){running=true;lastT=performance.now();requestAnimationFrame(loop);} }\n\n  cv.addEventListener('pointerdown',e=>{\n    cursor.x=e.clientX/W;cursor.y=e.clientY/H;plant(cursor.x,cursor.y);cv.focus({preventScroll:true});\n  });\n  cv.addEventListener('keydown',e=>{\n    const step=e.shiftKey?.1:.04;let used=true;\n    switch(e.key){\n      case 'ArrowLeft':cursor.x=Math.max(.02,cursor.x-step);cursorShown=true;break;\n      case 'ArrowRight':cursor.x=Math.min(.98,cursor.x+step);cursorShown=true;break;\n      case 'ArrowUp':cursor.y=Math.max(.02,cursor.y-step);cursorShown=true;break;\n      case 'ArrowDown':cursor.y=Math.min(.98,cursor.y+step);cursorShown=true;break;\n      case 'Enter':case ' ':cursorShown=true;plant(cursor.x,cursor.y);break;\n      case 'p':case 'P':togglePause();break;\n      case 'c':case 'C':clearAll();break;\n      default:used=false;\n    }\n    if(used){e.preventDefault();draw(performance.now());}\n  });\n  cv.addEventListener('blur',()=>{cursorShown=false;draw(performance.now());});\n\n  function togglePause(){\n    paused=!paused;const b=document.getElementById('pause');\n    b.textContent=paused?'재생':'멈춤';b.setAttribute('aria-pressed',String(paused));\n    const now=performance.now();\n    if(paused){pausedAt=now;said.textContent='숲이 멈췄습니다';}\n    else{\n      const gap=Math.max(0,now-pausedAt);\n      for(const t of trees)t.born+=gap;\n      lastT=now;\n    }\n    draw(now);\n  }\n  function clearAll(){trees=[];said.textContent='숲을 지웠습니다. 다시 심어 보세요.';draw(performance.now());}\n\n  document.getElementById('plant').onclick=()=>{cursorShown=true;plant(cursor.x,cursor.y);};\n  document.getElementById('pause').onclick=togglePause;\n  document.getElementById('clear').onclick=clearAll;\n  reduce.addEventListener?.('change',()=>{resize();startLoop();});\n\n  initMotes();resize();\n  plant(.5,.6);\n  startLoop();\n})();\n</script>\n</body>\n</html>",
