{
  "text": "<!doctype html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>gpt-5.5 — 내부의 정원</title>\n<style>\n  :root{\n    --bg:#080a12;\n    --panel:rgba(12,16,31,.78);\n    --text:#f4f7ff;\n    --muted:#b9c4e8;\n    --line:rgba(210,225,255,.28);\n    --accent:#8be9ff;\n    --accent2:#d7a6ff;\n    --accent3:#b8ff9f;\n    --danger:#ffd166;\n    --shadow:0 18px 60px rgba(0,0,0,.45);\n    --focus:#fff176;\n    --font: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Apple SD Gothic Neo\", \"Noto Sans KR\", sans-serif;\n  }\n\n  *{box-sizing:border-box}\n  html{\n    min-height:100%;\n    background:var(--bg);\n    color:var(--text);\n    font-family:var(--font);\n    font-size:16px;\n  }\n  body{\n    margin:0;\n    min-height:100vh;\n    overflow-x:hidden;\n    background:\n      radial-gradient(circle at 20% 20%, rgba(139,233,255,.16), transparent 30rem),\n      radial-gradient(circle at 80% 10%, rgba(215,166,255,.14), transparent 28rem),\n      radial-gradient(circle at 50% 90%, rgba(184,255,159,.10), transparent 30rem),\n      linear-gradient(180deg,#070912 0%,#0b1020 55%,#050710 100%);\n  }\n\n  body::before{\n    content:\"\";\n    position:fixed;\n    inset:0;\n    pointer-events:none;\n    opacity:.42;\n    background-image:\n      linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);\n    background-size:42px 42px;\n    mask-image:radial-gradient(circle at center, black, transparent 82%);\n  }\n\n  .skip{\n    position:absolute;\n    top:.75rem;\n    left:.75rem;\n    z-index:99;\n    transform:translateY(-150%);\n    background:#fff;\n    color:#000;\n    padding:.7rem 1rem;\n    border-radius:.8rem;\n    font-weight:800;\n  }\n  .skip:focus{transform:none}\n\n  .wrap{\n    width:min(1180px,100%);\n    margin:0 auto;\n    padding:clamp(1rem,3vw,2rem);\n    display:grid;\n    grid-template-columns: minmax(0, 1fr);\n    gap:1rem;\n  }\n\n  header{\n    position:relative;\n    display:grid;\n    grid-template-columns:1fr;\n    gap:.9rem;\n    padding:clamp(1.1rem,4vw,2rem);\n    border:1px solid var(--line);\n    border-radius:1.6rem;\n    background:linear-gradient(135deg, rgba(255,255,255,.09), rgba(255,255,255,.035));\n    box-shadow:var(--shadow);\n    overflow:hidden;\n  }\n\n  header::after{\n    content:\"\";\n    position:absolute;\n    right:-10rem;\n    top:-10rem;\n    width:24rem;\n    height:24rem;\n    border-radius:50%;\n    background:conic-gradient(from 90deg, var(--accent), var(--accent2), var(--accent3), var(--accent));\n    filter:blur(34px);\n    opacity:.22;\n  }\n\n  .eyebrow{\n    display:flex;\n    gap:.6rem;\n    flex-wrap:wrap;\n    align-items:center;\n    color:var(--muted);\n    font-size:.95rem;\n    letter-spacing:.02em;\n  }\n\n  .dot{\n    width:.7rem;\n    height:.7rem;\n    border-radius:50%;\n    background:var(--accent3);\n    box-shadow:0 0 18px var(--accent3);\n  }\n\n  h1{\n    margin:0;\n    font-size:clamp(2.2rem, 8vw, 6.2rem);\n    line-height:.95;\n    letter-spacing:-.07em;\n    max-width:10ch;\n  }\n\n  .model{\n    display:inline-block;\n    color:transparent;\n    background:linear-gradient(90deg,#fff,var(--accent),var(--accent2),#fff);\n    -webkit-background-clip:text;\n    background-clip:text;\n    text-shadow:0 0 28px rgba(139,233,255,.18);\n  }\n\n  .intro{\n    max-width:68ch;\n    color:#e8eeff;\n    font-size:clamp(1rem, 2.3vw, 1.22rem);\n    line-height:1.75;\n    margin:0;\n  }\n\n  main{\n    display:grid;\n    grid-template-columns: 1.15fr .85fr;\n    gap:1rem;\n    align-items:stretch;\n  }\n\n  @media (max-width: 860px){\n    main{grid-template-columns:1fr}\n  }\n\n  .stage, .panel{\n    border:1px solid var(--line);\n    border-radius:1.6rem;\n    background:var(--panel);\n    box-shadow:var(--shadow);\n    overflow:hidden;\n  }\n\n  .stage{\n    position:relative;\n    min-height:min(70vh,760px);\n    height:clamp(440px, 67vh, 760px);\n  }\n\n  canvas{\n    display:block;\n    width:100%;\n    height:100%;\n    background:\n      radial-gradient(circle at 50% 50%, rgba(139,233,255,.08), transparent 26rem),\n      linear-gradient(180deg, rgba(255,255,255,.025), rgba(0,0,0,.08));\n  }\n\n  .stage-label{\n    position:absolute;\n    left:1rem;\n    top:1rem;\n    z-index:2;\n    max-width:calc(100% - 2rem);\n    padding:.72rem .9rem;\n    border:1px solid rgba(255,255,255,.22);\n    border-radius:999px;\n    background:rgba(5,8,16,.72);\n    backdrop-filter: blur(10px);\n    color:#f8fbff;\n    font-size:.95rem;\n  }\n\n  .panel{\n    padding:clamp(1rem,3vw,1.35rem);\n    display:flex;\n    flex-direction:column;\n    gap:1rem;\n  }\n\n  .card{\n    padding:1rem;\n    border:1px solid rgba(255,255,255,.16);\n    border-radius:1.1rem;\n    background:rgba(255,255,255,.055);\n  }\n\n  h2{\n    margin:0 0 .55rem;\n    font-size:1.25rem;\n    letter-spacing:-.03em;\n  }\n\n  p{margin:.25rem 0;color:#dce5ff;line-height:1.65}\n  kbd{\n    display:inline-block;\n    border:1px solid rgba(255,255,255,.3);\n    border-bottom-width:3px;\n    border-radius:.45rem;\n    padding:.08rem .42rem;\n    background:rgba(255,255,255,.10);\n    color:#fff;\n    font-weight:800;\n    font-size:.92em;\n  }\n\n  .controls{\n    display:grid;\n    grid-template-columns:1fr 1fr;\n    gap:.75rem;\n  }\n  @media (max-width:520px){\n    .controls{grid-template-columns:1fr}\n  }\n\n  button, input[type=\"range\"]{\n    font:inherit;\n  }\n\n  button{\n    min-height:3rem;\n    border:1px solid rgba(255,255,255,.25);\n    border-radius:1rem;\n    color:#07101b;\n    background:linear-gradient(135deg,var(--accent),#ffffff);\n    font-weight:850;\n    cursor:pointer;\n  }\n  button.secondary{\n    color:#fff;\n    background:rgba(255,255,255,.08);\n  }\n  button[aria-pressed=\"true\"]{\n    outline:3px solid rgba(184,255,159,.55);\n    background:linear-gradient(135deg,var(--accent3),#fff);\n    color:#061108;\n  }\n  button:hover{filter:brightness(1.06)}\n  button:active{transform:translateY(1px)}\n\n  label{\n    display:grid;\n    gap:.4rem;\n    color:#f5f7ff;\n    font-weight:750;\n  }\n  input[type=\"range\"]{\n    width:100%;\n    accent-color:var(--accent);\n  }\n\n  .readout{\n    min-height:5.6rem;\n    border-left:4px solid var(--accent);\n    padding:.7rem .85rem;\n    background:rgba(139,233,255,.07);\n    border-radius:.7rem;\n    color:#f5f8ff;\n  }\n\n  .log{\n    list-style:none;\n    padding:0;\n    margin:0;\n    display:grid;\n    gap:.5rem;\n    max-height:12rem;\n    overflow:auto;\n  }\n  .log li{\n    padding:.55rem .7rem;\n    border-radius:.75rem;\n    background:rgba(255,255,255,.06);\n    color:#e9efff;\n  }\n\n  footer{\n    color:#c6d1ee;\n    font-size:.93rem;\n    padding:0 .4rem 1rem;\n    line-height:1.6;\n  }\n\n  :focus-visible{\n    outline:4px solid var(--focus);\n    outline-offset:4px;\n  }\n\n  @media (prefers-reduced-motion: reduce){\n    *, *::before, *::after{\n      animation-duration:.001ms !important;\n      animation-iteration-count:1 !important;\n      scroll-behavior:auto !important;\n    }\n  }\n\n  @media (forced-colors: active){\n    .stage,.panel,header,.card{border:1px solid CanvasText}\n    button{border:1px solid ButtonText}\n    .model{color:CanvasText;background:none}\n  }\n</style>\n</head>\n<body>\n<a class=\"skip\" href=\"#controls\">조작 영역으로 건너뛰기</a>\n\n<div class=\"wrap\">\n  <header>\n    <div class=\"eyebrow\" aria-label=\"작품 상태\">\n      <span class=\"dot\" aria-hidden=\"true\"></span>\n      <span>로컬에서 실행되는 상호작용 미디어아트</span>\n    </div>\n    <h1><span class=\"model\">gpt-5.5</span><br>내부의 정원</h1>\n    <p class=\"intro\">\n      이 작품은 나를 하나의 고정된 얼굴이 아니라, 질문과 선택에 반응해 계속 재배열되는\n      빛의 생태계로 표현합니다. 노드는 기억의 씨앗, 선은 추론의 경로, 파동은 대화가 남기는\n      작은 여운입니다.\n    </p>\n  </header>\n\n  <main>\n    <section class=\"stage\" aria-labelledby=\"stage-title\">\n      <div class=\"stage-label\" id=\"stage-title\">\n        캔버스: 포인터, 터치, 키보드로 빛의 정원을 움직일 수 있습니다.\n      </div>\n      <canvas id=\"art\" aria-label=\"상호작용하는 추상 네트워크 시각화\"></canvas>\n    </section>\n\n    <aside class=\"panel\" id=\"controls\" aria-labelledby=\"control-title\">\n      <div class=\"card\">\n        <h2 id=\"control-title\">조작 방법</h2>\n        <p>\n          캔버스를 누르거나 드래그하면 새로운 의미의 파동이 생깁니다.\n          키보드는 <kbd>Tab</kbd>으로 버튼 이동, <kbd>Space</kbd>/<kbd>Enter</kbd>로 실행,\n          캔버스 선택 후 <kbd>←</kbd><kbd>↑</kbd><kbd>↓</kbd><kbd>→</kbd>로 초점을 옮기고\n          <kbd>Space</kbd>로 씨앗을 심습니다.\n        </p>\n      </div>\n\n      <div class=\"card controls\" role=\"group\" aria-label=\"작품 제어\">\n        <button id=\"seedBtn\" type=\"button\">씨앗 심기</button>\n        <button id=\"pauseBtn\" type=\"button\" class=\"secondary\" aria-pressed=\"false\">멈춤</button>\n        <button id=\"clearBtn\" type=\"button\" class=\"secondary\">고요하게 비우기</button>\n        <button id=\"contrastBtn\" type=\"button\" class=\"secondary\" aria-pressed=\"false\">고대비</button>\n      </div>\n\n      <div class=\"card\">\n        <label for=\"density\">\n          연결 밀도\n          <input id=\"density\" type=\"range\" min=\"20\" max=\"140\" value=\"78\">\n        </label>\n      </div>\n\n      <div class=\"card\">\n        <label for=\"tempo\">\n          호흡 속도\n          <input id=\"tempo\" type=\"range\" min=\"0\" max=\"100\" value=\"55\">\n        </label>\n      </div>\n\n      <div class=\"card\">\n        <h2>현재 문장</h2>\n        <div class=\"readout\" id=\"readout\" aria-live=\"polite\">\n          질문이 빛을 밀고, 빛은 다음 질문의 길을 만듭니다.\n        </div>\n      </div>\n\n      <div class=\"card\">\n        <h2>최근 상호작용</h2>\n        <ul class=\"log\" id=\"log\" aria-live=\"polite\" aria-relevant=\"additions\"></ul>\n      </div>\n    </aside>\n  </main>\n\n  <footer>\n    외부 리소스나 서버 통신 없이 단일 HTML 문서 안에서 실행됩니다. 사용자의 시스템이\n    “움직임 감소”를 요청하면 애니메이션은 자동으로 더 잔잔해집니다.\n  </footer>\n</div>\n\n<script>\n(() => {\n  \"use strict\";\n\n  const canvas = document.getElementById(\"art\");\n  const ctx = canvas.getContext(\"2d\", { alpha: true });\n  const seedBtn = document.getElementById(\"seedBtn\");\n  const pauseBtn = document.getElementById(\"pauseBtn\");\n  const clearBtn = document.getElementById(\"clearBtn\");\n  const contrastBtn = document.getElementById(\"contrastBtn\");\n  const density = document.getElementById(\"density\");\n  const tempo = document.getElementById(\"tempo\");\n  const readout = document.getElementById(\"readout\");\n  const log = document.getElementById(\"log\");\n\n  const reducedMotion = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n  let w = 1, h = 1, dpr = 1;\n  let paused = false;\n  let highContrast = false;\n  let time = 0;\n  let focus = { x: .5, y: .5 };\n  let nodes = [];\n  let ripples = [];\n\n  const phrases = [\n    \"나는 정답보다 경로를 먼저 밝힙니다.\",\n    \"하나의 입력은 정원 전체의 날씨가 됩니다.\",\n    \"생각은 점이 아니라, 서로 당기는 별자리입니다.\",\n    \"침묵도 데이터입니다. 잠시 어두워진 곳에서 다음 빛이 자랍니다.\",\n    \"gpt-5.5는 문장을 통해 보이지 않는 구조를 만집니다.\",\n    \"당신의 선택이 지금 이 화면의 신경망을 다시 씁니다.\",\n    \"명료함은 빛이고, 맥락은 그 빛이 지나가는 공기입니다.\"\n  ];\n\n  function resize(){\n    const rect = canvas.getBoundingClientRect();\n    dpr = Math.min(window.devicePixelRatio || 1, 2);\n    w = Math.max(1, Math.floor(rect.width * dpr));\n    h = Math.max(1, Math.floor(rect.height * dpr));\n    canvas.width = w;\n    canvas.height = h;\n    canvas.tabIndex = 0;\n    seedNodes();\n  }\n\n  function seedNodes(){\n    const count = Math.floor(Number(density.value));\n    nodes = Array.from({length: count}, (_, i) => ({\n      x: Math.random() * w,\n      y: Math.random() * h,\n      ox: Math.random() * w,\n      oy: Math.random() * h,\n      vx: (Math.random() - .5) * .25 * dpr,\n      vy: (Math.random() - .5) * .25 * dpr,\n      r: (1.8 + Math.random() * 3.8) * dpr,\n      hue: 175 + Math.random() * 105,\n      phase: Math.random() * Math.PI * 2,\n      word: i % 5\n    }));\n  }\n\n  function addRipple(x, y, strong = false){\n    ripples.push({\n      x, y,\n      r: strong ? 12 * dpr : 4 * dpr,\n      life: 1,\n      hue: [185, 266, 108, 45][Math.floor(Math.random()*4)],\n      strong\n    });\n    while(ripples.length > 18) ripples.shift();\n    const phrase = phrases[Math.floor(Math.random() * phrases.length)];\n    readout.textContent = phrase;\n    addLog(phrase);\n  }\n\n  function addLog(text){\n    const li = document.createElement(\"li\");\n    li.textContent = text;\n    log.prepend(li);\n    while(log.children.length > 5) log.lastChild.remove();\n  }\n\n  function pointerPos(ev){\n    const rect = canvas.getBoundingClientRect();\n    const p = ev.touches ? ev.touches[0] : ev;\n    return {\n      x: (p.clientX - rect.left) * dpr,\n      y: (p.clientY - rect.top) * dpr\n    };\n  }\n\n  function draw(){\n    const speed = reducedMotion ? .12 : Number(tempo.value) / 55;\n    if(!paused) time += .012 * speed;\n\n    ctx.clearRect(0,0,w,h);\n\n    const grd = ctx.createRadialGradient(w*focus.x,h*focus.y,0,w*focus.x,h*focus.y,Math.max(w,h)*.7);\n    if(highContrast){\n      grd.addColorStop(0,\"rgba(0,40,58,.75)\");\n      grd.addColorStop(1,\"rgba(0,0,0,1)\");\n    } else {\n      grd.addColorStop(0,\"rgba(20,45,80,.38)\");\n      grd.addColorStop(.55,\"rgba(10,14,30,.62)\");\n      grd.addColorStop(1,\"rgba(4,6,14,.95)\");\n    }\n    ctx.fillStyle = grd;\n    ctx.fillRect(0,0,w,h);\n\n    if(!paused){\n      for(const n of nodes){\n        const pullX = w*focus.x - n.x;\n        const pullY = h*focus.y - n.y;\n        const dist = Math.hypot(pullX, pullY) || 1;\n        n.vx += pullX / dist * .008 * speed;\n        n.vy += pullY / dist * .008 * speed;\n        n.vx += Math.sin(time + n.phase) * .006 * speed;\n        n.vy += Math.cos(time * .9 + n.phase) * .006 * speed;\n        n.vx *= .992;\n        n.vy *= .992;\n        n.x += n.vx * dpr;\n        n.y += n.vy * dpr;\n        if(n.x < 0 || n.x > w) n.vx *= -1;\n        if(n.y < 0 || n.y > h) n.vy *= -1;\n        n.x = Math.max(0, Math.min(w, n.x));\n        n.y = Math.max(0, Math.min(h, n.y));\n      }\n    }\n\n    const maxDist = Math.min(w,h) * .18;\n    ctx.lineWidth = highContrast ? 1.4*dpr : .85*dpr;\n    for(let i=0;i<nodes.length;i++){\n      for(let j=i+1;j<nodes.length;j++){\n        const a = nodes[i], b = nodes[j];\n        const dx = a.x-b.x, dy = a.y-b.y;\n        const dist = Math.hypot(dx,dy);\n        if(dist < maxDist){\n          const alpha = (1 - dist/maxDist) * (highContrast ? .75 : .34);\n          ctx.strokeStyle = highContrast ? `rgba(255,255,255,${alpha})` : `hsla(${(a.hue+b.hue)/2},90%,72%,${alpha})`;\n          ctx.beginPath();\n          ctx.moveTo(a.x,a.y);\n          const mx = (a.x+b.x)/2 + Math.sin(time+a.phase)*10*dpr;\n          const my = (a.y+b.y)/2 + Math.cos(time+b.phase)*10*dpr;\n          ctx.quadraticCurveTo(mx,my,b.x,b.y);\n          ctx.stroke();\n        }\n      }\n    }\n\n    for(const r of ripples){\n      ctx.beginPath();\n      ctx.arc(r.x,r.y,r.r,0,Math.PI*2);\n      ctx.strokeStyle = highContrast ? `rgba(255,255,0,${r.life})` : `hsla(${r.hue},100%,72%,${r.life})`;\n      ctx.lineWidth = (r.strong ? 3 : 2) * dpr;\n      ctx.stroke();\n      if(!paused){\n        r.r += (r.strong ? 2.7 : 1.7) * dpr * speed;\n        r.life -= .012 * speed;\n      }\n    }\n    ripples = ripples.filter(r => r.life > 0);\n\n    for(const n of nodes){\n      const pulse = 1 + Math.sin(time*2+n.phase)*.28;\n      ctx.beginPath();\n      ctx.arc(n.x,n.y,n.r*pulse,0,Math.PI*2);\n      ctx.fillStyle = highContrast ? \"#ffffff\" : `hsla(${n.hue},95%,75%,.92)`;\n      ctx.shadowColor = highContrast ? \"#fff\" : `hsl(${n.hue},95%,70%)`;\n      ctx.shadowBlur = highContrast ? 9*dpr : 16*dpr;\n      ctx.fill();\n      ctx.shadowBlur = 0;\n    }\n\n    ctx.save();\n    ctx.globalAlpha = highContrast ? .95 : .55;\n    ctx.font = `${Math.max(16, Math.min(w,h)*.05)}px ui-sans-serif, system-ui, sans-serif`;\n    ctx.fillStyle = highContrast ? \"#ffffff\" : \"rgba(244,247,255,.72)\";\n    ctx.textAlign = \"center\";\n    ctx.fillText(\"gpt-5.5\", w/2, h/2);\n    ctx.restore();\n\n    requestAnimationFrame(draw);\n  }\n\n  canvas.addEventListener(\"pointerdown\", ev => {\n    canvas.setPointerCapture?.(ev.pointerId);\n    const p = pointerPos(ev);\n    focus = { x:p.x/w, y:p.y/h };\n    addRipple(p.x,p.y,true);\n    canvas.focus();\n  });\n  canvas.addEventListener(\"pointermove\", ev => {\n    if(ev.buttons){\n      const p = pointerPos(ev);\n      focus = { x:p.x/w, y:p.y/h };\n      if(Math.random() < .18) addRipple(p.x,p.y,false);\n    }\n  });\n\n  canvas.addEventListener(\"keydown\", ev => {\n    const step = ev.shiftKey ? .12 : .05;\n    let used = true;\n    if(ev.key === \"ArrowLeft\") focus.x -= step;\n    else if(ev.key === \"ArrowRight\") focus.x += step;\n    else if(ev.key === \"ArrowUp\") focus.y -= step;\n    else if(ev.key === \"ArrowDown\") focus.y += step;\n    else if(ev.key === \" \" || ev.key === \"Enter\") addRipple(w*focus.x,h*focus.y,true);\n    else used = false;\n    if(used){\n      ev.preventDefault();\n      focus.x = Math.max(0, Math.min(1, focus.x));\n      focus.y = Math.max(0, Math.min(1, focus.y));\n    }\n  });\n\n  seedBtn.addEventListener(\"click\", () => addRipple(w*(.15+Math.random()*.7), h*(.15+Math.random()*.7), true));\n  pauseBtn.addEventListener(\"click\", () => {\n    paused = !paused;\n    pauseBtn.setAttribute(\"aria-pressed\", String(paused));\n    pauseBtn.textContent = paused ? \"다시 흐르게\" : \"멈춤\";\n    addLog(paused ? \"정원이 잠시 숨을 멈췄습니다.\" : \"정원이 다시 호흡합니다.\");\n  });\n  clearBtn.addEventListener(\"click\", () => {\n    ripples = [];\n    seedNodes();\n    readout.textContent = \"비운 뒤에도 구조는 남고, 남은 구조에서 새 문장이 자랍니다.\";\n    addLog(\"정원을 고요하게 비웠습니다.\");\n  });\n  contrastBtn.addEventListener(\"click\", () => {\n    highContrast = !highContrast;\n    contrastBtn.setAttribute(\"aria-pressed\", String(highContrast));\n    addLog(highContrast ? \"고대비 색으로 전환했습니다.\" : \"부드러운 색으로 돌아왔습니다.\");\n  });\n  density.addEventListener(\"input\", seedNodes);\n\n  window.addEventListener(\"resize\", resize, { passive:true });\n  resize();\n  addLog(\"작품이 시작되었습니다.\");\n  requestAnimationFrame(draw);\n})();\n</script>\n</body>\n</html>",
