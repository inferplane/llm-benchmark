{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>gpt-5.6-luna — signal garden</title>\n<style>\n  :root{\n    color-scheme:dark;\n    --ink:#edf3ff;\n    --muted:#aebbd7;\n    --line:rgba(220,235,255,.24);\n    --glass:rgba(11,17,39,.72);\n    --accent:#9be8ff;\n    --accent2:#d8a7ff;\n    --focus:#fff2a8;\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0;min-height:100%;background:#060817;color:var(--ink);\n    font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}\n  body{overflow-x:hidden}\n  .wrap{min-height:100vh;position:relative;isolation:isolate}\n  canvas{position:fixed;inset:0;width:100%;height:100%;z-index:-2}\n  .wash{position:fixed;inset:0;z-index:-1;\n    background:radial-gradient(circle at 50% 42%,transparent 0 18%,rgba(4,7,22,.18) 45%,rgba(2,4,13,.88) 100%),\n    linear-gradient(135deg,rgba(8,20,47,.54),rgba(34,10,54,.36))}\n  main{width:min(1180px,100%);margin:auto;padding:clamp(1.2rem,4vw,4rem);\n    min-height:100vh;display:flex;flex-direction:column;justify-content:space-between;gap:2rem}\n  header{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem}\n  .eyebrow{font-size:.74rem;letter-spacing:.22em;text-transform:uppercase;color:var(--accent);font-weight:700}\n  h1{margin:.55rem 0 0;font-size:clamp(2.5rem,8vw,7.6rem);line-height:.88;letter-spacing:-.07em;max-width:800px}\n  h1 span{color:var(--accent2);font-weight:300}\n  .badge{border:1px solid var(--line);border-radius:999px;padding:.55rem .8rem;\n    font-size:.78rem;color:var(--muted);white-space:nowrap;background:rgba(5,9,25,.4)}\n  .panel{width:min(440px,100%);padding:1rem;border:1px solid var(--line);border-radius:1.2rem;\n    background:var(--glass);backdrop-filter:blur(18px);box-shadow:0 1rem 4rem rgba(0,0,0,.2)}\n  .panel p{margin:.1rem 0 1rem;color:var(--muted);font-size:.92rem;line-height:1.55}\n  .row{display:grid;grid-template-columns:1fr auto;align-items:center;gap:.8rem;margin:.9rem 0}\n  label{font-size:.82rem;color:var(--muted)}\n  input[type=range]{width:100%;accent-color:var(--accent);cursor:pointer}\n  output{font-variant-numeric:tabular-nums;color:var(--ink);min-width:3.5ch;text-align:right}\n  .buttons{display:flex;gap:.55rem;flex-wrap:wrap;margin-top:1rem}\n  button{font:inherit;color:var(--ink);background:rgba(255,255,255,.08);border:1px solid var(--line);\n    border-radius:999px;padding:.62rem .9rem;cursor:pointer}\n  button:hover{background:rgba(155,232,255,.16)}\n  button:focus-visible,input:focus-visible{outline:3px solid var(--focus);outline-offset:3px}\n  .status{margin-top:1rem;padding-top:.8rem;border-top:1px solid var(--line);font-size:.78rem;color:var(--muted)}\n  footer{display:flex;justify-content:space-between;gap:1rem;align-items:end;color:var(--muted);font-size:.76rem}\n  .hint{max-width:34rem;line-height:1.5}\n  @media(max-width:600px){\n    header{display:block}.badge{display:inline-block;margin-top:1rem}\n    main{padding:1.1rem;gap:1.2rem}\n    footer{display:block}.hint{margin-top:.7rem}\n  }\n  @media(prefers-reduced-motion:reduce){\n    *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important}\n  }\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <canvas id=\"sky\" aria-label=\"상호작용하는 별빛 정원\"></canvas>\n  <div class=\"wash\"></div>\n  <main>\n    <header>\n      <div>\n        <div class=\"eyebrow\">an artificial inner weather</div>\n        <h1>gpt-5.6-<span>luna</span></h1>\n      </div>\n      <div class=\"badge\" aria-label=\"작품 상태\">LOCAL / LISTENING</div>\n    </header>\n\n    <section class=\"panel\" aria-labelledby=\"controls-title\">\n      <h2 id=\"controls-title\" style=\"font-size:1rem;margin:.1rem 0 .35rem\">빛의 성격을 조율하세요</h2>\n      <p>화면을 누르거나 드래그하면 생각의 씨앗이 생깁니다. 이 작품은 질문과 침묵 사이의 패턴을 시각화합니다.</p>\n      <div class=\"row\">\n        <label for=\"density\">기억의 밀도</label>\n        <input id=\"density\" type=\"range\" min=\"20\" max=\"180\" value=\"85\">\n        <output id=\"densityOut\">85</output>\n      </div>\n      <div class=\"row\">\n        <label for=\"drift\">달의 표류</label>\n        <input id=\"drift\" type=\"range\" min=\"0\" max=\"100\" value=\"42\">\n        <output id=\"driftOut\">42</output>\n      </div>\n      <div class=\"buttons\">\n        <button id=\"seed\" type=\"button\">새로운 생각 심기</button>\n        <button id=\"clear\" type=\"button\">고요하게 비우기</button>\n      </div>\n      <div class=\"status\" id=\"status\" role=\"status\" aria-live=\"polite\">별 85개 · 움직임 42%</div>\n    </section>\n\n    <footer>\n      <div>MODEL IDENTIFIER · <strong>openai.gpt-5.6-luna</strong></div>\n      <div class=\"hint\">키보드: <strong>Enter</strong>로 생각 심기 · <strong>Space</strong>로 일시정지 · <strong>Esc</strong>로 비우기</div>\n    </footer>\n  </main>\n</div>\n<script>\n(() => {\n  const canvas=document.getElementById('sky'), ctx=canvas.getContext('2d');\n  const density=document.getElementById('density'), drift=document.getElementById('drift');\n  const dOut=document.getElementById('densityOut'), mOut=document.getElementById('driftOut');\n  const status=document.getElementById('status');\n  let w,h,dpr,paused=false,stars=[],ripples=[],t=0;\n\n  function resize(){\n    dpr=Math.min(devicePixelRatio||1,2); w=innerWidth; h=innerHeight;\n    canvas.width=w*dpr; canvas.height=h*dpr; ctx.setTransform(dpr,0,0,dpr,0,0);\n    makeStars();\n  }\n  function makeStars(){\n    const n=+density.value; stars=Array.from({length:n},()=>({\n      x:Math.random()*w,y:Math.random()*h,r:.35+Math.random()*1.8,\n      p:Math.random()*Math.PI*2, a:.25+Math.random()*.7,\n      hue:Math.random()<.5?190:275\n    }));\n  }\n  function updateLabels(){\n    dOut.value=density.value;mOut.value=drift.value;\n    status.textContent=`별 ${density.value}개 · 움직임 ${drift.value}%`;\n    makeStars();\n  }\n  function draw(){\n    if(!paused)t+=.008*(+drift.value/42);\n    ctx.clearRect(0,0,w,h);\n    const cx=w*.73+Math.sin(t*.42)*w*.035, cy=h*.38+Math.cos(t*.3)*h*.025;\n    const g=ctx.createRadialGradient(cx,cy,5,cx,cy,Math.max(w,h)*.34);\n    g.addColorStop(0,'rgba(238,220,255,.95)');g.addColorStop(.08,'rgba(166,202,255,.34)');\n    g.addColorStop(1,'rgba(100,120,255,0)');\n    ctx.fillStyle=g;ctx.fillRect(0,0,w,h);\n    for(const s of stars){\n      const x=s.x+Math.sin(t*.45+s.p)*(+drift.value/100)*12;\n      const y=s.y+Math.cos(t*.34+s.p)*(+drift.value/100)*8;\n      ctx.globalAlpha=s.a*(.65+.35*Math.sin(t*1.7+s.p));\n      ctx.fillStyle=`hsl(${s.hue} 90% 82%)`;ctx.beginPath();ctx.arc(x,y,s.r,0,Math.PI*2);ctx.fill();\n    }\n    ctx.globalAlpha=1;\n    ctx.strokeStyle='rgba(176,220,255,.4)';ctx.lineWidth=1;\n    for(const r of ripples){r.age+=.012;ctx.globalAlpha=1-r.age;\n      ctx.beginPath();ctx.arc(r.x,r.y,r.age*130,0,Math.PI*2);ctx.stroke()}\n    ripples=ripples.filter(r=>r.age<1);\n    requestAnimationFrame(draw);\n  }\n  function plant(x=w*.5,y=h*.5){\n    ripples.push({x,y,age:0});\n    for(let i=0;i<8;i++)stars.push({x:x+(Math.random()-.5)*35,y:y+(Math.random()-.5)*35,r:.5+Math.random()*2,p:Math.random()*6,a:.8,hue:200+Math.random()*80});\n  }\n  addEventListener('resize',resize);\n  density.addEventListener('input',updateLabels);drift.addEventListener('input',()=>{mOut.value=drift.value;status.textContent=`별 ${density.value}개 · 움직임 ${drift.value}%`});\n  document.getElementById('seed').onclick=()=>plant();\n  document.getElementById('clear').onclick=()=>{ripples=[];stars=[];status.textContent='고요한 빈 공간 · 다시 심을 수 있습니다'};\n  canvas.addEventListener('pointerdown',e=>plant(e.clientX,e.clientY));\n  addEventListener('keydown',e=>{\n    if(e.key==='Enter')plant();\n    if(e.key===' '){e.preventDefault();paused=!paused;status.textContent=paused?'일시정지됨 · Space로 재생':'재생 중';}\n    if(e.key==='Escape'){ripples=[];stars=[];status.textContent='고요한 빈 공간 · 다시 심을 수 있습니다'}\n  });\n  resize();draw();\n})();\n</script>\n</body>\n</html>",
