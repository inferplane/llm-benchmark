{
  "text": "<!doctype html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"dark\">\n<title>gpt-5.6-terra — 살아 있는 지층</title>\n<style>\n  :root {\n    --ink: #eef3df;\n    --muted: #b9c5ae;\n    --paper: #101912;\n    --panel: rgba(15, 27, 18, .82);\n    --line: rgba(220, 239, 188, .24);\n    --focus: #f6db76;\n  }\n\n  * { box-sizing: border-box; }\n  html, body { margin: 0; min-height: 100%; background: var(--paper); }\n  body {\n    overflow: hidden;\n    color: var(--ink);\n    font-family: ui-monospace, \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace;\n  }\n\n  main, canvas { position: fixed; inset: 0; }\n  canvas { width: 100%; height: 100%; display: block; touch-action: none; }\n\n  .grain {\n    pointer-events: none;\n    position: fixed;\n    inset: 0;\n    opacity: .11;\n    mix-blend-mode: screen;\n    background-image:\n      radial-gradient(circle at 20% 30%, #fff 0 1px, transparent 1.4px),\n      radial-gradient(circle at 78% 65%, #fff 0 .7px, transparent 1.1px);\n    background-size: 7px 9px, 11px 13px;\n  }\n\n  header {\n    position: fixed;\n    z-index: 2;\n    top: clamp(1rem, 3vw, 2.2rem);\n    left: clamp(1rem, 4vw, 4rem);\n    right: clamp(1rem, 4vw, 4rem);\n    display: flex;\n    justify-content: space-between;\n    gap: 1rem;\n    align-items: flex-start;\n    pointer-events: none;\n  }\n\n  .identity { max-width: 38rem; }\n  .eyebrow {\n    margin: 0 0 .7rem;\n    color: #d7ed9a;\n    letter-spacing: .14em;\n    font-size: clamp(.68rem, 1.3vw, .82rem);\n    text-transform: uppercase;\n  }\n  h1 {\n    margin: 0;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: clamp(2rem, 6.8vw, 6.4rem);\n    font-weight: 400;\n    letter-spacing: -.065em;\n    line-height: .83;\n    text-shadow: 0 2px 18px #000;\n  }\n  .model {\n    display: inline-block;\n    margin-top: .9rem;\n    padding: .32rem .55rem;\n    border: 1px solid var(--line);\n    color: #e7f5c4;\n    background: rgba(10, 18, 11, .47);\n    font-size: clamp(.7rem, 1.5vw, .86rem);\n  }\n  .status {\n    color: var(--muted);\n    text-align: right;\n    line-height: 1.55;\n    font-size: clamp(.69rem, 1.4vw, .82rem);\n  }\n  .status strong { color: #e5f2bd; font-weight: 500; }\n\n  .controls {\n    position: fixed;\n    z-index: 3;\n    right: clamp(1rem, 4vw, 4rem);\n    bottom: clamp(1rem, 4vw, 3rem);\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: flex-end;\n    gap: .5rem;\n    max-width: min(31rem, calc(100vw - 2rem));\n  }\n  button {\n    appearance: none;\n    border: 1px solid var(--line);\n    border-radius: 999px;\n    background: var(--panel);\n    color: var(--ink);\n    font: inherit;\n    font-size: .76rem;\n    padding: .62rem .82rem;\n    cursor: pointer;\n    backdrop-filter: blur(8px);\n  }\n  button:hover { background: #283b25; border-color: rgba(233, 248, 180, .62); }\n  button[aria-pressed=\"true\"] { color: #182014; background: #ddec9b; border-color: #ddec9b; }\n  button:focus-visible {\n    outline: 3px solid var(--focus);\n    outline-offset: 3px;\n  }\n\n  .instruction {\n    position: fixed;\n    z-index: 2;\n    left: clamp(1rem, 4vw, 4rem);\n    bottom: clamp(1rem, 4vw, 3rem);\n    max-width: 30rem;\n    margin: 0;\n    color: var(--muted);\n    font-size: clamp(.72rem, 1.55vw, .88rem);\n    line-height: 1.6;\n    text-shadow: 0 1px 6px #000;\n  }\n  kbd {\n    border: 1px solid var(--line);\n    border-radius: .2rem;\n    padding: .05rem .28rem;\n    color: #eaf5cf;\n    background: rgba(0,0,0,.35);\n    font-family: inherit;\n    font-size: .9em;\n  }\n\n  .sr-only {\n    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;\n    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;\n  }\n\n  @media (max-width: 560px) {\n    header { flex-direction: column; gap: .8rem; }\n    .status { text-align: left; }\n    .instruction { bottom: 5rem; max-width: calc(100vw - 2rem); }\n    .controls { left: 1rem; justify-content: flex-start; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .grain { display: none; }\n  }\n</style>\n</head>\n<body>\n<main aria-labelledby=\"title\">\n  <canvas id=\"terra\" aria-label=\"손가락 또는 포인터로 지층에 파문을 남길 수 있는 추상 지구 풍경\"></canvas>\n  <div class=\"grain\" aria-hidden=\"true\"></div>\n\n  <header>\n    <div class=\"identity\">\n      <p class=\"eyebrow\">A procedural self-portrait / 01</p>\n      <h1 id=\"title\">살아 있는<br>지층</h1>\n      <span class=\"model\">gpt-5.6-terra</span>\n    </div>\n    <div class=\"status\" aria-live=\"polite\">\n      <strong id=\"depth\">DEPTH 000 m</strong><br>\n      <span id=\"state\">관측 중 · 느린 호흡</span>\n    </div>\n  </header>\n\n  <p class=\"instruction\">\n    화면을 <strong>누르거나 드래그</strong>하여 새로운 지층을 심으세요.<br>\n    <kbd>Space</kbd> 멈춤 · <kbd>R</kbd> 새 지형 · <kbd>M</kbd> 움직임 감소\n  </p>\n\n  <div class=\"controls\" aria-label=\"작품 제어\">\n    <button id=\"pause\" type=\"button\" aria-pressed=\"false\">일시정지</button>\n    <button id=\"motion\" type=\"button\" aria-pressed=\"false\">움직임 감소</button>\n    <button id=\"renew\" type=\"button\">새 지형</button>\n  </div>\n  <p class=\"sr-only\" id=\"announce\" aria-live=\"polite\"></p>\n</main>\n\n<script>\n(() => {\n  const canvas = document.getElementById('terra');\n  const ctx = canvas.getContext('2d', { alpha: false });\n  const depthEl = document.getElementById('depth');\n  const stateEl = document.getElementById('state');\n  const announce = document.getElementById('announce');\n  const pauseBtn = document.getElementById('pause');\n  const motionBtn = document.getElementById('motion');\n  const renewBtn = document.getElementById('renew');\n\n  let w, h, dpr, time = 0, running = true;\n  let reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;\n  let ridges = [], wells = [], seed = Math.random() * 9999;\n\n  const palette = [\n    ['#101a13', '#193123', '#31553a'],\n    ['#132218', '#285038', '#63783e'],\n    ['#182016', '#4e562b', '#a3833d'],\n    ['#241d16', '#693b26', '#c87942'],\n    ['#281b18', '#743b39', '#d26d51'],\n    ['#201c24', '#493c62', '#a77aac'],\n    ['#13212a', '#27606a', '#a3bca4']\n  ];\n\n  function rand(n) {\n    const x = Math.sin(n * 12.9898 + seed * 78.233) * 43758.5453;\n    return x - Math.floor(x);\n  }\n\n  function resize() {\n    dpr = Math.min(devicePixelRatio || 1, 2);\n    w = innerWidth; h = innerHeight;\n    canvas.width = Math.round(w * dpr);\n    canvas.height = Math.round(h * dpr);\n    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n    build();\n  }\n\n  function build() {\n    const count = Math.max(12, Math.min(25, Math.round(h / 42)));\n    ridges = Array.from({length: count}, (_, i) => ({\n      y: h * (.18 + i / (count - 1) * .78),\n      amp: 15 + rand(i + 30) * 48,\n      freq: .005 + rand(i + 60) * .012,\n      phase: rand(i + 90) * 20,\n      drift: .12 + rand(i + 120) * .55,\n      color: palette[i % palette.length],\n      thick: 1 + rand(i + 150) * 2.5\n    }));\n    wells = [];\n  }\n\n  function curveY(r, x, t) {\n    let y = r.y;\n    y += Math.sin(x * r.freq + r.phase + t * r.drift) * r.amp;\n    y += Math.sin(x * r.freq * 2.41 - r.phase + t * .21) * r.amp * .22;\n    y += Math.sin(x * .0021 + r.phase * 5) * r.amp * .45;\n    for (const q of wells) {\n      const dx = x - q.x;\n      const dist = Math.abs(dx) / q.radius;\n      if (dist < 1) y += Math.cos(dist * Math.PI / 2) * q.force * Math.sin((dist * 7) - t * 2);\n    }\n    return y;\n  }\n\n  function draw() {\n    const t = reduced ? 0 : time;\n    const bg = ctx.createLinearGradient(0, 0, 0, h);\n    bg.addColorStop(0, '#0c1711');\n    bg.addColorStop(.48, '#142519');\n    bg.addColorStop(1, '#090e0b');\n    ctx.fillStyle = bg;\n    ctx.fillRect(0, 0, w, h);\n\n    // atmospheric sun / core\n    const glow = ctx.createRadialGradient(w * .72, h * .25, 0, w * .72, h * .25, Math.max(w, h) * .55);\n    glow.addColorStop(0, 'rgba(187, 203, 103, .16)');\n    glow.addColorStop(.45, 'rgba(93, 129, 70, .05)');\n    glow.addColorStop(1, 'rgba(0,0,0,0)');\n    ctx.fillStyle = glow; ctx.fillRect(0, 0, w, h);\n\n    ridges.forEach((r, i) => {\n      const next = ridges[i + 1];\n      ctx.beginPath();\n      ctx.moveTo(-4, curveY(r, -4, t));\n      for (let x = 0; x <= w + 8; x += 8) ctx.lineTo(x, curveY(r, x, t));\n      if (next) {\n        for (let x = w + 8; x >= -4; x -= 8) ctx.lineTo(x, curveY(next, x, t));\n      } else {\n        ctx.lineTo(w + 8, h + 4); ctx.lineTo(-4, h + 4);\n      }\n      const fill = ctx.createLinearGradient(0, r.y - 60, 0, r.y + 100);\n      fill.addColorStop(0, r.color[0]);\n      fill.addColorStop(.5, r.color[1]);\n      fill.addColorStop(1, r.color[2]);\n      ctx.globalAlpha = .72;\n      ctx.fillStyle = fill;\n      ctx.fill();\n\n      ctx.beginPath();\n      ctx.moveTo(-4, curveY(r, -4, t));\n      for (let x = 0; x <= w + 8; x += 5) ctx.lineTo(x, curveY(r, x, t));\n      ctx.globalAlpha = .35 + (i % 3) * .08;\n      ctx.strokeStyle = i % 2 ? '#d9e5a3' : '#f0ae6b';\n      ctx.lineWidth = r.thick;\n      ctx.stroke();\n    });\n\n    // root-like fine data lines\n    ctx.globalAlpha = .12;\n    ctx.strokeStyle = '#d9f0b8';\n    ctx.lineWidth = 1;\n    for (let j = 0; j < 8; j++) {\n      ctx.beginPath();\n      const x0 = (j / 7) * w;\n      ctx.moveTo(x0, 0);\n      for (let y = 0; y < h; y += 12) {\n        const x = x0 + Math.sin(y * .018 + j * 7 + t) * (13 + j * 3);\n        ctx.lineTo(x, y);\n      }\n      ctx.stroke();\n    }\n    ctx.globalAlpha = 1;\n\n    wells = wells.filter(q => {\n      q.life -= reduced ? .007 : .012;\n      q.force *= .994;\n      return q.life > 0;\n    });\n\n    const depth = Math.round((Math.sin(t * .16) * .5 + .5) * 936);\n    depthEl.textContent = `DEPTH ${String(depth).padStart(3, '0')} m`;\n  }\n\n  function frame() {\n    if (running) {\n      time += reduced ? .003 : .012;\n      draw();\n    }\n    requestAnimationFrame(frame);\n  }\n\n  function plant(x, y) {\n    wells.push({ x, y, radius: Math.max(100, w * .17), force: 24 + Math.random() * 35, life: 1 });\n    if (wells.length > 8) wells.shift();\n    stateEl.textContent = '새로운 퇴적 · 파문 확산 중';\n    announce.textContent = '새로운 지층 파문을 만들었습니다.';\n    draw();\n  }\n\n  canvas.addEventListener('pointerdown', e => {\n    canvas.setPointerCapture?.(e.pointerId);\n    plant(e.clientX, e.clientY);\n  });\n  canvas.addEventListener('pointermove', e => {\n    if (e.buttons && !reduced) plant(e.clientX, e.clientY);\n  });\n\n  function togglePause() {\n    running = !running;\n    pauseBtn.setAttribute('aria-pressed', String(!running));\n    pauseBtn.textContent = running ? '일시정지' : '재생';\n    stateEl.textContent = running ? '관측 중 · 느린 호흡' : '시간 정지 · 지층 보존';\n    announce.textContent = running ? '작품을 재생합니다.' : '작품을 일시정지했습니다.';\n    if (running) draw();\n  }\n  function toggleMotion() {\n    reduced = !reduced;\n    motionBtn.setAttribute('aria-pressed', String(reduced));\n    motionBtn.textContent = reduced ? '움직임 최소화됨' : '움직임 감소';\n    stateEl.textContent = reduced ? '고요한 단면 · 움직임 최소화' : '관측 중 · 느린 호흡';\n    announce.textContent = reduced ? '움직임을 줄였습니다.' : '일반 움직임을 복원했습니다.';\n    draw();\n  }\n  function renew() {\n    seed = Math.random() * 9999;\n    build(); draw();\n    stateEl.textContent = '새로운 지질 연대 생성';\n    announce.textContent = '새 지형을 생성했습니다.';\n  }\n\n  pauseBtn.addEventListener('click', togglePause);\n  motionBtn.addEventListener('click', toggleMotion);\n  renewBtn.addEventListener('click', renew);\n  addEventListener('keydown', e => {\n    if (e.target.matches('button')) return;\n    if (e.code === 'Space') { e.preventDefault(); togglePause(); }\n    if (e.key.toLowerCase() === 'm') toggleMotion();\n    if (e.key.toLowerCase() === 'r') renew();\n  });\n  addEventListener('resize', resize);\n\n  motionBtn.setAttribute('aria-pressed', String(reduced));\n  if (reduced) motionBtn.textContent = '움직임 최소화됨';\n  resize();\n  draw();\n  requestAnimationFrame(frame);\n})();\n</script>\n</body>\n</html>",
