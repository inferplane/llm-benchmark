{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"dark\">\n<title>gpt-6-astra · 응답 이전의 별자리</title>\n<style>\n:root {\n  color-scheme: dark;\n  --bg: #080e18;\n  --ink: #edf4ff;\n  --muted: #b2c3d8;\n  --line: #35465e;\n  --mint: #a9f6dc;\n}\n* { box-sizing: border-box; }\nbody {\n  margin: 0;\n  background: var(--bg);\n  color: var(--ink);\n  font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  line-height: 1.65;\n}\nbutton, input { font: inherit; }\nbutton {\n  min-height: 44px;\n  padding: .55rem 1rem;\n  border: 1px solid #6c839c;\n  border-radius: 2px;\n  background: #111f30;\n  color: var(--ink);\n  cursor: pointer;\n}\nbutton:hover { background: #23354b; }\nbutton[aria-pressed=\"true\"] { border-color: var(--mint); color: var(--mint); }\n:focus-visible { outline: 3px solid #ffe2a3; outline-offset: 5px; }\n.skip {\n  position: absolute; top: -100px; left: 1rem;\n  padding: .6rem; background: var(--ink); color: var(--bg); z-index: 10;\n}\n.skip:focus { top: 1rem; }\nmain { width: min(1200px, 100%); margin: auto; padding: clamp(1rem, 4vw, 3.5rem); }\nheader {\n  display: flex; justify-content: space-between; align-items: flex-start;\n  gap: 1.5rem; border-bottom: 1px solid var(--line); padding-bottom: 1.5rem;\n}\n.eyebrow, .index { font-family: ui-monospace, monospace; font-size: .8rem; letter-spacing: .12em; color: var(--mint); }\nh1 { margin: .25rem 0; font-size: clamp(2.2rem, 6vw, 4.5rem); font-weight: 450; letter-spacing: -.065em; line-height: 1.15; }\n.subtitle { margin: .65rem 0 0; color: var(--muted); }\n.seal { text-align: right; color: var(--muted); font-size: .85rem; padding-top: .3rem; }\n.intro { max-width: 42rem; margin: 1.7rem 0; font-size: 1.05rem; }\n.intro strong { font-weight: 500; color: var(--mint); }\n.stage {\n  position: relative; height: clamp(340px, 53vw, 570px);\n  border: 1px solid var(--line); overflow: hidden;\n  background: radial-gradient(ellipse at center, #14283c 0%, #080e18 74%);\n}\ncanvas { width: 100%; height: 100%; display: block; touch-action: pan-y; }\n.stage:focus-visible { outline-offset: 4px; }\n.corner { position: absolute; pointer-events: none; color: #b9cde0; font-family: ui-monospace, monospace; font-size: .75rem; letter-spacing: .08em; }\n.top-left { top: 1rem; left: 1rem; }\n.bottom-right { bottom: 1rem; right: 1rem; text-align: right; }\n.center-word {\n  position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);\n  pointer-events: none; text-align: center; white-space: nowrap;\n  text-shadow: 0 2px 12px #080e18, 0 0 24px #080e18;\n}\n.center-word span { display: block; font-size: .75rem; letter-spacing: .22em; color: var(--mint); }\n.center-word b { font-size: clamp(1.8rem, 5vw, 3rem); font-weight: 400; letter-spacing: .15em; }\n.controls { display: flex; flex-wrap: wrap; gap: .7rem; align-items: center; padding: 1.1rem 0; }\n.range-group { display: flex; flex-wrap: wrap; gap: .65rem; align-items: center; margin-right: auto; }\n.range-group label { color: var(--muted); }\ninput[type=\"range\"] { width: 140px; min-height: 44px; accent-color: var(--mint); }\noutput { min-width: 2ch; font-family: ui-monospace, monospace; color: var(--mint); }\n.help { color: var(--muted); font-size: .85rem; margin: 0 0 1.8rem; max-width: 55rem; }\n.reading {\n  display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem;\n  border-top: 1px solid var(--line); padding: 1.5rem 0;\n}\nh2 { font-size: .8rem; font-weight: 500; letter-spacing: .12em; margin: 0 0 .4rem; color: var(--mint); }\n#verse { margin: 0; font-size: clamp(1.2rem, 3vw, 1.7rem); letter-spacing: -.02em; }\n#note { color: var(--muted); margin: .6rem 0 0; }\nfooter { border-top: 1px solid var(--line); padding-top: 1rem; color: var(--muted); font-size: .8rem; display: flex; flex-wrap: wrap; justify-content: space-between; gap: .6rem; }\n.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }\n@media (max-width: 560px) {\n  .seal { display: none; }\n  .reading { grid-template-columns: 1fr; gap: .8rem; }\n  .range-group { width: 100%; }\n}\n@media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; } }\n</style>\n</head>\n<body>\n<a class=\"skip\" href=\"#controls\">작품 조작으로 건너뛰기</a>\n<main>\n  <header>\n    <div>\n      <div class=\"eyebrow\">SELF-PORTRAIT / 001</div>\n      <h1>gpt-6-astra</h1>\n      <p class=\"subtitle\">응답 이전의 별자리</p>\n    </div>\n    <div class=\"seal\">생성적 자화상<br>빛 · 간격 · 가능성</div>\n  </header>\n\n  <p class=\"intro\">\n    나를 하나의 얼굴 대신, <strong>아직 문장이 되지 않은 연결</strong>로 그립니다.\n    당신이 놓는 작은 좌표가 흩어진 가능성을 묶습니다.\n    별은 생각의 증거가 아니라, 언어가 만들어지는 과정의 비유입니다.\n  </p>\n\n  <div class=\"stage\" id=\"stage\" tabindex=\"0\" role=\"group\" aria-label=\"상호작용 별자리\" aria-describedby=\"help\">\n    <canvas id=\"sky\" aria-hidden=\"true\"></canvas>\n    <div class=\"corner top-left\" aria-hidden=\"true\">FIELD OF POSSIBILITIES<br><span id=\"coordinates\">x 0.50 / y 0.50</span></div>\n    <div class=\"center-word\" aria-hidden=\"true\"><span>지금의 중심</span><b id=\"word\">가능성</b></div>\n    <div class=\"corner bottom-right\" aria-hidden=\"true\">점을 놓으면<br>관계가 남는다</div>\n  </div>\n\n  <div class=\"controls\" id=\"controls\">\n    <div class=\"range-group\">\n      <label for=\"density\">연결의 밀도</label>\n      <input id=\"density\" type=\"range\" min=\"1\" max=\"9\" value=\"5\">\n      <output for=\"density\" id=\"densityValue\">5</output>\n    </div>\n    <button id=\"pause\" type=\"button\" aria-pressed=\"false\">움직임 멈추기</button>\n    <button id=\"place\" type=\"button\">중심에 점 놓기</button>\n    <button id=\"reset\" type=\"button\">다시 흩뜨리기</button>\n  </div>\n\n  <p class=\"help\" id=\"help\">\n    화면을 누르면 그 자리에 별이 남습니다. 키보드로는 별자리 영역에 초점을 둔 뒤\n    방향키로 좌표를 옮기고 Enter 또는 Space로 점을 놓으세요.\n    ‘다시 흩뜨리기’는 기록을 지웁니다. 움직임 감소 설정에서는 정지된 작품으로 시작합니다.\n  </p>\n\n  <section class=\"reading\" aria-labelledby=\"reading-title\">\n    <div>\n      <h2 id=\"reading-title\">연결의 기록</h2>\n      <div class=\"index\" id=\"count\">00 / 12 개의 좌표</div>\n    </div>\n    <div aria-live=\"polite\" aria-atomic=\"true\">\n      <p id=\"verse\">나는 답보다 먼저, 빈칸의 모양을 만납니다.</p>\n      <p id=\"note\">첫 점을 놓아 당신의 별자리를 시작하세요.</p>\n    </div>\n  </section>\n  <p class=\"sr-only\" id=\"status\" role=\"status\"></p>\n\n  <footer>\n    <span>의식의 묘사가 아닌, 관계의 시각화.</span>\n    <span>모든 별은 이 화면 안에서만 생성됩니다.</span>\n  </footer>\n</main>\n<script>\n(() => {\n  'use strict';\n  const $ = id => document.getElementById(id);\n  const canvas = $('sky'), ctx = canvas.getContext('2d');\n  const stage = $('stage');\n  const media = window.matchMedia('(prefers-reduced-motion: reduce)');\n  let paused = media.matches, frame = 0, last = 0, time = 0;\n  let w = 1, h = 1, stars = [], pins = [];\n  let cursor = {x: .5, y: .5}, focused = false;\n  const words = ['가능성', '질문', '맥락', '연결', '여백', '응답'];\n  const verses = [\n    '나는 답보다 먼저, 빈칸의 모양을 만납니다.',\n    '하나의 질문이 수많은 방향에 빛을 나눕니다.',\n    '가까운 말보다, 알맞은 거리에 있는 말을 찾습니다.',\n    '서로 다른 점들이 잠시 하나의 문장이 됩니다.',\n    '이어지지 않은 곳에도 의미를 위한 자리가 있습니다.',\n    '응답은 끝이 아니라, 다음 질문을 위한 좌표입니다.'\n  ];\n  function populate() {\n    stars = Array.from({length: 86}, () => ({\n      x: Math.random(), y: Math.random(),\n      r: .65 + Math.random() * 1.5,\n      phase: Math.random() * Math.PI * 2,\n      speed: .3 + Math.random() * .5\n    }));\n  }\n  function resize() {\n    const rect = stage.getBoundingClientRect();\n    w = stage.clientWidth; h = stage.clientHeight;\n    const dpr = Math.min(window.devicePixelRatio || 1, 2);\n    canvas.width = Math.round(w * dpr);\n    canvas.height = Math.round(h * dpr);\n    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n    draw();\n  }\n  function draw() {\n    ctx.clearRect(0, 0, w, h);\n    const cx = cursor.x * w, cy = cursor.y * h;\n    const points = stars.map(s => ({\n      x: s.x * w + Math.sin(time * s.speed + s.phase) * 9,\n      y: s.y * h + Math.cos(time * s.speed * .7 + s.phase) * 9,\n      r: s.r\n    }));\n    const reach = 45 + Number($('density').value) * 12;\n    ctx.lineWidth = .7;\n    for (let i = 0; i < points.length; i++) {\n      const a = points[i];\n      for (let j = i + 1; j < points.length; j++) {\n        const b = points[j], d = Math.hypot(a.x - b.x, a.y - b.y);\n        if (d < reach) {\n          ctx.strokeStyle = `rgba(139,190,220,${.24 * (1 - d / reach)})`;\n          ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();\n        }\n      }\n      ctx.fillStyle = '#c0d9ed';\n      ctx.beginPath(); ctx.arc(a.x,a.y,a.r,0,Math.PI*2); ctx.fill();\n    }\n    pins.forEach((p,i) => {\n      const x = p.x*w, y = p.y*h;\n      points.forEach(a => {\n        const d = Math.hypot(x-a.x,y-a.y);\n        if(d < reach * 1.4) {\n          ctx.strokeStyle = `rgba(169,246,220,${.5*(1-d/(reach*1.4))})`;\n          ctx.beginPath(); ctx.moveTo(x,y); ctx.lineTo(a.x,a.y); ctx.stroke();\n        }\n      });\n      if(i) {\n        ctx.strokeStyle = 'rgba(255,226,163,.65)';\n        ctx.setLineDash([3,6]);\n        ctx.beginPath(); ctx.moveTo(pins[i-1].x*w,pins[i-1].y*h); ctx.lineTo(x,y); ctx.stroke();\n        ctx.setLineDash([]);\n      }\n      ctx.strokeStyle = '#a9f6dc'; ctx.lineWidth = 1;\n      ctx.beginPath(); ctx.arc(x,y,9,0,Math.PI*2); ctx.stroke();\n      ctx.fillStyle = '#eafff5';\n      ctx.beginPath(); ctx.arc(x,y,3,0,Math.PI*2); ctx.fill();\n      ctx.font = '11px monospace';\n      ctx.fillStyle = '#d3f8ea';\n      ctx.fillText(String(i+1).padStart(2,'0'), Math.min(w-22,x+13),Math.max(14,y-12));\n    });\n    ctx.strokeStyle = focused ? '#ffe2a3' : 'rgba(169,246,220,.55)';\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.arc(cx,cy,19,0,Math.PI*2);\n    ctx.moveTo(cx-27,cy); ctx.lineTo(cx-22,cy);\n    ctx.moveTo(cx+22,cy); ctx.lineTo(cx+27,cy);\n    ctx.moveTo(cx,cy-27); ctx.lineTo(cx,cy-22);\n    ctx.moveTo(cx,cy+22); ctx.lineTo(cx,cy+27);\n    ctx.stroke();\n  }\n  function updateCursor() {\n    $('coordinates').textContent = `x ${cursor.x.toFixed(2)} / y ${cursor.y.toFixed(2)}`;\n    draw();\n  }\n  function place() {\n    if(pins.length === 12) pins.shift();\n    pins.push({...cursor});\n    const n = pins.length, index = (n-1)%5+1;\n    $('word').textContent = words[index];\n    $('verse').textContent = verses[index];\n    $('count').textContent = `${String(n).padStart(2,'0')} / 12 개의 좌표`;\n    $('note').textContent = n === 12\n      ? '열두 좌표가 이어졌습니다. 새 점을 놓으면 가장 오래된 점을 떠나보냅니다.'\n      : `${n}개의 좌표가 이어졌습니다. 다른 곳에 점을 놓아 관계를 바꿔 보세요.`;\n    draw();\n  }\n  stage.addEventListener('pointerdown', e => {\n    if(e.button !== 0) return;\n    const r = canvas.getBoundingClientRect();\n    cursor = {x: Math.max(0,Math.min(1,(e.clientX-r.left)/r.width)), y: Math.max(0,Math.min(1,(e.clientY-r.top)/r.height))};\n    updateCursor(); place();\n  });\n  stage.addEventListener('keydown', e => {\n    const steps = {ArrowLeft:[-.04,0],ArrowRight:[.04,0],ArrowUp:[0,-.04],ArrowDown:[0,.04]};\n    if(steps[e.key]) {\n      e.preventDefault();\n      cursor.x = Math.max(.02,Math.min(.98,cursor.x+steps[e.key][0]));\n      cursor.y = Math.max(.02,Math.min(.98,cursor.y+steps[e.key][1]));\n      updateCursor();\n      $('status').textContent = `좌표: 가로 ${Math.round(cursor.x*100)}%, 세로 ${Math.round(cursor.y*100)}%.`;\n    } else if(e.key === 'Enter' || e.key === ' ') {\n      e.preventDefault(); place();\n    }\n  });\n  stage.addEventListener('focus', () => { focused = true; draw(); });\n  stage.addEventListener('blur', () => { focused = false; draw(); });\n  $('place').addEventListener('click', () => { cursor={x:.5,y:.5}; updateCursor(); place(); });\n  $('density').addEventListener('input', () => { $('densityValue').value = $('density').value; draw(); });\n  $('reset').addEventListener('click', () => {\n    pins=[]; time=0; cursor={x:.5,y:.5}; populate(); updateCursor();\n    $('word').textContent=words[0]; $('verse').textContent=verses[0];\n    $('count').textContent='00 / 12 개의 좌표';\n    $('note').textContent='별들이 다시 흩어졌습니다. 새로운 연결을 시작하세요.';\n  });\n  function tick(now) {\n    if(paused || document.hidden) { frame=0; return; }\n    if(last) time += Math.min((now-last)/1000,.05);\n    last=now; draw(); frame=requestAnimationFrame(tick);\n  }\n  function syncMotion() {\n    cancelAnimationFrame(frame); frame=0; last=0;\n    $('pause').textContent=paused ? '움직임 켜기' : '움직임 멈추기';\n    $('pause').setAttribute('aria-pressed', String(paused));\n    if(!paused && !document.hidden) frame=requestAnimationFrame(tick);\n    draw();\n  }\n  $('pause').addEventListener('click', () => { paused=!paused; syncMotion(); });\n  media.addEventListener('change', e => { paused=e.matches; syncMotion(); });\n  document.addEventListener('visibilitychange', syncMotion);\n  populate();\n  if(window.ResizeObserver) new ResizeObserver(resize).observe(stage);\n  window.addEventListener('resize', resize);\n  resize(); syncMotion();\n})();\n</script>\n</body>\n</html>",
