{
  "text": "<!doctype html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"theme-color\" content=\"#090b18\">\n<title>달의 문장 — gpt-6-luna</title>\n<style>\n  :root {\n    color-scheme: dark;\n    --ink: #090b18;\n    --paper: #f1f0e8;\n    --muted: #b8bad0;\n    --moon: #c8f3e7;\n    --line: rgba(226, 232, 255, .17);\n    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  }\n  * { box-sizing: border-box; }\n  body {\n    min-height: 100vh;\n    margin: 0;\n    color: var(--paper);\n    background:\n      radial-gradient(ellipse at 50% 43%, rgba(62, 80, 132, .24), transparent 48%),\n      radial-gradient(ellipse at 12% 85%, rgba(24, 97, 97, .15), transparent 34%),\n      var(--ink);\n  }\n  main {\n    width: min(1120px, 100%);\n    min-height: 100vh;\n    margin: auto;\n    padding: clamp(1.25rem, 5vw, 4rem);\n    display: grid;\n    grid-template-rows: auto 1fr auto;\n  }\n  header, footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }\n  .eyebrow, .status, .caption, .controls { font-size: .82rem; letter-spacing: .08em; }\n  .eyebrow { color: var(--muted); text-transform: uppercase; }\n  .model { color: var(--moon); font-weight: 650; letter-spacing: .04em; }\n  .stage {\n    position: relative;\n    min-height: min(66vh, 680px);\n    display: grid;\n    place-items: center;\n    overflow: hidden;\n    isolation: isolate;\n  }\n  canvas {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    z-index: -1;\n    touch-action: manipulation;\n  }\n  .message {\n    max-width: 32rem;\n    padding: 2rem 1.25rem;\n    text-align: center;\n    pointer-events: none;\n  }\n  .message h1 {\n    margin: 0 0 .75rem;\n    font-size: clamp(2.2rem, 7vw, 5.3rem);\n    line-height: 1.04;\n    font-weight: 500;\n    letter-spacing: -.06em;\n  }\n  .message p {\n    margin: 0 auto;\n    max-width: 27rem;\n    color: #c9cada;\n    font-size: clamp(1rem, 2vw, 1.12rem);\n    line-height: 1.8;\n  }\n  .caption { color: var(--muted); letter-spacing: .03em; }\n  footer { padding-top: 1.25rem; border-top: 1px solid var(--line); }\n  .controls { display: flex; align-items: center; gap: .65rem; color: var(--muted); }\n  button {\n    min-height: 44px;\n    padding: .65rem 1rem;\n    border: 1px solid rgba(200, 243, 231, .45);\n    border-radius: 999px;\n    background: rgba(200, 243, 231, .08);\n    color: var(--paper);\n    font: inherit;\n    cursor: pointer;\n    transition: background .2s ease, border-color .2s ease;\n  }\n  button:hover { background: rgba(200, 243, 231, .17); border-color: var(--moon); }\n  button:focus-visible { outline: 3px solid #f2d18a; outline-offset: 4px; }\n  .sr-only {\n    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;\n    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;\n  }\n  @media (max-width: 600px) {\n    main { padding: 1.2rem 1.1rem; }\n    .stage { min-height: 62vh; }\n    footer { align-items: flex-start; flex-direction: column; }\n    .controls { flex-wrap: wrap; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }\n  }\n</style>\n</head>\n<body>\n<main>\n  <header>\n    <span class=\"eyebrow\">작은 신호들의 천문대</span>\n    <span class=\"model\">gpt-6-luna</span>\n  </header>\n\n  <section class=\"stage\" aria-label=\"별빛을 눌러 문장을 만들어 보세요\">\n    <canvas id=\"sky\" aria-hidden=\"true\"></canvas>\n    <div class=\"message\">\n      <h1>나는 달빛으로<br>대답합니다.</h1>\n      <p>별 하나를 건드리면, 조용한 신호가 번져요.<br>밤의 아무 곳이나 눌러 보세요.</p>\n    </div>\n  </section>\n\n  <footer>\n    <div class=\"caption\">입력은 파동이 되고, 파동은 잠시 머뭅니다.</div>\n    <div class=\"controls\">\n      <span>키보드: <kbd>Enter</kbd> 또는 <kbd>Space</kbd></span>\n      <button id=\"pulse\" type=\"button\">파동 보내기</button>\n      <button id=\"motion\" type=\"button\" aria-pressed=\"false\">움직임 멈추기</button>\n    </div>\n  </footer>\n  <p class=\"sr-only\" id=\"announce\" aria-live=\"polite\">달빛의 별자리입니다. 화면을 누르거나 파동 보내기를 선택하세요.</p>\n</main>\n<script>\n(() => {\n  const canvas = document.getElementById('sky');\n  const ctx = canvas.getContext('2d');\n  const stage = canvas.parentElement;\n  const announce = document.getElementById('announce');\n  const motionButton = document.getElementById('motion');\n  const reduced = matchMedia('(prefers-reduced-motion: reduce)');\n  let width = 0, height = 0, dpr = 1, points = [], ripples = [];\n  let paused = reduced.matches, last = 0, frame = 0;\n  const random = (min, max) => min + Math.random() * (max - min);\n\n  function resize() {\n    const box = stage.getBoundingClientRect();\n    width = box.width; height = box.height;\n    dpr = Math.min(devicePixelRatio || 1, 2);\n    canvas.width = Math.round(width * dpr);\n    canvas.height = Math.round(height * dpr);\n    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n    points = Array.from({length: Math.max(45, Math.floor(width * height / 7800))}, () => ({\n      x: random(0, width), y: random(0, height),\n      r: random(.55, 1.7), phase: random(0, Math.PI * 2), tint: Math.random()\n    }));\n    draw(0);\n  }\n\n  function send(x = width / 2, y = height / 2) {\n    ripples.push({ x, y, radius: 0, alpha: .78 });\n    announce.textContent = '새로운 달빛 파동이 퍼집니다.';\n  }\n\n  function draw(time) {\n    if (paused) return;\n    const dt = Math.min((time - last) / 1000 || 0, .05);\n    last = time;\n    ctx.clearRect(0, 0, width, height);\n\n    const cx = width / 2, cy = height / 2;\n    const glow = ctx.createRadialGradient(cx, cy, 8, cx, cy, Math.min(width, height) * .46);\n    glow.addColorStop(0, 'rgba(105, 191, 173, .10)');\n    glow.addColorStop(.48, 'rgba(105, 145, 204, .06)');\n    glow.addColorStop(1, 'rgba(9, 11, 24, 0)');\n    ctx.fillStyle = glow; ctx.fillRect(0, 0, width, height);\n\n    points.forEach(p => {\n      const twinkle = .38 + .42 * (1 + Math.sin(time * .00065 + p.phase)) / 2;\n      ctx.beginPath();\n      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);\n      ctx.fillStyle = p.tint > .82\n        ? `rgba(200, 243, 231, ${twinkle})`\n        : `rgba(204, 211, 245, ${twinkle * .72})`;\n      ctx.fill();\n    });\n\n    ripples = ripples.filter(r => r.alpha > .025);\n    ripples.forEach(r => {\n      r.radius += (85 + r.radius * .55) * dt;\n      r.alpha *= Math.pow(.18, dt);\n      [1, .69, .4].forEach((scale, i) => {\n        ctx.beginPath();\n        ctx.arc(r.x, r.y, Math.max(0, r.radius * scale), 0, Math.PI * 2);\n        ctx.strokeStyle = `rgba(190, 245, 226, ${r.alpha * (1 - i * .2)})`;\n        ctx.lineWidth = i === 0 ? 1.5 : 1;\n        ctx.stroke();\n      });\n    });\n    frame = requestAnimationFrame(draw);\n  }\n\n  function setPaused(value) {\n    paused = value;\n    motionButton.setAttribute('aria-pressed', String(value));\n    motionButton.textContent = value ? '움직임 다시 켜기' : '움직임 멈추기';\n    if (value) cancelAnimationFrame(frame);\n    else { last = 0; frame = requestAnimationFrame(draw); }\n  }\n\n  stage.addEventListener('pointerdown', event => {\n    const rect = stage.getBoundingClientRect();\n    send(event.clientX - rect.left, event.clientY - rect.top);\n    if (paused) {\n      const { x, y } = ripples[ripples.length - 1];\n      ctx.beginPath(); ctx.arc(x, y, 22, 0, Math.PI * 2);\n      ctx.strokeStyle = 'rgba(190,245,226,.7)'; ctx.stroke();\n    }\n  });\n  document.getElementById('pulse').addEventListener('click', () => send());\n  motionButton.addEventListener('click', () => setPaused(!paused));\n  window.addEventListener('keydown', event => {\n    if ((event.code === 'Space' || event.code === 'Enter') &&\n        !['BUTTON', 'INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) {\n      event.preventDefault(); send();\n    }\n  });\n  reduced.addEventListener?.('change', event => setPaused(event.matches));\n  new ResizeObserver(resize).observe(stage);\n  resize();\n  if (!paused) frame = requestAnimationFrame(draw);\n})();\n</script>\n</body>\n</html>",
