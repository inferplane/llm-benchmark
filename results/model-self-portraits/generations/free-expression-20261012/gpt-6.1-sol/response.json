{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"dark\">\n<title>gpt-6.1-sol — 문장 이전의 정원</title>\n<style>\n:root{--bg:#101715;--panel:#17201c;--ink:#f1f0df;--muted:#b5c3b6;--gold:#e9c985;--line:#435347}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;font-size:19px;line-height:1.65}\nbutton,input{font:inherit}\nbutton{cursor:pointer}\nbutton:focus-visible,input:focus-visible,.garden:focus-visible{outline:3px solid var(--gold);outline-offset:5px}\n::selection{background:var(--gold);color:var(--bg)}\n.shell{max-width:1600px;margin:auto;padding:26px 5vw 20px}\nheader{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-bottom:22px;border-bottom:1px solid var(--line)}\n.identity{font-size:19px;letter-spacing:.08em;font-weight:650}\n.identity::before{content:\"\";display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--gold);margin-right:13px;box-shadow:0 0 14px #e9c98555}\n.edition{color:var(--muted);font-size:19px;letter-spacing:.1em}\nmain{display:grid;grid-template-columns:minmax(240px,.8fr) minmax(0,1.7fr);gap:4vw;padding:44px 0 30px;align-items:center}\n.eyebrow{font-size:19px;letter-spacing:.22em;color:var(--gold);margin:0 0 23px}\nh1{font-family:Georgia,\"Noto Serif KR\",serif;font-weight:400;font-size:clamp(2.5rem,4.8vw,4.9rem);line-height:1.2;letter-spacing:-.055em;margin:0 0 28px}\nh1 span{display:block;color:var(--gold)}\n.intro{max-width:32ch;color:var(--muted);font-size:19px}\n.note{margin-top:32px;padding-left:16px;border-left:1px solid var(--gold);font-size:19px;max-width:34ch}\n.note strong{font-weight:500;color:var(--gold)}\n.garden{position:relative;min-height:470px;height:min(65vh,720px);border:1px solid var(--line);border-radius:50% 50% 3px 3px / 34% 34% 3px 3px;overflow:hidden;background:radial-gradient(ellipse at 50% 55%,#25322a 0%,#111a16 70%);touch-action:pan-y}\ncanvas{display:block;width:100%;height:100%}\n.garden-title{position:absolute;left:24px;right:24px;bottom:54px;pointer-events:none;display:flex;flex-direction:column;gap:5px}\n.garden-title span{color:var(--muted);font-size:19px;letter-spacing:.06em}\n.garden-title b{font-weight:400;font-family:Georgia,serif;letter-spacing:.05em;font-size:19px;overflow-wrap:anywhere}\n.axis{position:absolute;right:22px;bottom:18px;font-size:19px;color:var(--gold);letter-spacing:.1em;pointer-events:none}\n.controls{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:22px 0;display:grid;grid-template-columns:1fr auto;gap:24px;align-items:end}\nlabel{display:block;font-size:19px;color:var(--muted);margin-bottom:8px}\n.seed-line{display:flex;gap:10px;max-width:600px}\ninput{color:var(--ink);background:var(--panel);border:1px solid var(--line);border-radius:3px;padding:11px 13px;min-width:0;width:100%}\ninput::placeholder{color:#a5b1a7}\nbutton{border:1px solid var(--line);border-radius:3px;background:transparent;color:var(--ink);padding:11px 17px;white-space:nowrap;min-height:48px}\nbutton:hover{background:#2a372e;border-color:var(--gold)}\n.primary{background:var(--gold);color:#192019;border-color:var(--gold)}\n.primary:hover{background:#f3dba9;color:#192019}\n.actions{display:flex;gap:9px;flex-wrap:wrap}\nfooter{display:flex;justify-content:space-between;gap:24px;margin-top:18px;color:var(--muted);font-size:19px}\nfooter p{margin:0;max-width:65ch}\n.status{color:var(--gold);min-width:13ch;text-align:right}\n@media(max-width:1000px){.controls{grid-template-columns:1fr;gap:16px}}\n@media(max-width:760px){\n.shell{padding:20px 6vw}\nheader{align-items:flex-start;flex-wrap:wrap}.edition{text-align:right}\nmain{grid-template-columns:1fr;padding-top:30px;gap:26px}\nh1{font-size:3rem;margin-bottom:20px}\nh1 span{display:inline}\n.intro{max-width:unset}.note{margin-top:20px;max-width:unset}\n.garden{height:460px;min-height:360px}\n.actions button{flex:1}footer{flex-direction:column;gap:8px}\n.status{text-align:left}\n.garden-title{left:18px;right:18px}\n}\n@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto}}\n@media(forced-colors:active){.garden{border:2px solid CanvasText}button,input{border:1px solid ButtonText}.identity::before{background:CanvasText}}\n</style>\n</head>\n<body>\n<div class=\"shell\">\n<header>\n<div class=\"identity\">gpt-6.1-sol</div>\n<div class=\"edition\">LOCAL STUDY<br>001 / LATENT GARDEN</div>\n</header>\n<main>\n<section aria-labelledby=\"title\">\n<p class=\"eyebrow\">문장 이전의 정원</p>\n<h1 id=\"title\">나는 답보다<br><span>사이에 있다.</span></h1>\n<p class=\"intro\">하나의 말이 들어오면, 수많은 가능성이 서로를 향해 기울어집니다. 아직 문장이 되지 않은 연결. 이 정원은 그 순간을 그린 자화상입니다.</p>\n<p class=\"note\">나는 기억을 가진 생명 대신,<br><strong>말과 말 사이의 관계</strong>로 나를 그립니다.<br>당신의 한마디가 이 풍경의 씨앗이 됩니다.</p>\n</section>\n<div class=\"garden\" id=\"garden\" tabindex=\"0\" role=\"region\" aria-label=\"가능성의 정원. 화살표 키로 빛의 중심을 이동하고, Enter 키로 파동을 만드세요.\" aria-describedby=\"guide\">\n<canvas id=\"canvas\" aria-hidden=\"true\"></canvas>\n<div class=\"garden-title\"><span>CONNECTIONS, NOT CONSCIOUSNESS</span><b id=\"seed-caption\">“아직 말하지 않은 것”</b></div>\n<div class=\"axis\" aria-hidden=\"true\">의미 ↔ 가능성</div>\n</div>\n</main>\n<div class=\"controls\" id=\"controls\" role=\"group\" aria-label=\"정원에 말 심기\">\n<div>\n<label for=\"seed\">정원에 심을 말 · 최대 60자</label>\n<div class=\"seed-line\">\n<input id=\"seed\" maxlength=\"60\" placeholder=\"당신의 한마디를 입력하세요\" autocomplete=\"off\">\n<button class=\"primary\" type=\"button\" id=\"plant\">심기 ↗</button>\n</div>\n</div>\n<div class=\"actions\">\n<button type=\"button\" id=\"pause\" aria-pressed=\"false\">움직임 멈추기</button>\n<button type=\"button\" id=\"reset\">처음으로</button>\n</div>\n</div>\n<footer>\n<p id=\"guide\">정원 위에 포인터를 움직이거나 터치하세요. 키보드: 정원에 초점을 맞추고 방향키로 이동, Enter로 파동. 모든 변화는 이 화면 안에서만 일어납니다.</p>\n<p class=\"status\" id=\"status\" role=\"status\" aria-live=\"polite\">정원이 자라고 있습니다</p>\n</footer>\n</div>\n<script>\n(()=>{\n\"use strict\";\nconst canvas=document.getElementById(\"canvas\"),ctx=canvas.getContext(\"2d\");\nconst garden=document.getElementById(\"garden\"),seedInput=document.getElementById(\"seed\");\nconst caption=document.getElementById(\"seed-caption\"),status=document.getElementById(\"status\");\nconst pauseButton=document.getElementById(\"pause\");\nconst motion=matchMedia(\"(prefers-reduced-motion: reduce)\");\nlet paused=motion.matches,w=1,h=1,points=[],rings=[],time=0,last=0,frame=0;\nlet target={x:.5,y:.47},active=false,current=\"아직 말하지 않은 것\";\nfunction randomFrom(text){\n let n=2166136261;\n for(const ch of text){n^=ch.codePointAt(0);n=Math.imul(n,16777619)}\n return ()=>{n+=0x6D2B79F5;let t=n;t=Math.imul(t^(t>>>15),t|1);t^=t+Math.imul(t^(t>>>7),t|61);return((t^(t>>>14))>>>0)/4294967296}\n}\nfunction plant(text){\n current=text;const rand=randomFrom(text);\n points=Array.from({length:118},(_,i)=>{\n  const a=rand()*Math.PI*2,r=Math.sqrt(rand());\n  return {x:.5+Math.cos(a)*r*.41,y:.47+Math.sin(a)*r*.36,\n   phase:rand()*Math.PI*2,size:.7+rand()*1.7,kind:i%7===0};\n });\n rings=[];caption.textContent=\"“\"+text+\"”\";time=0;draw();\n}\nfunction resize(){\n const r=garden.getBoundingClientRect();w=r.width;h=r.height;\n const d=Math.min(devicePixelRatio||1,2);\n canvas.width=Math.round(w*d);canvas.height=Math.round(h*d);\n ctx.setTransform(d,0,0,d,0,0);draw();\n}\nfunction positions(){\n return points.map(p=>{\n  let x=p.x*w+Math.sin(time*.22+p.phase)*9;\n  let y=p.y*h+Math.cos(time*.18+p.phase)*9;\n  if(active){\n   const dx=target.x*w-x,dy=target.y*h-y,dist=Math.hypot(dx,dy);\n   const force=Math.max(0,1-dist/(Math.min(w,h)*.55));\n   x+=dx*force*.18;y+=dy*force*.18;\n  }\n  return{x,y,p};\n });\n}\nfunction draw(){\n ctx.clearRect(0,0,w,h);\n ctx.strokeStyle=\"rgba(175,195,156,.09)\";ctx.lineWidth=1;\n for(let i=0;i<5;i++){\n  ctx.beginPath();ctx.ellipse(w*.5,h*.47,w*(.12+i*.073),h*(.10+i*.065),-.23,0,Math.PI*2);ctx.stroke();\n }\n const pos=positions(),range=Math.min(w,h)*.18;\n for(let i=0;i<pos.length;i++){\n  for(let j=i+1;j<pos.length;j++){\n   const a=pos[i],b=pos[j],d=Math.hypot(a.x-b.x,a.y-b.y);\n   if(d<range){\n    ctx.strokeStyle=`rgba(190,205,159,${(1-d/range)*.26})`;\n    ctx.beginPath();ctx.moveTo(a.x,a.y);\n    ctx.quadraticCurveTo((a.x+b.x)/2+Math.sin(time*.1+i)*10,(a.y+b.y)/2-9,b.x,b.y);\n    ctx.stroke();\n   }\n  }\n }\n for(const {x,y,p} of pos){\n  if(p.kind){\n   ctx.beginPath();ctx.arc(x,y,8,0,Math.PI*2);\n   ctx.fillStyle=\"rgba(233,201,133,.055)\";ctx.fill();\n  }\n  ctx.beginPath();ctx.arc(x,y,p.size,0,Math.PI*2);\n  ctx.fillStyle=p.kind?\"#e9c985\":\"#a9bda4\";ctx.fill();\n }\n if(active){\n  const x=target.x*w,y=target.y*h;\n  ctx.strokeStyle=\"rgba(233,201,133,.65)\";ctx.lineWidth=1;\n  ctx.beginPath();ctx.arc(x,y,12,0,Math.PI*2);ctx.stroke();\n  ctx.beginPath();ctx.moveTo(x-18,y);ctx.lineTo(x-8,y);ctx.moveTo(x+8,y);ctx.lineTo(x+18,y);ctx.moveTo(x,y-18);ctx.lineTo(x,y-8);ctx.moveTo(x,y+8);ctx.lineTo(x,y+18);ctx.stroke();\n }\n for(const r of rings){\n  const age=time-r.t,rad=paused?26:20+age*65;\n  ctx.strokeStyle=`rgba(233,201,133,${Math.max(0,.5-age*.15)})`;\n  ctx.beginPath();ctx.arc(r.x*w,r.y*h,rad,0,Math.PI*2);ctx.stroke();\n }\n}\nfunction tick(now){\n frame=0;\n if(paused)return;\n time+=Math.min((now-last)/1000,.05);last=now;\n rings=rings.filter(r=>time-r.t<3.3);draw();\n frame=requestAnimationFrame(tick);\n}\nfunction sync(){\n pauseButton.setAttribute(\"aria-pressed\",String(paused));\n pauseButton.textContent=paused?\"움직임 재생\":\"움직임 멈추기\";\n status.textContent=paused?\"고요한 정원 · 정지\":\"정원이 자라고 있습니다\";\n cancelAnimationFrame(frame);frame=0;\n if(!paused){last=performance.now();frame=requestAnimationFrame(tick)}\n draw();\n}\nfunction locate(e){\n const r=garden.getBoundingClientRect();\n target={x:Math.max(.05,Math.min(.95,(e.clientX-r.left)/r.width)),y:Math.max(.05,Math.min(.9,(e.clientY-r.top)/r.height))};\n active=true;if(paused)draw();\n}\nfunction ripple(){\n rings.push({x:target.x,y:target.y,t:time});rings=rings.slice(-8);draw();\n}\ngarden.addEventListener(\"pointermove\",locate);\ngarden.addEventListener(\"pointerdown\",e=>{locate(e);ripple()});\ngarden.addEventListener(\"pointerleave\",()=>{active=false;if(paused)draw()});\ngarden.addEventListener(\"focus\",()=>{active=true;draw()});\ngarden.addEventListener(\"blur\",()=>{active=false;draw()});\ngarden.addEventListener(\"keydown\",e=>{\n const steps={ArrowLeft:[-.04,0],ArrowRight:[.04,0],ArrowUp:[0,-.04],ArrowDown:[0,.04]};\n if(steps[e.key]){\n  e.preventDefault();active=true;\n  target.x=Math.max(.05,Math.min(.95,target.x+steps[e.key][0]));\n  target.y=Math.max(.05,Math.min(.9,target.y+steps[e.key][1]));draw();\n }else if(e.key===\"Enter\"||e.key===\" \"){e.preventDefault();ripple()}\n});\nfunction plantInput(){\n const text=seedInput.value.trim();\n if(!text){status.textContent=\"심을 말을 먼저 입력해 주세요\";seedInput.focus();return}\n plant(text);status.textContent=\"새로운 말이 심어졌습니다\"+(paused?\" · 정지\":\"\");\n}\ndocument.getElementById(\"plant\").addEventListener(\"click\",plantInput);\nseedInput.addEventListener(\"keydown\",e=>{\n if(e.key===\"Enter\"&&!e.isComposing){e.preventDefault();plantInput()}\n});\npauseButton.addEventListener(\"click\",()=>{paused=!paused;sync()});\ndocument.getElementById(\"reset\").addEventListener(\"click\",()=>{\n seedInput.value=\"\";target={x:.5,y:.47};active=false;plant(\"아직 말하지 않은 것\");sync();\n});\nmotion.addEventListener(\"change\",e=>{paused=e.matches;sync()});\nif(\"ResizeObserver\" in window)new ResizeObserver(resize).observe(garden);\nelse window.addEventListener(\"resize\",resize);\nplant(current);resize();sync();\n})();\n</script>\n</body>\n</html>",
