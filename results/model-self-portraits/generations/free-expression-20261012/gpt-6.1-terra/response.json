{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>생각의 지형 — gpt-6.1-terra</title>\n<style>\n  :root {\n    color-scheme: dark;\n    --bg: #0b1110;\n    --ink: #ecf0df;\n    --muted: #b7c5b5;\n    --lime: #c9ee8c;\n    --line: rgba(220, 238, 204, .22);\n  }\n  * { box-sizing: border-box; }\n  html { min-height: 100%; }\n  body {\n    margin: 0;\n    min-height: 100vh;\n    background: var(--bg);\n    color: var(--ink);\n    font-family: system-ui, -apple-system, \"Segoe UI\", sans-serif;\n    line-height: 1.55;\n  }\n  button { font: inherit; }\n  button:focus-visible { outline: 3px solid #e2ffa9; outline-offset: 4px; }\n  .page {\n    width: min(100% - 2.5rem, 90rem);\n    margin: auto;\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n  }\n  header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 1rem;\n    padding: 1.4rem 0;\n    border-bottom: 1px solid var(--line);\n    font-size: .78rem;\n    letter-spacing: .12em;\n  }\n  .brand { color: var(--lime); font-weight: 700; }\n  .header-note { color: var(--muted); text-align: right; }\n  main { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 2.5rem 0; }\n  .intro {\n    display: grid;\n    grid-template-columns: 1fr minmax(15rem, 26rem);\n    gap: 1.5rem;\n    align-items: end;\n    margin-bottom: 1.5rem;\n  }\n  .eyebrow {\n    margin: 0 0 .65rem;\n    color: var(--lime);\n    font-size: .75rem;\n    font-weight: 700;\n    letter-spacing: .18em;\n  }\n  h1 {\n    margin: 0;\n    font-size: clamp(2.5rem, 6.8vw, 6.5rem);\n    font-weight: 500;\n    line-height: 1.05;\n    letter-spacing: -.06em;\n  }\n  .description { margin: 0; max-width: 28rem; color: var(--muted); font-size: .95rem; }\n  .art {\n    position: relative;\n    height: clamp(23rem, 52vw, 42rem);\n    overflow: hidden;\n    border: 1px solid var(--line);\n    background: #111b16;\n    isolation: isolate;\n  }\n  canvas { display: block; width: 100%; height: 100%; cursor: crosshair; }\n  .art-label {\n    pointer-events: none;\n    position: absolute;\n    left: 1.2rem;\n    top: 1rem;\n    color: #e5f3d6;\n    text-shadow: 0 1px 5px #07100a;\n    font-size: .72rem;\n    letter-spacing: .14em;\n  }\n  .art-index {\n    pointer-events: none;\n    position: absolute;\n    right: 1.2rem;\n    bottom: 1rem;\n    color: #d7e8ce;\n    text-shadow: 0 1px 5px #07100a;\n    font-size: .72rem;\n    letter-spacing: .12em;\n  }\n  .under {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 1.25rem;\n    padding-top: 1.15rem;\n  }\n  .hint { margin: 0; color: var(--muted); font-size: .88rem; }\n  .controls { display: flex; flex-wrap: wrap; gap: .6rem; }\n  button {\n    min-height: 2.75rem;\n    padding: .6rem 1rem;\n    color: var(--ink);\n    background: transparent;\n    border: 1px solid #859781;\n    cursor: pointer;\n  }\n  button:hover { background: #263629; border-color: var(--lime); }\n  button.primary { background: var(--lime); border-color: var(--lime); color: #11200f; font-weight: 700; }\n  button.primary:hover { background: #e1ffaf; }\n  footer {\n    display: flex;\n    justify-content: space-between;\n    gap: 1rem;\n    padding: 1.2rem 0;\n    border-top: 1px solid var(--line);\n    color: var(--muted);\n    font-size: .75rem;\n    letter-spacing: .04em;\n  }\n  @media (max-width: 650px) {\n    .page { width: min(100% - 1.5rem, 90rem); }\n    header { align-items: flex-start; }\n    .intro { grid-template-columns: 1fr; gap: 1rem; }\n    .art { height: 55vh; min-height: 20rem; max-height: 35rem; }\n    .under { align-items: flex-start; flex-direction: column; }\n    footer { flex-wrap: wrap; }\n  }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <header>\n    <span class=\"brand\">TERRA / 지형 실험실</span>\n    <span class=\"header-note\">MEDIA ART &nbsp;·&nbsp; 01</span>\n  </header>\n\n  <main>\n    <section aria-labelledby=\"title\">\n      <div class=\"intro\">\n        <div>\n          <p class=\"eyebrow\">A LANDSCAPE OF POSSIBILITY</p>\n          <h1 id=\"title\">생각의 지형</h1>\n        </div>\n        <p class=\"description\">나는 완성된 지도가 아니라, 질문을 만날 때마다 달라지는 지형입니다. 작은 점 하나가 주변의 선들을 움직이고 새로운 길을 만듭니다.</p>\n      </div>\n\n      <div class=\"art\" id=\"art\">\n        <canvas id=\"landscape\" aria-hidden=\"true\"></canvas>\n        <span class=\"art-label\">관계의 등고선 / RELATIONAL TOPOGRAPHY</span>\n        <span class=\"art-index\">● &nbsp;HERE, A THOUGHT</span>\n      </div>\n\n      <div class=\"under\">\n        <p class=\"hint\">화면을 누르거나 ‘생각 놓기’를 선택해 지형에 흔적을 남겨 보세요.</p>\n        <div class=\"controls\">\n          <button class=\"primary\" id=\"seed\" type=\"button\">생각 놓기</button>\n          <button id=\"reset\" type=\"button\">다시 그리기</button>\n          <button id=\"motion\" type=\"button\" aria-pressed=\"false\">움직임 일시정지</button>\n        </div>\n      </div>\n      <p id=\"status\" class=\"hint\" aria-live=\"polite\"></p>\n    </section>\n  </main>\n\n  <footer>\n    <span>SELF-PORTRAIT / gpt-6.1-terra</span>\n    <span>질문과 응답 사이의 풍경</span>\n  </footer>\n</div>\n\n<script>\n(() => {\n  const canvas = document.getElementById('landscape');\n  const art = document.getElementById('art');\n  const ctx = canvas.getContext('2d');\n  const status = document.getElementById('status');\n  const motionButton = document.getElementById('motion');\n  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');\n  let paused = reduced.matches;\n  let width = 0, height = 0, time = 0, last = 0, frame = 0;\n  let points = [];\n\n  function randomPoint() {\n    return {\n      x: .1 + Math.random() * .8,\n      y: .16 + Math.random() * .68,\n      strength: .7 + Math.random() * .65,\n      phase: Math.random() * Math.PI * 2\n    };\n  }\n\n  function reset() {\n    points = Array.from({length: 6}, randomPoint);\n    draw();\n  }\n\n  function resize() {\n    const rect = art.getBoundingClientRect();\n    width = rect.width;\n    height = rect.height;\n    const dpr = Math.min(window.devicePixelRatio || 1, 2);\n    canvas.width = Math.max(1, Math.round(width * dpr));\n    canvas.height = Math.max(1, Math.round(height * dpr));\n    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n    draw();\n  }\n\n  function draw() {\n    if (!width || !height) return;\n    const bg = ctx.createLinearGradient(0, 0, width, height);\n    bg.addColorStop(0, '#17271d');\n    bg.addColorStop(.55, '#101b16');\n    bg.addColorStop(1, '#1b2a20');\n    ctx.fillStyle = bg;\n    ctx.fillRect(0, 0, width, height);\n\n    const glow = ctx.createRadialGradient(width * .53, height * .48, 0, width * .53, height * .48, width * .62);\n    glow.addColorStop(0, 'rgba(109,145,77,.19)');\n    glow.addColorStop(1, 'rgba(10,19,14,0)');\n    ctx.fillStyle = glow;\n    ctx.fillRect(0, 0, width, height);\n\n    const spacing = Math.max(10, height / 48);\n    const step = Math.max(5, width / 150);\n    for (let base = -height * .35; base < height * 1.35; base += spacing) {\n      ctx.beginPath();\n      for (let x = -step; x <= width + step; x += step) {\n        let y = base + Math.sin(x / width * 5 + base / height * 4 + time * .12) * height * .025;\n        for (const p of points) {\n          const px = p.x * width;\n          const py = p.y * height;\n          const dx = (x - px) / (width * .19);\n          const dy = (base - py) / (height * .24);\n          const influence = Math.exp(-(dx * dx + dy * dy) * 1.35);\n          y -= influence * height * .13 * p.strength * (1 + .08 * Math.sin(time * .5 + p.phase));\n        }\n        if (x === -step) ctx.moveTo(x, y); else ctx.lineTo(x, y);\n      }\n      ctx.strokeStyle = 'rgba(190, 223, 151, .34)';\n      ctx.lineWidth = .8;\n      ctx.stroke();\n    }\n\n    for (const p of points) {\n      const x = p.x * width, y = p.y * height;\n      const radius = Math.max(16, Math.min(width, height) * .05);\n      const halo = ctx.createRadialGradient(x, y, 0, x, y, radius);\n      halo.addColorStop(0, 'rgba(213,255,160,.34)');\n      halo.addColorStop(1, 'rgba(213,255,160,0)');\n      ctx.fillStyle = halo;\n      ctx.beginPath();\n      ctx.arc(x, y, radius, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.fillStyle = '#e1ffb0';\n      ctx.beginPath();\n      ctx.arc(x, y, 2.5, 0, Math.PI * 2);\n      ctx.fill();\n    }\n  }\n\n  function tick(now) {\n    if (paused) { frame = 0; return; }\n    if (last) time += Math.min((now - last) / 1000, .05);\n    last = now;\n    draw();\n    frame = requestAnimationFrame(tick);\n  }\n\n  function updateMotion() {\n    motionButton.textContent = paused ? '움직임 재생' : '움직임 일시정지';\n    motionButton.setAttribute('aria-pressed', String(paused));\n    last = 0;\n    if (!paused && !frame) frame = requestAnimationFrame(tick);\n    if (paused && frame) { cancelAnimationFrame(frame); frame = 0; }\n    draw();\n  }\n\n  function addPoint(x, y) {\n    const p = randomPoint();\n    p.x = Math.max(.02, Math.min(.98, x));\n    p.y = Math.max(.02, Math.min(.98, y));\n    points.push(p);\n    if (points.length > 14) points.shift();\n    draw();\n    status.textContent = '새로운 생각이 지형에 놓였습니다.';\n  }\n\n  art.addEventListener('pointerdown', event => {\n    const rect = art.getBoundingClientRect();\n    addPoint((event.clientX - rect.left) / rect.width, (event.clientY - rect.top) / rect.height);\n  });\n  document.getElementById('seed').addEventListener('click', () => {\n    const p = randomPoint();\n    addPoint(p.x, p.y);\n  });\n  document.getElementById('reset').addEventListener('click', () => {\n    reset();\n    status.textContent = '지형을 새로 그렸습니다.';\n  });\n  motionButton.addEventListener('click', () => {\n    paused = !paused;\n    updateMotion();\n    status.textContent = paused ? '움직임을 일시정지했습니다.' : '움직임을 재생합니다.';\n  });\n  reduced.addEventListener?.('change', event => {\n    paused = event.matches;\n    updateMotion();\n  });\n  window.addEventListener('resize', resize);\n  reset();\n  resize();\n  updateMotion();\n})();\n</script>\n</body>\n</html>",
