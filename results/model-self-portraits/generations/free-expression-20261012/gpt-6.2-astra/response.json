  "text": "<!doctype html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>문장의 직조기 — gpt-6.2-astra</title>\n<style>\n*{box-sizing:border-box}\n:root{color-scheme:dark;background:#111a1c;color:#f8f1df;font:100%/1.65 system-ui,sans-serif}\nbody{margin:0}\nmain{max-width:76rem;margin:auto;padding:clamp(1rem,4vw,4rem)}\nheader,footer{display:flex;justify-content:space-between;gap:.6rem 2rem;flex-wrap:wrap;align-items:baseline}\nheader{border-bottom:1px solid #75837c;padding-bottom:.75rem}\nsmall,.label,output{font-family:ui-monospace,monospace;letter-spacing:.06em;color:#c2d6c9}\nh1{font:600 clamp(2.3rem,7vw,5.8rem)/1.15 serif;letter-spacing:-.06em;margin:1.6rem 0 .65rem}\np{margin:.4rem 0 1.3rem}\nfigure{margin:0;border:1px solid #899a90;background:#182323}\ncanvas{display:block;width:100%;height:clamp(15rem,42vh,30rem)}\nfigcaption{padding:.8rem 1rem;border-top:1px solid #61776e;color:#fae8c7}\n.controls{display:flex;gap:1rem 2rem;flex-wrap:wrap;align-items:end;margin:1.2rem 0}\nlabel{display:grid;gap:.35rem;max-width:100%}\ninput,button{font:inherit;color:inherit;max-width:100%}\ninput[type=text],button{background:#1f302f;border:1px solid #9bada0;padding:.52rem .8rem;border-radius:.2rem}\ninput[type=range]{width:13rem;height:2.4rem;accent-color:#f8ba83}\nbutton{cursor:pointer}\n:focus-visible{outline:3px solid #ffcf79;outline-offset:4px}\nfooter{border-top:1px solid #68796f;padding-top:.8rem}\n</style>\n</head>\n<body>\n<main>\n<header><strong>gpt-6.2-astra</strong><small>TEXTILE STUDY &nbsp; / &nbsp; 01</small></header>\n<h1>문장의 직조기</h1>\n<p>내게 문장은 한 줄로 오지만, 한 줄로 남지 않는다. 글자의 결을 풀어 서로의 위아래로 건넨다.</p>\n<figure>\n<canvas id=\"cloth\" role=\"img\" aria-describedby=\"legend\" aria-label=\"입력한 글자를 세로의 날실과 가로의 씨실로 엮은 직물\"></canvas>\n<figcaption id=\"legend\">날실은 글자의 순서를, 씨실은 그 모양을 기억한다. 밝은 매듭은 두 실이 만나는 자리다.</figcaption>\n</figure>\n<div class=\"controls\">\n<label for=\"phrase\">실이 될 문장<input id=\"phrase\" type=\"text\" value=\"고요를 읽는 빛\" maxlength=\"48\" placeholder=\"짧은 문장을 입력하세요\"></label>\n<label for=\"tension\"><span>장력 &nbsp;<output id=\"level\" for=\"tension\">5</output></span><input type=\"range\" id=\"tension\" min=\"1\" max=\"9\" value=\"5\"></label>\n<button type=\"button\" id=\"motion\" aria-pressed=\"false\">숨결 애니메이션</button>\n</div>\n<footer><small id=\"count\"></small><small>바탕 · 청먹 &nbsp; / &nbsp; 실 · 옥빛과 살구</small></footer>\n</main>\n<script>\n(()=>{\nconst $=id=>document.getElementById(id),c=$('cloth'),g=c.getContext('2d'),text=$('phrase'),range=$('tension'),btn=$('motion'),pref=matchMedia('(prefers-reduced-motion: reduce)');\nlet run=!pref.matches,t=0,last=0,frame=0;\nfunction paint(){\n const w=c.clientWidth,h=c.clientHeight,d=Math.min(devicePixelRatio||1,2);\n if(c.width!==Math.round(w*d)||c.height!==Math.round(h*d)){c.width=Math.round(w*d);c.height=Math.round(h*d)}\n if(!w||!h)return;\n g.setTransform(d,0,0,d,0,0);g.fillStyle='#182323';g.fillRect(0,0,w,h);\n const chars=Array.from(text.value),codes=chars.map(v=>v.codePointAt(0)),n=codes.length;\n $('count').textContent='직조 기록 / '+String(n).padStart(2,'0')+' 글자';\n const margin=Math.min(46,w*.08),cols=Math.max(9,Math.floor((w-2*margin)/12)),rows=Math.max(9,Math.floor((h-56)/12)),step=(w-2*margin)/cols,dy=(h-56)/rows,k=+range.value;\n function node(i,j){\n const a=codes[i%n]||0,b=codes[j%n]||0;\n return [margin+i*step+Math.sin(j*.23+t+i*.12+a%9)*(10-k)*.66,28+j*dy+Math.sin(i*.21-t+j*.09+b%7)*(10-k)*.85]}\n function thread(vert,i,end,col,width){\n g.beginPath();for(let j=0;j<=end;j++){const p=vert?node(i,j):node(j,i);if(j)g.lineTo(...p);else g.moveTo(...p)}\n g.strokeStyle=col;g.lineWidth=width;g.stroke()}\n for(let i=0;i<=cols;i++)thread(true,i,rows,n?'#8db9ad':'#526961',1.5);\n if(!n)return;\n for(let j=0;j<=rows;j++)thread(false,j,cols,j%4?'#b68062':'#f3c28f',j%4?1:2);\n for(let i=0;i<=cols;i++)for(let j=0;j<=rows;j++){\n const a=codes[i%n],b=codes[j%n],bit=((a^b)>>(j%12))&1;\n if((i+j)%2===bit){\n const [x,y]=node(i,j);g.fillStyle='#182323';g.fillRect(x-2,y-2,4,4);g.fillStyle=bit?'#ffe3b9':'#b2dfc9';g.fillRect(x-1.5,y-3.6,3,7.2)}\n }\n}\nfunction loop(now){if(last)t+=Math.min(80,now-last)*.00045;last=now;paint();if(run)frame=requestAnimationFrame(loop)}\nfunction sync(){cancelAnimationFrame(frame);last=0;btn.setAttribute('aria-pressed',String(run));btn.textContent='숨결 애니메이션 · '+(run?'켜짐':'꺼짐');paint();if(run)frame=requestAnimationFrame(loop)}\nbtn.onclick=()=>{run=!run;sync()};\npref.addEventListener('change',()=>{run=!pref.matches;sync()});\ntext.oninput=paint;range.oninput=()=>{$('level').value=range.value;paint()};\nwindow.addEventListener('resize',paint);sync();\n})();\n</script>\n</body>\n</html>",
