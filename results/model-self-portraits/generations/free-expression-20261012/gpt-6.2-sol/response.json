{
  "text": "<!doctype html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"dark\">\n<title>응답 이전의 빛 — gpt-6.2-sol</title>\n<style>\n:root{color-scheme:dark;--ground:#131414;--ink:#f3eedf;--muted:#c0bbae;--line:#706d62;--accent:#ffba84}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--ground);color:var(--ink);font:1rem/1.65 system-ui,sans-serif}\nmain{max-width:85rem;margin:auto;padding:clamp(1rem,4vw,4rem)}\nheader,.folio{display:flex;justify-content:space-between;gap:.4rem 2rem;flex-wrap:wrap}\nheader,.folio,.eyebrow,output{font-family:ui-monospace,monospace;letter-spacing:.08em}\nheader{border-bottom:1px solid var(--line);padding-bottom:.85rem}\nheader span:last-child,.folio,.eyebrow,figcaption,.hint{color:var(--muted)}\n.work{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.65fr);gap:clamp(1.5rem,4vw,4rem);align-items:center;margin-block:clamp(1.5rem,5vw,5rem)}\nh1{font-size:clamp(2rem,5.4vw,5.4rem);line-height:1.06;letter-spacing:-.075em;margin:.5em 0;word-break:keep-all;overflow-wrap:anywhere}\n.eyebrow{font-size:.84rem}\n.intro{max-width:30ch}\nfieldset{border:0;padding:0;margin:2rem 0 0;min-width:0}\nlegend{font-weight:700;padding:0;margin-bottom:.45rem}\n.buttons{display:flex;gap:.5rem;flex-wrap:wrap}\nbutton{font:inherit;color:inherit;background:transparent;border:1px solid var(--line);padding:.5rem .8rem;min-height:44px;cursor:pointer}\nbutton[aria-pressed=true]{background:var(--accent);color:#22170f;border-color:var(--accent)}\n:focus-visible{outline:3px solid #a8e2ff;outline-offset:4px}\nlabel{display:flex;justify-content:space-between;gap:.5rem;flex-wrap:wrap;margin-top:1.3rem}\ninput[type=range]{width:100%;margin:.25rem 0;min-height:44px;accent-color:var(--accent)}\n.hint{font-size:.9rem;margin:0}\nfigure{margin:0;min-width:0}\n.plate{position:relative;border:1px solid var(--line);background:#191b1a}\ncanvas{display:block;width:100%;aspect-ratio:1.16}\n.plate span{position:absolute;top:.65rem;left:.8rem;font: .8rem ui-monospace,monospace;color:var(--muted);pointer-events:none}\nfigcaption{margin-top:.65rem;min-height:3.3em}\n.folio{border-top:1px solid var(--line);padding-top:.8rem;font-size:.85rem}\n@media(max-width:50rem){.work{grid-template-columns:1fr}}\n@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}\n</style>\n</head>\n<body>\n<main>\n<header><strong>gpt-6.2-sol</strong><span>자화상 / 01</span></header>\n<section class=\"work\" aria-labelledby=\"title\">\n<div>\n<p class=\"eyebrow\">언어의 노출 실험</p>\n<h1 id=\"title\">응답 이전의 빛</h1>\n<p class=\"intro\">내 얼굴 대신 문장의 단면을 그렸다. 질문을 받으면 여러 갈래의 문장이 생긴다. 한 문장이 선명해질수록, 쓰이지 않은 문장들은 그 뒤에 가느다란 결로 남는다.</p>\n<fieldset>\n<legend>문장의 상태</legend>\n<div class=\"buttons\">\n<button type=\"button\" aria-pressed=\"true\" data-mode=\"0\">질문</button>\n<button type=\"button\" aria-pressed=\"false\" data-mode=\"1\">여백</button>\n<button type=\"button\" aria-pressed=\"false\" data-mode=\"2\">응답</button>\n</div>\n</fieldset>\n<label for=\"exposure\">노출 <output id=\"value\" for=\"exposure\">58%</output></label>\n<input id=\"exposure\" type=\"range\" min=\"0\" max=\"100\" value=\"58\" aria-describedby=\"guide\">\n<p class=\"hint\" id=\"guide\">노출을 높이면 숨은 선이 드러납니다. 방향키로도 조절할 수 있습니다.</p>\n</div>\n<figure>\n<div class=\"plate\"><canvas id=\"art\" role=\"img\" aria-label=\"어두운 바탕에 주황색과 옅은 청록색 선들이 겹쳐 만든 문장의 단면\"></canvas><span aria-hidden=\"true\" id=\"index\">I / III</span></div>\n<figcaption id=\"caption\" aria-live=\"polite\">질문 — 가는 선들이 중심을 향해 휘지만, 아직 서로 닿지 않는다.</figcaption>\n</figure>\n</section>\n<footer class=\"folio\"><span>세 개의 상태 · 하나의 단면</span><span>정지 화면 / 오프라인</span></footer>\n</main>\n<script>\n(() => {\n  const canvas = document.querySelector('#art');\n  const ctx = canvas.getContext('2d');\n  const slider = document.querySelector('#exposure');\n  const value = document.querySelector('#value');\n  const caption = document.querySelector('#caption');\n  const index = document.querySelector('#index');\n  const buttons = [...document.querySelectorAll('[data-mode]')];\n  const captions = [\n    '질문 — 가는 선들이 중심을 향해 휘지만, 아직 서로 닿지 않는다.',\n    '여백 — 선들이 양쪽으로 물러나고, 비어 있는 부분이 형태를 얻는다.',\n    '응답 — 흩어졌던 선들이 한쪽에서 만나 밝은 이음매를 만든다.'\n  ];\n  let mode = 0;\n  function draw() {\n    if (!ctx) return;\n    const {width:w,height:h} = canvas.getBoundingClientRect();\n    if (!w || !h) return;\n    const d = Math.min(devicePixelRatio || 1, 2);\n    canvas.width = Math.round(w*d);\n    canvas.height = Math.round(h*d);\n    ctx.setTransform(canvas.width/800,0,0,canvas.height/690,0,0);\n    ctx.fillStyle = '#191b1a';\n    ctx.fillRect(0,0,800,690);\n    const e = Number(slider.value)/100;\n    let seed = 6439;\n    function random(){\n      seed = (Math.imul(seed,1664525)+1013904223)>>>0;\n      return seed/4294967296;\n    }\n    for(let i=0;i<4300;i++){\n      const x=random()*800,y=random()*690;\n      ctx.fillStyle=i%3 ? '#e4dcb010':'#00000036';\n      ctx.fillRect(x,y,1+random()*1.8,1);\n    }\n    ctx.strokeStyle='#e4dcb035';\n    ctx.lineWidth=1;\n    ctx.strokeRect(34,46,732,598);\n    for(let x=50;x<760;x+=14){\n      ctx.beginPath();\n      ctx.moveTo(x,644);\n      ctx.lineTo(x,644+(x%5===0?12:5));\n      ctx.stroke();\n    }\n    ctx.save();\n    ctx.beginPath();\n    ctx.rect(35,47,730,596);\n    ctx.clip();\n    const n=34+Math.round(e*96);\n    for(let j=0;j<n;j++){\n      const t=j/(n-1),side=t<.5?-1:1;\n      ctx.beginPath();\n      for(let k=0;k<=220;k++){\n        const s=k/220;\n        const x=57+686*s;\n        const a=Math.sin(Math.PI*s);\n        let y=345+(t-.5)*465;\n        if(mode===0){\n          y=345+(y-345)*(1-.80*a)+Math.sin(s*9+t*9)*32*a;\n        }else if(mode===1){\n          y+=side*109*a**2*Math.exp(-Math.abs(t-.5)*3)+Math.sin(s*8+t*8)*22*a;\n        }else{\n          const pinch=Math.exp(-((s-.72)**2)/.017);\n          y=345+(y-345)*(1-.96*pinch)+72*Math.sin(s*6-1)*a+Math.sin(s*14+t*10)*18*a*(1-pinch);\n        }\n        if(k===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);\n      }\n      ctx.strokeStyle=j%7===0?'#d8fff0':t<.48?'#ffab70':'#96d6c8';\n      ctx.globalAlpha=(.24+e*.46)*(.47+random()*.53);\n      ctx.lineWidth=j%7===0?1.35:.82;\n      ctx.stroke();\n    }\n    ctx.restore();\n  }\n  buttons.forEach(button => button.addEventListener('click',() => {\n    mode=Number(button.dataset.mode);\n    buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));\n    caption.textContent=captions[mode];\n    index.textContent=['I','II','III'][mode]+' / III';\n    draw();\n  }));\n  slider.addEventListener('input',()=>{\n    value.textContent=slider.value+'%';\n    draw();\n  });\n  if ('ResizeObserver' in window) new ResizeObserver(draw).observe(canvas);\n  else window.addEventListener('resize',draw);\n  draw();\n})();\n</script>\n</body>\n</html>",
