  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>grok-4.3 • Neural Constellation</title>\n<style>\n  :root {\n    --accent: #00f0ff;\n  }\n  \n  * {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n  }\n  \n  body {\n    background: #000000;\n    color: #ffffff;\n    font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n    overflow: hidden;\n    height: 100vh;\n    width: 100vw;\n    position: relative;\n  }\n  \n  canvas {\n    display: block;\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    touch-action: none;\n  }\n  \n  .overlay {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    z-index: 10;\n  }\n  \n  .header {\n    position: absolute;\n    top: 40px;\n    left: 50%;\n    transform: translateX(-50%);\n    text-align: center;\n    pointer-events: auto;\n  }\n  \n  .model-name {\n    font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n    font-size: 42px;\n    font-weight: 600;\n    letter-spacing: -2px;\n    color: #ffffff;\n    text-shadow: 0 0 20px rgba(0, 240, 255, 0.5);\n  }\n  \n  .sub {\n    font-size: 13px;\n    letter-spacing: 4px;\n    color: #00f0ff;\n    margin-top: 4px;\n    opacity: 0.8;\n  }\n  \n  .controls {\n    position: absolute;\n    bottom: 40px;\n    left: 50%;\n    transform: translateX(-50%);\n    display: flex;\n    gap: 12px;\n    pointer-events: auto;\n    z-index: 20;\n  }\n  \n  button {\n    background: rgba(255,255,255,0.08);\n    border: 1px solid rgba(255,255,255,0.2);\n    color: white;\n    padding: 10px 20px;\n    font-size: 16px;\n    border-radius: 9999px;\n    cursor: pointer;\n    transition: all 0.2s ease;\n    font-weight: 400;\n  }\n  \n  button:hover {\n    background: rgba(255,255,255,0.15);\n    border-color: #00f0ff;\n  }\n  \n  button:focus {\n    outline: 2px solid #00f0ff;\n    outline-offset: 2px;\n  }\n  \n  .info {\n    position: absolute;\n    bottom: 40px;\n    right: 40px;\n    font-size: 19px;\n    color: rgba(255,255,255,0.4);\n    text-align: right;\n    line-height: 1.4;\n  }\n  \n  @media (max-width: 768px) {\n    .model-name {\n      font-size: 32px;\n    }\n    .controls {\n      bottom: 24px;\n    }\n    .info {\n      display: none;\n    }\n  }\n</style>\n</head>\n<body>\n  <canvas id=\"canvas\"></canvas>\n  \n  <div class=\"overlay\">\n    <!-- Header -->\n    <div class=\"header\">\n      <div class=\"model-name\">grok-4.3</div>\n      <div class=\"sub\">xai.grok-4.3</div>\n    </div>\n    \n    <!-- Controls -->\n    <div class=\"controls\">\n      <button id=\"pauseBtn\" aria-label=\"애니메이션 일시정지\">일시정지</button>\n      <button id=\"resetBtn\" aria-label=\"네트워크 초기화\">초기화</button>\n      <button id=\"motionBtn\" aria-label=\"움직임 감소 토글\">움직임 감소</button>\n    </div>\n    \n    <div class=\"info\">\n      마우스/터치로 상호작용<br>\n      키보드: Space(정지) · R(초기화)\n    </div>\n  </div>\n\n  <script>\n    const canvas = document.getElementById('canvas');\n    const ctx = canvas.getContext('2d', { alpha: true });\n    \n    let width, height;\n    let particles = [];\n    let mouse = { x: null, y: null, active: false };\n    let paused = false;\n    let reducedMotion = false;\n    \n    const PARTICLE_COUNT = 92;\n    const CONNECTION_DISTANCE = 140;\n    \n    function resize() {\n      width = window.innerWidth;\n      height = window.innerHeight;\n      canvas.width = width;\n      canvas.height = height;\n    }\n    \n    class Particle {\n      constructor() {\n        this.reset();\n      }\n      \n      reset() {\n        this.x = Math.random() * width;\n        this.y = Math.random() * height;\n        this.vx = (Math.random() - 0.5) * 0.6;\n        this.vy = (Math.random() - 0.5) * 0.6;\n        this.size = Math.random() * 2.2 + 1.4;\n        this.alpha = Math.random() * 0.6 + 0.5;\n      }\n      \n      update() {\n        if (reducedMotion) {\n          this.vx *= 0.96;\n          this.vy *= 0.96;\n        }\n        \n        this.x += this.vx;\n        this.y += this.vy;\n        \n        if (this.x < 0 || this.x > width) this.vx *= -1;\n        if (this.y < 0 || this.y > height) this.vy *= -1;\n        \n        if (mouse.active && mouse.x !== null) {\n          const dx = mouse.x - this.x;\n          const dy = mouse.y - this.y;\n          const dist = Math.sqrt(dx * dx + dy * dy);\n          \n          if (dist < 220 && dist > 0) {\n            const force = (220 - dist) / 220 * 0.8;\n            this.vx += (dx / dist) * force * 0.04;\n            this.vy += (dy / dist) * force * 0.04;\n          }\n        }\n        \n        const speed = Math.sqrt(this.vx * this.vx + this.vy * this.vy);\n        if (speed > 1.8) {\n          this.vx = (this.vx / speed) * 1.8;\n          this.vy = (this.vy / speed) * 1.8;\n        }\n      }\n      \n      draw() {\n        ctx.save();\n        ctx.fillStyle = `rgba(0, 240, 255, ${this.alpha})`;\n        ctx.beginPath();\n        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.restore();\n      }\n    }\n    \n    function createParticles() {\n      particles = [];\n      for (let i = 0; i < PARTICLE_COUNT; i++) {\n        particles.push(new Particle());\n      }\n    }\n    \n    function drawConnections() {\n      ctx.strokeStyle = 'rgba(0, 240, 255, 0.12)';\n      ctx.lineWidth = 1;\n      \n      for (let i = 0; i < particles.length; i++) {\n        for (let j = i + 1; j < particles.length; j++) {\n          const p1 = particles[i];\n          const p2 = particles[j];\n          const dx = p1.x - p2.x;\n          const dy = p1.y - p2.y;\n          const dist = Math.sqrt(dx * dx + dy * dy);\n          \n          if (dist < CONNECTION_DISTANCE) {\n            const alpha = (1 - dist / CONNECTION_DISTANCE) * 0.35;\n            ctx.strokeStyle = `rgba(0, 240, 255, ${alpha})`;\n            ctx.beginPath();\n            ctx.moveTo(p1.x, p1.y);\n            ctx.lineTo(p2.x, p2.y);\n            ctx.stroke();\n          }\n        }\n      }\n    }\n    \n    function animate() {\n      if (paused) {\n        requestAnimationFrame(animate);\n        return;\n      }\n      \n      ctx.fillStyle = 'rgba(0, 0, 0, 0.65)';\n      ctx.fillRect(0, 0, width, height);\n      \n      drawConnections();\n      \n      for (let p of particles) {\n        p.update();\n        p.draw();\n      }\n      \n      const centerX = width / 2;\n      const centerY = height / 2;\n      \n      ctx.save();\n      ctx.shadowColor = '#00f0ff';\n      ctx.shadowBlur = 30;\n      ctx.fillStyle = 'rgba(0, 240, 255, 0.9)';\n      ctx.beginPath();\n      ctx.arc(centerX, centerY, 5.5, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.restore();\n      \n      requestAnimationFrame(animate);\n    }\n    \n    function setupEvents() {\n      window.addEventListener('resize', () => {\n        resize();\n      });\n      \n      canvas.addEventListener('mousemove', (e) => {\n        mouse.x = e.clientX;\n        mouse.y = e.clientY;\n        mouse.active = true;\n      });\n      \n      canvas.addEventListener('mouseleave', () => {\n        mouse.active = false;\n      });\n      \n      canvas.addEventListener('touchmove', (e) => {\n        e.preventDefault();\n        mouse.x = e.touches[0].clientX;\n        mouse.y = e.touches[0].clientY;\n        mouse.active = true;\n      }, { passive: false });\n      \n      canvas.addEventListener('touchend', () => {\n        mouse.active = false;\n      });\n      \n      document.addEventListener('keydown', (e) => {\n        if (e.key === ' ' || e.key === 'Spacebar') {\n          e.preventDefault();\n          togglePause();\n        }\n        if (e.key.toLowerCase() === 'r') {\n          resetParticles();\n        }\n      });\n      \n      document.getElementById('pauseBtn').addEventListener('click', togglePause);\n      document.getElementById('resetBtn').addEventListener('click', resetParticles);\n      document.getElementById('motionBtn').addEventListener('click', toggleMotion);\n    }\n    \n    function togglePause() {\n      paused = !paused;\n      const btn = document.getElementById('pauseBtn');\n      btn.textContent = paused ? '재생' : '일시정지';\n    }\n    \n    function resetParticles() {\n      createParticles();\n    }\n    \n    function toggleMotion() {\n      reducedMotion = !reducedMotion;\n      const btn = document.getElementById('motionBtn');\n      btn.style.borderColor = reducedMotion ? '#00f0ff' : 'rgba(255,255,255,0.2)';\n    }\n    \n    function init() {\n      resize();\n      createParticles();\n      setupEvents();\n      \n      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n        reducedMotion = true;\n        document.getElementById('motionBtn').style.borderColor = '#00f0ff';\n      }\n      \n      animate();\n      \n      setTimeout(() => {\n        mouse.x = width * 0.5;\n        mouse.y = height * 0.5;\n      }, 800);\n    }\n    \n    init();\n  </script>\n</body>\n</html>",
