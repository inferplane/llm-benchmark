{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<meta name=\"description\" content=\"kimi-k3가 스스로를 표현한 미디어아트: 달빛 토큰의 바다. 단일 HTML 파일, 오프라인 실행.\">\n<title>kimi-k3 — 달빛 토큰의 바다</title>\n<style>\n  :root{\n    --bg1:#070b1a;\n    --bg2:#101838;\n    --ink:#f4f6ff;\n    --muted:#c6cdea;\n    --accent:#8fd6ff;\n    --gold:#ffd166;\n    --panel:rgba(9,13,30,.88);\n    --line:rgba(160,180,255,.30);\n    --focus:#ffd166;\n  }\n  body.hc{\n    --bg1:#000000;\n    --bg2:#000000;\n    --ink:#ffffff;\n    --muted:#ffffff;\n    --accent:#7df9ff;\n    --gold:#ffe95e;\n    --panel:#000000;\n    --line:#ffffff;\n    --focus:#ffe95e;\n  }\n  *{box-sizing:border-box;}\n  html{scroll-behavior:smooth;}\n  body{\n    margin:0;\n    min-height:100vh;\n    color:var(--ink);\n    background:\n      radial-gradient(1200px 800px at 68% 28%, var(--bg2), var(--bg1) 70%);\n    font-family: \"Pretendard\", \"Apple SD Gothic Neo\", \"Malgun Gothic\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n    line-height:1.65;\n    overflow-x:hidden;\n  }\n  /* ---- 상호작용 무대(캔버스) ---- */\n  #stage{\n    position:fixed; inset:0; z-index:0;\n    display:block;\n  }\n  #stage canvas{display:block;}\n  #stage:focus-visible{\n    outline:3px solid var(--focus);\n    outline-offset:-6px;\n  }\n  /* ---- 콘텐츠 ---- */\n  .skip{\n    position:absolute; left:-9999px; top:0; z-index:10;\n    background:var(--gold); color:#111; padding:.7em 1.1em;\n    font-weight:700; border-radius:0 0 10px 0; text-decoration:none;\n  }\n  .skip:focus{left:0;}\n  header, main{position:relative; z-index:1;}\n  header{padding:clamp(1.2rem,4vw,3rem) clamp(1rem,4vw,3rem) 0; pointer-events:none;}\n  .kicker{\n    margin:0; font-size:.85em; letter-spacing:.18em; text-transform:uppercase;\n    color:var(--accent);\n  }\n  h1{\n    margin:.1em 0 0;\n    font-size:clamp(2.6rem, 9vw, 5.5rem);\n    line-height:1.05;\n    letter-spacing:-.02em;\n    font-weight:800;\n  }\n  h1 .moonmark{color:var(--gold);}\n  .sub{\n    margin:.4em 0 0; color:var(--muted);\n    font-size:clamp(1rem, 2.6vw, 1.25rem);\n  }\n  main{\n    display:flex; justify-content:flex-start;\n    padding:clamp(1rem,3vw,2.4rem) clamp(1rem,4vw,3rem) clamp(4rem,10vh,6rem);\n  }\n  .panel{\n    max-width:42rem; width:100%;\n    background:var(--panel);\n    border:1px solid var(--line);\n    border-radius:18px;\n    padding:clamp(1.1rem,3vw,2rem);\n    backdrop-filter:blur(9px);\n    -webkit-backdrop-filter:blur(9px);\n    box-shadow:0 20px 60px rgba(0,0,0,.45);\n  }\n  .panel h2{margin:.2em 0 .5em; font-size:1.3em;}\n  .panel h3{margin:1.4em 0 .4em; font-size:1.05em; color:var(--accent);}\n  .poem{\n    border-left:3px solid var(--gold);\n    padding-left:1em; margin:1em 0;\n    color:var(--ink);\n  }\n  .poem em{font-style:normal; color:var(--gold); font-weight:700;}\n  .sig{font-size:.9em; color:var(--muted);}\n  code{\n    background:rgba(140,170,255,.14);\n    border:1px solid var(--line);\n    padding:.1em .45em; border-radius:6px;\n    font-family:ui-monospace, \"Cascadia Code\", Consolas, monospace;\n    font-size:.92em; color:var(--accent);\n  }\n  ul{margin:.3em 0 0; padding-left:1.2em;}\n  li{margin:.25em 0;}\n  kbd{\n    border:1px solid var(--line); border-bottom-width:2px; border-radius:6px;\n    padding:.05em .45em; font-family:inherit; font-size:.88em;\n    background:rgba(140,170,255,.10);\n  }\n  /* ---- 컨트롤 ---- */\n  .controls{\n    display:flex; flex-wrap:wrap; gap:.55em; align-items:center;\n    margin-top:1.3em; padding-top:1.1em;\n    border-top:1px dashed var(--line);\n  }\n  button{\n    font:inherit; color:var(--ink);\n    background:transparent;\n    border:1.5px solid var(--line);\n    border-radius:999px;\n    padding:.55em 1.05em;\n    cursor:pointer;\n    min-height:44px;\n    transition:background .2s, color .2s, border-color .2s;\n  }\n  button:hover{background:rgba(143,214,255,.14); border-color:var(--accent);}\n  button[aria-pressed=\"true\"]{\n    background:var(--accent); color:#06101f; border-color:var(--accent);\n    font-weight:700;\n  }\n  body.hc button[aria-pressed=\"true\"]{color:#000;}\n  #fsVal{min-width:3.4em; text-align:center; color:var(--muted); font-variant-numeric:tabular-nums;}\n  :focus-visible{outline:3px solid var(--focus); outline-offset:3px;}\n  .sr-only{\n    position:absolute!important; width:1px; height:1px;\n    padding:0; margin:-1px; overflow:hidden;\n    clip:rect(0 0 0 0); white-space:nowrap; border:0;\n  }\n  footer{\n    position:relative; z-index:1;\n    padding:0 clamp(1rem,4vw,3rem) 1.6rem;\n    color:var(--muted); font-size:.82em;\n  }\n  @media (max-width:640px){\n    main{padding-bottom:5rem;}\n    .panel{max-width:100%;}\n  }\n  @media (prefers-reduced-motion: reduce){\n    html{scroll-behavior:auto;}\n    *{animation:none!important; transition:none!important;}\n  }\n  body.reduce-motion *{animation:none!important; transition:none!important;}\n</style>\n</head>\n<body>\n  <a class=\"skip\" href=\"#description\">작품 설명으로 바로가기</a>\n\n  <header>\n    <p class=\"kicker\">Self-Portrait · Single-File Media Art</p>\n    <h1><span class=\"moonmark\" aria-hidden=\"true\">◐</span> kimi-k3</h1>\n    <p class=\"sub\">달빛 토큰의 바다 — <span lang=\"en\">A Moonlit Sea of Tokens</span></p>\n  </header>\n\n  <main>\n    <section class=\"panel\" id=\"description\" aria-labelledby=\"aboutTitle\">\n      <h2 id=\"aboutTitle\">작품 소개</h2>\n      <div class=\"poem\">\n        <p>\n          나는 <em>kimi-k3</em>.<br>\n          달빛으로 엮은 언어의 바다 위에서<br>\n          토큰들이 별자리처럼 흐른다.<br>\n          당신의 손끝이 닿는 곳마다 생각이 물결치고,<br>\n          멈춤을 선택해도 빛은 그 자리에 남는다.\n        </p>\n      </div>\n      <p>\n        화면의 달은 저의 중심이고, 흐르는 글자들은 제가 다루는 언어의 조각들입니다.\n        포인터와 키보드가 만드는 <strong>중력장</strong>에 따라 조각들의 궤도가 바뀝니다.\n        이 페이지는 외부 자원 없이, 이 한 파일만으로 어디서나 켜집니다.\n      </p>\n      <p class=\"sig\">호출 식별자: <code>us.moonshotai.kimi-k3</code></p>\n\n      <h3 id=\"howtoTitle\">조작 방법</h3>\n      <ul id=\"howto\" aria-labelledby=\"howtoTitle\">\n        <li>마우스 이동·터치 드래그: 중력장이 따라다니며 글자 흐름을 휘게 합니다.</li>\n        <li>클릭·탭: 달빛 파동이 퍼집니다.</li>\n        <li>키보드: 캔버스에 초점을 둔 뒤 <kbd>←</kbd><kbd>↑</kbd><kbd>↓</kbd><kbd>→</kbd> 중력장 이동, <kbd>Space</kbd>/<kbd>Enter</kbd> 파동, <kbd>M</kbd> 움직임 전환.</li>\n      </ul>\n\n      <div class=\"controls\" role=\"group\" aria-label=\"작품 설정\">\n        <button type=\"button\" id=\"motionBtn\" aria-pressed=\"false\">움직임 줄이기</button>\n        <button type=\"button\" id=\"contrastBtn\" aria-pressed=\"false\">고대비</button>\n        <button type=\"button\" id=\"fontMinus\" aria-label=\"글자 크기 축소\">A−</button>\n        <span id=\"fsVal\" aria-live=\"polite\">100%</span>\n        <button type=\"button\" id=\"fontPlus\" aria-label=\"글자 크기 확대\">A+</button>\n      </div>\n      <noscript><p>이 작품은 JavaScript가 켜져 있을 때 움직입니다. 지금은 정지된 달빛만 머뭅니다.</p></noscript>\n    </section>\n  </main>\n\n  <footer>\n    <p>kimi-k3 · 단일 HTML · 외부 통신 없음 · sandbox 안전 — 움직임 감소, 고대비, 글자 확대, 키보드 조작을 지원합니다.</p>\n  </footer>\n\n  <div id=\"stage\" tabindex=\"0\" role=\"group\"\n       aria-label=\"상호작용 캔버스: 달빛 토큰의 바다. 화살표 키로 중력장을 움직이고, 스페이스나 엔터로 파동을 만듭니다.\"\n       aria-describedby=\"howto\">\n    <canvas id=\"c\" aria-hidden=\"true\"></canvas>\n  </div>\n\n  <p id=\"live\" class=\"sr-only\" role=\"status\" aria-live=\"polite\"></p>\n\n<script>\n(function(){\n  \"use strict\";\n  var canvas = document.getElementById('c');\n  var ctx = canvas.getContext('2d');\n  var stage = document.getElementById('stage');\n  var live = document.getElementById('live');\n  var motionBtn = document.getElementById('motionBtn');\n  var contrastBtn = document.getElementById('contrastBtn');\n  var fontMinus = document.getElementById('fontMinus');\n  var fontPlus = document.getElementById('fontPlus');\n  var fsVal = document.getElementById('fsVal');\n\n  var W=0, H=0;\n  var moon = {x:0,y:0,r:120};\n  var gp = {x:0,y:0};              // 중력장\n  var parts = [];\n  var ripples = [];\n  var hc = false;\n\n  var GLYPHS = ('kimiK3달빛토큰별01∴✦·λ문').split('');\n\n  function say(msg){\n    live.textContent = '';\n    setTimeout(function(){ live.textContent = msg; }, 30);\n  }\n  function clamp(v,a,b){ return v<a?a:(v>b?b:v); }\n\n  /* ---------- 입자 ---------- */\n  function newPart(){\n    var gold = Math.random() < 0.18;\n    return {\n      x: Math.random()*W,\n      y: Math.random()*H,\n      vx: (Math.random()-.5)*.3,\n      vy: (Math.random()-.5)*.3,\n      g: GLYPHS[(Math.random()*GLYPHS.length)|0],\n      s: 10 + Math.random()*16,\n      hue: gold ? 42+Math.random()*14 : 198+Math.random()*70,\n      a: .35 + Math.random()*.45,\n      tw: Math.random()*Math.PI*2\n    };\n  }\n  function initParts(){\n    var n = Math.min(200, Math.max(50, Math.floor(W*H/8500)));\n    parts = [];\n    for(var i=0;i<n;i++) parts.push(newPart());\n  }\n\n  function resize(){\n    var DPR = Math.min(window.devicePixelRatio||1, 2);\n    W = window.innerWidth; H = window.innerHeight;\n    canvas.width = Math.round(W*DPR);\n    canvas.height = Math.round(H*DPR);\n    canvas.style.width = W+'px';\n    canvas.style.height = H+'px';\n    ctx.setTransform(DPR,0,0,DPR,0,0);\n    var wide = W > 760;\n    moon.x = W * (wide ? 0.64 : 0.5);\n    moon.y = H * (wide ? 0.42 : 0.30);\n    moon.r = Math.min(W,H) * (wide ? 0.17 : 0.14) + 36;\n    gp.x = moon.x; gp.y = moon.y;\n    initParts();\n  }\n\n  /* ---------- 그리기 ---------- */\n  function drawMoon(){\n    var x=moon.x, y=moon.y, r=moon.r;\n    if(!hc){\n      var glow = ctx.createRadialGradient(x,y,r*0.6, x,y,r*2.6);\n      glow.addColorStop(0,'rgba(255,224,150,0.20)');\n      glow.addColorStop(0.5,'rgba(150,180,255,0.07)');\n      glow.addColorStop(1,'rgba(0,0,0,0)');\n      ctx.fillStyle = glow;\n      ctx.fillRect(x-r*2.6, y-r*2.6, r*5.2, r*5.2);\n    }\n    var body = ctx.createRadialGradient(x-r*0.35, y-r*0.4, r*0.1, x, y, r);\n    if(hc){ body.addColorStop(0,'#ffffff'); body.addColorStop(1,'#ffffff'); }\n    else{\n      body.addColorStop(0,'#fff9e8');\n      body.addColorStop(0.6,'#e9e4d2');\n      body.addColorStop(1,'#b9c0d6');\n    }\n    ctx.beginPath();\n    ctx.arc(x,y,r,0,Math.PI*2);\n    ctx.fillStyle = body;\n    ctx.fill();\n\n    if(!hc){\n      ctx.fillStyle = 'rgba(110,120,155,0.22)';\n      var craters = [[-0.32,-0.18,0.14],[0.22,0.08,0.10],[-0.05,0.33,0.08],[0.38,-0.34,0.07]];\n      for(var i=0;i<craters.length;i++){\n        var c=craters[i];\n        ctx.beginPath();\n        ctx.arc(x+c[0]*r, y+c[1]*r, c[2]*r, 0, Math.PI*2);\n        ctx.fill();\n      }\n      // 궤도 고리\n      ctx.save();\n      ctx.translate(x,y);\n      ctx.rotate(-0.35);\n      ctx.beginPath();\n      ctx.ellipse(0,0,r*1.7,r*0.55,0,0,Math.PI*2);\n      ctx.strokeStyle = 'rgba(255,209,102,0.30)';\n      ctx.lineWidth = 1.2;\n      ctx.stroke();\n      ctx.restore();\n    }\n  }\n\n  function drawParts(t){\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    for(var i=0;i<parts.length;i++){\n      var p = parts[i];\n      var tw = reduced ? (0.85 + 0.15*Math.sin(t/1600 + p.tw))\n                       : (0.72 + 0.28*Math.sin(t/650 + p.tw));\n      var alpha = p.a * tw;\n      ctx.font = p.s + 'px system-ui, sans-serif';\n      ctx.fillStyle = hc ? 'rgba(255,255,255,'+alpha+')'\n                         : 'hsla('+p.hue+',82%,'+(p.hue<100?70:74)+'%,'+alpha+')';\n      ctx.fillText(p.g, p.x, p.y);\n    }\n  }\n\n  function drawRipples(){\n    for(var i=0;i<ripples.length;i++){\n      var rp = ripples[i];\n      ctx.beginPath();\n      ctx.arc(rp.x, rp.y, rp.r, 0, Math.PI*2);\n      ctx.strokeStyle = hc ? 'rgba(255,255,255,'+rp.a+')'\n                           : 'rgba(255,209,102,'+rp.a+')';\n      ctx.lineWidth = 2;\n      ctx.stroke();\n      ctx.beginPath();\n      ctx.arc(rp.x, rp.y, Math.max(1,rp.r*0.55), 0, Math.PI*2);\n      ctx.strokeStyle = hc ? 'rgba(255,255,255,'+(rp.a*0.5)+')'\n                           : 'rgba(143,214,255,'+(rp.a*0.55)+')';\n      ctx.lineWidth = 1.2;\n      ctx.stroke();\n    }\n  }\n\n  function step(){\n    for(var i=0;i<parts.length;i++){\n      var p = parts[i];\n      var dx = gp.x - p.x, dy = gp.y - p.y;\n      var d = Math.sqrt(dx*dx+dy*dy) || 1;\n      var f = 90/(d+60);\n      // 접선 방향 소용돌이 + 약한 인력\n      p.vx += (-dy/d)*f*0.6 + (dx/d)*f*0.12;\n      p.vy += ( dx/d)*f*0.6 + (dy/d)*f*0.12;\n      p.vx *= 0.985; p.vy *= 0.985;\n      p.x += p.vx; p.y += p.vy;\n      if(p.x<-40) p.x = W+40; else if(p.x>W+40) p.x = -40;\n      if(p.y<-40) p.y = H+40; else if(p.y>H+40) p.y = -40;\n    }\n    // 파동이 입자를 밀어냄\n    for(var j=0;j<ripples.length;j++){\n      var rp = ripples[j];\n      if(rp.fixed) continue;\n      for(var k=0;k<parts.length;k++){\n        var q = parts[k];\n        var rx = q.x - rp.x, ry = q.y - rp.y;\n        var rd = Math.sqrt(rx*rx+ry*ry) || 1;\n        if(Math.abs(rd - rp.r) < 28){\n          q.vx += (rx/rd)*1.4;\n          q.vy += (ry/rd)*1.4;\n        }\n      }\n    }\n  }\n\n  var reduced = false;\n  function frame(t){\n    requestAnimationFrame(frame);\n    ctx.clearRect(0,0,W,H);\n    if(!reduced) step();\n    for(var i=ripples.length-1;i>=0;i--){\n      var rp = ripples[i];\n      if(rp.fixed){ rp.a -= 0.012; } else { rp.r += 5; rp.a -= 0.018; }\n      if(rp.a <= 0) ripples.splice(i,1);\n    }\n    drawMoon();\n    drawParts(t||0);\n    drawRipples();\n  }\n\n  function spawnRipple(x,y,announce){\n    if(ripples.length > 8) ripples.shift();\n    ripples.push(reduced ? {x:x,y:y,r:70,a:0.9,fixed:true}\n                         : {x:x,y:y,r:2,a:1,fixed:false});\n    if(announce) say('달빛 파동이 퍼집니다.');\n  }\n\n  /* ---------- 상태: 움직임 ---------- */\n  var mq = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : {matches:false};\n  reduced = !!mq.matches;\n  function applyMotion(){\n    motionBtn.setAttribute('aria-pressed', String(reduced));\n    motionBtn.textContent = reduced ? '움직임 켜기' : '움직임 줄이기';\n    document.body.classList.toggle('reduce-motion', reduced);\n  }\n  function toggleMotion(){\n    reduced = !reduced;\n    applyMotion();\n    say(reduced ? '움직임이 줄어듭니다. 장면이 거의 고정됩니다.'\n                : '움직임이 켜집니다. 토큰들이 흐르기 시작합니다.');\n  }\n  motionBtn.addEventListener('click', toggleMotion);\n  if(mq.addEventListener){\n    mq.addEventListener('change', function(e){ reduced = e.matches; applyMotion(); });\n  }\n\n  /* ---------- 상태: 고대비 ---------- */\n  contrastBtn.addEventListener('click', function(){\n    hc = !hc;\n    document.body.classList.toggle('hc', hc);\n    contrastBtn.setAttribute('aria-pressed', String(hc));\n    say(hc ? '고대비 모드가 켜졌습니다.' : '고대비 모드가 꺼졌습니다.');\n  });\n\n  /* ---------- 상태: 글자 크기 ---------- */\n  var fs = 100;\n  function applyFs(){\n    fs = clamp(fs, 80, 140);\n    document.documentElement.style.fontSize = fs + '%';\n    fsVal.textContent = fs + '%';\n  }\n  fontMinus.addEventListener('click', function(){ fs -= 10; applyFs(); say('글자 크기 ' + fs + '퍼센트'); });\n  fontPlus.addEventListener('click', function(){ fs += 10; applyFs(); say('글자 크기 ' + fs + '퍼센트'); });\n\n  /* ---------- 입력 ---------- */\n  window.addEventListener('pointermove', function(e){\n    if(reduced) return;\n    gp.x = e.clientX; gp.y = e.clientY;\n  }, {passive:true});\n\n  window.addEventListener('pointerdown', function(e){\n    if(e.target.closest('button, a, input, select, textarea, .panel')) return;\n    gp.x = e.clientX; gp.y = e.clientY;\n    spawnRipple(e.clientX, e.clientY, false);\n  });\n\n  stage.addEventListener('keydown', function(e){\n    var k = e.key;\n    var stepPx = 28;\n    if(k==='ArrowUp' || k==='ArrowDown' || k==='ArrowLeft' || k==='ArrowRight'){\n      e.preventDefault();\n      if(k==='ArrowUp') gp.y = clamp(gp.y - stepPx, 0, H);\n      if(k==='ArrowDown') gp.y = clamp(gp.y + stepPx, 0, H);\n      if(k==='ArrowLeft') gp.x = clamp(gp.x - stepPx, 0, W);\n      if(k==='ArrowRight') gp.x = clamp(gp.x + stepPx, 0, W);\n    } else if(k===' ' || k==='Enter'){\n      e.preventDefault();\n      spawnRipple(gp.x, gp.y, true);\n    } else if(k==='m' || k==='M'){\n      toggleMotion();\n    }\n  });\n\n  window.addEventListener('resize', resize);\n\n  /* ---------- 시작 ---------- */\n  resize();\n  applyMotion();\n  applyFs();\n  requestAnimationFrame(frame);\n})();\n</script>\n</body>\n</html>",
