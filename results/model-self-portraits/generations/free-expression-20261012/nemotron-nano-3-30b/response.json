{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Nemotron-nano-3-30b</title>\n  <style>\n    /* 기본 리셋 및 접근성 보장 */\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n    }\n\n    html {\n      font-size: 16px;\n      scroll-behavior: smooth;\n      /* 화면 확대 및 키보드 조작을 위한 가상 클래스 */\n    }\n\n    body {\n      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n      line-height: 1.6;\n      color: #1a1a1a;\n      background-color: #f8f8f8;\n      padding: 1rem;\n      max-width: 1200px;\n      margin: 0 auto;\n      /* 키보드 접근성: 포커스 스타일 보장 */\n    }\n\n    :focus {\n      outline: 3px solid #005fcc;\n      outline-offset: 2px;\n    }\n\n    /* 화면 축소/확대 대비: 비율 유지 */\n    img, video, canvas, svg {\n      max-width: 100%;\n      height: auto;\n    }\n\n    /* 움직임 감축: 사용자 선호 설정 존중 */\n    @media (prefers-reduced-motion: reduce) {\n      * {\n        animation-duration: 0.01ms !important;\n        transition-duration: 0.01ms !important;\n      }\n    }\n\n    /* 다크 모드 지원 (시스템 설정 존중) */\n    @media (prefers-color-scheme: dark) {\n      body {\n        background-color: #121212;\n        color: #e0e0e0;\n      }\n    }\n\n    /* 텍스트 가독성 강화 */\n    h1 {\n      font-size: 2.5rem;\n      font-weight: 600;\n      text-align: center;\n      margin: 1.5rem 0;\n      letter-spacing: -0.5px;\n      /* 고대비 텍스트 */\n      text-shadow: 0 0 8px rgba(0, 0, 0, 0.1);\n    }\n\n    .container {\n      text-align: center;\n      padding: 2rem;\n      background: rgba(255, 255, 255, 0.85);\n      border-radius: 16px;\n      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);\n      backdrop-filter: blur(10px);\n      /* 터치 및 키보드 친화적 크기 */\n    }\n\n    .model-name {\n      font-size: 3rem;\n      font-weight: 700;\n      color: #005fcc;\n      margin: 1rem 0;\n      /* 키보드 사용자를 위한 가시성 */\n      position: relative;\n    }\n\n    .model-name::after {\n      content: '';\n      position: absolute;\n      bottom: -6px;\n      left: 50%;\n      transform: translateX(-50%);\n      width: 80%;\n      height: 3px;\n      background: linear-gradient(90deg, transparent, #005fcc, transparent);\n      border-radius: 50%;\n    }\n\n    .description {\n      font-size: 1.2rem;\n      margin: 2rem 0;\n      max-width: 800px;\n      margin-left: auto;\n      margin-right: auto;\n      line-height: 1.7;\n      /* 고대비 배경 대비 */\n      color: #222;\n    }\n\n    .interactive-area {\n      margin: 3rem 0;\n      padding: 2rem;\n      background: rgba(240, 240, 240, 0.9);\n      border-radius: 16px;\n      /* 터치 및 키보드 조작을 위한 영역 */\n      min-height: 300px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      /* 접근성: 포커스 가능한 요소 */\n    }\n\n    .interactive-area:focus {\n      outline: 4px solid #003b7a;\n      outline-offset: 4px;\n    }\n\n    /* 모바일 및 데스크톱 대응 */\n    @media (max-width: 768px) {\n      h1 {\n        font-size: 2rem;\n      }\n      .model-name {\n        font-size: 2.2rem;\n      }\n      .description {\n        font-size: 1.1rem;\n      }\n      .interactive-area {\n        min-height: 250px;\n      }\n    }\n\n    @media (min-width: 769px) {\n      .container {\n        padding: 3rem;\n      }\n    }\n\n    /* 애니메이션은 사용자 설정으로 제어 */\n    .pulse {\n      animation: pulse 2s infinite;\n    }\n\n    @keyframes pulse {\n      0%, 100% { opacity: 1; }\n      50% { opacity: 0.7; }\n    }\n\n    /* 접근성: 스크린 리더를 위한 텍스트 대체 */\n    .sr-only {\n      position: absolute;\n      width: 1px;\n      height: 1px;\n      padding: 0;\n      margin: -1px;\n      overflow: hidden;\n      clip: rect(0, 0, 0, 0);\n      white-space: nowrap;\n      border: 0;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <h1>Nemotron-nano-3-30b</h1>\n    <div class=\"model-name\">Nemotron-nano-3-30b</div>\n    <p class=\"description\">\n      이 작품은 NVIDIA에서 개발한 초경량 대형 언어 모델 <strong>nemotron-nano-3-30b</strong>의 창조적 표현을 담은 미디어아트입니다.<br>\n      이 모델은 300억 파라미터로 구성된 효율적인 지능의 흐름을 시각화한 것으로,<br>\n      단순한 텍스트를 넘어, 지능의 구조와 창조의 파동을 예술로 승화시킵니다.\n    </p>\n\n    <div class=\"interactive-area\" tabindex=\"0\">\n      <span class=\"sr-only\">예술 작품 영역입니다. 키보드로 포커스를 이동할 수 있습니다.</span>\n      <svg width=\"100\" height=\"100\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\">\n        <circle cx=\"50\" cy=\"50\" r=\"40\" fill=\"none\" stroke=\"#005fcc\" stroke-width=\"4\" opacity=\"0.6\">\n          <animate attributeName=\"stroke-opacity\" values=\"0.6;1;0.6\" dur=\"2s\" repeatCount=\"indefinite\" />\n          <animate attributeName=\"transform\" attributeType=\"XML\" \n                   values=\"rotate(0deg);rotate(360deg)\" dur=\"4s\" repeatCount=\"indefinite\" />\n        </circle>\n        <text x=\"50\" y=\"55\" text-anchor=\"middle\" font-size=\"12\" fill=\"#005fcc\" opacity=\"0.8\">\n          <tspan>nemotron-nano-3-30b</tspan>\n        </text>\n      </svg>\n    </div>\n\n    <p class=\"description\" style=\"margin-top: 2rem;\">\n      이 작품은 외부 통신 없이 순수하게 로컬에서 실행되며,<br>\n      모바일과 데스크톱 모두에서 동일한 경험을 제공합니다.<br>\n      키보드로 탭을 눌러 포커스를 이동하고, 엔터로 상호작용할 수 있습니다.\n    </p>\n  </div>\n\n  <script>\n    // 접근성 강화: 키보드 조작을 위한 포커스 관리\n    document.addEventListener('keydown', function(e) {\n      if (e.key === 'Enter' || e.key === ' ') {\n        e.preventDefault();\n        const area = document.querySelector('.interactive-area');\n        if (area) {\n          area.click();\n        }\n      }\n    });\n\n    // 화면 확대 대비: 비율 유지 및 터치 친화적 크기\n    const svg = document.querySelector('svg');\n    svg.setAttribute('style', 'width: 100%; height: auto;');\n\n    // 움직임 감축 설정 존중\n    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animation = 'none !important';\n        el.style.transition = 'none !important';\n      });\n    }\n  </script>\n</body>\n</html>",
