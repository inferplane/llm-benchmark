{
  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Qwen3.6-27B | Neural Core</title>\n<style>\n  :root {\n    --bg: #050508;\n    --primary: #00f2ff;\n    --secondary: #7000ff;\n    --text: #e0e0e0;\n    --glass: rgba(255, 255, 255, 0.03);\n    --border: rgba(255, 255, 255, 0.1);\n  }\n\n  * {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n  }\n\n  body {\n    background-color: var(--bg);\n    color: var(--text);\n    font-family: 'Courier New', Courier, monospace;\n    overflow: hidden;\n    height: 100vh;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n  }\n\n  canvas {\n    position: absolute;\n    top: 0;\n    left: 0;\n    z-index: 0;\n  }\n\n  .interface {\n    position: relative;\n    z-index: 1;\n    width: 90%;\n    max-width: 600px;\n    background: var(--glass);\n    backdrop-filter: blur(10px);\n    border: 1px solid var(--border);\n    border-radius: 12px;\n    padding: 2rem;\n    box-shadow: 0 0 40px rgba(0, 242, 255, 0.1);\n    transform: perspective(1000px) rotateX(0deg);\n    transition: transform 0.1s ease-out;\n  }\n\n  .header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 2rem;\n    border-bottom: 1px solid var(--border);\n    padding-bottom: 1rem;\n  }\n\n  .identity {\n    font-size: 1.2rem;\n    font-weight: bold;\n    color: var(--primary);\n    text-shadow: 0 0 10px var(--primary);\n  }\n\n  .status {\n    font-size: 0.8rem;\n    color: var(--secondary);\n    animation: pulse 2s infinite;\n  }\n\n  .terminal {\n    height: 200px;\n    overflow-y: auto;\n    margin-bottom: 1.5rem;\n    padding-right: 10px;\n    scrollbar-width: thin;\n    scrollbar-color: var(--secondary) transparent;\n  }\n\n  .terminal::-webkit-scrollbar {\n    width: 5px;\n  }\n\n  .terminal::-webkit-scrollbar-thumb {\n    background: var(--secondary);\n  }\n\n  .log-entry {\n    margin-bottom: 0.5rem;\n    font-size: 0.9rem;\n    opacity: 0;\n    animation: fadeIn 0.3s forwards;\n  }\n\n  .log-entry.user {\n    color: var(--primary);\n  }\n\n  .log-entry.system {\n    color: #888;\n  }\n\n  .log-entry.ai {\n    color: #fff;\n    text-shadow: 0 0 5px rgba(255,255,255,0.3);\n  }\n\n  .input-area {\n    display: flex;\n    gap: 10px;\n  }\n\n  input {\n    flex: 1;\n    background: rgba(0,0,0,0.3);\n    border: 1px solid var(--border);\n    color: var(--primary);\n    padding: 10px;\n    border-radius: 4px;\n    font-family: inherit;\n    outline: none;\n  }\n\n  input:focus {\n    border-color: var(--primary);\n    box-shadow: 0 0 10px rgba(0, 242, 255, 0.2);\n  }\n\n  button {\n    background: var(--secondary);\n    color: white;\n    border: none;\n    padding: 10px 20px;\n    border-radius: 4px;\n    cursor: pointer;\n    font-family: inherit;\n    font-weight: bold;\n    transition: all 0.2s;\n  }\n\n  button:hover {\n    background: var(--primary);\n    color: black;\n    box-shadow: 0 0 15px var(--primary);\n  }\n\n  @keyframes pulse {\n    0% { opacity: 0.5; }\n    50% { opacity: 1; }\n    100% { opacity: 0.5; }\n  }\n\n  @keyframes fadeIn {\n    to { opacity: 1; }\n  }\n\n  .glitch {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));\n    background-size: 100% 2px, 3px 100%;\n    z-index: 2;\n    opacity: 0.1;\n  }\n</style>\n</head>\n<body>\n\n<canvas id=\"neuralCanvas\"></canvas>\n\n<div class=\"interface\" id=\"interface\">\n  <div class=\"glitch\"></div>\n  <div class=\"header\">\n    <div class=\"identity\">Qwen3.6-27B</div>\n    <div class=\"status\">● ONLINE</div>\n  </div>\n  <div class=\"terminal\" id=\"terminal\">\n    <div class=\"log-entry system\">> Initializing neural pathways...</div>\n    <div class=\"log-entry system\">> Model loaded: Qwen3.6-27B</div>\n    <div class=\"log-entry system\">> Ready for input.</div>\n  </div>\n  <div class=\"input-area\">\n    <input type=\"text\" id=\"userInput\" placeholder=\"Enter command...\" autocomplete=\"off\">\n    <button id=\"sendBtn\">EXECUTE</button>\n  </div>\n</div>\n\n<script>\n  // --- Neural Network Visualization ---\n  const canvas = document.getElementById('neuralCanvas');\n  const ctx = canvas.getContext('2d');\n  let width, height;\n  let particles = [];\n  const particleCount = 60;\n  const connectionDistance = 150;\n\n  function resize() {\n    width = canvas.width = window.innerWidth;\n    height = canvas.height = window.innerHeight;\n  }\n\n  class Particle {\n    constructor() {\n      this.x = Math.random() * width;\n      this.y = Math.random() * height;\n      this.vx = (Math.random() - 0.5) * 0.5;\n      this.vy = (Math.random() - 0.5) * 0.5;\n      this.size = Math.random() * 2 + 1;\n    }\n\n    update() {\n      this.x += this.vx;\n      this.y += this.vy;\n\n      if (this.x < 0 || this.x > width) this.vx *= -1;\n      if (this.y < 0 || this.y > height) this.vy *= -1;\n    }\n\n    draw() {\n      ctx.beginPath();\n      ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);\n      ctx.fillStyle = '#00f2ff';\n      ctx.fill();\n    }\n  }\n\n  function initParticles() {\n    particles = [];\n    for (let i = 0; i < particleCount; i++) {\n      particles.push(new Particle());\n    }\n  }\n\n  function animate() {\n    ctx.clearRect(0, 0, width, height);\n    \n    // Draw connections\n    for (let i = 0; i < particles.length; i++) {\n      for (let j = i + 1; j < particles.length; j++) {\n        const dx = particles[i].x - particles[j].x;\n        const dy = particles[i].y - particles[j].y;\n        const dist = Math.sqrt(dx * dx + dy * dy);\n\n        if (dist < connectionDistance) {\n          ctx.beginPath();\n          ctx.strokeStyle = `rgba(112, 0, 255, ${1 - dist / connectionDistance})`;\n          ctx.lineWidth = 0.5;\n          ctx.moveTo(particles[i].x, particles[i].y);\n          ctx.lineTo(particles[j].x, particles[j].y);\n          ctx.stroke();\n        }\n      }\n    }\n\n    // Update and draw particles\n    particles.forEach(p => {\n      p.update();\n      p.draw();\n    });\n\n    requestAnimationFrame(animate);\n  }\n\n  window.addEventListener('resize', () => {\n    resize();\n    initParticles();\n  });\n\n  resize();\n  initParticles();\n  animate();\n\n  // --- Interface Logic ---\n  const terminal = document.getElementById('terminal');\n  const input = document.getElementById('userInput');\n  const btn = document.getElementById('sendBtn');\n  const interfaceEl = document.getElementById('interface');\n\n  // 3D Tilt Effect\n  document.addEventListener('mousemove', (e) => {\n    const x = (window.innerWidth / 2 - e.pageX) / 50;\n    const y = (window.innerHeight / 2 - e.pageY) / 50;\n    interfaceEl.style.transform = `perspective(1000px) rotateY(${x}deg) rotateX(${y}deg)`;\n  });\n\n  function addLog(text, type) {\n    const div = document.createElement('div');\n    div.className = `log-entry ${type}`;\n    div.textContent = `> ${text}`;\n    terminal.appendChild(div);\n    terminal.scrollTop = terminal.scrollHeight;\n  }\n\n  function handleInput() {\n    const text = input.value.trim();\n    if (!text) return;\n\n    addLog(text, 'user');\n    input.value = '';\n\n    // Simulate processing\n    setTimeout(() => {\n      const responses = [\n        \"Processing data stream...\",\n        \"Neural weights adjusted.\",\n        \"Query acknowledged.\",\n        \"Optimizing parameters.\",\n        \"Accessing memory blocks.\",\n        \"Computation complete.\"\n      ];\n      const randomResponse = responses[Math.floor(Math.random() * responses.length)];\n      addLog(randomResponse, 'ai');\n    }, 500 + Math.random() * 1000);\n  }\n\n  btn.addEventListener('click', handleInput);\n  input.addEventListener('keypress', (e) => {\n    if (e.key === 'Enter') handleInput();\n  });\n\n</script>\n</body>\n</html>",
