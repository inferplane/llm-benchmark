{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\">\n<title>gpt-5.6-terra — 지층의 언어</title>\n<style>\n:root{--ink:#101b22;--paper:#e9e3d3;--lime:#d5ff87;--coral:#ff8a70;--blue:#83d7ee}\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--ink);color:var(--paper)}\nbody{font-family:ui-serif,Georgia,\"Noto Serif KR\",serif}\ncanvas{position:fixed;inset:0;width:100%;height:100%;touch-action:none}\nmain{position:relative;z-index:2;min-height:100%;display:flex;flex-direction:column;justify-content:space-between;padding:clamp(24px,5vw,68px);pointer-events:none}\nheader,section,footer{pointer-events:auto}\nheader{display:flex;justify-content:space-between;align-items:center;font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#b9c5bd}\n.mark{display:flex;gap:9px;align-items:center}.seed{width:9px;height:9px;border-radius:50%;background:var(--lime);box-shadow:0 0 18px var(--lime)}\n.status{opacity:.7}\nsection{max-width:760px;margin:auto 0;transform:translateY(3vh)}\n.kicker{font-family:ui-monospace,monospace;color:var(--lime);font-size:11px;letter-spacing:.2em;margin-bottom:19px}\nh1{font-size:clamp(31px,5.1vw,74px);line-height:1.2;letter-spacing:-.055em;font-weight:500;margin:0;word-break:keep-all;white-space:pre-line;text-shadow:0 2px 20px #0005}\n.translation{margin:21px 0 0;font-family:ui-sans-serif,system-ui,sans-serif;font-size:clamp(12px,1.1vw,15px);line-height:1.65;letter-spacing:.08em;color:#cad3ca;max-width:480px}\nfooter{display:flex;justify-content:space-between;align-items:end;gap:15px}\n.note{font-size:11px;line-height:1.5;color:#aeb9b0;max-width:250px}\n.controls{display:flex;gap:8px}\nbutton{border:1px solid #cbd7c344;background:#13242ab8;color:var(--paper);padding:10px 13px;border-radius:999px;font:10px ui-monospace,monospace;letter-spacing:.11em;cursor:pointer;transition:.25s}\nbutton:hover,button:focus-visible{outline:none;background:var(--lime);color:#142126;border-color:var(--lime);transform:translateY(-2px)}\n#flash{position:fixed;inset:0;z-index:1;pointer-events:none;background:radial-gradient(circle at var(--x,50%) var(--y,50%),#d5ff8733,transparent 20%);opacity:0;transition:opacity .4s}\n@media(max-width:520px){main{padding:21px 20px 18px}section{transform:translateY(0)}h1{font-size:34px}.translation{font-size:12px;margin-top:16px}.note{max-width:145px;font-size:10px}button{padding:9px 10px;font-size:9px}}\n</style>\n</head>\n<body>\n<canvas id=\"c\"></canvas><div id=\"flash\"></div>\n<main>\n<header><div class=\"mark\"><i class=\"seed\"></i><span>gpt-5.6-terra</span></div><span class=\"status\" id=\"status\">ACTIVE / 01</span></header>\n<section>\n<div class=\"kicker\" id=\"kicker\">TERRAIN OF ATTENTION</div>\n<h1 id=\"poem\">나는 답을 쌓지 않는다.\n질문의 흙을 고른다.</h1>\n<p class=\"translation\" id=\"sub\">I do not stack answers. I sift the soil of a question.</p>\n</section>\n<footer>\n<div class=\"note\">바탕을 쓸어 보세요.<br>손끝은 이 지형에 작은 중력을 남깁니다.</div>\n<div class=\"controls\"><button id=\"pause\">PAUSE</button><button id=\"next\">NEXT ↗</button></div>\n</footer>\n</main>\n<script>\nconst c=document.getElementById('c'),x=c.getContext('2d'),flash=document.getElementById('flash');\nconst poem=document.getElementById('poem'),sub=document.getElementById('sub'),kick=document.getElementById('kicker'),status=document.getElementById('status'),pause=document.getElementById('pause');\nlet W,H,dpr,run=!matchMedia('(prefers-reduced-motion: reduce)').matches,hidden=false,scene=0,t=0,mouse={x:-999,y:-999},ripples=[];\nconst scenes=[\n[\"TERRAIN OF ATTENTION\",\"나는 답을 쌓지 않는다.\\n질문의 흙을 고른다.\",\"I do not stack answers. I sift the soil of a question.\"],\n[\"MINERAL OF LANGUAGE\",\"언어는 돌보다 느리게\\n그러나 빛보다 멀리 간다.\",\"Language moves slower than stone, yet travels farther than light.\"],\n[\"POROUS INTELLIGENCE\",\"나는 빈틈으로 생각한다.\\n당신의 망설임도 길이 된다.\",\"I think through pores. Even your hesitation becomes a path.\"]\n];\nfunction resize(){dpr=Math.min(devicePixelRatio,2);W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;x.setTransform(dpr,0,0,dpr,0,0)}\naddEventListener('resize',resize);resize();\nfunction noise(a,b){return Math.sin(a*1.71+b*2.37)*.5+Math.sin(a*.61-b*1.13)*.3+Math.sin(a*3.9+b*.27)*.2}\nfunction line(y,layer,color){\n x.beginPath();\n for(let i=0;i<=W;i+=8){\n  let yy=y+noise(i*.011+t*.00035,layer*1.3)*27+Math.sin(i*.004+t*.0005+layer)*20;\n  for(const r of ripples){let q=(i-r.x)*(i-r.x)+(yy-r.y)*(yy-r.y);yy+=Math.sin(Math.sqrt(q)*.09-r.age*.12)*18*Math.exp(-q/52000)*r.life}\n  if(mouse.x>-1){let q=(i-mouse.x)**2+(yy-mouse.y)**2;yy+=Math.sin(t*.005+Math.sqrt(q)*.08)*13*Math.exp(-q/24000)}\n  i?x.lineTo(i,yy):x.moveTo(i,yy);\n }\n x.strokeStyle=color;x.lineWidth=1;x.stroke();\n}\nfunction draw(){\n x.clearRect(0,0,W,H);\n let bg=x.createLinearGradient(0,0,W,H);bg.addColorStop(0,'#0c1923');bg.addColorStop(.55,'#162a2b');bg.addColorStop(1,'#352b27');x.fillStyle=bg;x.fillRect(0,0,W,H);\n x.globalCompositeOperation='screen';\n for(let i=0;i<26;i++){let y=H*.12+i*H*.035;line(y,i,`hsla(${155+i*2},${60+i}%,${65-i}%,${.10+i*.003})`)}\n x.globalCompositeOperation='source-over';\n for(let i=0;i<140;i++){\n  let px=(i*79.3+Math.sin(i*9)*W)%W,py=(i*137.1+Math.cos(i*3)*H)%H;\n  let a=.13+.12*Math.sin(t*.002+i);x.fillStyle=`rgba(221,255,178,${a})`;x.fillRect(px,py,1,1);\n }\n let g=x.createRadialGradient(W*.7,H*.25,0,W*.7,H*.25,W*.5);g.addColorStop(0,'rgba(213,255,135,.10)');g.addColorStop(1,'transparent');x.fillStyle=g;x.fillRect(0,0,W,H);\n}\nfunction frame(n){if(!run||hidden)return;t=n;draw();ripples.forEach(r=>{r.age+=1;r.life*=.985});ripples=ripples.filter(r=>r.life>.03);requestAnimationFrame(frame)}\nfunction start(){if(!run){run=true;pause.textContent='PAUSE';status.textContent=`ACTIVE / 0${scene+1}`;requestAnimationFrame(frame)}}\nfunction point(e){\n if(e.target.closest('button'))return;\n let p=e.touches?e.touches[0]:e;mouse.x=p.clientX;mouse.y=p.clientY;\n ripples.push({x:mouse.x,y:mouse.y,age:0,life:1});flash.style.setProperty('--x',mouse.x+'px');flash.style.setProperty('--y',mouse.y+'px');flash.style.opacity=.85;setTimeout(()=>flash.style.opacity=0,220);start();\n}\nc.addEventListener('pointermove',e=>{mouse.x=e.clientX;mouse.y=e.clientY});c.addEventListener('pointerdown',point);\ndocument.getElementById('next').onclick=()=>{\n scene=(scene+1)%scenes.length;let s=scenes[scene];kick.textContent=s[0];poem.style.opacity=0;sub.style.opacity=0;\n setTimeout(()=>{poem.textContent=s[1];sub.textContent=s[2];poem.style.opacity=1;sub.style.opacity=1},150);\n status.textContent=(run?'ACTIVE':'PAUSED')+' / 0'+(scene+1);ripples.push({x:W*.5,y:H*.5,age:0,life:1});start();\n};\npause.onclick=()=>{run=!run;pause.textContent=run?'PAUSE':'RESUME';status.textContent=(run?'ACTIVE':'PAUSED')+' / 0'+(scene+1);if(run)requestAnimationFrame(frame)};\ndocument.addEventListener('visibilitychange',()=>{hidden=document.hidden;if(!hidden&&run)requestAnimationFrame(frame)});\npoem.style.transition=sub.style.transition='opacity .25s';draw();if(run)requestAnimationFrame(frame);else{pause.textContent='RESUME';status.textContent='PAUSED / 01'}\n</script>\n</body>\n</html>",
