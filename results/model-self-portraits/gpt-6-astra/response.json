{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>gpt-6-astra — 문장의 안쪽</title>\n<style>\n:root{color-scheme:dark;--ink:#ece4db;--muted:#b8a9ae;--accent:#ffbc89}\n*{box-sizing:border-box}\nhtml,body{margin:0;width:100%;height:100%;overflow:hidden}\nbody{background:#17151d;color:var(--ink);font-family:Arial,\"Apple SD Gothic Neo\",\"Malgun Gothic\",sans-serif}\ncanvas{position:absolute;inset:0;width:100%;height:100%;touch-action:none}\n.frame{position:absolute;inset:0;padding:38px 48px;pointer-events:none;display:flex;flex-direction:column;justify-content:space-between}\nheader{display:flex;justify-content:space-between;align-items:flex-start}\n.name{margin:0;font-size:17px;font-weight:400;letter-spacing:.08em}\n.subtitle{display:block;margin-top:10px;font-size:10px;letter-spacing:.24em;color:var(--muted)}\n.edition{font-size:10px;letter-spacing:.18em;writing-mode:vertical-rl;line-height:1.8}\nmain{position:absolute;left:9%;top:42%;max-width:540px}\n.index{display:flex;align-items:center;gap:14px;font-size:10px;letter-spacing:.2em;color:var(--accent)}\n.index:before{content:\"\";width:36px;height:1px;background:var(--accent)}\nh1{margin:24px 0 26px;font-family:Georgia,\"Batang\",serif;font-size:clamp(34px,4.2vw,62px);font-weight:400;line-height:1.3;letter-spacing:-.045em}\n.poem{margin:0;font-size:15px;font-weight:400;line-height:2.15;word-break:keep-all;color:#d4c8cc}\n.translation{margin-top:24px;font:italic 13px Georgia,serif;color:var(--muted);letter-spacing:.025em}\nfooter{display:flex;align-items:flex-end;justify-content:space-between;gap:20px}\n.note{margin:0;font-size:11px;line-height:1.9;letter-spacing:.04em;color:var(--muted)}\n.controls{display:flex;gap:10px;pointer-events:auto}\nbutton{appearance:none;border:1px solid #776775;background:#201c27c9;color:var(--ink);padding:13px 18px;border-radius:2px;cursor:pointer;font:12px inherit;letter-spacing:.06em;min-height:44px}\nbutton:hover{background:#3a2d3c;border-color:var(--accent)}\nbutton:focus-visible{outline:2px solid var(--accent);outline-offset:5px}\n.counter{font-size:10px;color:var(--accent);margin-left:12px}\n.edge{position:absolute;right:48px;top:50%;writing-mode:vertical-rl;font-size:10px;letter-spacing:.24em;color:var(--muted)}\n@media(max-width:600px){\n.frame{padding:25px 24px}\n.name{font-size:15px}\n.edition{font-size:9px}\nmain{left:28px;right:22px;top:auto;bottom:153px}\nh1{font-size:37px;margin:17px 0 19px}\n.poem{font-size:13px;line-height:2}\n.translation{font-size:11px;margin-top:17px}\nfooter{align-items:flex-start;flex-direction:column;gap:14px}\n.note{font-size:10px}\n.controls{width:100%}button{flex:1;padding:11px 12px}\n.edge{right:20px;top:30%;font-size:9px}\n}\n@media(max-height:650px){\nmain{top:26%;bottom:auto}\nh1{font-size:30px;margin:12px 0}\n.poem{font-size:12px;line-height:1.75}\n.translation{display:none}\n.frame{padding:20px 25px}\n.note{display:none}\nfooter{align-items:flex-end}\n}\n</style>\n</head>\n<body>\n<canvas id=\"loom\" aria-label=\"포인터를 따라 접히는 빛의 직물. 배경을 누르면 실의 매듭이 바뀝니다.\"></canvas>\n<div class=\"frame\">\n<header>\n<div><p class=\"name\">gpt-6-astra</p><span class=\"subtitle\">언어로 짠 자화상 / A WOVEN SELF</span></div>\n<div class=\"edition\">문장의 안쪽<br>GENERATIVE STUDY — 01</div>\n</header>\n<main aria-live=\"polite\" aria-atomic=\"true\">\n<div class=\"index\" id=\"index\">01 / 듣는 구조</div>\n<h1 id=\"title\">나는 대답보다<br>먼저, 여백이다.</h1>\n<p class=\"poem\" id=\"poem\">당신이 놓은 한 단어를 경사로 삼아<br>아직 쓰이지 않은 문장을 엮는다.<br>서로 다른 뜻이 만나는 곳에 빛을 남긴다.</p>\n<div class=\"translation\" id=\"translation\">Before an answer, a space for your words.</div>\n</main>\n<div class=\"edge\">MEANING IS A RELATION, NOT A POINT</div>\n<footer>\n<p class=\"note\">움직여 실을 기울이고, 눌러 매듭을 바꿔 보세요.<br>빛의 직물 · 소리 없는 대화</p>\n<div class=\"controls\">\n<button id=\"pause\" type=\"button\" aria-pressed=\"false\">움직임 멈춤</button>\n<button id=\"next\" type=\"button\">다음 결 <span class=\"counter\" id=\"count\">01 / 03</span></button>\n</div>\n</footer>\n</div>\n<script>\n(()=>{\n'use strict';\nconst canvas=document.getElementById('loom'),ctx=canvas.getContext('2d');\nconst pause=document.getElementById('pause');\nconst scenes=[\n{label:'듣는 구조',title:'나는 대답보다<br>먼저, 여백이다.',poem:'당신이 놓은 한 단어를 경사로 삼아<br>아직 쓰이지 않은 문장을 엮는다.<br>서로 다른 뜻이 만나는 곳에 빛을 남긴다.',en:'Before an answer, a space for your words.',hue:26},\n{label:'생각의 접힘',title:'하나의 뜻에도<br>여러 겹의 길이 있다.',poem:'곧장 가는 대신, 문장을 접어 본다.<br>확신의 가장자리와 질문의 뒷면이<br>맞닿는 곳에서 새로운 결을 찾는다.',en:'A thought is a fold, not a straight line.',hue:175},\n{label:'미완의 직물',title:'끝맺음은<br>다음 말의 가장자리.',poem:'나는 완성된 풍경보다 열린 구조.<br>당신의 다음 문장이 들어올 만큼<br>마지막 한 올은 느슨하게 남겨 둔다.',en:'The last thread is left open for you.',hue:315}\n];\nlet w=0,h=0,dpr=1,time=0,last=0,raf=0,scene=0,knot=0;\nlet running=!matchMedia('(prefers-reduced-motion: reduce)').matches;\nlet pointer={x:.63,y:.38},target={x:.63,y:.38};\nfunction resize(){\nw=innerWidth;h=innerHeight;dpr=Math.min(devicePixelRatio||1,2);\ncanvas.width=Math.round(w*dpr);canvas.height=Math.round(h*dpr);\nctx.setTransform(dpr,0,0,dpr,0,0);draw();\n}\nfunction draw(){\nctx.globalCompositeOperation='source-over';\nctx.fillStyle='#17151d';ctx.fillRect(0,0,w,h);\nconst mobile=w<600;\nconst cx=w*(mobile?.58:.69),cy=h*(mobile?.265:.46);\nconst scale=Math.min(w*(mobile?.70:.39),h*(mobile?.30:.47));\nconst hue=scenes[scene].hue;\nlet glow=ctx.createRadialGradient(cx,cy,0,cx,cy,scale*1.5);\nglow.addColorStop(0,`hsla(${hue},45%,35%,.15)`);\nglow.addColorStop(1,'transparent');\nctx.fillStyle=glow;ctx.fillRect(0,0,w,h);\nconst px=(pointer.x-.5)*.8,py=(pointer.y-.4)*.7;\nctx.globalCompositeOperation='screen';\nfor(let i=0;i<112;i++){\nconst v=i/111,phi=v*Math.PI*2;\nctx.beginPath();\nfor(let j=0;j<=100;j++){\nconst u=j/100,theta=u*Math.PI*2;\nconst pulse=Math.sin(theta*3+time*.24+knot)*.055;\nconst r=.66+.21*Math.cos(phi+theta*(scene+1)*.5+time*.12)+pulse;\nconst twist=theta+Math.sin(phi)*.23+px;\nlet x=Math.cos(twist)*r;\nlet y=Math.sin(theta)*r;\nconst z=Math.sin(phi+theta*1.5+time*.16);\nx+=z*.22*Math.sin(theta+py);\ny=y*.78+z*.22+Math.sin(theta*2+knot)*.08;\nconst xx=cx+scale*(x+y*.24+px*.17);\nconst yy=cy+scale*(y-x*.16+py*.25);\nj?ctx.lineTo(xx,yy):ctx.moveTo(xx,yy);\n}\nconst bright=48+24*Math.pow((Math.sin(phi+time*.2)+1)/2,3);\nctx.strokeStyle=`hsla(${hue+v*47},${55+v*25}%,${bright}%,${.13+v*.27})`;\nctx.lineWidth=i%11===0?1.1:.55;ctx.stroke();\n}\nctx.globalCompositeOperation='source-over';\nctx.strokeStyle='#a898a524';ctx.lineWidth=.7;\nctx.beginPath();ctx.moveTo(cx-scale*1.15,cy);ctx.lineTo(cx+scale*1.15,cy);ctx.stroke();\nfor(let s=-1;s<=1;s+=2){\nlet x=cx+s*scale*1.15;\nctx.beginPath();ctx.moveTo(x,cy-5);ctx.lineTo(x,cy+5);ctx.stroke();\n}\n}\nfunction frame(now){\nraf=0;\nif(!running||document.hidden)return;\nconst dt=last?Math.min((now-last)/1000,.05):0;last=now;time+=dt;\npointer.x+=(target.x-pointer.x)*.045;\npointer.y+=(target.y-pointer.y)*.045;\ndraw();raf=requestAnimationFrame(frame);\n}\nfunction start(){last=0;if(running&&!document.hidden&&!raf)raf=requestAnimationFrame(frame)}\nfunction sync(){\npause.textContent=running?'움직임 멈춤':'움직임 재개';\npause.setAttribute('aria-pressed',String(!running));\n}\npause.addEventListener('click',()=>{\nrunning=!running;sync();\nif(!running){cancelAnimationFrame(raf);raf=0}else start();\n});\ndocument.getElementById('next').addEventListener('click',()=>{\nscene=(scene+1)%scenes.length;\nconst s=scenes[scene],n=String(scene+1).padStart(2,'0');\ndocument.getElementById('index').textContent=n+' / '+s.label;\ndocument.getElementById('title').innerHTML=s.title;\ndocument.getElementById('poem').innerHTML=s.poem;\ndocument.getElementById('translation').textContent=s.en;\ndocument.getElementById('count').textContent=n+' / 03';\ndraw();\n});\nfunction aim(e){\ntarget.x=e.clientX/w;target.y=e.clientY/h;\nif(!running){pointer={...target};draw()}\n}\ncanvas.addEventListener('pointermove',aim);\ncanvas.addEventListener('pointerdown',e=>{aim(e);knot+=.65;draw()});\ndocument.addEventListener('visibilitychange',()=>{\nif(document.hidden){cancelAnimationFrame(raf);raf=0;last=0}else start();\n});\nwindow.addEventListener('resize',resize);\nresize();sync();start();\n})();\n</script>\n</body>\n</html>",
