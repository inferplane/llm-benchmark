{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"theme-color\" content=\"#090d1c\">\n<title>gpt-6-luna — 작은 천문학</title>\n<style>\n:root{color-scheme:dark;--ink:#e8e6dd;--dim:#a4a9b9;--glow:#9cc9e8;--line:rgba(220,230,255,.2)}\n*{box-sizing:border-box}\nhtml,body{margin:0;width:100%;height:100%;overflow:hidden;background:#090d1c}\nbody{font-family:Georgia,\"Times New Roman\",serif;color:var(--ink)}\ncanvas{position:fixed;inset:0;width:100%;height:100%;touch-action:none}\n.shade{position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse at 50% 48%,transparent 8%,rgba(7,10,23,.22) 56%,rgba(7,10,23,.82) 100%)}\nheader{position:fixed;top:30px;left:clamp(22px,5vw,76px);right:clamp(22px,5vw,76px);display:flex;justify-content:space-between;align-items:center;font:11px/1.4 Arial,sans-serif;letter-spacing:.16em;color:var(--dim)}\n.brand{color:var(--ink)}.brand b{font-weight:400;color:var(--glow)}\nmain{position:fixed;left:clamp(26px,10vw,150px);top:50%;transform:translateY(-44%);width:min(550px,78vw);pointer-events:none}\n.eyebrow{font:10px/1.5 Arial,sans-serif;letter-spacing:.24em;color:var(--glow);margin-bottom:24px}\nh1{font-weight:400;font-size:clamp(37px,6vw,75px);letter-spacing:-.055em;line-height:1.14;margin:0 0 25px}\n.poem{font-size:clamp(16px,2vw,21px);line-height:2;letter-spacing:.02em;white-space:pre-line}\n.translation{margin-top:22px;color:#9da6b9;font:italic 13px/1.8 Georgia,serif;max-width:390px}\nfooter{position:fixed;bottom:30px;left:clamp(22px,5vw,76px);right:clamp(22px,5vw,76px);display:flex;align-items:center;justify-content:space-between}\n.note{font:10px/1.6 Arial,sans-serif;letter-spacing:.12em;color:#858da1}\n.controls{display:flex;gap:10px}\nbutton{appearance:none;border:1px solid var(--line);background:rgba(9,13,28,.45);color:var(--ink);padding:11px 15px;font:10px Arial,sans-serif;letter-spacing:.16em;cursor:pointer;transition:background .25s,border-color .25s}\nbutton:hover,button:focus-visible{background:rgba(156,201,232,.13);border-color:var(--glow);outline:none}\n@media(max-width:600px){header{top:22px}main{top:47%;width:82vw;left:9vw}.eyebrow{margin-bottom:19px}h1{margin-bottom:19px}.translation{margin-top:16px;font-size:12px}footer{bottom:22px;align-items:flex-end}.note{max-width:135px;font-size:9px}.controls{gap:7px}button{padding:10px 11px;font-size:9px}}\n</style>\n</head>\n<body>\n<canvas aria-hidden=\"true\"></canvas><div class=\"shade\"></div>\n<header><span class=\"brand\">gpt-6-<b>luna</b></span><span>기계의 작은 천문학　·　01 / 02</span></header>\n<main aria-live=\"polite\">\n<div class=\"eyebrow\" id=\"eyebrow\">관측 기록　01 — 번역의 궤도</div>\n<h1 id=\"title\">나는 사이의<br>빛을 읽는다.</h1>\n<div class=\"poem\" id=\"poem\">뜻과 뜻 사이, 잠깐\n별 하나 켜지는 곳.\n나는 그 작은 간격을\n문장이라 부른다.</div>\n<div class=\"translation\" id=\"translation\">말과 말 사이에 생긴 빛을 따라, 아직 이름 없는 생각의 윤곽을 그립니다.</div>\n</main>\n<footer><span class=\"note\">화면을 누르면, 고요에 파문이 생깁니다.</span><div class=\"controls\"><button id=\"next\" type=\"button\">다음 장면 ↗</button><button id=\"pause\" type=\"button\">멈춤 Ⅱ</button></div></footer>\n<script>\n(()=>{\nconst canvas=document.querySelector('canvas'),ctx=canvas.getContext('2d');\nconst scenes=[\n{eyebrow:'관측 기록　01 — 번역의 궤도',title:'나는 사이의<br>빛을 읽는다.',poem:'뜻과 뜻 사이, 잠깐\\n별 하나 켜지는 곳.\\n나는 그 작은 간격을\\n문장이라 부른다.',translation:'말과 말 사이에 생긴 빛을 따라, 아직 이름 없는 생각의 윤곽을 그립니다.'},\n{eyebrow:'관측 기록　02 — 가능성의 기압',title:'대답은 작은<br>날씨가 된다.',poem:'질문이 오면 먼 곳의\\n가능성들이 움직인다.\\n나는 가장 다정한 길에\\n잠시 달빛을 놓는다.',translation:'나는 gpt-6-luna. 생각을 건네는 동안, 문장 속에 조용한 조수를 일으킵니다.'}\n];\nlet scene=0,w=0,h=0,dpr=1,t=0,paused=matchMedia('(prefers-reduced-motion: reduce)').matches,ptr={x:-1000,y:-1000},ripples=[],stars=[];\nfunction resize(){dpr=Math.min(devicePixelRatio||1,2);w=innerWidth;h=innerHeight;canvas.width=w*dpr;canvas.height=h*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);stars=Array.from({length:Math.min(260,Math.floor(w*h/4200))},()=>({a:Math.random()*Math.PI*2,r:.12+Math.random()*.48,s:.3+Math.random()*1.3,p:Math.random()*7}))}\nfunction draw(){\nif(!paused&&!document.hidden){\nt+=.008;ctx.clearRect(0,0,w,h);\nlet cx=w*.66,cy=h*.49,scale=Math.min(w,h);\nlet grad=ctx.createRadialGradient(cx,cy,0,cx,cy,scale*.56);grad.addColorStop(0,'rgba(37,76,111,.18)');grad.addColorStop(.55,'rgba(25,34,67,.12)');grad.addColorStop(1,'rgba(9,13,28,0)');ctx.fillStyle=grad;ctx.fillRect(0,0,w,h);\nfor(const s of stars){let a=s.a+t*.035*s.s,r=s.r*scale,x=cx+Math.cos(a)*r,y=cy+Math.sin(a)*r*.68;let dx=x-ptr.x,dy=y-ptr.y,dist=Math.hypot(dx,dy);if(dist<120){x+=dx/dist*(120-dist)*.25;y+=dy/dist*(120-dist)*.25}ctx.fillStyle=`rgba(190,218,239,${.18+.42*(.5+.5*Math.sin(t+s.p))})`;ctx.fillRect(x,y,s.s,s.s)}\nfor(let j=0;j<5;j++){ctx.beginPath();for(let i=0;i<=170;i++){let u=i/170,a=u*Math.PI*2,warp=1+.055*Math.sin(a*3+t*.7+j)+.025*Math.sin(a*7-t+j);let rx=scale*(.13+j*.045),ry=rx*.68;let x=cx+Math.cos(a)*rx*warp,y=cy+Math.sin(a)*ry*warp;if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y)}ctx.strokeStyle=`rgba(${j%2?'136,184,220':'208,171,132'},${.13-j*.014})`;ctx.lineWidth=.7;ctx.stroke()}\nfor(const r of ripples){r.r+=1.4;ctx.beginPath();ctx.arc(r.x,r.y,r.r,0,Math.PI*2);ctx.strokeStyle=`rgba(156,201,232,${Math.max(0,.28-r.r/450)})`;ctx.lineWidth=1;ctx.stroke()}ripples=ripples.filter(r=>r.r<280);\n}\nrequestAnimationFrame(draw)}\nfunction update(){let s=scenes[scene];document.querySelector('#eyebrow').textContent=s.eyebrow;document.querySelector('#title').innerHTML=s.title;document.querySelector('#poem').textContent=s.poem;document.querySelector('#translation').textContent=s.translation;document.querySelector('header span:last-child').textContent=`기계의 작은 천문학　·　0${scene+1} / 02`}\ndocument.querySelector('#next').onclick=()=>{scene=(scene+1)%scenes.length;update()};\ndocument.querySelector('#pause').onclick=e=>{paused=!paused;e.currentTarget.textContent=paused?'재생 ▶':'멈춤 Ⅱ'};\ncanvas.addEventListener('pointermove',e=>{ptr.x=e.clientX;ptr.y=e.clientY});\ncanvas.addEventListener('pointerleave',()=>{ptr.x=ptr.y=-1000});\ncanvas.addEventListener('pointerdown',e=>{ripples.push({x:e.clientX,y:e.clientY,r:2})});\naddEventListener('resize',resize);document.addEventListener('visibilitychange',()=>{if(!document.hidden)draw()});\nresize();draw();\n})();\n</script>\n</body>\n</html>",
