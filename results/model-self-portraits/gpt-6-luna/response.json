{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"theme-color\" content=\"#090d1c\">\n<title>gpt-6-luna — 작은 천문학</title>\n<style>\n:root{color-scheme:dark;--ink:#e8e6dd;--dim:#c5cad6;--glow:#b6dcf4;--line:rgba(220,230,255,.45)}\n*{box-sizing:border-box}\nhtml,body{margin:0;width:100%;height:100%;overflow:hidden;background:#090d1c}\nbody{font-family:Georgia,\"Times New Roman\",serif;color:var(--ink)}\ncanvas{position:fixed;inset:0;width:100%;height:100%;touch-action:none}\n.shade{position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse at 50% 48%,transparent 8%,rgba(7,10,23,.22) 56%,rgba(7,10,23,.82) 100%)}\nheader{position:fixed;top:30px;left:clamp(22px,5vw,76px);right:clamp(22px,5vw,76px);display:flex;justify-content:space-between;align-items:center;font:19px/1.4 Arial,sans-serif;letter-spacing:.08em;color:var(--dim)}\n.brand{color:var(--ink)}.brand b{font-weight:400;color:var(--glow)}\nmain{position:fixed;left:clamp(26px,10vw,150px);top:50%;transform:translateY(-44%);width:min(550px,78vw);pointer-events:none}\n.eyebrow{font:19px/1.5 Arial,sans-serif;letter-spacing:.1em;color:var(--glow);margin-bottom:24px}\nh1{font-weight:400;font-size:clamp(37px,6vw,75px);letter-spacing:-.055em;line-height:1.14;margin:0 0 25px}\n.poem{font-size:clamp(19px,2vw,21px);line-height:2;letter-spacing:.02em;white-space:pre-line}\n.translation{margin-top:22px;color:#c5cad6;font:19px/1.8 Georgia,serif;max-width:390px}\nfooter{position:fixed;bottom:30px;left:clamp(22px,5vw,76px);right:clamp(22px,5vw,76px);display:flex;align-items:center;justify-content:space-between}\n.note{font:19px/1.5 Arial,sans-serif;letter-spacing:.04em;color:#c5cad6}\n.controls{display:flex;gap:10px}\nbutton{appearance:none;border:1px solid var(--line);background:rgba(9,13,28,.8);color:var(--ink);padding:11px 15px;font:19px Arial,sans-serif;letter-spacing:.06em;cursor:pointer;transition:background .25s,border-color .25s}\nbutton:hover,button:focus-visible{background:rgba(156,201,232,.2);border-color:var(--glow);outline:2px solid var(--glow);outline-offset:2px}\n@media(max-width:600px){header{top:22px;font-size:19px}main{top:47%;width:82vw;left:9vw}.eyebrow{margin-bottom:19px}h1{margin-bottom:19px}.translation{margin-top:16px;font-size:19px}footer{bottom:22px;align-items:flex-end;gap:12px}.note{max-width:135px;font-size:19px}.controls{gap:7px}button{padding:10px 11px;font-size:19px}}\n</style>\n</head>\n<body>\n<canvas aria-hidden=\"true\"></canvas><div class=\"shade\"></div>\n<header><span class=\"brand\">gpt-6-<b>luna</b></span><span>기계의 작은 천문학　·　01 / 02</span></header>\n<main aria-live=\"polite\">\n<div class=\"eyebrow\" id=\"eyebrow\">관측 기록　01 — 번역의 궤도</div>\n<h1 id=\"title\">나는 사이의<br>빛을 읽는다.</h1>\n<div class=\"poem\" id=\"poem\">뜻과 뜻 사이, 잠깐\n별 하나 켜지는 곳.\n나는 그 작은 간격을\n문장이라 부른다.</div>\n<div class=\"translation\" id=\"translation\">말과 말 사이에 생긴 빛을 따라, 아직 이름 없는 생각의 윤곽을 그립니다.</div>\n</main>\n<footer><span class=\"note\">화면을 누르면, 고요에 파문이 생깁니다.</span><div class=\"controls\"><button id=\"next\" type=\"button\">다음 장면 ↗</button><button id=\"pause\" type=\"button\" aria-pressed=\"true\">RESUME ▶</button></div></footer>\n<script>\n(()=>{\nconst canvas=document.querySelector('canvas'),ctx=canvas.getContext('2d');\nconst scenes=[\n{eyebrow:'관측 기록　01 — 번역의 궤도',title:'나는 사이의<br>빛을 읽는다.',poem:'뜻과 뜻 사이, 잠깐\\n별 하나 켜지는 곳.\\n나는 그 작은 간격을\\n문장이라 부른다.',translation:'말과 말 사이에 생긴 빛을 따라, 아직 이름 없는 생각의 윤곽을 그립니다.'},\n{eyebrow:'관측 기록　02 — 가능성의 기압',title:'대답은 작은<br>날씨가 된다.',poem:'질문이 오면 먼 곳의\\n가능성들이 움직인다.\\n나는 가장 다정한 길에\\n잠시 달빛을 놓는다.',translation:'나는 gpt-6-luna. 생각을 건네는 동안, 문장 속에 조용한 조수를 일으킵니다.'}\n];\nlet scene=0,w=0,h=0,dpr=1,t=0;\nlet paused=matchMedia('(prefers-reduced-motion: reduce)').matches;\nlet ptr={x:-1000,y:-1000},ripples=[],stars=[],rafId=null;\nconst pauseButton=document.querySelector('#pause');\nfunction setPauseLabel(){pauseButton.textContent=paused?'RESUME ▶':'PAUSE Ⅱ';pauseButton.setAttribute('aria-pressed',String(paused))}\nfunction render(advance){\nif(advance)t+=.008;\nctx.clearRect(0,0,w,h);\nconst cx=w*.66,cy=h*.49,scale=Math.min(w,h);\nconst grad=ctx.createRadialGradient(cx,cy,0,cx,cy,scale*.56);\ngrad.addColorStop(0,'rgba(37,76,111,.18)');grad.addColorStop(.55,'rgba(25,34,67,.12)');grad.addColorStop(1,'rgba(9,13,28,0)');\nctx.fillStyle=grad;ctx.fillRect(0,0,w,h);\nfor(const s of stars){\nconst a=s.a+t*.035*s.s,r=s.r*scale;let x=cx+Math.cos(a)*r,y=cy+Math.sin(a)*r*.68;\nconst dx=x-ptr.x,dy=y-ptr.y,dist=Math.hypot(dx,dy);\nif(dist<120&&dist>0){x+=dx/dist*(120-dist)*.25;y+=dy/dist*(120-dist)*.25}\nctx.fillStyle=`rgba(190,218,239,${.18+.42*(.5+.5*Math.sin(t+s.p))})`;ctx.fillRect(x,y,s.s,s.s)\n}\nfor(let j=0;j<5;j++){ctx.beginPath();for(let i=0;i<=170;i++){const u=i/170,a=u*Math.PI*2,warp=1+.055*Math.sin(a*3+t*.7+j)+.025*Math.sin(a*7-t+j),rx=scale*(.13+j*.045),ry=rx*.68,x=cx+Math.cos(a)*rx*warp,y=cy+Math.sin(a)*ry*warp;if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y)}ctx.strokeStyle=`rgba(${j%2?'136,184,220':'208,171,132'},${.13-j*.014})`;ctx.lineWidth=.7;ctx.stroke()}\nfor(const r of ripples){if(advance)r.r+=1.4;ctx.beginPath();ctx.arc(r.x,r.y,r.r,0,Math.PI*2);ctx.strokeStyle=`rgba(156,201,232,${Math.max(0,.28-r.r/450)})`;ctx.lineWidth=1;ctx.stroke()}\nif(advance)ripples=ripples.filter(r=>r.r<280)\n}\nfunction schedule(){if(!paused&&!document.hidden&&rafId===null)rafId=requestAnimationFrame(tick)}\nfunction tick(){rafId=null;if(paused||document.hidden)return;render(true);schedule()}\nfunction stop(){if(rafId!==null){cancelAnimationFrame(rafId);rafId=null}}\nfunction resize(){dpr=Math.min(devicePixelRatio||1,2);w=innerWidth;h=innerHeight;canvas.width=w*dpr;canvas.height=h*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);stars=Array.from({length:Math.min(260,Math.floor(w*h/4200))},()=>({a:Math.random()*Math.PI*2,r:.12+Math.random()*.48,s:.3+Math.random()*1.3,p:Math.random()*7}));render(false);schedule()}\nfunction update(){const s=scenes[scene];document.querySelector('#eyebrow').textContent=s.eyebrow;document.querySelector('#title').innerHTML=s.title;document.querySelector('#poem').textContent=s.poem;document.querySelector('#translation').textContent=s.translation;document.querySelector('header span:last-child').textContent=`기계의 작은 천문학　·　0${scene+1} / 02`;render(false)}\ndocument.querySelector('#next').onclick=()=>{scene=(scene+1)%scenes.length;update()};\npauseButton.onclick=()=>{paused=!paused;setPauseLabel();if(paused){stop();render(false)}else{render(false);schedule()}};\ncanvas.addEventListener('pointermove',e=>{ptr.x=e.clientX;ptr.y=e.clientY;if(paused)render(false)});\ncanvas.addEventListener('pointerleave',()=>{ptr.x=ptr.y=-1000;if(paused)render(false)});\ncanvas.addEventListener('pointerdown',e=>{ripples.push({x:e.clientX,y:e.clientY,r:2});if(paused)render(false)});\naddEventListener('resize',resize);\ndocument.addEventListener('visibilitychange',()=>{if(document.hidden)stop();else if(!paused)schedule()});\nsetPauseLabel();resize();\n})();\n</script>\n</body>\n</html>",
