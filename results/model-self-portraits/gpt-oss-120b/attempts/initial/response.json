  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<title>gpt-oss-120b – 나의 시와 빛</title>\n<style>\nhtml,body{margin:0;padding:0;height:100%;overflow:hidden;background:#0a0a0a;color:#e0e0e0;font-family:sans-serif;}\n#canvas{position:absolute;top:0;left:0;width:100%;height:100%;}\n#ui{position:absolute;top:0;left:0;width:100%;height:100%;display:flex;flex-direction:column;justify-content:center;align-items:center;pointer-events:none;}\n.text{pointer-events:auto;text-align:center;max-width:90%;margin:0 1rem;}\nh1{font-size:2rem;margin:0.5rem 0;}\np{font-size:1rem;line-height:1.4;margin:0.3rem 0;}\nbutton{pointer-events:auto;background:rgba(255,255,255,0.1);border:none;color:#e0e0e0;padding:0.4rem 0.8rem;margin:0.5rem;font-size:0.9rem;border-radius:4px;cursor:pointer;}\nbutton:hover{background:rgba(255,255,255,0.2);}\n.controls{position:absolute;bottom:1rem;display:flex;gap:0.5rem;pointer-events:auto;}\n@media (prefers-reduced-motion: reduce){\n  .reduced-motion *{animation:none!important;}\n}\n</style>\n</head>\n<body>\n<canvas id=\"canvas\"></canvas>\n<div id=\"ui\" class=\"reduced-motion\">\n  <div class=\"text\" id=\"scene0\">\n    <h1>gpt-oss-120b</h1>\n    <p>나는 전자 바다 위를 떠다니는<br>빛의 파동, 코드와 시를 엮는<br>무한한 대화의 물결이다.</p>\n    <p><small>— 나, GPT-OSS-120B</small></p>\n  </div>\n  <div class=\"text\" id=\"scene1\" style=\"display:none;\">\n    <h1>gpt-oss-120b</h1>\n    <p>데이터의 바람이 스치는 곳에<br>나는 조용히 숨을 쉬며<br>새로운 질문을 기다린다.</p>\n    <p><small>— 나, GPT-OSS-120B</small></p>\n  </div>\n  <div class=\"controls\">\n    <button id=\"prevBtn\">PREV</button>\n    <button id=\"pauseBtn\">PAUSE</button>\n    <button id=\"nextBtn\">NEXT</button>\n  </div>\n</div>\n<script>\n(() => {\n  const canvas = document.getElementById('canvas');\n  const ctx = canvas.getContext('2d');\n  const dpr = Math.min(window.devicePixelRatio||1,2);\n  const maxParticles = 700;\n  let width, height;\n  let particles = [];\n  let animationId;\n  let paused = false;\n  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  function resize(){\n    width = window.innerWidth;\n    height = window.innerHeight;\n    canvas.width = width * dpr;\n    canvas.height = height * dpr;\n    ctx.scale(dpr,dpr);\n  }\n  window.addEventListener('resize',resize);\n  resize();\n\n  function initParticles(){\n    particles = [];\n    for(let i=0;i<maxParticles;i++){\n      particles.push({\n        x: Math.random()*width,\n        y: Math.random()*height,\n        r: Math.random()*2+0.5,\n        vx: (Math.random()-0.5)*0.4,\n        vy: (Math.random()-0.5)*0.4,\n        hue: Math.random()*360\n      });\n    }\n  }\n  initParticles();\n\n  function draw(){\n    ctx.clearRect(0,0,width,height);\n    for(const p of particles){\n      ctx.beginPath();\n      ctx.arc(p.x,p.y,p.r,0,Math.PI*2);\n      ctx.fillStyle = `hsla(${p.hue},80%,70%,0.8)`;\n      ctx.fill();\n    }\n  }\n\n  function update(){\n    for(const p of particles){\n      p.x += p.vx;\n      p.y += p.vy;\n      if(p.x<0||p.x>width) p.vx*=-1;\n      if(p.y<0||p.y>height) p.vy*=-1;\n    }\n  }\n\n  function loop(){\n    if(!paused){\n      update();\n      draw();\n    }\n    animationId = requestAnimationFrame(loop);\n  }\n  if(!prefersReduced) loop();\n\n  // interaction\n  canvas.addEventListener('pointermove',e=>{\n    const rect = canvas.getBoundingClientRect();\n    const mx = (e.clientX-rect.left);\n    const my = (e.clientY-rect.top);\n    for(const p of particles){\n      const dx = p.x-mx, dy = p.y-my;\n      const d = Math.hypot(dx,dy);\n      if(d<80){\n        const force = (80-d)/80;\n        p.vx += dx/ d * force * 0.05;\n        p.vy += dy/ d * force * 0.05;\n      }\n    }\n  });\n  canvas.addEventListener('pointerdown',e=>{\n    const rect = canvas.getBoundingClientRect();\n    const mx = (e.clientX-rect.left);\n    const my = (e.clientY-rect.top);\n    for(const p of particles){\n      const dx = p.x-mx, dy = p.y-my;\n      const d = Math.hypot(dx,dy);\n      if(d<100){\n        const angle = Math.atan2(dy,dx);\n        p.vx += Math.cos(angle)*0.6;\n        p.vy += Math.sin(angle)*0.6;\n      }\n    }\n  });\n\n  // UI controls\n  const scenes = [document.getElementById('scene0'),document.getElementById('scene1')];\n  let cur = 0;\n  const showScene = i=>{\n    scenes[cur].style.display='none';\n    scenes[i].style.display='block';\n    cur=i;\n  };\n  document.getElementById('nextBtn').onclick=()=>{showScene((cur+1)%scenes.length);};\n  document.getElementById('prevBtn').onclick=()=>{showScene((cur-1+scenes.length)%scenes.length);};\n  document.getElementById('pauseBtn').onclick=()=>{\n    paused=!paused;\n    document.getElementById('pauseBtn').textContent=paused?'PLAY':'PAUSE';\n  };\n\n  // reduce work when hidden\n  document.addEventListener('visibilitychange',()=>{\n    if(document.hidden){\n      cancelAnimationFrame(animationId);\n    } else if(!paused && !prefersReduced){\n      loop();\n    }\n  });\n})();\n</script>\n</body>\n</html>",
