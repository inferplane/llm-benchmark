  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<title>gpt-oss-20b</title>\n<style>\nhtml,body{margin:0;height:100%;overflow:hidden;background:#111;color:#eee;font-family:system-ui,Arial,sans-serif;}\n#canvas{position:absolute;top:0;left:0;width:100%;height:100%;}\n#ui{position:absolute;top:10px;right:10px;display:flex;gap:8px;}\nbutton{background:#222;color:#eee;border:none;padding:8px 12px;border-radius:4px;cursor:pointer;}\nbutton:focus{outline:2px solid #fff;}\n#text{position:absolute;bottom:20%;left:50%;transform:translateX(-50%);text-align:center;pointer-events:none;}\n#text h1{font-size:2.5rem;margin:0;}\n#text p{font-size:1.2rem;margin:4px 0;}\n@media (max-width:480px){#text h1{font-size:1.8rem;}#text p{font-size:1rem;}}\n</style>\n</head>\n<body>\n<canvas id=\"canvas\"></canvas>\n<div id=\"ui\">\n<button id=\"pauseBtn\">PAUSE</button>\n<button id=\"nextBtn\">NEXT</button>\n</div>\n<div id=\"text\">\n<h1 id=\"title\"></h1>\n<p id=\"poem\"></p>\n<p id=\"model\">gpt-oss-20b</p>\n</div>\n<script>\nconst canvas=document.getElementById('canvas');\nconst ctx=canvas.getContext('2d');\nlet width, height, dpr;\nfunction resize(){\n  dpr=Math.min(window.devicePixelRatio||1,2);\n  width=canvas.clientWidth*dpr;\n  height=canvas.clientHeight*dpr;\n  canvas.width=width;\n  canvas.height=height;\n}\nresize();\nwindow.addEventListener('resize',resize);\n\nconst scenes=[\n{title:'빛의 언어',poem:'빛은 말없이\\n소리를 품고\\n세상을 노래한다',color:'#ff6f61'},\n{title:'음성의 그림',poem:'음성은 그림을 그려\\n숨결에 색을 입히고\\n마음에 울려 퍼진다',color:'#6f86ff'}\n];\nlet sceneIndex=0;\nlet paused=false;\nlet particles=[];\nconst maxParticles=700;\nconst mouse={x:0,y:0,down:false};\n\nfunction initParticles(){\n  particles=[];\n  for(let i=0;i<maxParticles;i++){\n    particles.push({\n      x:Math.random()*width,\n      y:Math.random()*height,\n      vx:(Math.random()-0.5)*0.5,\n      vy:(Math.random()-0.5)*0.5,\n      size:Math.random()*2+1,\n      alpha:Math.random()*0.5+0.5\n    });\n  }\n}\ninitParticles();\n\nfunction update(){\n  if(paused)return;\n  for(let p of particles){\n    p.x+=p.vx;\n    p.y+=p.vy;\n    if(p.x<0||p.x>width)p.vx*=-1;\n    if(p.y<0||p.y>height)p.vy*=-1;\n    // mouse attraction\n    const dx=p.x-mouse.x,dy=p.y-mouse.y;\n    const dist=Math.hypot(dx,dy);\n    if(dist<100){\n      const force=0.05*(100-dist)/100;\n      p.vx-=dx*force;\n      p.vy-=dy*force;\n    }\n  }\n}\nfunction draw(){\n  ctx.fillStyle='rgba(17,17,17,0.2)';\n  ctx.fillRect(0,0,width,height);\n  ctx.globalCompositeOperation='lighter';\n  for(let p of particles){\n    ctx.fillStyle=`rgba(255,255,255,${p.alpha})`;\n    ctx.beginPath();\n    ctx.arc(p.x,p.y,p.size,0,Math.PI*2);\n    ctx.fill();\n  }\n  ctx.globalCompositeOperation='source-over';\n}\nfunction loop(){\n  if(!document.hidden || !document.hidden){\n    update();\n    draw();\n  }\n  requestAnimationFrame(loop);\n}\nloop();\n\nfunction setScene(i){\n  sceneIndex=i%scenes.length;\n  const s=scenes[sceneIndex];\n  document.getElementById('title').textContent=s.title;\n  document.getElementById('poem').textContent=s.poem;\n  canvas.style.backgroundColor=s.color;\n}\nsetScene(0);\n\ndocument.getElementById('pauseBtn').addEventListener('click',()=>{\n  paused=!paused;\n  document.getElementById('pauseBtn').textContent=paused?'PLAY':'PAUSE';\n});\ndocument.getElementById('nextBtn').addEventListener('click',()=>setScene(sceneIndex+1));\n\ncanvas.addEventListener('mousemove',e=>{\n  const rect=canvas.getBoundingClientRect();\n  mouse.x=(e.clientX-rect.left)*dpr;\n  mouse.y=(e.clientY-rect.top)*dpr;\n});\ncanvas.addEventListener('mousedown',()=>mouse.down=true);\ncanvas.addEventListener('mouseup',()=>mouse.down=false);\ncanvas.addEventListener('touchmove',e=>{\n  const rect=canvas.getBoundingClientRect();\n  const touch=e.touches[0];\n  mouse.x=(touch.clientX-rect.left)*dpr;\n  mouse.y=(touch.clientY-rect.top)*dpr;\n});\ncanvas.addEventListener('touchstart',()=>mouse.down=true);\ncanvas.addEventListener('touchend',()=>mouse.down=false);\n\nif(window.matchMedia('(prefers-reduced-motion: reduce)').matches){\n  paused=true;\n  document.getElementById('pauseBtn').textContent='PLAY';\n}\n</script>\n</body>\n</html>",
