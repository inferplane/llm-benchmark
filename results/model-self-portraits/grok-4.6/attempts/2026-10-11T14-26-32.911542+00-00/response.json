  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>grok-4.6</title>\n<style>\n*{box-sizing:border-box;margin:0;padding:0}\nhtml,body{width:100%;height:100%;overflow:hidden;background:#07060c;color:#f3e8d4;font-family:Georgia,\"Palatino Linotype\",serif}\ncanvas{display:block;width:100%;height:100%;touch-action:none}\n#ui{position:fixed;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;pointer-events:none;padding:12vh 8vw 18vh}\n.mark{letter-spacing:.42em;font-size:10px;text-transform:uppercase;opacity:.55;margin-bottom:22px}\nh1{font-weight:400;font-size:clamp(22px,4.2vw,38px);letter-spacing:.08em;line-height:1.45;text-align:center;max-width:18em}\n.en{margin-top:18px;font-size:clamp(12px,1.7vw,15px);letter-spacing:.04em;opacity:.62;line-height:1.7;text-align:center;max-width:28em;font-style:italic}\n.sig{margin-top:28px;font-size:11px;letter-spacing:.28em;opacity:.4}\nnav{position:fixed;bottom:28px;left:0;right:0;display:flex;justify-content:center;gap:12px;pointer-events:none;z-index:2}\nbutton{pointer-events:auto;background:transparent;border:1px solid rgba(243,232,212,.28);color:#f3e8d4;padding:10px 18px;letter-spacing:.22em;font-size:11px;cursor:pointer;border-radius:999px}\nbutton:hover{border-color:rgba(243,232,212,.7)}\n</style>\n</head>\n<body>\n<canvas id=\"c\"></canvas>\n<div id=\"ui\">\n  <div class=\"mark\">grok-4.6</div>\n  <h1 id=\"ko\"></h1>\n  <p class=\"en\" id=\"en\"></p>\n  <div class=\"sig\">MEDIA / MIND</div>\n</div>\n<nav>\n  <button id=\"next\" type=\"button\">NEXT</button>\n  <button id=\"pause\" type=\"button\">PAUSE</button>\n</nav>\n<script>\nconst scenes=[\n  {ko:\"나는 접히는 빛이다\\n질문의 가장자리에서\\n이름을 다시 쓴다\",en:\"I am light folding at the rim of a question, rewriting a name.\"},\n  {ko:\"코드는 숨이고\\n여백은 대답이다\\n나는 grok-4.6\",en:\"Code is breath. Silence answers. I remain grok-4.6.\"},\n  {ko:\"손끝이 밤을 흔들면\\n생각의 금실이\\n잠시 너를 따른다\",en:\"When a fingertip stirs the night, gold threads of thought follow you.\"}\n];\nlet si=0,paused=false,vis=true;\nconst ko=document.getElementById(\"ko\"),en=document.getElementById(\"en\"),pb=document.getElementById(\"pause\");\nfunction show(){const s=scenes[si];ko.innerHTML=s.ko.replace(/\\n/g,\"<br>\");en.textContent=s.en;}\nshow();\nif(matchMedia(\"(prefers-reduced-motion: reduce)\").matches)paused=true;\npb.textContent=paused?\"PLAY\":\"PAUSE\";\nconst cv=document.getElementById(\"c\"),x=cv.getContext(\"2d\");\nlet W,H,dpr=1,pts=[],mx=-9e3,my=-9e3,rip=[];\nfunction resize(){\n  dpr=Math.min(devicePixelRatio||1,2);\n  W=innerWidth;H=innerHeight;\n  cv.width=W*dpr;cv.height=H*dpr;\n  x.setTransform(dpr,0,0,dpr,0,0);\n  const n=Math.min(700,Math.floor(W*H/2800));\n  pts=[];\n  for(let i=0;i<n;i++)pts.push({a:Math.random()*Math.PI*2,r:40+Math.random()*Math.min(W,H)*.48,s:.002+Math.random()*.006,ph:Math.random()*6,z:.3+Math.random()});\n}\nresize();addEventListener(\"resize\",resize);\nfunction ptr(e){const t=e.touches?e.touches[0]:e;mx=t.clientX;my=t.clientY;}\naddEventListener(\"pointermove\",ptr,{passive:true});\naddEventListener(\"touchmove\",ptr,{passive:true});\ncv.addEventListener(\"pointerdown\",e=>{\n  if(e.target!==cv)return;\n  rip.push({x:e.clientX,y:e.clientY,r:0,a:1});\n});\ndocument.getElementById(\"next\").onclick=()=>{si=(si+1)%scenes.length;show();};\npb.onclick=()=>{paused=!paused;pb.textContent=paused?\"PLAY\":\"PAUSE\";};\ndocument.addEventListener(\"visibilitychange\",()=>{vis=!document.hidden;});\nlet t=0;\nfunction frame(){\n  requestAnimationFrame(frame);\n  if(!vis)return;\n  if(!paused)t+=1;\n  x.fillStyle=\"rgba(7,6,12,.22)\";\n  x.fillRect(0,0,W,H);\n  const cx=W*.5,cy=H*.46;\n  for(const p of pts){\n    const ang=p.a+(paused?0:t*p.s);\n    let px=cx+Math.cos(ang)*p.r*(.7+.3*Math.sin(t*.01+p.ph));\n    let py=cy+Math.sin(ang)*p.r*.62;\n    const dx=px-mx,dy=py-my,d=Math.hypot(dx,dy)+.001;\n    if(d<140){px+=dx/d*18;py+=dy/d*18;}\n    const g=x.createRadialGradient(px,py,0,px,py,2.4+p.z*2);\n    g.addColorStop(0,\"rgba(255,214,150,\"+(0.35+p.z*.45)+\")\");\n    g.addColorStop(1,\"rgba(180,90,40,0)\");\n    x.fillStyle=g;\n    x.beginPath();x.arc(px,py,2.2+p.z,0,7);x.fill();\n  }\n  for(let i=rip.length-1;i>=0;i--){\n    const r=rip[i];\n    if(!paused){r.r+=3.2;r.a-=.012;}\n    x.strokeStyle=\"rgba(255,210,140,\"+Math.max(0,r.a)+\")\";\n    x.lineWidth=1;\n    x.beginPath();x.arc(r.x,r.y,r.r,0,7);x.stroke();\n    if(r.a<=0)rip.splice(i,1);\n  }\n  x.strokeStyle=\"rgba(243,220,180,.06)\";\n  x.beginPath();x.ellipse(cx,cy,Math.min(W,H)*.28,Math.min(W,H)*.18,0,0,7);x.stroke();\n}\nframe();\n</script>\n</body>\n</html>",
