  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>llama-3.1-8b</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      text-align: center;\n    }\n    #poem {\n      font-size: 24px;\n      line-height: 1.5;\n      margin-bottom: 20px;\n    }\n    #controls {\n      font-size: 19px;\n      display: flex;\n      justify-content: space-between;\n      margin-bottom: 20px;\n    }\n    #controls button {\n      margin: 0 10px;\n    }\n    #controls button:disabled {\n      opacity: 0.5;\n    }\n    #canvas {\n      border: 1px solid black;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n    }\n  </style>\n</head>\n<body>\n  <h1 id=\"poem\">Scene 1</h1>\n  <div id=\"controls\">\n    <button id=\"pause\" aria-pressed=\"false\">PLAY</button>\n    <button id=\"next\" aria-pressed=\"false\">NEXT</button>\n  </div>\n  <canvas id=\"canvas\" width=\"375\" height=\"812\"></canvas>\n  <script>\n    let paused = matchMedia('(prefers-reduced-motion)').matches;\n    let scene = 1;\n    let canvas = document.getElementById('canvas');\n    let ctx = canvas.getContext('2d');\n    let particles = [];\n    let rafId = null;\n\n    function start() {\n      if (!rafId) {\n        rafId = requestAnimationFrame(draw);\n      }\n    }\n\n    function stop() {\n      if (rafId) {\n        cancelAnimationFrame(rafId);\n        rafId = null;\n      }\n    }\n\n    function draw() {\n      ctx.clearRect(0, 0, canvas.width, canvas.height);\n      // render particles\n      for (let i = 0; i < particles.length; i++) {\n        ctx.beginPath();\n        ctx.arc(particles[i].x, particles[i].y, 5, 0, 2 * Math.PI);\n        ctx.fillStyle = 'rgba(255, 0, 0, 0.5)';\n        ctx.fill();\n        particles[i].x += particles[i].vx;\n        particles[i].y += particles[i].vy;\n        if (particles[i].x > canvas.width || particles[i].x < 0 || particles[i].y > canvas.height || particles[i].y < 0) {\n          particles.splice(i, 1);\n        }\n      }\n      // render scene poem\n      ctx.font = '24px Arial';\n      ctx.fillStyle = 'black';\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'top';\n      ctx.fillText(document.getElementById('poem').textContent, canvas.width / 2, 20);\n      // update DOM\n      document.getElementById('poem').textContent = scene === 1 ? 'Scene 1' : 'Scene 2';\n      document.getElementById('pause').ariaPressed = paused;\n      document.getElementById('next').ariaPressed = paused;\n      // schedule next frame\n      start();\n    }\n\n    function init() {\n      // render initial static frame\n      ctx.clearRect(0, 0, canvas.width, canvas.height);\n      for (let i = 0; i < 700; i++) {\n        particles.push({\n          x: Math.random() * canvas.width,\n          y: Math.random() * canvas.height,\n          vx: Math.random() * 2 - 1,\n          vy: Math.random() * 2 - 1\n        });\n      }\n      draw();\n      // start RAF\n      start();\n    }\n\n    function handleResize() {\n      canvas.width = Math.min(375, window.innerWidth);\n      canvas.height = Math.min(812, window.innerHeight);\n      canvas.style.width = `${canvas.width}px`;\n      canvas.style.height = `${canvas.height}px`;\n      canvas.style.transform = `scale(${Math.min(1, window.devicePixelRatio / Math.min(2, window.devicePixelRatio))})`;\n      ctx.canvas.width = canvas.width * Math.min(2, window.devicePixelRatio);\n      ctx.canvas.height = canvas.height * Math.min(2, window.devicePixelRatio);\n      if (paused) {\n        init();\n      } else {\n        stop();\n        init();\n      }\n    }\n\n    window.addEventListener('resize', handleResize);\n    handleResize();\n    init();\n\n    document.getElementById('pause').addEventListener('click', () => {\n      paused = !paused;\n      document.getElementById('pause').ariaPressed = paused;\n      document.getElementById('next').ariaPressed = paused;\n      if (paused) {\n        stop();\n      } else {\n        start();\n      }\n    });\n\n    document.getElementById('next').addEventListener('click', () => {\n      scene = scene === 1 ? 2 : 1;\n      stop();\n      init();\n    });\n  </script>\n  <p>나의 이름은 llama-3.1-8b입니다.</p>\n  <p>나는 AI로 만들어진 모델입니다.</p>\n  <p>나는 사람과 대화를 할 수 있습니다.</p>\n</body>\n</html>",
