  "text": "<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\nbody { margin: 0; background-color: #333; font-family: sans-serif; }\ncanvas { display: block; width: 100%; height: 100vh; }\nbutton { position: absolute; top: 10px; left: 10px; z-index: 1; font-size: 19px; }\n.text { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 24px; color: #fff; }\n</style>\n</head>\n<body>\n<canvas id=\"canvas\"></canvas>\n<div class=\"text\" id=\"text\">나는 llama-3.3-70b-bedrock<br>한국어를 이해하고 생성하는 모델입니다.</div>\n<button id=\"play-pause\" style=\"background-color: #444; color: #fff; border: none; padding: 10px;\">PLAY</button>\n<script>\nconst canvas = document.getElementById('canvas');\nconst ctx = canvas.getContext('2d');\nconst playPauseButton = document.getElementById('play-pause');\nconst textElement = document.getElementById('text');\nlet paused = false;\nlet scene = 0;\nlet particles = [];\nlet devicePixelRatio = window.devicePixelRatio || 1;\nlet rafId = null;\n\ncanvas.width = window.innerWidth;\ncanvas.height = window.innerHeight;\nctx.scale(devicePixelRatio, devicePixelRatio);\n\nfor (let i = 0; i < 500; i++) {\n  particles.push({\n    x: Math.random() * canvas.width,\n    y: Math.random() * canvas.height,\n    vx: Math.random() * 2 - 1,\n    vy: Math.random() * 2 - 1,\n    radius: Math.random() * 2 + 1\n  });\n}\n\nfunction draw() {\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\n  ctx.fillStyle = 'rgba(0, 0, 0, 0.1)';\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n  for (let i = 0; i < particles.length; i++) {\n    const particle = particles[i];\n    ctx.beginPath();\n    ctx.arc(particle.x, particle.y, particle.radius, 0, 2 * Math.PI);\n    ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';\n    ctx.fill();\n    particle.x += particle.vx;\n    particle.y += particle.vy;\n    if (particle.x < 0 || particle.x > canvas.width) {\n      particle.vx = -particle.vx;\n    }\n    if (particle.y < 0 || particle.y > canvas.height) {\n      particle.vy = -particle.vy;\n    }\n  }\n}\n\nfunction drawStaticFrame() {\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\n  ctx.fillStyle = 'rgba(0, 0, 0, 0.1)';\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n  for (let i = 0; i < particles.length; i++) {\n    const particle = particles[i];\n    ctx.beginPath();\n    ctx.arc(particle.x, particle.y, particle.radius, 0, 2 * Math.PI);\n    ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';\n    ctx.fill();\n  }\n}\n\nfunction animate() {\n  if (!paused) {\n    draw();\n  } else {\n    drawStaticFrame();\n  }\n  rafId = requestAnimationFrame(animate);\n}\n\nplayPauseButton.addEventListener('click', () => {\n  paused = !paused;\n  if (paused) {\n    playPauseButton.textContent = 'PLAY';\n    playPauseButton.setAttribute('aria-pressed', 'false');\n  } else {\n    playPauseButton.textContent = 'PAUSE';\n    playPauseButton.setAttribute('aria-pressed', 'true');\n  }\n  drawStaticFrame();\n});\n\ncanvas.addEventListener('mousemove', (e) => {\n  const x = e.clientX;\n  const y = e.clientY;\n  for (let i = 0; i < particles.length; i++) {\n    const particle = particles[i];\n    const distance = Math.sqrt((x - particle.x) ** 2 + (y - particle.y) ** 2);\n    if (distance < 50) {\n      particle.vx = (x - particle.x) / 10;\n      particle.vy = (y - particle.y) / 10;\n    }\n  }\n});\n\nwindow.addEventListener('resize', () => {\n  canvas.width = window.innerWidth;\n  canvas.height = window.innerHeight;\n  ctx.scale(devicePixelRatio, devicePixelRatio);\n  drawStaticFrame();\n});\n\nif (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n  paused = true;\n  playPauseButton.textContent = 'PLAY';\n  playPauseButton.setAttribute('aria-pressed', 'false');\n} else {\n  playPauseButton.textContent = 'PAUSE';\n  playPauseButton.setAttribute('aria-pressed', 'true');\n}\nanimate();\n</script>\n</body>\n</html>",
