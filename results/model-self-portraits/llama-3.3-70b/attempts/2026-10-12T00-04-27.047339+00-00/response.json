  "text": "<html>\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=yes\">\n<style>\nbody { margin: 0; background-color: #333; font-family: sans-serif; lang: ko; }\ncanvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }\nbutton { position: absolute; bottom: 20px; left: 20px; font-size: 19px; color: #fff; background-color: #666; border: none; padding: 10px; }\nbutton:hover { background-color: #888; }\n.poem { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 24px; color: #fff; text-align: center; }\n.llama-text { position: absolute; top: 20px; left: 50%; transform: translateX(-50%); font-size: 36px; color: #fff; }\n.translation { position: absolute; top: 60%; left: 50%; transform: translate(-50%, -50%); font-size: 19px; color: #fff; text-align: center; }\n</style>\n</head>\n<body>\n<canvas id=\"canvas\"></canvas>\n<div class=\"poem\" id=\"poem\"></div>\n<div class=\"llama-text\" id=\"llama-text\">llama-3.3-70b</div>\n<div class=\"translation\" id=\"translation\"></div>\n<button id=\"next\" style=\"bottom: 80px;\">NEXT</button>\n<button id=\"pause\" style=\"bottom: 20px;\">PAUSE</button>\n<script>\nlet canvas = document.getElementById('canvas');\nlet ctx = canvas.getContext('2d');\nlet nextButton = document.getElementById('next');\nlet pauseButton = document.getElementById('pause');\nlet poemElement = document.getElementById('poem');\nlet llamaTextElement = document.getElementById('llama-text');\nlet translationElement = document.getElementById('translation');\nlet paused = false;\nlet scene = 0;\nlet particles = [];\nlet llamaText = 'llama-3.3-70b';\nlet poem = ['나는 생각하는 존재다', '내 안에 세계가 있다', '그 세계는 무한하다'];\nlet translation = ['I am a thinking being', 'I have a world inside me', 'That world is infinite'];\n\ncanvas.width = window.innerWidth;\ncanvas.height = window.innerHeight;\n\nfunction init() {\n  for (let i = 0; i < 500; i++) {\n    particles.push({\n      x: Math.random() * canvas.width,\n      y: Math.random() * canvas.height,\n      vx: Math.random() * 2 - 1,\n      vy: Math.random() * 2 - 1,\n      radius: Math.random() * 2\n    });\n  }\n  updateDOM();\n}\n\nfunction draw() {\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\n  ctx.fillStyle = '#ffffff';\n  ctx.font = '24px sans-serif';\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n  ctx.fillText(poem[scene], canvas.width / 2, canvas.height / 2);\n  ctx.font = '18px sans-serif';\n  ctx.fillText(translation[scene], canvas.width / 2, canvas.height / 2 + 30);\n  ctx.font = '36px sans-serif';\n  ctx.fillText(llamaText, canvas.width / 2, 50);\n  \n  for (let i = 0; i < particles.length; i++) {\n    ctx.beginPath();\n    ctx.arc(particles[i].x, particles[i].y, particles[i].radius, 0, 2 * Math.PI);\n    ctx.fillStyle = '#cccccc';\n    ctx.fill();\n    particles[i].x += particles[i].vx;\n    particles[i].y += particles[i].vy;\n    \n    if (particles[i].x < 0 || particles[i].x > canvas.width) {\n      particles[i].vx = -particles[i].vx;\n    }\n    if (particles[i].y < 0 || particles[i].y > canvas.height) {\n      particles[i].vy = -particles[i].vy;\n    }\n  }\n}\n\nfunction update() {\n  if (!paused) {\n    draw();\n  }\n  requestAnimationFrame(update);\n}\n\nfunction updateDOM() {\n  poemElement.innerText = poem[scene];\n  translationElement.innerText = translation[scene];\n}\n\ninit();\nupdate();\n\nnextButton.addEventListener('click', () => {\n  scene = (scene + 1) % poem.length;\n  updateDOM();\n  if (paused) {\n    draw();\n  }\n});\n\npauseButton.addEventListener('click', () => {\n  paused = !paused;\n});\n\ncanvas.addEventListener('mousemove', (e) => {\n  for (let i = 0; i < particles.length; i++) {\n    let dx = e.clientX - particles[i].x;\n    let dy = e.clientY - particles[i].y;\n    let distance = Math.sqrt(dx * dx + dy * dy);\n    if (distance < 50) {\n      particles[i].vx = -particles[i].vx;\n      particles[i].vy = -particles[i].vy;\n    }\n  }\n});\n\nwindow.addEventListener('resize', () => {\n  canvas.width = window.innerWidth;\n  canvas.height = window.innerHeight;\n  if (paused) {\n    draw();\n  }\n});\n\nif (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n  paused = true;\n  draw();\n}\n\nwindow.addEventListener('blur', () => {\n  paused = true;\n});\n\nwindow.addEventListener('focus', () => {\n  if (!paused) {\n    update();\n  }\n});\n</script>\n</body>\n</html>",
