{
  "text": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>llama4-maverick</title>\n</head>\n<body style=\"margin: 0; overflow: hidden; background-color: #000; font-size: 19px; color: #fff;\">\n    <canvas id=\"canvas\" style=\"width: 100%; height: 100%;\"></canvas>\n    <div id=\"text-container\" style=\"position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; line-height: 1.5;\">\n        <div id=\"main-text\"></div>\n        <div id=\"sub-text\" style=\"font-size: 0.8em; margin-top: 0.5em;\"></div>\n    </div>\n    <div style=\"position: absolute; top: 1em; left: 1em;\">\n        <button id=\"pause-button\" style=\"background-color: #fff; color: #000; border: none; padding: 0.5em 1em; font-size: 1em; cursor: pointer;\"></button>\n    </div>\n    <div style=\"position: absolute; top: 1em; right: 1em;\">\n        <button id=\"next-button\" style=\"background-color: #fff; color: #000; border: none; padding: 0.5em 1em; font-size: 1em; cursor: pointer;\">NEXT</button>\n    </div>\n    <script>\n        const canvas = document.getElementById('canvas');\n        const ctx = canvas.getContext('2d');\n        const mainTextElement = document.getElementById('main-text');\n        const subTextElement = document.getElementById('sub-text');\n        const pauseButton = document.getElementById('pause-button');\n        let particles = [];\n        let scene = 0;\n        let paused = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n        let lastFrameTime = 0;\n\n        function resizeCanvas() {\n            const dpr = Math.min(2, window.devicePixelRatio);\n            canvas.width = window.innerWidth * dpr;\n            canvas.height = window.innerHeight * dpr;\n            ctx.scale(dpr, dpr);\n        }\n        window.addEventListener('resize', resizeCanvas);\n        resizeCanvas();\n\n        class Particle {\n            constructor(x, y) {\n                this.x = x;\n                this.y = y;\n                this.vx = Math.random() * 2 - 1;\n                this.vy = Math.random() * 2 - 1;\n                this.radius = Math.random() * 1.5 + 0.5;\n            }\n            update() {\n                this.x += this.vx;\n                this.y += this.vy;\n                if (this.x < 0 || this.x > canvas.width) this.vx *= -1;\n                if (this.y < 0 || this.y > canvas.height) this.vy *= -1;\n            }\n            draw() {\n                ctx.beginPath();\n                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);\n                ctx.fillStyle = `hsl(${Math.random() * 360}, 100%, 70%)`;\n                ctx.fill();\n            }\n        }\n\n        for (let i = 0; i < 500; i++) {\n            particles.push(new Particle(Math.random() * canvas.width, Math.random() * canvas.height));\n        }\n\n        const texts = [\n            { main: 'llama4-maverick', sub: '내면의 창의적 코드를 풀어내다' },\n            { main: '상상과 현실의 경계', sub: '자유로운 사고의 흐름' },\n            { main: '언어와 지능의 춤', sub: '끊임없는 탐구의 여정' }\n        ];\n\n        function updateText() {\n            const text = texts[scene];\n            mainTextElement.textContent = text.main;\n            subTextElement.textContent = text.sub;\n        }\n\n        function draw() {\n            ctx.clearRect(0, 0, canvas.width / Math.min(2, window.devicePixelRatio), canvas.height / Math.min(2, window.devicePixelRatio));\n            for (let particle of particles) {\n                particle.update();\n                particle.draw();\n            }\n        }\n\n        canvas.addEventListener('click', (e) => {\n            const rect = canvas.getBoundingClientRect();\n            const x = e.clientX;\n            const y = e.clientY;\n            for (let particle of particles) {\n                const dx = particle.x / Math.min(2, window.devicePixelRatio) - x;\n                const dy = particle.y / Math.min(2, window.devicePixelRatio) - y;\n                const distance = Math.sqrt(dx * dx + dy * dy);\n                if (distance < 100) {\n                    particle.vx = dx / distance * 5;\n                    particle.vy = dy / distance * 5;\n                }\n            }\n        });\n\n        pauseButton.addEventListener('click', () => {\n            paused = !paused;\n            pauseButton.textContent = paused ? 'PLAY' : 'PAUSE';\n        });\n\n        document.getElementById('next-button').addEventListener('click', () => {\n            scene = (scene + 1) % texts.length;\n            updateText();\n            if (paused) {\n                draw();\n            }\n        });\n\n        function animate(timestamp) {\n            if (!paused || !lastFrameTime) {\n                draw();\n            }\n            lastFrameTime = timestamp;\n            requestAnimationFrame(animate);\n        }\n\n        updateText();\n        pauseButton.textContent = paused ? 'PLAY' : 'PAUSE';\n\n        document.addEventListener('visibilitychange', () => {\n            if (document.hidden) {\n                paused = true;\n            } else {\n                paused = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n            }\n            pauseButton.textContent = paused ? 'PLAY' : 'PAUSE';\n        });\n\n        animate(0);\n    </script>\n</body>\n</html>",
