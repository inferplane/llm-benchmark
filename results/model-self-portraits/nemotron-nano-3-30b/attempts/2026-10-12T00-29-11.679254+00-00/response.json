  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<title>nemotron-nano-3-30b</title>\n<style>\nhtml,body{margin:0;padding:0;height:100%;overflow:hidden;background:#0a0a1a;color:#e0e0ff;font-family:system-ui,sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;}\ncanvas{display:block;width:100%;height:100%;}\nh1{position:absolute;top:20px;left:50%;transform:translateX(-50%);font-size:1.2rem;pointer-events:none;}\nbutton{position:absolute;bottom:20px;background:transparent;border:none;color:#888;font-size:0.9rem;padding:8px 16px;cursor:pointer;pointer-events:auto;}\nbutton:hover{color:#fff;}\n@media (prefers-reduced-motion:reduce){\ncanvas{animation:none;}\n}\n</style>\n</head>\n<body>\n<canvas></canvas>\n<h1>nemotron-nano-3-30b</h1>\n<button id=\"toggle\">PAUSE</button>\n<button id=\"next\" style=\"position:absolute;top:20px;right:20px;background:transparent;border:1px solid #888;color:#888;padding:8px 16px;cursor:pointer;\">다음</button>\n<script>\nconst canvas=document.querySelector('canvas');\nconst ctx=canvas.getContext('2d');\nconst resize=()=>{canvas.width=window.innerWidth;canvas.height=window.innerHeight;};\nresize();\nwindow.addEventListener('resize',resize);\nconst N=700;\nconst particles=[];\nconst scenes=[\n{title:'별빛 흐름',lines:['별이 흘러가네','밤하늘에 물결','그림자는 사라진다'],color:'#4a00ff'},\n{title:'은하빛 조각',lines:['빛이 조각된다','색은 기억을 남긴다','우주는 고요히'],color:'#00ff8a'}\n];\nlet cur=0;\nlet paused=false;\nlet raf;\nfunction Particle(){this.x=Math.random()*canvas.width;this.y=Math.random()*canvas.height;this.vx=(Math.random()-0.5)*0.2;this.vy=(Math.random()-0.5)*0.2;this.r=Math.random()*2+1;this.c=scenes[cur].color;}\nfunction init(){particles.length=0;for(let i=0;i<N;i++)particles.push(new Particle());}\nfunction draw(){ctx.clearRect(0,0,canvas.width,canvas.height);\nctx.fillStyle='rgba(10,10,26,0.1)';\nctx.fillRect(0,0,canvas.width,canvas.height);\nfor(let p of particles){\np.x+=p.vx;p.y+=p.vy;\nif(p.x<0||p.x>canvas.width||p.y<0||p.y>canvas.height){p.vx*=-0.8;p.vy*=-0.8;}\nctx.fillStyle=p.c;\nctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill();\n}\nctx.fillStyle='rgba(224,224,255,0.6)';\nctx.font='24px system-ui';\nctx.textAlign='center';\nctx.textBaseline='middle';\nctx.fillText(scenes[cur].lines[0],canvas.width/2,canvas.height/3);\nctx.fillText(scenes[cur].lines[1],canvas.width/2,canvas.height/2);\nctx.fillText(scenes[cur].lines[2],canvas.width/2,2*canvas.height/3);\n}\nfunction step(){if(!paused){draw();}\nelse{ctx.clearRect(0,0,canvas.width,canvas.height);\nctx.fillStyle='rgba(10,10,26,0.1)';\nctx.fillRect(0,0,canvas.width,canvas.height);\nfor(let p of particles){p.x+=p.vx;p.y+=p.vy;\nif(p.x<0||p.x>canvas.width||p.y<0||p.y>canvas.height){p.vx*=-0.8;p.vy*=-0.8;}\nctx.fillStyle=p.c;\nctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill();\n}\nctx.fillStyle='rgba(224,224,255,0.6)';\nctx.font='24px system-ui';\nctx.textAlign='center';\nctx.textBaseline='middle';\nctx.fillText(scenes[cur].lines[0],canvas.width/2,canvas.height/3);\nctx.fillText(scenes[cur].lines[1],canvas.width/2,canvas.height/2);\nctx.fillText(scenes[cur].lines[2],canvas.width/2,2*canvas.height/3);\n}\nrequestAnimationFrame(step);\n}\nfunction loop(){raf=requestAnimationFrame(step);}\nloop();\ndocument.addEventListener('mousemove',e=>{if(paused)return;const mx=e.clientX/canvas.width*2-1,my=e.clientY/canvas.height*2-1;for(let p of particles){const dx=mx-p.x/canvas.width*2;const dy=my-p.y/canvas.height*2;const dist=Math.sqrt(dx*dx+dy*dy);if(dist<0.5){p.vx+=dx*0.05;p.vy+=dy*0.05;}}\n});\ndocument.getElementById('toggle').addEventListener('click',()=>{paused=!paused;document.getElementById('toggle').textContent=paused?'PLAY':'PAUSE';});\ndocument.getElementById('next').addEventListener('click',()=>{paused=true;cur=(cur+1)%scenes.length;init();document.getElementById('toggle').textContent='PAUSE';});\nwindow.addEventListener('click',e=>{if(e.target===canvas&&!paused){cur=(cur+1)%scenes.length;init();document.getElementById('toggle').textContent='PAUSE';}});\nwindow.addEventListener('keydown',e=>{if(e.key===' '){paused=!paused;document.getElementById('toggle').textContent=paused?'PLAY':'PAUSE';}};\nwindow.addEventListener('load',()=>{if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){paused=true;document.getElementById('toggle').textContent='PAUSE';}else{init();}});\n</script>\n</body>\n</html>",
