  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Nemotron Nano 3 30B Self-Portrait</title>\n<style>\n  body{margin:0;padding:0;display:flex;justify-content:center;align-items:center;height:100vh;background:#111;color:#fff;font-family:sans-serif;}\n  #scene{position:relative;width:100%;height:100%;overflow:hidden;}\n  #particles{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;}\n  .control{margin:10px;padding:10px 20px;font-size:16px;background:#222;color:#fff;border:none;cursor:pointer;}\n  .control:focus{outline:2px solid #0f0;}\n</style>\n</head>\n<body>\n<div id=\"scene\">\n  <div id=\"particles\"></div>\n  <div id=\"poem\" style=\"position:absolute;bottom:20px;left:20px;max-width:90%;text-align:center;\">\n    <p>별빛은 흘러가고<br>그리움은 남아</p>\n    <p>고요히 빛나는<br>우리의 꿈</p>\n  </div>\n  <div style=\"position:absolute;top:20px;right:20px;\">\n    <button id=\"next\" class=\"control\" aria-label=\"Next\">NEXT</button>\n    <button id=\"pause\" class=\"control\" aria-label=\"Pause\">PAUSE</button>\n  </div>\n</div>\n<script>\nconst canvas = document.createElement('canvas');\nconst ctx = canvas.getContext('2d');\ncanvas.width = window.innerWidth;\ncanvas.height = window.innerHeight;\ndocument.getElementById('particles').appendChild(canvas);\n\nlet paused = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\nlet particles = [];\nconst scene = document.getElementById('scene');\nconst nextBtn = document.getElementById('next');\nconst pauseBtn = document.getElementById('pause');\n\nfunction createParticle() {\n  return {\n    x: Math.random() * canvas.width,\n    y: Math.random() * canvas.height,\n    vx: (Math.random() - 0.5) * 2,\n    vy: (Math.random() - 0.5) * 2,\n    radius: 2 + Math.random() * 3,\n    life: 1\n  };\n}\nfunction initParticles() {\n  particles = Array.from({length: 150}, createParticle);\n}\ninitParticles();\n\nfunction draw() {\n  ctx.clearRect(0,0,canvas.width,canvas.height);\n  particles.forEach(p => {\n    p.x += p.vx;\n    p.y += p.vy;\n    if(p.x<0||p.x>canvas.width||p.y<0||p.y>canvas.height) {\n      p.x = Math.random()*canvas.width;\n      p.y = Math.random()*canvas.height;\n    }\n    ctx.fillStyle = 'rgba(255,255,255,0.8)';\n    ctx.beginPath();\n    ctx.arc(p.x,p.y,p.radius,0,Math.PI*2);\n    ctx.fill();\n  });\n  requestAnimationFrame(draw);\n}\nfunction step() {\n  if(!paused) draw();\n}\nfunction start() {\n  if(!paused) return;\n  paused = false;\n  nextBtn.textContent = 'PAUSE';\n  pauseBtn.textContent = 'PAUSE';\n  nextBtn.setAttribute('aria-pressed','false');\n  pauseBtn.setAttribute('aria-pressed','false');\n  requestAnimationFrame(step);\n}\nfunction stop() {\n  paused = true;\n  nextBtn.textContent = 'NEXT';\n  pauseBtn.textContent = 'PAUSE';\n  nextBtn.setAttribute('aria-pressed','true');\n  pauseBtn.setAttribute('aria-pressed','true');\n}\nnextBtn.addEventListener('click',()=>{ if(paused) start(); else stop(); });\npauseBtn.addEventListener('click',()=>{ if(!paused) stop(); });\nwindow.addEventListener('resize',()=>{ canvas.width = window.innerWidth; canvas.height = window.innerHeight; if(paused) initParticles(); });\nif(!paused) start();\n</script>\n</body>\n</html>",
