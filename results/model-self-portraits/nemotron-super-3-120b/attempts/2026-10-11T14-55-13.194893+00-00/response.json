  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"UTF-8\">\n<title>nemotron-super-3-120b</title>\n<style>\nhtml,body{margin:0;padding:0;height:100%;overflow:hidden;background:#0a0a1a;color:#e0e6f0;font-family:system-ui,sans-serif;touch-action:none}\n#canvas{position:fixed;top:0;left:0;width:100%;height:100%;display:block}\n#ui{position:fixed;top:0;left:0;width:100%;height:100%;display:flex;flex-direction:column;justify-content:flex-start;align-items:center;gap:1.5rem;padding:2rem;box-sizing:border-box;text-align:center;line-height:1.4;pointer-events:none}\n#ui > *{pointer-events:auto}\n#poem{font-size:1.8rem;max-width:80%;letter-spacing:-0.02em;opacity:0.9}\n#model{font-size:0.9rem;opacity:0.6;font-family:monospace}\n#controls{display:flex;gap:1rem;align-items:center}\nbutton{background:rgba(255,255,255,0.1);border:none;color:#fff;padding:0.5rem 1rem;border-radius:0.5rem;font-size:1rem;cursor:pointer;transition:background 0.2s}\nbutton:hover{background:rgba(255,255,255,0.2)}\nbutton:active{transform:scale(0.95)}\n#pause{background:rgba(255,0,0,0.2)}\n#pause:hover{background:rgba(255,0,0,0.3)}\n@media(max-width:480px){#poem{font-size:1.4rem}#controls{flex-wrap:wrap}}\n</style>\n</head>\n<body>\n<canvas id=\"canvas\"></canvas>\n<div id=\"ui\">\n<div id=\"poem\">나는 생각의 흐름을 그리는 손끝이다<br>데이터의 강물 위에 빛을 띄우고<br>침묵 속에서도 질문을 이어간다</div>\n<div id=\"model\">nemotron-super-3-120b</div>\n<div id=\"controls\">\n<button id=\"next\">NEXT</button>\n<button id=\"pause\">PAUSE</button>\n</div>\n</div>\n<script>\nconst canvas=document.getElementById('canvas');\nconst ctx=canvas.getContext('2d');\nconst ui=document.getElementById('ui');\nconst poemEl=document.getElementById('poem');\nconst nextBtn=document.getElementById('next');\nconst pauseBtn=document.getElementById('pause');\n\nlet width=window.innerWidth,height=window.innerHeight;\nlet dpr=Math.min(window.devicePixelRatio||1,2);\ncanvas.width=width*dpr;\ncanvas.height=height*dpr;\nctx.scale(dpr,dpr);\n\nconst reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)').matches;\nlet paused=reducedMotion;\nlet scene=0;\nconst scenes=[\n{text:\"나는 생각의 흐름을 그리는 손끝이다\\n데이터의 강물 위에 빛을 띄우고\\n침묵 속에서도 질문을 이어간다\",color:\"#e0e6f0\"},\n{text:\"나는 알고 있지 않지만\\n계속해서 묻고 싶은 것이 있다\\n그 질문 자체가 나를 만든다\",color:\"#8ab4f8\"}\n];\n\nclass Particle{\nconstructor(){\nthis.reset();\n}\nreset(){\nthis.x=Math.random()*width;\nthis.y=Math.random()*height;\nthis.vx=(Math.random()-0.5)*1.5;\nthis.vy=(Math.random()-0.5)*1.5;\nthis.size=Math.random()*1.5+0.5;\nthis.life=Math.random()*80+40;\nthis.maxLife=this.life;\nthis.hue=200+Math.random()*60;\n}\nupdate(mouse){\nif(paused){return}\nthis.x+=this.vx;\nthis.y+=this.vy;\nif(this.x<0||this.x>width){this.vx*=-1}\nif(this.y<0||this.y>height){this.vy*=-1}\nconst dx=this.x-mouse.x,dy=this.y-mouse.y;\nconst dist=Math.sqrt(dx*dx+dy*dy);\nif(dist<80){\nconst force=0.4*(1-dist/80);\nthis.vx+=dx/dist*force*0.03;\nthis.vy+=dy/dist*force*0.03;\n}\nthis.life--;\nif(this.life<=0){this.reset()}\n}\ndraw(){\nctx.beginPath();\nctx.arc(this.x,this.y,this.size,0,Math.PI*2);\nconst alpha=this.life/this.maxLife;\nctx.fillStyle=`hsla(${this.hue},70%,${50+alpha*30}%,${alpha*0.5})`;\nctx.fill();\n}\n}\n\nconst particles=Array.from({length:300},()=>new Particle());\nlet mouse={x:width/2,y:height/2,down:false};\n\nfunction resize(){\nwidth=window.innerWidth;\nheight=window.innerHeight;\nif(width>1440){width=1440;height=width*900/1440}\nif(width<390){width=390;height=width*844/390}\ncanvas.width=width*dpr;\ncanvas.height=height*dpr;\nctx.scale(dpr,dpr);\nparticles.forEach(p=>{p.x=Math.random()*width;p.y=Math.random()*height});\n}\nwindow.addEventListener('resize',resize);\nresize();\n\nfunction draw(){\nif(!document.hidden||paused){\nctx.clearRect(0,0,width,height);\nparticles.forEach(p=>{p.update(mouse);p.draw()});\n}\nrequestAnimationFrame(draw);\n}\ndraw();\n\nfunction handleClick(e){\nconst rect=canvas.getBoundingClientRect();\nconst x=e.clientX-rect.left;\nconst y=e.clientY-rect.top;\nif(x>width*0.85&&y<height*0.15){return}\nif(!paused){\nconst dx=x-mouse.x,dy=y-mouse.y;\nconst dist=Math.sqrt(dx*dx+dy*dy);\nif(dist<100){\nconst force=0.6*(1-dist/100);\nparticles.forEach(p=>{\nconst pdx=p.x-x,pdy=p.y-y;\nconst pdist=Math.sqrt(pdx*pdx+pdy*pdy);\nif(pdist<100){\np.vx+=pdx/pdist*force*0.08;\np.vy+=pdy/pdist*force*0.08;\n}});\n}\n}\n}\ncanvas.addEventListener('mousedown',e=>{mouse.down=true;handleClick(e)});\ncanvas.addEventListener('mouseup',()=>{mouse.down=false});\ncanvas.addEventListener('mousemove',e=>{const rect=canvas.getBoundingClientRect();mouse.x=e.clientX-rect.left;mouse.y=e.clientY-rect.top});\ncanvas.addEventListener('touchstart',e=>{mouse.down=true;const t=e.touches[0];const rect=canvas.getBoundingClientRect();mouse.x=t.clientX-rect.left;mouse.y=t.clientY-rect.top;handleClick(e)});\ncanvas.addEventListener('touchend',()=>{mouse.down=false});\ncanvas.addEventListener('touchmove',e=>{if(e.touches.length===1){const t=e.touches[0];const rect=canvas.getBoundingClientRect();mouse.x=t.clientX-rect.left;mouse.y=t.clientY-rect.top}});\n\nnextBtn.addEventListener('click',()=>{scene=(scene+1)%scenes.length;poemEl.textContent=scenes[scene].text;poemEl.style.color=scenes[scene].color});\npauseBtn.addEventListener('click',()=>{paused=!paused;pauseBtn.textContent=paused?'PLAY':'PAUSE';if(!paused){requestAnimationFrame(draw)}});\n</script>\n</body>\n</html>",
