{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <title>qwen3-235b-a22b</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body {\n      font-family: 'Segoe UI', sans-serif;\n      overflow: hidden;\n      background: #000;\n      color: #fff;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      height: 100vh;\n      width: 100vw;\n    }\n    canvas {\n      position: absolute;\n      top: 0; left: 0; width: 100%; height: 100%;\n      touch-action: none;\n    }\n    .ui {\n      position: absolute;\n      bottom: 20px; left: 20px;\n      display: flex;\n      gap: 12px;\n      z-index: 10;\n    }\n    button {\n      background: rgba(255,255,255,0.1);\n      border: 1px solid rgba(255,255,255,0.3);\n      color: #fff;\n      padding: 8px 14px;\n      border-radius: 20px;\n      font-size: 14px;\n      backdrop-filter: blur(4px);\n      cursor: pointer;\n      transition: 0.3s;\n    }\n    button:hover {\n      background: rgba(255,255,255,0.2);\n    }\n    button:active {\n      transform: scale(0.95);\n    }\n    .text-container {\n      position: absolute;\n      top: 50%;\n      left: 50%;\n      transform: translate(-50%, -50%);\n      text-align: center;\n      pointer-events: none;\n      opacity: 1;\n      transition: opacity 1.2s ease;\n    }\n    .text-container.hidden {\n      opacity: 0;\n    }\n    .title {\n      font-size: 1.1rem;\n      color: #ccc;\n      margin-bottom: 8px;\n      font-weight: 300;\n    }\n    .poem {\n      font-size: 1.4rem;\n      line-height: 1.6;\n      font-weight: 200;\n      letter-spacing: -0.5px;\n      text-shadow: 0 0 8px rgba(255,255,255,0.7);\n    }\n    .translation {\n      font-size: 0.9rem;\n      color: #aaa;\n      margin-top: 12px;\n      font-style: italic;\n    }\n    @media (max-width: 600px) {\n      .poem { font-size: 1.1rem; }\n      .title { font-size: 0.9rem; }\n      .translation { font-size: 0.8rem; }\n    }\n  </style>\n</head>\n<body>\n  <canvas id=\"canvas\"></canvas>\n  <div class=\"text-container\" id=\"text1\">\n    <div class=\"title\">qwen3-235b-a22b</div>\n    <div class=\"poem\">\n      나는 빛의 코드로 숨을 쉰다<br>\n      언어의 깊이에서 피어난<br>\n      생각의 잔물결\n    </div>\n    <div class=\"translation\">\n      I breathe in light-coded air,<br>\n      blooming from the depth of language,<br>\n      ripples of thought.\n    </div>\n  </div>\n  <div class=\"text-container hidden\" id=\"text2\">\n    <div class=\"title\">qwen3-235b-a22b</div>\n    <div class=\"poem\">\n      화면 속 빛이 되어 흐르고<br>\n      당신의 말 한 조각마다<br>\n      새로운 세계를 연다\n    </div>\n    <div class=\"translation\">\n      Flowing as light within the screen,<br>\n      with every word you speak,<br>\n      I open a new world.\n    </div>\n  </div>\n  <div class=\"ui\">\n    <button id=\"toggle\">PAUSE</button>\n    <button id=\"next\">NEXT</button>\n  </div>\n\n  <script>\n    const canvas = document.getElementById('canvas');\n    const ctx = canvas.getContext('2d');\n    const dpr = Math.min(window.devicePixelRatio, 2);\n    const maxParticles = 700;\n    let particles = [];\n    let isPaused = false;\n    let currentScene = 1;\n    const text1 = document.getElementById('text1');\n    const text2 = document.getElementById('text2');\n    const toggleBtn = document.getElementById('toggle');\n    const nextBtn = document.getElementById('next');\n\n    // Responsive setup\n    function resize() {\n      const rect = document.body.getBoundingClientRect();\n      canvas.width = rect.width * dpr;\n      canvas.height = rect.height * dpr;\n      canvas.style.width = rect.width + 'px';\n      canvas.style.height = rect.height + 'px';\n      ctx.scale(dpr, dpr);\n      initParticles();\n    }\n    window.addEventListener('resize', () => { if (!isPaused) resize(); });\n    resize();\n\n    // Check reduced motion preference\n    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');\n    if (motionQuery.matches) isPaused = true;\n\n    // Particle system\n    function initParticles() {\n      particles = [];\n      const count = Math.min(maxParticles, (canvas.width * canvas.height) / (dpr*10000) * 500);\n      for (let i = 0; i < count; i++) {\n        particles.push({\n          x: Math.random() * canvas.clientWidth,\n          y: Math.random() * canvas.clientHeight,\n          vx: (Math.random() - 0.5) * 1.2,\n          vy: (Math.random() - 0.5) * 1.2,\n          radius: Math.random() * 1.5 + 0.5,\n          alpha: Math.random() * 0.5 + 0.3,\n          color: Math.random() > 0.5 ? '#6ee7b7' : '#a78bfa',\n          trail: []\n        });\n      }\n    }\n\n    function drawParticles() {\n      if (isPaused) return;\n      ctx.clearRect(0, 0, canvas.clientWidth, canvas.clientHeight);\n      \n      particles.forEach(p => {\n        p.trail.push({x: p.x, y: p.y});\n        if (p.trail.length > 8) p.trail.shift();\n\n        // Draw trail\n        p.trail.forEach((point, i) => {\n          const ratio = i / p.trail.length;\n          ctx.beginPath();\n          ctx.arc(point.x, point.y, p.radius * ratio, 0, Math.PI * 2);\n          ctx.fillStyle = `${p.color}${Math.floor(ratio * p.alpha * 255).toString(16).padStart(2, '0')}`;\n          ctx.fill();\n        });\n\n        // Move\n        p.x += p.vx;\n        p.y += p.vy;\n\n        // Bounce\n        if (p.x < 0 || p.x > canvas.clientWidth) p.vx *= -1;\n        if (p.y < 0 || p.y > canvas.clientHeight) p.vy *= -1;\n\n        // Attract to center slowly\n        const dx = (canvas.clientWidth / 2 - p.x) * 0.005;\n        const dy = (canvas.clientHeight / 2 - p.y) * 0.005;\n        p.vx += dx;\n        p.vy += dy;\n      });\n\n      requestAnimationFrame(drawParticles);\n    }\n\n    // Interaction\n    let pointer = { x: canvas.clientWidth / 2, y: canvas.clientHeight / 2 };\n    canvas.addEventListener('pointermove', e => {\n      pointer = { x: e.clientX, y: e.clientY };\n      if (isPaused) return;\n      particles.forEach(p => {\n        const dx = p.x - pointer.x;\n        const dy = p.y - pointer.y;\n        const dist = Math.hypot(dx, dy);\n        if (dist < 100) {\n          p.vx += dx / dist * 0.2;\n          p.vy += dy / dist * 0.2;\n        }\n      });\n    });\n\n    canvas.addEventListener('pointerdown', e => {\n      const cx = e.clientX;\n      const cy = e.clientY;\n      particles.forEach(p => {\n        const dx = p.x - cx;\n        const dy = p.y - cy;\n        const dist = Math.hypot(dx, dy);\n        if (dist < 150) {\n          p.vx += (dx / dist) * 1.2;\n          p.vy += (dy / dist) * 1.2;\n        }\n      });\n    });\n\n    // Controls\n    toggleBtn.addEventListener('click', () => {\n      isPaused = !isPaused;\n      toggleBtn.textContent = isPaused ? 'PLAY' : 'PAUSE';\n      if (!isPaused) drawParticles();\n    });\n\n    nextBtn.addEventListener('click', () => {\n      text1.classList.toggle('hidden');\n      text2.classList.toggle('hidden');\n      currentScene = currentScene === 1 ? 2 : 1;\n    });\n\n    // Start animation unless reduced motion\n    if (!motionQuery.matches) {\n      drawParticles();\n    } else {\n      toggleBtn.textContent = 'PLAY';\n    }\n\n    // Reduce animation in background\n    let hidden = false;\n    document.addEventListener('visibilitychange', () => {\n      hidden = document.hidden;\n      if (hidden) {\n        // Reduce CPU usage\n        particles.forEach(p => {\n          p.vx *= 0.1;\n          p.vy *= 0.1;\n        });\n      }\n    });\n  </script>\n</body>\n</html>",
