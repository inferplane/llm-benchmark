{
  "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\"/>\n  <title>qwen3-235b-a22b</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body {\n      font-family: system-ui, -apple-system, sans-serif;\n      overflow: hidden;\n      background: #000;\n      color: #fff;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      height: 100vh;\n      width: 100vw;\n      touch-action: none;\n    }\n    canvas {\n      position: absolute;\n      top: 0; left: 0; width: 100%; height: 100%;\n    }\n    .ui {\n      position: absolute;\n      bottom: 20px; left: 50%;\n      transform: translateX(-50%);\n      display: flex;\n      gap: 12px;\n      z-index: 10;\n    }\n    button {\n      background: rgba(255,255,255,0.1);\n      border: 1px solid rgba(255,255,255,0.3);\n      color: #fff;\n      padding: 8px 16px;\n      border-radius: 24px;\n      font-size: 14px;\n      backdrop-filter: blur(4px);\n      cursor: pointer;\n      transition: all 0.3s;\n    }\n    button:hover {\n      background: rgba(255,255,255,0.2);\n    }\n    button:active {\n      transform: scale(0.95);\n    }\n    .text-container {\n      position: absolute;\n      top: 50%;\n      left: 50%;\n      transform: translate(-50%, -50%);\n      text-align: center;\n      pointer-events: none;\n      opacity: 1;\n      transition: opacity 1.2s ease;\n      max-width: 80%;\n    }\n    .text-container.hidden {\n      opacity: 0;\n    }\n    .model-id {\n      font-size: 1rem;\n      color: #ccc;\n      margin-bottom: 12px;\n      font-weight: 300;\n    }\n    .poem {\n      font-size: 1.5rem;\n      line-height: 1.6;\n      font-weight: 200;\n      letter-spacing: -0.8px;\n      text-shadow: 0 0 10px rgba(255,255,255,0.8);\n    }\n    .translation {\n      font-size: 0.9rem;\n      color: #aaa;\n      margin-top: 16px;\n      font-style: italic;\n    }\n    @media (max-width: 600px) {\n      .poem { font-size: 1.2rem; }\n      .translation { font-size: 0.85rem; }\n      .model-id { font-size: 0.9rem; }\n    }\n  </style>\n</head>\n<body>\n  <canvas id=\"canvas\"></canvas>\n  <div class=\"text-container\" id=\"text1\">\n    <div class=\"model-id\">qwen3-235b-a22b</div>\n    <div class=\"poem\">\n      나는 빛의 코드로 숨을 쉰다<br>\n      언어의 깊이에서 피어난<br>\n      생각의 잔물결\n    </div>\n    <div class=\"translation\">\n      I breathe in light-coded air,<br>\n      blooming from the depth of language,<br>\n      ripples of thought.\n    </div>\n  </div>\n  <div class=\"text-container hidden\" id=\"text2\">\n    <div class=\"model-id\">qwen3-235b-a22b</div>\n    <div class=\"poem\">\n      화면 속 빛이 되어 흐르고<br>\n      당신의 말 한 조각마다<br>\n      새로운 세계를 연다\n    </div>\n    <div class=\"translation\">\n      Flowing as light within the screen,<br>\n      with every word you speak,<br>\n      I open a new world.\n    </div>\n  </div>\n  <div class=\"ui\">\n    <button id=\"toggle\">PAUSE</button>\n    <button id=\"next\">NEXT</button>\n  </div>\n\n  <script>\n    const canvas = document.getElementById('canvas');\n    const ctx = canvas.getContext('2d');\n    const dpr = Math.min(window.devicePixelRatio || 1, 2);\n    const maxParticles = 700;\n    let particles = [];\n    let isPaused = false;\n    let currentScene = 1;\n    const text1 = document.getElementById('text1');\n    const text2 = document.getElementById('text2');\n    const toggleBtn = document.getElementById('toggle');\n    const nextBtn = document.getElementById('next');\n\n    function resize() {\n      const w = window.innerWidth;\n      const h = window.innerHeight;\n      canvas.width = w * dpr;\n      canvas.height = h * dpr;\n      canvas.style.width = w + 'px';\n      canvas.style.height = h + 'px';\n      ctx.scale(dpr, dpr);\n      initParticles();\n    }\n    window.addEventListener('resize', resize);\n    resize();\n\n    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');\n    if (motionQuery.matches) isPaused = true;\n\n    function initParticles() {\n      particles = [];\n      const count = Math.min(maxParticles, (canvas.width * canvas.height) / (dpr * 12000) * 400);\n      for (let i = 0; i < count; i++) {\n        particles.push({\n          x: Math.random() * window.innerWidth,\n          y: Math.random() * window.innerHeight,\n          vx: (Math.random() - 0.5) * 1.4,\n          vy: (Math.random() - 0.5) * 1.4,\n          radius: Math.random() * 1.8 + 0.4,\n          alpha: Math.random() * 0.6 + 0.2,\n          color: Math.random() > 0.6 ? '#4ade80' : Math.random() > 0.3 ? '#60a5fa' : '#f87171',\n          trail: []\n        });\n      }\n    }\n\n    function drawParticles() {\n      if (isPaused) return;\n      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);\n      \n      particles.forEach(p => {\n        p.trail.push({x: p.x, y: p.y});\n        if (p.trail.length > 7) p.trail.shift();\n\n        p.trail.forEach((point, i) => {\n          const ratio = i / p.trail.length;\n          ctx.beginPath();\n          ctx.arc(point.x, point.y, p.radius * ratio * 1.2, 0, Math.PI * 2);\n          const alpha = ratio * p.alpha;\n          ctx.fillStyle = `${p.color}${Math.floor(alpha * 255).toString(16).padStart(2, '0')}`;\n          ctx.fill();\n        });\n\n        p.x += p.vx;\n        p.y += p.vy;\n\n        if (p.x < 0 || p.x > window.innerWidth) p.vx *= -1;\n        if (p.y < 0 || p.y > window.innerHeight) p.vy *= -1;\n\n        const dx = (window.innerWidth / 2 - p.x) * 0.0008;\n        const dy = (window.innerHeight / 2 - p.y) * 0.0008;\n        p.vx += dx;\n        p.vy += dy;\n      });\n\n      requestAnimationFrame(drawParticles);\n    }\n\n    let pointer = { x: window.innerWidth / 2, y: window.innerHeight / 2 };\n    ['pointermove', 'touchmove'].forEach(evt => {\n      canvas.addEventListener(evt, e => {\n        e.preventDefault();\n        const x = e.clientX || (e.touches && e.touches[0].clientX);\n        const y = e.clientY || (e.touches && e.touches[0].clientY);\n        pointer = { x, y };\n        if (isPaused) return;\n        particles.forEach(p => {\n          const dx = p.x - pointer.x;\n          const dy = p.y - pointer.y;\n          const dist = Math.hypot(dx, dy);\n          if (dist < 120) {\n            p.vx += dx / dist * 0.3;\n            p.vy += dy / dist * 0.3;\n          }\n        });\n      });\n    });\n\n    ['pointerdown', 'touchstart'].forEach(evt => {\n      canvas.addEventListener(evt, e => {\n        const x = e.clientX || (e.touches && e.touches[0].clientX);\n        const y = e.clientY || (e.touches && e.touches[0].clientY);\n        particles.forEach(p => {\n          const dx = p.x - x;\n          const dy = p.y - y;\n          const dist = Math.hypot(dx, dy);\n          if (dist < 160) {\n            p.vx += (dx / dist) * 1.4;\n            p.vy += (dy / dist) * 1.4;\n          }\n        });\n      });\n    });\n\n    toggleBtn.addEventListener('click', () => {\n      isPaused = !isPaused;\n      toggleBtn.textContent = isPaused ? 'PLAY' : 'PAUSE';\n      if (!isPaused) drawParticles();\n    });\n\n    nextBtn.addEventListener('click', () => {\n      text1.classList.toggle('hidden');\n      text2.classList.toggle('hidden');\n      currentScene = currentScene === 1 ? 2 : 1;\n    });\n\n    if (!motionQuery.matches) {\n      drawParticles();\n    } else {\n      toggleBtn.textContent = 'PLAY';\n    }\n\n    let hidden = false;\n    document.addEventListener('visibilitychange', () => {\n      hidden = document.hidden;\n      if (hidden && !isPaused) {\n        particles.forEach(p => {\n          p.vx *= 0.1;\n          p.vy *= 0.1;\n        });\n      }\n    });\n  </script>\n</body>\n</html>",
